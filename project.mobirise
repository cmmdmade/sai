              },
              "&.navbar-short": {
                "min-height": "96px",
                ".navbar-brand": {
                  "min-height": "96px"
                }
              },
              "padding": "0 !important",
              "border-radius": "0 !important",
              "border": "none !important",
              "box-shadow": "none !important"
            },
            ".navbar-brand": {
              "min-height": "96px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word !important",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important",
                "font-weight": "400",
                "&:hover, &:focus": {
                  "color": "@activeColor !important"
                }
              },
              ".navbar-logo a": {
                "outline": "none"
              },
              "word-wrap": "break-word !important",
              "white-space": "normal"
            },
            ".navbar.opened": {
              ".navbar-brand": {
                ".navbar-caption": {
                  "&:hover, &:focus": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                "top": "3rem",
                "border-radius": "0",
                "@media (max-width: 992px)": {
                  "top": "0"
                },
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%",
                  "top": "0",
                  "border-left": "1px solid transparent"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap",
              "@media (min-width: 991px)": {
                "padding": "0",
                "background-color": "transparent",
                "border": "2px solid @borderColor",
                "& when (@collapsed)": {
                  "border-radius": "0 !important"
                }
              }
            },
            ".navbar-buttons": {
              "text-align": "center",
              ".btn": {
                "white-space": "nowrap",
                "margin-right": "0",
                "padding": "22px 32px",
                "min-height": "auto",
                ".mbr-iconfont": {
                  "width": "32px",
                  "height": "32px",
                  "min-width": "32px",
                  "font-size": "16px",
                  "margin-left": "32px",
                  "margin-right": "-20px"
                },
                "@media (max-width: 575px)": {
                  "width": "auto !important"
                }
              }
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "50px",
              "height": "50px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "border-radius": "100%",
              "background-color": "@menuBgColor !important",
              "border": "none !important",
              "box-shadow": "none !important",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "20px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "18px",
                  "left": "15px",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "left": "15px",
                  "top": "30px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            ".navbar-nav": {
              "margin": "0 auto",
              "& when not (@showButtons)": {
                "justify-content": "flex-end",
                "margin": "0"
              }
            },
            ".nav-item": {
              "padding": "0",
              "margin": "0",
              ".nav-link": {
                "padding": "24px 32px !important",
                "margin": "0 !important",
                "transition": "all 0.3s ease-in-out",
                "font-weight": "400",
                "&::after": {
                  "color": "@activeColor !important",
                  "transform": "rotate(0)",
                  "transition": ".3s"
                },
                "&:hover": {
                  "background-color": "transparent",
                  "color": "@activeColor !important"
                }
              },
              ".nav-link.show": {
                "&::after": {
                  "transform": "rotate(180deg)"
                }
              },
              ".dropdown-menu": {
                "background-color": "transparent !important",
                "&:hover": {
                  "background-color": "transparent !important"
                },
                ".dropdown-item": {
                  "color": "@primaryColor !important",
                  "&:hover": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            "& when (@collapsed)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 5rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "40px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid hsla(0, 0%, 100%, 0.2)"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center"
                  }
                }
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "flex-direction": "column !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 3rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "24px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid hsla(0, 0%, 100%, 0.2)"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center"
                  }
                }
              }
            },
            ".content-wrap": {
              "min-height": "130px"
            }
          },
          "_name": "menu01",
          "_sourceTheme": "glancem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 glancem5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#c75423\" condition=\"showItems\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffffff\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#101012\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://neutral3rd.space\">\n                        <img src=\"@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.webp\" alt=\"Neutral3rd Emerging Tech Development Studio\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-info\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">GlanceM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">OfferBeacon Suite</a></li><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">LearnHub (coming soon)</a></li>\n                    \n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#dev-about\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"index.html\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-bluesky socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-secondary\" href=\"https://studioguide.neutral3rd.space/chat?token=cf7573456c87d54489c7ba5f0a2e93bf&name=Samir%20%7C%20Neutral3rd%20Emerging%20Tech%20Development%20Studio&accent=%23c75423&greet=Hey!%20Welcome%20to%20Neutral3rd.%20I%27m%20Samir%2C%20Neutral3rd%27s%20AI%20studio%20guide.%20I%20can%20help%20you%20explore%20the%20OfferBeacon%20Suite%2C%20learn%20about%20this%20development%20studio%20in%20general%2C%20or%20find%20the%20right%20next%20step.%20What%20brings%20you%20here%20today%3F&face=https%3A%2F%2Fcuevueapp.com%2Fassets%2Ffaces%2Fstandard%2F62227bb3-2f6e-4220-b3c9-2c02b2fdb349.jpg&page=https%3A%2F%2Fstudioguide.neutral3rd.space%2Fneutral3rd-emerging-technologies%2Fsamir-from-neutral3rd-emerging&mode=desktop&lang=en\" data-app-placeholder=\"Type Text\" target=\"_blank\">Start a Conversation</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vA8TDtYH0a",
          "_anchor": "menu01-4l",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_name": "pricing02",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing02 impactm5\" group=\"Pricing\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Marker\" name=\"showMarker\" condition=\"showLabel\">\n        <input type=\"color\" title=\"Label BG\" value=\"#28282F\" name=\"labelBg\" condition=\"showLabel\">\n        <input type=\"color\" title=\"Label Border\" value=\"#c75423\" name=\"labelBorder\" condition=\"showLabel\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showCardLabel\" checked>\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showCardLabel\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Card BG\" value=\"#161617\" name=\"cardBg\">\n        <input type=\"color\" title=\"Card Border\" value=\"#353535\" name=\"cardBorder\">\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#28282F\" name=\"border\" condition=\"showBorder\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/impactm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/impactm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"col-12 justify-content-center\">\n            <div class=\"content-wrapper\">\n                <div class=\"border-wrap border_1\"></div>\n                <div class=\"border-wrap border_2\"></div>\n                <div class=\"border-wrap border_3\"></div>\n                <div class=\"border-wrap border_4\"></div>\n                <div class=\"border-wrap border_5\"></div>\n                <div class=\"row title-wrapper\" mbr-if=\"showLabel || showTitle\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"col-12 col-lg-6 card\">\n                        <div class=\"title-wrap\">\n                            <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                                <div class=\"label-wrap card-wrap small-radius\">\n                                    <div class=\"marker-wrap card-wrap\" mbr-if=\"showMarker\"></div>\n                                    <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                        PRODUCTS\n                                    </p>\n                                </div>\n                            </div>\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .main-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                                <b>DIGITAL MARKETING SERVICE PLANS</b>\n                            </h2>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"row items-wrapper\">\n                    <div class=\"col-12 card\">\n                        <div class=\"items-wrap\">\n                            <div class=\"item features-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"item-img\">\n                                        <img src=\"@PROJECT_PATH@/assets/images/image8.webp\" alt=\"Mobirise Website Builder\">\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-price\">\n                                            <b>$5</b></p>\n                                        <div class=\"card-label\" mbr-if=\"showCardLabel\">\n                                            <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-label, .card-label\">\n                                                SENSITIVE MESSAGE WRITER</p>\n                                        </div>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\"><b>NEUTRAL3RD ClearWords</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            Turn a difficult business situation into a clear, considerate message. The customer supplies the circumstances, relationship, desired outcome, and tone to generate one draft for an apology, delay, disagreement, or boundary-setting conversation.\n                                        </p>\n                                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                BUY NOW\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"item features-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"item-img\">\n                                        <img src=\"@PROJECT_PATH@/assets/images/mbr-1128x752.webp\" alt=\"Mobirise Website Builder\">\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-price\">\n                                            <b>$9</b>\n                                        </p>\n                                        <div class=\"card-label\" mbr-if=\"showCardLabel\">\n                                            <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-label, .card-label\">\n                                                Business Case Study Creator\n                                            </p>\n                                        </div>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\"><b>Neutral3rd ImpactStory</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            Turn a completed client project or business success into a professional case study for your website, proposals, presentations, or marketing materials. Provide the customer’s challenge, what your business did, and the results achieved to generate one structured draft that shows prospective customers how your business solves problems.\n                                        </p>\n                                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                BUY NOW\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"item features-image\">\n                                <div class=\"item-wrapper\">\n                                    <div class=\"item-img\">\n                                        <img src=\"@PROJECT_PATH@/assets/images/mbr-1-1128x752.webp\" alt=\"Mobirise Website Builder\" data-slide-to=\"2\" data-bs-slide-to=\"3\">\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-price\">\n                                            <b>$7</b></p>\n                                        <div class=\"card-label\" mbr-if=\"showCardLabel\">\n                                            <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-label, .card-label\">\n                                                Business FAQ Creator\n                                            </p>\n                                        </div>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\"><b>Neutral3rd AnswerFrame</b></h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            Convert supplied business, product, or service information into one organized FAQ set. Customers receive draft questions and answers for review, with information gaps identified rather than filled with invented policies or promises.\n                                        </p>\n                                        <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-4\">\n                                            <a href class=\"btn btn-primary-outline\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                BUY NOW\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            \n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@showBorder)": {
              "overflow": "hidden",
              "position": "relative"
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center",
              "& when (@showBorder)": {
                ".border-wrap": {
                  "position": "absolute",
                  "height": "1000%",
                  "width": "1px",
                  "border-left": "1px dashed @border",
                  "pointer-events": "none"
                },
                ".border_1": {
                  "left": "0"
                },
                ".border_2": {
                  "left": "25%",
                  "@media (max-width: 992px)": {
                    "display": "none"
                  }
                },
                ".border_3": {
                  "left": "50%"
                },
                ".border_4": {
                  "left": "75%",
                  "@media (max-width: 992px)": {
                    "display": "none"
                  }
                },
                ".border_5": {
                  "left": "100%"
                }
              }
            },
            ".title-wrapper": {
              "margin": "0 0 60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              ".card": {
                "position": "relative",
                "justify-content": "flex-end",
                "z-index": "2",
                "padding": "0"
              },
              ".label-wrapper": {
                "margin-bottom": "24px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "20px"
                },
                ".label-wrap": {
                  "position": "relative",
                  "display": "inline-flex",
                  "align-items": "center",
                  "padding": "7px 16px",
                  "border": "1px",
                  "gap": "6px",
                  "border-right": "1px solid @labelBorder",
                  "border-left": "1px solid @labelBorder",
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "width": "100%",
                    "height": "100%",
                    "background-color": "@labelBg",
                    "opacity": ".3"
                  },
                  ".marker-wrap": {
                    "display": "inline-flex",
                    "width": "12px",
                    "min-width": "12px",
                    "height": "12px",
                    "border": "1px solid @labelBorder",
                    "margin-bottom": "3px"
                  },
                  ".mbr-label": {
                    "position": "relative",
                    "z-index": "1",
                    "margin-bottom": "0"
                  }
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".items-wrapper": {
              "margin": "0",
              ".card": {
                "padding": "0"
              }
            },
            ".items-wrap": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "gap": "40px 2px",
              "margin-left": "1px",
              "@media (max-width: 992px)": {
                "grid-template-columns": "1fr",
                "gap": "16px"
              }
            },
            ".item": {
              "z-index": "2",
              ".item-wrapper": {
                "height": "100%",
                "background-color": "@cardBg",
                "border-top": "1px solid @cardBorder",
                "border-bottom": "1px solid @cardBorder",
                "transition": "all .3s ease",
                "overflow": "hidden",
                "padding": "24px",
                "@media (max-width: 992px)": {
                  "margin": "0 1px",
                  "padding": "20px 16px"
                },
                ".item-img": {
                  "margin-bottom": "24px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  },
                  "img": {
                    "width": "100%",
                    "height": "300px",
                    "object-fit": "cover"
                  }
                },
                ".card-box": {
                  ".item-price": {
                    "margin-bottom": "24px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "20px"
                    }
                  },
                  ".card-label": {
                    ".item-label": {
                      "position": "relative",
                      "display": "inline-flex",
                      "align-items": "center",
                      "padding-left": "20px",
                      "margin-bottom": "16px",
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "left": "0",
                        "width": "12px",
                        "height": "12px",
                        "background-color": "@markerColor"
                      }
                    }
                  },
                  ".item-title": {
                    "margin-bottom": "12px"
                  },
                  ".item-text": {
                    "margin-bottom": "0"
                  },
                  ".mbr-section-btn": {
                    "margin-top": "16px",
                    "margin-bottom": "-9.6px",
                    "width": "100%",
                    ".btn": {
                      "width": "100%"
                    }
                  }
                }
              }
            },
            ".mbr-label": {
              "color": "#f0e226"
            },
            ".mbr-section-title": {
              "color": "#e4e3dc"
            },
            ".item-price": {
              "color": "#e4e3dc"
            },
            ".item-label": {
              "color": "#ffffff"
            },
            ".item-title": {
              "color": "#c75423"
            },
            ".item-text": {
              "color": "#b3b2ae",
              "text-align": "justify"
            },
            ".mbr-label, .label-wrapper": {
              "color": "#c75423"
            }
          },
          "_cid": "vA8TPNYlUS",
          "_anchor": "pricing02-4p",
          "_protectedParams": [],
          "_global": false,
