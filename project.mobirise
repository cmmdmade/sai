        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<section aria-labelledby=\"n3-fmwd-title\">\n  <div class=\"n3-fmwd\">\n    <svg class=\"fmwd-defs\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" focusable=\"false\">\n      <defs>\n        <symbol id=\"n3-fmwd-spiral\" viewBox=\"0 0 210 210\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\".62\">\n            <path d=\"M0 170A130 130 0 0 1 130 40A80 80 0 0 1 210 120A50 50 0 0 1 160 170A30 30 0 0 1 130 140A20 20 0 0 1 150 120A10 10 0 0 1 160 130A10 10 0 0 1 150 140\"></path>\n            <circle cx=\"106\" cy=\"106\" r=\"79\" stroke-dasharray=\"7 4 1 4\"></circle>\n            <circle cx=\"106\" cy=\"106\" r=\"58\" opacity=\".6\"></circle>\n            <circle cx=\"106\" cy=\"106\" r=\"24\" stroke-dasharray=\"3 3\"></circle>\n            <path d=\"M0 106h210M106 0v210M8 45h159v159M106 106h61v98M8 106v98h159\" opacity=\".58\"></path>\n            <path d=\"M102 106h8m-4-4v8M162 143h9m-4.5-4.5v9M102 45h8m-4-4v8\"></path>\n            <path d=\"M6 104h4v4H6zm98 98h4v4h-4zm61-61h4v4h-4z\"></path>\n          </g>\n        </symbol>\n        <pattern id=\"n3-fmwd-hatch\" width=\"11\" height=\"11\" patternUnits=\"userSpaceOnUse\">\n          <path d=\"m-3 3 6-6m-3 14L11 0m-3 14 6-6\" stroke=\"#a6a39e\" stroke-width=\".65\"></path>\n        </pattern>\n        <symbol id=\"n3-fmwd-notes\" viewBox=\"0 0 48 48\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"5\" y=\"7\" width=\"38\" height=\"36\" rx=\"3\"></rect><path d=\"M14 4v7m20-7v7M18 19h17m-17 8h17m-17 8h17M12 19h.5m-.5 8h.5m-.5 8h.5\"></path>\n          </g>\n        </symbol>\n        <symbol id=\"n3-fmwd-code\" viewBox=\"0 0 48 48\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M10 3h17l13 13v26a3 3 0 0 1-3 3H10a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Z\"></path><path d=\"M27 3v13h13M18 23l-5 5 5 5m11-10 5 5-5 5m-4-12-4 14\"></path>\n          </g>\n        </symbol>\n        <symbol id=\"n3-fmwd-recap\" viewBox=\"0 0 48 48\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"6\" y=\"12\" width=\"30\" height=\"29\" rx=\"3\"></rect><path d=\"M13 12V8a3 3 0 0 1 3-3h25a3 3 0 0 1 3 3v27a3 3 0 0 1-3 3h-5M16 21h13m-13 6h13m-13 6h13m-17-12h.5m-.5 6h.5m-.5 6h.5\"></path>\n          </g>\n        </symbol>\n        <symbol id=\"n3-fmwd-layers\" viewBox=\"0 0 48 48\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"m3 15 21-11 21 11-21 11L3 15Zm7 6-7 4 21 11 21-11-7-4M10 31l-7 4 21 11 21-11-7-4\"></path>\n          </g>\n        </symbol>\n        <symbol id=\"n3-fmwd-message\" viewBox=\"0 0 48 48\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M10 5h28a6 6 0 0 1 6 6v19a6 6 0 0 1-6 6H17L5 44V11a6 6 0 0 1 5-6Z\"></path>\n            <circle cx=\"15\" cy=\"20\" r=\"1.4\"></circle><circle cx=\"24\" cy=\"20\" r=\"1.4\"></circle><circle cx=\"33\" cy=\"20\" r=\"1.4\"></circle>\n          </g>\n        </symbol>\n      </defs>\n    </svg>\n    <div class=\"fmwd-drafting\" aria-hidden=\"true\">\n      <svg class=\"fmwd-traces\" viewBox=\"0 0 1024 1536\" preserveAspectRatio=\"none\" focusable=\"false\">\n        <g fill=\"none\" stroke=\"currentColor\" stroke-width=\".68\" vector-effect=\"non-scaling-stroke\">\n          <path d=\"M0 119h1024M0 615h1024M0 872h1024M0 1204h1024M0 1452h1024M46 0v1536m918-1536v1536M0 238h488v-102h66v77h112m-170-94v137m-125-152h125m302-14h168M0 582h700v-78h191M0 904h237v-31h449m-54-57v86m242 15v166m-156-39h306m-817 326h619m-302-113v158\"></path>\n          <path d=\"M0 238h16v220m356-354h74m-43 135 93-103m60 80h42m43-158 91-38h110v139m-45-65h166m-531 487h265m-65 67h102l80-80m-46 58h106m-138 291h139v60m-207-60h112m-336 327 72-53h153m-443 181h88m369-49h138m-212 181h311\" stroke-dasharray=\"9 4 2 4\"></path>\n          <path d=\"M13 235h7v7h-7zm356-134h7v7h-7zm124 15h7v7h-7zm57 93h7v7h-7zm287-193h8v8h-8zm-141 561h8v8h-8zm-67 67h8v8h-8zm-426 223h8v8h-8zm586 47h7v7h-7zm81-1h7v7h-7zm-234 586h8v8h-8z\" fill=\"#151515\"></path>\n          <path d=\"M891 644h133v83H891zM125 989h122v62H125zM920 1120h104v59H920z\" fill=\"url(#n3-fmwd-hatch)\" opacity=\".58\" stroke=\"none\"></path>\n        </g>\n      </svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--top-left\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--top-right\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--center\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--middle-left\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--middle-right\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--bottom-left\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--bottom-right\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n    </div>\n\n    <div class=\"fmwd-top\">\n      <div class=\"fmwd-fold\" aria-hidden=\"true\"></div>\n      <div class=\"fmwd-hero fmwd-wrap\">\n        <div>\n          <p class=\"fmwd-kicker\">Custom AI Prompt Service</p>\n            <h1 class=\"fmwd-title\" id=\"n3-fmwd-title\">From My <span>Wildest Dreams</span></h1>\n          <p class=\"fmwd-lede\">Bring one task you do often or a specific task that needs extra focus. I’ll build a reusable AI prompt for it (for use in either Claude, ChatGPT, or Google Gemini), then you and I will test and refine it together in a relaxed one-on-one video meeting session..</p>\n            <p><a class=\"fmwd-cta\" href=\"#n3-fmwd-intake\">Start Your Project</a></p>\n          <p class=\"fmwd-cta-note\">By answering questions within a short project brief.</p>\n        </div>\n        <figure class=\"fmwd-example\">\n          <figcaption>Example Workflow</figcaption>\n          <ol role=\"list\">\n            <li><svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-notes\"></use></svg>Rough job notes</li>\n            <li><svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-code\"></use></svg>Custom AI prompt</li>\n            <li><svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-recap\"></use></svg>Client-ready recap</li>\n          </ol>\n        </figure>\n      </div>\n    </div>\n\n    <div class=\"fmwd-content-section\">\n      <div class=\"fmwd-wrap\">\n        <h2 class=\"fmwd-section-title\">How it works</h2>\n        <ol class=\"fmwd-columns fmwd-steps\" role=\"list\">\n          <li>\n            <h3 class=\"fmwd-item-title fmwd-step-title\"><span class=\"fmwd-step-number\" aria-hidden=\"true\">01</span>Discuss the need</h3>\n            <p class=\"fmwd-item-text\">Share the task, an example, and what a good result looks like.</p>\n          </li>\n          <li>\n            <h3 class=\"fmwd-item-title fmwd-step-title\"><span class=\"fmwd-step-number\" aria-hidden=\"true\">02</span>Try it with me</h3>\n            <p class=\"fmwd-item-text\">I build the prompt in advance. We test it together on a private call.</p>\n          </li>\n          <li>\n            <h3 class=\"fmwd-item-title fmwd-step-title\"><span class=\"fmwd-step-number\" aria-hidden=\"true\">03</span>Use it again</h3>\n            <p class=\"fmwd-item-text\">Take home the editable prompt and tools to build your next one.</p>\n          </li>\n        </ol>\n      </div>\n    </div>\n\n    <div class=\"fmwd-content-section\">\n      <div class=\"fmwd-wrap\">\n        <h2 class=\"fmwd-section-title\">What you’ll take home</h2>\n        <div class=\"fmwd-columns\">\n          <div class=\"fmwd-card\">\n            <svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-code\"></use></svg>\n            <h3 class=\"fmwd-item-title\">Your custom prompt</h3>\n            <p class=\"fmwd-item-text\">An editable prompt for your one task.</p>\n          </div>\n          <div class=\"fmwd-card\">\n            <svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-layers\"></use></svg>\n            <h3 class=\"fmwd-item-title\">Prompt Workbench</h3>\n            <p class=\"fmwd-item-text\">A worked example, reusable templates, and a test checklist.</p>\n          </div>\n          <div class=\"fmwd-card\">\n            <svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-message\"></use></svg>\n            <h3 class=\"fmwd-item-title\">One Second Look</h3>\n            <p class=\"fmwd-item-text\">Send me a prompt you write within 30 days for written feedback.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"fmwd-price-section\">\n      <div class=\"fmwd-fold fmwd-fold--bottom\" aria-hidden=\"true\"></div>\n      <div class=\"fmwd-wrap fmwd-price\">\n        <div class=\"fmwd-price-left\">\n          <h2 class=\"fmwd-kicker\">Founding Client Offer</h2>\n          <strong class=\"fmwd-price-amount\">$350</strong>\n          <p class=\"fmwd-item-text\">One-time payment for the first three clients. <strong>Act Now! Pricing will go up.</strong></p>\n        </div>\n        <div class=\"fmwd-price-right\">\n          <p class=\"fmwd-price-title\">One task. One private session.<br>Tools you can keep.</p>\n          <p class=\"fmwd-item-text\">I’ll review your brief and confirm the scope before you pay.</p>\n          <a class=\"fmwd-cta\" href=\"#n3-fmwd-intake\">Start Your Project</a>\n        </div>\n      </div>\n      <aside class=\"fmwd-wrap fmwd-intake\" id=\"n3-fmwd-intake\" tabindex=\"-1\">\n        <p>The project intake form will be available here when the service opens.</p>\n      </aside>\n    </div>\n  </div>\n</section>\n",
          "_customCSS": "",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "fabm5",
          "_anchor": "custom-html-5c",
          "_PHPplaceholders": [],
          "_JSplaceholders": []
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <a href=\"https://neutral3rd.space\"><img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-1-512x512.webp\" alt=\"Neutral3rd Emerging Tech Development Studio\"></a>\n                            </div>\n\n                           <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <!-- <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">xx</p>\n                    </div> -->\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                       <!-- <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3> -->\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\">Neutral3rd helps small businesses and professionals put AI to work in real human work. Led by Renée and supported by AI agents, the studio brings strategy, development, automation, and AI-powered media together to make work more capable without making it more complicated.<br></p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/privacy\" class=\"text-info\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/terms\" class=\"text-info\">TERMS OF SERVICE</a></b></li><a href=\"https://neutral3rd.space/terms\" class=\"text-primary\">\n                                </a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/accessibility\" class=\"text-info\">ACCESSIBILITY</a></b></li><li class=\"item-wrap\"><b><a href=\"https://connections.neutral3rd.space/wall\" class=\"text-info\" target=\"_blank\">LEAVE YOUR FEEDBACK</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://offerbeacon.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">HELP THE RIGHT BUYERS FIND YOU</a></b></li>\n<li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space\" class=\"text-info\">LEARN HUB</a>&nbsp;(coming soon)</b></li><li class=\"item-wrap\"><b><a href=\"https://perspectives.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">NEUTRAL3RD PERSPECTIVES</a></b></li><a href=\"https://neutral3rd.space\" class=\"text-primary\">\n</a><li class=\"item-wrap\"><b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-info\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Tech Development Studio. Operated by Rowdy Independents LLC., a U.S.-based business entity. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vAkxbStNJy",
          "_anchor": "footer01-5b",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    }
  }
}