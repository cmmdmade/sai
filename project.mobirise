          "_name": "list01",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 fabm5 neutral3rd-faq\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n 'mbr-fullscreen': fullScreen,\n 'mbr-parallax-background': bg.parallax\n }\">\n\n<mbr-parameters>\n\n  <header>Size</header>\n  <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n  <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n  <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n  <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n\n  <header>Content</header>\n  <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n  <input type=\"checkbox\" title=\"Intro\" name=\"showText\" checked>\n  <input type=\"checkbox\" title=\"Studio Guide\" name=\"showStudioGuide\" checked>\n\n  <select title=\"FAQ Amount\" name=\"cardAmount\">\n   <option value=\"1\">1</option>\n   <option value=\"2\">2</option>\n   <option value=\"3\">3</option>\n   <option value=\"4\">4</option>\n   <option value=\"5\">5</option>\n   <option value=\"6\">6</option>\n   <option value=\"7\">7</option>\n   <option value=\"8\" selected>8</option>\n  </select>\n\n  <header>Colors</header>\n  <input type=\"color\" title=\"Border\" name=\"border\" value=\"#72716b\">\n  <input type=\"color\" title=\"Accent\" name=\"active\" value=\"#c75423\">\n\n  <header>Studio Guide</header>\n  <input type=\"image\" title=\"Guide Portrait\" name=\"studioGuideImage\" value=\"@PROJECT_PATH@/assets/images/image1-1.webp\">\n\n  <header>Background</header>\n  <fieldset type=\"background\" name=\"bg\" parallax>\n   <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" selected parallax>\n   <input type=\"color\" title=\"Color\" value=\"#474A48\">\n  </fieldset>\n\n  <input type=\"image\" title=\"Fallback Image\" name=\"fallBackImage\" value=\"../_images/background1.jpg\" condition=\"bg.type == 'video'\">\n\n  <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n  <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n  <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n</mbr-parameters>\n\n<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n<div mbr-class=\"{\n 'container': !fullWidth,\n 'container-fluid': fullWidth\n }\">\n\n <div class=\"n3-faq-inner\">\n\n  <header class=\"n3-faq-heading\">\n\n   <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrap\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Before We Build</b></h2>\n\n   <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n    Quick answers before you get started.\n    You can also chat with my AI assistant\n    for more details.\n   </p>\n\n  </header>\n\n  <div class=\"n3-faq-layout\">\n\n   <!-- LEFT COLUMN: FAQ -->\n\n   <div class=\"n3-faq-main\">\n\n    <div class=\"n3-faq-side-label\" aria-hidden=\"true\">FAQ</div>\n\n    <div class=\"n3-faq-list\">\n\n     <div class=\"panel-group accordionStyles accordion\" id=\"neutral3rd-faq-accordion\">\n\n      <!-- QUESTION 1 -->\n\n      <div class=\"card\">\n       <div class=\"card-header\" id=\"n3-faq-heading-1\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-1\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-1\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          What is an AI Business Guide?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-1\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-1\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          An AI Business Guide is a conversational\n          assistant configured around your approved\n          business information. It helps visitors\n          find answers, understand your services,\n          and identify relevant next steps.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 2 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 1\">\n       <div class=\"card-header\" id=\"n3-faq-heading-2\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-2\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-2\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          How is it different from a conventional chatbot?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-2\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-2\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Rather than relying only on fixed\n          question-and-answer scripts, the guide\n          is configured to respond conversationally\n          using relevant business information.\n          Its behavior and available actions depend\n          on the setup and supported integrations.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 3 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 2\">\n       <div class=\"card-header\" id=\"n3-faq-heading-3\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-3\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-3\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          What information do you need from me?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-3\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-3\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          We begin with your website, business\n          description, products or services,\n          frequently asked questions, contact\n          details, and desired customer actions.\n          We'll identify any additional information\n          needed during discovery.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 4 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 3\">\n       <div class=\"card-header\" id=\"n3-faq-heading-4\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-4\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-4\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          Can it work with my existing website?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-4\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-4\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Website integration is one of the intended\n          deployment options. We'll review your\n          website platform, available integration\n          methods, and requirements before\n          recommending the right setup.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 5 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 4\">\n       <div class=\"card-header\" id=\"n3-faq-heading-5\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-5\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-5\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          How do I get started?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-5\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-5\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Request early access or start a\n          conversation with Neutral3rd.\n          We'll discuss your business, what\n          you want the guide to accomplish,\n          and whether the current development\n          offering is a suitable fit.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 6 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 5\">\n       <div class=\"card-header\" id=\"n3-faq-heading-6\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-6\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-6\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          How much does an AI Business Guide cost?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-6\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-6\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Pricing depends on your business\n          requirements, information sources,\n          integrations, and support needs.\n          Neutral3rd provides a tailored scope\n          and pricing information after an\n          initial discussion.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 7 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 6\">\n       <div class=\"card-header\" id=\"n3-faq-heading-7\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-7\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-7\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          How do you help keep its answers accurate?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-7\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-7\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          We use approved business information,\n          test representative questions, review\n          responses, and refine the configuration.\n          Because AI can make mistakes, periodic\n          review and updated source information\n          remain important.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 8 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 7\">\n       <div class=\"card-header\" id=\"n3-faq-heading-8\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-8\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-8\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          What happens after my AI Business Guide launches?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-8\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-8\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Ongoing services may include updating\n          business information, reviewing\n          conversations, testing changes, and\n          refining the experience. The specific\n          support arrangements are established\n          as part of your engagement.\n         </p>\n        </div>\n       </div>\n      </div>\n\n     </div>\n    </div>\n\n   </div>\n\n   <!-- RIGHT COLUMN: STUDIO GUIDE -->\n\n   <aside class=\"n3-studio-guide\" mbr-if=\"showStudioGuide\" aria-label=\"Neutral3rd Studio Guide\">\n\n    <div class=\"n3-guide-top\">\n\n     <div class=\"n3-guide-avatar\">\n      <img src=\"@PROJECT_PATH@/assets/images/image1-1.webp\" alt=\"Neutral3rd Studio Guide portrait\" width=\"600\" height=\"600\">\n     </div>\n\n     <div class=\"n3-guide-content\">\n\n      <h3 class=\"n3-guide-title mbr-fonts-style\" mbr-theme-style=\"display-5\">\n       <b>NEUTRAL3RD STUDIO GUIDE</b>\n      </h3>\n\n      <p class=\"n3-guide-description mbr-fonts-style\" mbr-theme-style=\"display-7\">\n       Have a question? Chat with my AI\n       assistant to get instant answers\n       about the AI Business Guide,\n       current builds, and next steps.\n      </p>\n\n     </div>\n\n    </div>\n\n    <div class=\"n3-guide-actions mbr-section-btn\">\n     <a class=\"btn btn-primary display-4\" href=\"#\">\n      START A CONVERSATION\n      <span aria-hidden=\"true\">→</span>\n     </a>\n    </div>\n\n   </aside>\n\n  </div>\n\n </div>\n\n</div>\n\n</section>",
          "_cid": "tPfiWrOGHA",
          "_anchor": "faq-guide",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "position": "relative",
            "width": "100%",
            "max-width": "100%",
            "min-height": "180px",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "margin": "0",
            "overflow": "hidden",
            "background-color": "#101112",
            "background-size": "cover",
            "background-position": "center center",
            "background-repeat": "no-repeat",
            "color": "#FFFFFF",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "position": "absolute",
              "inset": "0",
              "width": "100%",
              "height": "100%",
              "background-position": "center",
              "background-size": "cover",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".n3-cta-outer, .n3-cta-outer *, .n3-cta-outer *::before, .n3-cta-outer *::after": {
              "box-sizing": "border-box"
            },
            ".n3-cta-outer": {
              "position": "relative",
              "z-index": "2",
              "width": "100%",
              "max-width": "100%",
              "padding": "0 clamp(24px, 7vw, 165px)"
            },
            ".n3-cta-inner": {
              "display": "flex",
              "flex-direction": "row",
              "align-items": "center",
              "justify-content": "space-between",
              "gap": "36px",
              "width": "100%",
              "max-width": "1600px",
              "min-height": "116px",
              "margin": "0 auto"
            },
            ".n3-cta-copy": {
              "flex": "1 1 auto",
              "min-width": "0",
              "max-width": "690px"
            },
            ".n3-cta-heading": {
              "color": "@headingColor !important",
              "font-size": "clamp(1.55rem, 2.35vw, 2.15rem)",
              "font-weight": "700",
              "line-height": "1.2",
              "letter-spacing": "-0.025em",
              "margin": "0 0 7px",
              "padding": "0",
              "text-align": "left",
              "overflow-wrap": "break-word"
            },
            ".n3-cta-heading b": {
              "color": "@headingColor !important"
            },
            ".n3-cta-description": {
              "color": "@textColor !important",
              "font-size": "clamp(1rem, 1.38vw, 1.3rem)",
              "font-weight": "400",
              "line-height": "1.42",
              "margin": "0",
              "padding": "0",
              "text-align": "left"
            },
            ".n3-cta-actions": {
              "display": "flex",
              "flex": "0 0 auto",
              "align-items": "center",
              "justify-content": "flex-end",
              "min-width": "0",
              "margin": "0",
              "padding": "0"
            },
            ".n3-cta-button, .n3-cta-actions .btn": {
              "display": "inline-flex",
              "flex-direction": "row",
              "align-items": "center",
              "justify-content": "center",
              "gap": "17px",
              "min-height": "52px",
              "margin": "0 !important",
              "padding": "14px 24px",
              "border": "1px solid @buttonColor !important",
              "border-radius": "4px",
              "background-color": "@buttonColor !important",
              "color": "@buttonTextColor !important",
              "font-size": "0.9rem",
              "font-weight": "800",
              "line-height": "1.3",
              "letter-spacing": "0.015em",
              "text-align": "center",
              "text-decoration": "none !important",
              "white-space": "nowrap",
              "box-shadow": "0 4px 15px rgba(0, 0, 0, 0.22)",
              "transition": "filter 0.2s ease,\n    transform 0.2s ease"
            },
            ".n3-cta-button span, .n3-cta-actions .btn span": {
              "color": "inherit !important"
            },
            ".n3-cta-button:hover, .n3-cta-actions .btn:hover": {
              "color": "@buttonTextColor !important",
              "background-color": "@buttonColor !important",
              "border-color": "@buttonColor !important",
              "filter": "brightness(1.13)",
              "transform": "translateY(-2px)"
            },
            ".n3-cta-button:focus-visible": {
              "outline": "3px solid #FFFFFF",
              "outline-offset": "4px"
            },
            ".n3-cta-arrow": {
              "display": "inline-block",
              "font-size": "1.35rem",
              "font-weight": "600",
              "line-height": "0.8"
            },
            "@media (max-width: 1199px)": {
              ".n3-cta-outer": {
                "padding-left": "5%",
                "padding-right": "5%"
              },
              ".n3-cta-inner": {
                "gap": "24px"
              },
              ".n3-cta-heading": {
                "font-size": "clamp(1.45rem, 2.5vw, 1.9rem)"
              },
              ".n3-cta-description": {
                "font-size": "1.05rem"
              },
              ".n3-cta-button, .n3-cta-actions .btn": {
                "padding": "13px 20px"
              }
            },
            "@media (max-width: 850px)": {
              "min-height": "220px",
              "background-position": "center center",
              ".n3-cta-outer": {
                "padding-left": "30px",
                "padding-right": "30px"
              },
              ".n3-cta-inner": {
                "flex-direction": "column",
                "align-items": "flex-start",
                "justify-content": "center",
                "gap": "23px",
                "min-height": "170px"
              },
              ".n3-cta-copy": {
                "flex": "0 1 auto",
                "max-width": "100%"
              },
              ".n3-cta-heading": {
                "font-size": "clamp(1.55rem, 3.5vw, 2rem)"
              },
              ".n3-cta-description": {
                "font-size": "1.05rem"
              },
              ".n3-cta-actions": {
                "justify-content": "flex-start",
                "width": "auto"
              }
            },
            "@media (max-width: 600px)": {
              "min-height": "260px",
              "background-position": "52% center",
              ".n3-cta-outer": {
                "width": "100%",
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".n3-cta-inner": {
                "display": "flex",
                "flex-direction": "column",
                "align-items": "stretch",
                "justify-content": "center",
                "gap": "22px",
                "min-height": "210px",
                "width": "100%"
              },
              ".n3-cta-copy": {
                "width": "100%",
                "max-width": "100%",
                "text-align": "left"
              },
              ".n3-cta-heading": {
                "font-size": "clamp(1.5rem, 6vw, 1.9rem)",
                "line-height": "1.23",
                "margin-bottom": "10px"
              },
              ".n3-cta-description": {
                "font-size": "1rem",
                "line-height": "1.5"
              },
              ".n3-cta-actions": {
                "width": "100%",
                "max-width": "100%",
                "justify-content": "stretch"
              },
              ".n3-cta-button, .n3-cta-actions .btn": {
                "width": "100%",
                "max-width": "100%",
                "min-height": "54px",
                "padding": "14px 16px",
                "white-space": "normal",
                "font-size": "0.88rem"
              }
            },
            "@media (max-width: 360px)": {
              ".n3-cta-outer": {
                "padding-left": "15px",
                "padding-right": "15px"
              },
              ".n3-cta-heading": {
                "font-size": "1.4rem"
              },
              ".n3-cta-description": {
                "font-size": "0.94rem"
              },
              ".n3-cta-button, .n3-cta-actions .btn": {
                "font-size": "0.82rem",
                "gap": "10px"
              }
            }
          },
          "_name": "list01",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 fabm5 n3-cta-banner\" group=\"List\" mbr-class=\"{\n  'mbr-parallax-background': bg.parallax\n }\">\n\n<mbr-parameters>\n\n  <header>Banner Spacing</header>\n\n  <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n\n  <input type=\"range\" inline title=\"Top Padding\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n\n  <input type=\"range\" inline title=\"Bottom Padding\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n\n  <header>Banner Content</header>\n\n  <input type=\"checkbox\" title=\"Supporting Text\" name=\"showText\" checked>\n\n  <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n\n  <header>Banner Colors</header>\n\n  <input type=\"color\" title=\"Heading Color\" name=\"headingColor\" value=\"#FFFFFF\">\n\n  <input type=\"color\" title=\"Text Color\" name=\"textColor\" value=\"#FFFFFF\">\n\n  <input type=\"color\" title=\"Button Background\" name=\"buttonColor\" value=\"#C75423\">\n\n  <input type=\"color\" title=\"Button Text\" name=\"buttonTextColor\" value=\"#FFFFFF\">\n\n  <header>Background</header>\n\n  <fieldset type=\"background\" name=\"bg\" parallax>\n\n    <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n\n    <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n\n  </fieldset>\n\n  <input type=\"image\" title=\"Fallback Image\" name=\"fallBackImage\" value=\"../_images/background1.jpg\" condition=\"bg.type == 'video'\">\n\n  <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\n  <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n\n  <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.15\" condition=\"overlay && bg.type !== 'color'\">\n\n</mbr-parameters>\n\n\n<!-- MOBIRISE BACKGROUND ELEMENTS -->\n\n<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\">\n</div>\n\n\n<!-- FULL-WIDTH BANNER CONTENT -->\n\n<div class=\"n3-cta-outer\">\n\n  <div class=\"n3-cta-inner\">\n\n    <!-- LEFT: TEXT -->\n\n    <div class=\"n3-cta-copy\">\n\n      <h2 class=\"n3-cta-heading mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".n3-cta-heading\">\n        <b>One Studio. Purposeful Builds.</b>\n      </h2>\n\n      <p class=\"n3-cta-description mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".n3-cta-description\">\n        Ideas into practical AI solutions.<br>\n        Plan. Build. Automate. Grow.\n      </p>\n\n    </div>\n\n\n    <!-- RIGHT: BUTTON -->\n\n    <div class=\"n3-cta-actions mbr-section-btn\" mbr-if=\"showButtons\">\n\n      <a class=\"n3-cta-button btn display-4\" href=\"#\">\n        <span>START YOUR PROJECT</span>\n        <span class=\"n3-cta-arrow\" aria-hidden=\"true\">→</span>\n      </a>\n\n    </div>\n\n  </div>\n\n</div>\n\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_anchor": "list01-1h",
          "_cid": "vyrQ7FI95L",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#e4e3dc",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#bcb9b4",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"95\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/neutral3rd20emerging20technologies20logo-720x240.webp\" alt=\"Neutral3rd\">\n                            </div>\n\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">\n                            Emerging Technologies Development Studio\n                        </p>\n                    </div>\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                        <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3>\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\">\n                                Combining human insight and creativity with AI to build smarter workflows, intelligent systems, and AI-powered media. From strategy and enablement to implementation, assurance, image, audio and video production, Neutral3rd helps businesses and professionals turn AI possibilities into practical results. Working smarter, serving better, and growing with confidence.\n                            </p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>PRIVACY</b></li>\n                                <li class=\"item-wrap\"><b>TERMS OF SERVICE</b></li>\n                                <li class=\"item-wrap\"><b>ACCESSIBILITY</b></li>\n                                <li class=\"item-wrap\"><b>SUPPORT</b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">\n                                    <b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-primary\">EMAIL RENEE</a></b>\n                                </li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>LINKEDIN</b></li>\n                                <li class=\"item-wrap\"><b>INSTAGRAM</b></li>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Technologies Development Studio. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "vyuTH9KVkF",
          "_anchor": "footer01-1m",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    }
  }
}