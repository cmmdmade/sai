          "_name": "menu01",
          "_sourceTheme": "glancem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 glancem5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#c75423\" condition=\"showItems\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffffff\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#101012\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://neutral3rd.space\">\n                        <img src=\"@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.png\" alt=\"Neutral3rd Emerging Tech Development Studio\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-info\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">GlanceM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">OfferBeacon Suite</a></li><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://neutral3rd.space/custom-task-prompt\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">From My Wildest Dreams</a></li>\n                    \n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#dev-about\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"index.html\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-bluesky socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-secondary\" href=\"https://studioguide.neutral3rd.space/chat?token=cf7573456c87d54489c7ba5f0a2e93bf&name=Samir%20%7C%20Neutral3rd%20Emerging%20Tech%20Development%20Studio&accent=%23c75423&greet=Hey!%20Welcome%20to%20Neutral3rd.%20I%27m%20Samir%2C%20Neutral3rd%27s%20AI%20studio%20guide.%20I%20can%20help%20you%20explore%20the%20OfferBeacon%20Suite%2C%20learn%20about%20this%20development%20studio%20in%20general%2C%20or%20find%20the%20right%20next%20step.%20What%20brings%20you%20here%20today%3F&face=https%3A%2F%2Fcuevueapp.com%2Fassets%2Ffaces%2Fstandard%2F62227bb3-2f6e-4220-b3c9-2c02b2fdb349.jpg&page=https%3A%2F%2Fstudioguide.neutral3rd.space%2Fneutral3rd-emerging-technologies%2Fsamir-from-neutral3rd-emerging&mode=desktop&lang=en\" data-app-placeholder=\"Type Text\" target=\"_blank\">Start a Conversation</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vA8TDtYH0a",
          "_anchor": "menu01-4l",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<section id=\"n3-fgc\" class=\"mbr-section\" aria-label=\"Neutral3rd one-off digital services\">\n <div class=\"container\">\n\n  <header class=\"n3-hero\">\n   <div class=\"n3-eyebrow mbr-section-subtitle mbr-fonts-style\">Neutral3rd / One-off digital services</div>\n   <h1 class=\"mbr-section-title mbr-fonts-style display-2\">FAST. GOOD.<br><span class=\"n3-accent\">CHEAP.</span></h1>\n   <h2 class=\"mbr-section-subtitle mbr-fonts-style display-5\">Pick two. Get it done.</h2>\n   <p class=\"n3-intro mbr-fonts-style\">Clear deliverables. Transparent options. Human-reviewed curriculum, presentations, scripts and business documents, developed with ChatGPT or Claude. No subscription required.</p>\n   <div class=\"n3-pills\"><span class=\"n3-pill\">One-time projects</span><span class=\"n3-pill\">Choose your tradeoff</span><span class=\"n3-pill\">Human-led, AI-powered</span></div>\n   <div class=\"mbr-section-btn\"><a class=\"n3-btn btn display-4\" href=\"#n3-fgc-catalog\">Explore services</a></div>\n  </header>\n\n  <div class=\"n3-section\" id=\"n3-fgc-how\">\n   <div class=\"n3-eyebrow mbr-section-subtitle mbr-fonts-style\">How it works</div>\n   <h2 class=\"mbr-section-subtitle mbr-fonts-style display-5\">Pick two. Understand the tradeoff.</h2>\n   <p class=\"n3-muted mbr-fonts-style\">The classic rule is simple: you can prioritize two, but the third gives way. Every delivered item must still be accurate, usable and reviewed. “Not good” means less polish and depth, never careless or defective work.</p>\n   <div class=\"n3-principles row\">\n    <div class=\"col-12 col-lg-4\"><div class=\"n3-principle\"><strong>FAST + GOOD</strong><span class=\"n3-tradeoff\">NOT CHEAP</span><p class=\"mbr-fonts-style\"><strong>Benefit:</strong> priority scheduling, full scope and deeper refinement.<br><strong>Tradeoff:</strong> premium price for reserved production capacity.</p></div></div>\n    <div class=\"col-12 col-lg-4\"><div class=\"n3-principle\"><strong>GOOD + CHEAP</strong><span class=\"n3-tradeoff\">NOT FAST</span><p class=\"mbr-fonts-style\"><strong>Benefit:</strong> full scope and thoughtful refinement at a lower starting price.<br><strong>Tradeoff:</strong> flexible scheduling; 3–14 business days estimated.</p></div></div>\n    <div class=\"col-12 col-lg-4\"><div class=\"n3-principle\"><strong>CHEAP + FAST</strong><span class=\"n3-tradeoff\">NOT FULL-SERVICE GOOD</span><p class=\"mbr-fonts-style\"><strong>Benefit:</strong> a quick, affordable starting point.<br><strong>Tradeoff:</strong> limited depth, templated structure, minimal customization and no extensive revision cycle. Still fact-checked and usable.</p></div></div>\n   </div>\n  </div>\n\n  <div class=\"n3-section\" id=\"n3-fgc-catalog\">\n   <div class=\"n3-eyebrow mbr-section-subtitle mbr-fonts-style\">Browse the studio</div>\n   <h2 class=\"mbr-section-subtitle mbr-fonts-style display-5\">Choose the job you need finished.</h2>\n   <p class=\"n3-muted mbr-fonts-style\">Select a service and compare its three options. Text-first packages use ChatGPT or Claude with human review; no AI video or image generation is included. Every price is a starting estimate, not a fixed quote. Client readiness, supplied materials, complexity and the agreed start date affect the final price and completion date.</p>\n\n   <div class=\"n3-toolbar\">\n    <input id=\"n3-fgc-search\" type=\"search\" placeholder=\"Search services or deliverables\" aria-label=\"Search services\">\n    <select id=\"n3-fgc-category\" aria-label=\"Filter by category\"><option value=\"all\">All categories</option></select>\n    <span class=\"n3-count\" id=\"n3-fgc-count\" aria-live=\"polite\">12 services</span>\n   </div>\n\n   <div class=\"n3-grid row\" id=\"n3-fgc-grid\">\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"course\" data-fgc-service=\"course-curriculum-blueprint\" data-full=\"Up to 8 modules, lesson objectives, exercises, resource list and one revision\" data-lite=\"4-module roadmap, core objectives and suggested lesson titles\" data-category=\"Courses &amp; Coaching\" data-search=\"course curriculum blueprint turn your expertise into a teachable, sequenced program with clear learning outcomes. 4–8 module curriculum map, lesson outcomes and assessment plan\">\n<div class=\"n3-tag mbr-fonts-style\">Courses &amp; Coaching</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">Course Curriculum Blueprint</h3>\n<p class=\"mbr-fonts-style\">Turn your expertise into a teachable, sequenced program with clear learning outcomes.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>4–8 module curriculum map, lesson outcomes and assessment plan</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $539</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $349</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $199</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: Up to 8 modules, lesson objectives, exercises, resource list and one revision</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"slides\" data-fgc-service=\"lesson-slide-content-kit\" data-full=\"Up to 25 slides of copy, speaker notes, examples and two quiz questions; no rendered slide design\" data-lite=\"12-slide outline with key talking points; no visual design\" data-category=\"Courses &amp; Coaching\" data-search=\"lesson slide content kit give one training lesson a structured, engaging teaching narrative. 12–25 slide content outline with speaker notes and knowledge checks\">\n<div class=\"n3-tag mbr-fonts-style\">Courses &amp; Coaching</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">Lesson Slide Content Kit</h3>\n<p class=\"mbr-fonts-style\">Give one training lesson a structured, engaging teaching narrative.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>12–25 slide content outline with speaker notes and knowledge checks</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $349</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $229</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $129</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: Up to 25 slides of copy, speaker notes, examples and two quiz questions; no rendered slide design</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"webinar\" data-fgc-service=\"webinar-presentation-script\" data-full=\"Up to 40 slide-by-slide scripts, transitions, Q&amp;A prompts and one revision\" data-lite=\"15-slide presentation outline with key messages\" data-category=\"Webinars &amp; Live Events\" data-search=\"webinar presentation script build a persuasive webinar narrative without purchasing a full production package. 30–40 slide narrative, speaker notes and q&amp;a prompts\">\n<div class=\"n3-tag mbr-fonts-style\">Webinars &amp; Live Events</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">Webinar Presentation Script</h3>\n<p class=\"mbr-fonts-style\">Build a persuasive webinar narrative without purchasing a full production package.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>30–40 slide narrative, speaker notes and Q&amp;A prompts</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $619</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $399</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $229</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: Up to 40 slide-by-slide scripts, transitions, Q&amp;A prompts and one revision</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"youtube\" data-fgc-service=\"youtube-script-discovery-kit\" data-full=\"One 8–12 minute script, 3 titles, description, chapters and one revision; no thumbnail or video\" data-lite=\"One 4-minute script outline, 2 titles and short description\" data-category=\"YouTube\" data-search=\"youtube script &amp; discovery kit plan a stronger video with an audience-focused hook and searchable metadata. one ready-to-film script, titles, description and chapters\">\n<div class=\"n3-tag mbr-fonts-style\">YouTube</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">YouTube Script &amp; Discovery Kit</h3>\n<p class=\"mbr-fonts-style\">Plan a stronger video with an audience-focused hook and searchable metadata.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>One ready-to-film script, titles, description and chapters</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $289</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $189</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $109</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: One 8–12 minute script, 3 titles, description, chapters and one revision; no thumbnail or video</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"vsl\" data-fgc-service=\"video-sales-letter-script\" data-full=\"One 5–8 minute script, visual cues, objection handling, CTA and one revision\" data-lite=\"One 3-minute script with a single CTA and basic scene notes\" data-category=\"VSL &amp; Sales Videos\" data-search=\"video sales letter script get the words and visual cues for a sales video without video-production costs. two-column spoken script and on-screen direction\">\n<div class=\"n3-tag mbr-fonts-style\">VSL &amp; Sales Videos</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">Video Sales Letter Script</h3>\n<p class=\"mbr-fonts-style\">Get the words and visual cues for a sales video without video-production costs.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>Two-column spoken script and on-screen direction</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $509</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $329</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $189</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: One 5–8 minute script, visual cues, objection handling, CTA and one revision</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"linkedin\" data-fgc-service=\"linkedin-profile-positioning\" data-full=\"3 headlines, About rewrite, 2 experience summaries, keyword map and one revision; no banner graphics\" data-lite=\"Headline and About rewrite with one positioning angle\" data-category=\"Personal Brand &amp; Portfolio\" data-search=\"linkedin profile positioning clarify your professional positioning for clients, employers or collaborators. headline, about section, experience framing and keyword suggestions\">\n<div class=\"n3-tag mbr-fonts-style\">Personal Brand &amp; Portfolio</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">LinkedIn Profile Positioning</h3>\n<p class=\"mbr-fonts-style\">Clarify your professional positioning for clients, employers or collaborators.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>Headline, About section, experience framing and keyword suggestions</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $339</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $219</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $119</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: 3 headlines, About rewrite, 2 experience summaries, keyword map and one revision; no banner graphics</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"bio\" data-fgc-service=\"professional-biography-suite\" data-full=\"4 bio lengths, first/third-person variants, 400-word About narrative and revision\" data-lite=\"50- and 150-word bios with a short introduction\" data-category=\"Personal Brand &amp; Portfolio\" data-search=\"professional biography suite a consistent professional introduction for speaking, websites and profiles. short, medium and long biographies plus about narrative\">\n<div class=\"n3-tag mbr-fonts-style\">Personal Brand &amp; Portfolio</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">Professional Biography Suite</h3>\n<p class=\"mbr-fonts-style\">A consistent professional introduction for speaking, websites and profiles.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>Short, medium and long biographies plus About narrative</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $229</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $149</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $79</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: 4 bio lengths, first/third-person variants, 400-word About narrative and revision</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"products\" data-fgc-service=\"ecommerce-product-copy-batch\" data-full=\"Up to 20 products, supplied-fact checks, SEO fields and CSV-ready copy; no images\" data-lite=\"Up to 8 products with titles, concise descriptions and benefits\" data-category=\"Product Photography &amp; Ads\" data-search=\"ecommerce product copy batch make product information clearer, more persuasive and easier to upload. seo product titles, descriptions, benefits and structured fields\">\n<div class=\"n3-tag mbr-fonts-style\">Product Photography &amp; Ads</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">Ecommerce Product Copy Batch</h3>\n<p class=\"mbr-fonts-style\">Make product information clearer, more persuasive and easier to upload.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>SEO product titles, descriptions, benefits and structured fields</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $459</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $299</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $169</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: Up to 20 products, supplied-fact checks, SEO fields and CSV-ready copy; no images</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"quiz\" data-fgc-service=\"training-quiz-assessment-kit\" data-full=\"20 questions, answer rationale, scoring rubric, learning-objective map and one revision; no hosted quiz\" data-lite=\"10 questions, answer key and basic scoring guide\" data-category=\"Courses &amp; Coaching\" data-search=\"training quiz &amp; assessment kit check learner understanding with measurable questions and useful feedback. 20-question assessment with answer key, scoring and explanations\">\n<div class=\"n3-tag mbr-fonts-style\">Courses &amp; Coaching</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">Training Quiz &amp; Assessment Kit</h3>\n<p class=\"mbr-fonts-style\">Check learner understanding with measurable questions and useful feedback.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>20-question assessment with answer key, scoring and explanations</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $349</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $229</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $129</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: 20 questions, answer rationale, scoring rubric, learning-objective map and one revision; no hosted quiz</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"pitch\" data-fgc-service=\"pitch-deck-story-slide-copy\" data-full=\"12 slides of copy, storyline, speaker notes and one revision; no visual deck production\" data-lite=\"6-slide pitch outline with core talking points\" data-category=\"Client Work &amp; Proposals\" data-search=\"pitch deck story &amp; slide copy turn a business idea into a coherent presentation narrative without invented financials. 12-slide pitch structure, written slide copy and speaker notes\">\n<div class=\"n3-tag mbr-fonts-style\">Client Work &amp; Proposals</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">Pitch Deck Story &amp; Slide Copy</h3>\n<p class=\"mbr-fonts-style\">Turn a business idea into a coherent presentation narrative without invented financials.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>12-slide pitch structure, written slide copy and speaker notes</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $459</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $299</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $169</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: 12 slides of copy, storyline, speaker notes and one revision; no visual deck production</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"ebook\" data-fgc-service=\"blog-to-ebook-manuscript\" data-full=\"Up to 8 supplied posts, edited 20–35 page-equivalent manuscript, intro and revision; no designed PDF\" data-lite=\"Up to 3 supplied posts, short ebook outline and edited manuscript\" data-category=\"Digital Products &amp; PLR\" data-search=\"blog-to-ebook manuscript repurpose your existing articles into a cohesive downloadable publication. edited ebook manuscript, chapter structure and contents\">\n<div class=\"n3-tag mbr-fonts-style\">Digital Products &amp; PLR</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">Blog-to-Ebook Manuscript</h3>\n<p class=\"mbr-fonts-style\">Repurpose your existing articles into a cohesive downloadable publication.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>Edited ebook manuscript, chapter structure and contents</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $619</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $399</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $229</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: Up to 8 supplied posts, edited 20–35 page-equivalent manuscript, intro and revision; no designed PDF</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n<div class=\"n3-card-col col-12 col-lg-4\">\n<article class=\"n3-card\" data-service=\"onboard\" data-fgc-service=\"customer-onboarding-email-kit\" data-full=\"4 emails, subject lines, preview text, timing, segmentation notes and one revision\" data-lite=\"2 onboarding emails and a simple timing plan\" data-category=\"Email Marketing\" data-search=\"customer onboarding email kit help new customers reach their first successful result with clear guidance. four onboarding emails and customer journey timing map\">\n<div class=\"n3-tag mbr-fonts-style\">Email Marketing</div>\n<h3 class=\"mbr-section-title mbr-fonts-style display-5\">Customer Onboarding Email Kit</h3>\n<p class=\"mbr-fonts-style\">Help new customers reach their first successful result with clear guidance.</p>\n<div class=\"n3-deliverable\"><strong>Deliverable: </strong>Four onboarding emails and customer journey timing map</div>\n<div class=\"n3-choices\" role=\"group\" aria-label=\"Choose your tradeoff\">\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fg\" aria-pressed=\"false\"><span>FAST + GOOD</span><strong>From $289</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"gc\" aria-pressed=\"true\"><span>GOOD + CHEAP</span><strong>From $189</strong></button>\n<button type=\"button\" class=\"n3-choice\" data-tier=\"fc\" aria-pressed=\"false\"><span>CHEAP + FAST</span><strong>From $109</strong></button>\n</div>\n<div class=\"n3-detail\"><b class=\"n3-days\">3–14 business days (estimated)</b><div class=\"n3-tradeoff-line\">NOT FAST · Full scope, thoughtful refinement and flexible scheduling.</div><div class=\"n3-included\">Included: 4 emails, subject lines, preview text, timing, segmentation notes and one revision</div></div>\n<button class=\"n3-btn n3-request btn display-4\" type=\"button\">Request this service</button>\n</article>\n</div>\n\n   </div>\n\n   <p class=\"n3-footnote mbr-fonts-style\">Scope and turnaround begin after receipt of all required materials and project acceptance. All displayed “From” prices are starting prices, not fixed quotes. Timing begins only after complete inputs, scope approval and an agreed start date. Images, video production, third-party licenses, hosting, advertising spend, implementation and additional revisions are excluded unless stated. AI-assisted content is reviewed before delivery.</p>\n  </div>\n\n  <div class=\"n3-section\" id=\"n3-fgc-request\">\n   <div class=\"n3-eyebrow mbr-section-subtitle mbr-fonts-style\">Project intake</div>\n   <h2 class=\"mbr-section-subtitle mbr-fonts-style display-5\">Tell us what you need.</h2>\n   <p class=\"n3-muted mbr-fonts-style\">Choose a service above, or pick one here. Not sure which one? <a href=\"?service=general#n3-fgc-request\">Send a general inquiry</a>. We read your details, email a payment link, and then ask only the questions your notes did not already answer. Nothing is charged on this page.</p>\n\n   <div class=\"n3-intake\">\n    <form id=\"n3-fgc-form\" method=\"post\" action=\"https://script.google.com/macros/s/AKfycbycuy5_qpPcLEDh8BOmrgg9xaVx8o2U5p8np8UINAPNNxOXKABsqDvs8jcGYKZKTYprMQ/exec\" accept-charset=\"UTF-8\">\n     <input type=\"hidden\" name=\"form\" value=\"fgc\">\n     <input type=\"hidden\" name=\"page\" id=\"n3-fgc-page\" value=\"\">\n     <input type=\"hidden\" name=\"utm\" id=\"n3-fgc-utm\" value=\"\">\n     <div class=\"n3-hp\" aria-hidden=\"true\">\n      <label for=\"n3-fgc-hp\">Leave this empty</label>\n      <input type=\"text\" id=\"n3-fgc-hp\" name=\"hp\" tabindex=\"-1\" autocomplete=\"off\">\n     </div>\n\n     <div class=\"n3-form-grid row\">\n      <!-- The service options are built from the cards by the script.\n           Add the card, not an option here. -->\n      <div class=\"n3-form-field n3-form-wide col-12\">\n       <label for=\"n3-fgc-service\">Service</label>\n       <select id=\"n3-fgc-service\" name=\"service_id\" aria-describedby=\"n3-fgc-service-hint\" required=\"\">\n        <option value=\"\">Choose a service</option>\n       </select>\n       <span class=\"n3-hint\" id=\"n3-fgc-service-hint\">Not sure? Choose the closest one and explain the rest in the details.</span>\n      </div>\n\n      <fieldset class=\"n3-tier-group n3-form-wide col-12\" id=\"n3-fgc-tier-box\">\n       <legend>Tradeoff</legend>\n       <p class=\"n3-hint mbr-fonts-style\">Pick the two that matter most for this job. The third gives way.</p>\n       <div class=\"n3-tiers row\" id=\"n3-fgc-tiers\"></div>\n      </fieldset>\n\n      <div class=\"n3-form-field col-12 col-lg-4\">\n       <label for=\"n3-fgc-name\">Your name</label>\n       <input class=\"form-control\" type=\"text\" id=\"n3-fgc-name\" name=\"name\" autocomplete=\"name\" required=\"\" maxlength=\"120\">\n      </div>\n\n      <div class=\"n3-form-field col-12 col-lg-4\">\n       <label for=\"n3-fgc-email\">Email</label>\n       <input class=\"form-control\" type=\"email\" id=\"n3-fgc-email\" name=\"email\" autocomplete=\"email\" aria-describedby=\"n3-fgc-email-hint\" required=\"\" maxlength=\"200\">\n       <span class=\"n3-hint\" id=\"n3-fgc-email-hint\">The payment link and the questions go here.</span>\n      </div>\n\n      <div class=\"n3-form-field col-12 col-lg-4\">\n       <label for=\"n3-fgc-business\">Business or project name</label>\n       <input class=\"form-control\" type=\"text\" id=\"n3-fgc-business\" name=\"business\" autocomplete=\"organization\" maxlength=\"160\">\n      </div>\n\n      <div class=\"n3-form-field n3-form-wide col-12\">\n       <label for=\"n3-fgc-website\">Website or social link (optional)</label>\n       <input class=\"form-control\" type=\"url\" id=\"n3-fgc-website\" name=\"website\" autocomplete=\"url\" maxlength=\"300\" placeholder=\"https://\">\n      </div>\n\n      <div class=\"n3-form-field n3-form-wide n3-form-details col-12\">\n       <label for=\"n3-fgc-details\">Project details and desired outcome</label>\n       <textarea class=\"form-control\" id=\"n3-fgc-details\" name=\"details\" rows=\"7\" required=\"\" minlength=\"20\" maxlength=\"8000\" aria-describedby=\"n3-fgc-details-hint\" placeholder=\"The more of the brief you put here, the fewer questions we have to ask later.\"></textarea>\n       <span class=\"n3-hint\" id=\"n3-fgc-details-hint\">What is the job, who is it for, and what should exist when it is done?</span>\n      </div>\n     </div>\n\n     <div class=\"n3-form-consent\">\n      <input type=\"checkbox\" id=\"n3-fgc-consent\" name=\"consent\" value=\"yes\" required=\"\">\n      <label for=\"n3-fgc-consent\">I agree that Neutral3rd may store these details and email me about this request. I understand the price shown is a starting price for the tradeoff I chose, confirmed after my materials are reviewed, and that no work starts until I approve the final scope.</label>\n     </div>\n\n     <button type=\"submit\" class=\"n3-btn btn display-4\" id=\"n3-fgc-send\">Send project request</button>\n     <p class=\"n3-status\" id=\"n3-fgc-status\" role=\"status\" aria-live=\"polite\"></p>\n     <p class=\"n3-legal mbr-fonts-style\">Your details are sent to Neutral3rd and stored in a private Drive folder and pipeline sheet, used only to quote and deliver this job. See the <a href=\"https://neutral3rd.space/privacy\">privacy policy</a>. Nothing is charged on this page. If you chose a service, the next email carries a secure Stripe link for the amount shown.</p>\n     <noscript><p class=\"n3-legal mbr-fonts-style\">This form needs JavaScript. You can email <a href=\"mailto:renee.leach@neutral3rd.space\">renee.leach@neutral3rd.space</a> with the service, the tradeoff and your project details instead.</p></noscript>\n    </form>\n   </div>\n  </div>\n\n </div>\n\n\n</section>\n\n<!-- END OF BLOCK -->",
          "_customCSS": "",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "fabm5",
          "_anchor": "custom-html-5e",
          "_PHPplaceholders": [],
          "_JSplaceholders": []
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <a href=\"https://neutral3rd.space\"><img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-1-512x512.png\" alt=\"Neutral3rd Emerging Tech Development Studio\"></a>\n                            </div>\n\n                           <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <!-- <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">xx</p>\n                    </div> -->\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                       <!-- <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3> -->\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\"><b>Neutral3rd</b> helps small businesses and independent professionals put AI to work within real human work. Led by Renée Leach and supported by an army of customized AI assistants, co-pilots, and agents, this studio brings strategy, development, workflows, and AI-powered media together with a \"human STILL in-the-loop\" to make work more capable without making it more complicated.<br></p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/privacy\" class=\"text-info\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/terms\" class=\"text-info\">TERMS OF SERVICE</a></b></li><a href=\"https://neutral3rd.space/terms\" class=\"text-primary\">\n                                </a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/accessibility\" class=\"text-info\">ACCESSIBILITY</a></b></li><li class=\"item-wrap\"><b><a href=\"https://connections.neutral3rd.space/wall\" class=\"text-info\" target=\"_blank\">LEAVE YOUR FEEDBACK</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://offerbeacon.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">HELP THE RIGHT BUYERS FIND YOU</a></b></li>\n<li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/custom-task-prompt\" class=\"text-info text-primary\">FROM MY WILDEST DREAMS</a></b></li><li class=\"item-wrap\"><b><a href=\"https://perspectives.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">NEUTRAL3RD PERSPECTIVES</a></b></li><a href=\"https://neutral3rd.space\" class=\"text-primary\">\n</a><li class=\"item-wrap\"><b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-info\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Tech Development Studio. Operated by U.S.-based business entity, Rowdy Independents LLC. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vA8TDuKXjP",
          "_anchor": "footer01-4n",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "page7.html": {
      "settings": {
        "title": "Page 7",
        "order": "7"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "110px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding-left": "108px",
                "padding-right": "108px",
                "@media (max-width: 1440px)": {
                  "padding-left": "64px",
                  "padding-right": "64px"
                },
                "@media (max-width: 992px)": {
                  "padding-left": "16px",
                  "padding-right": "16px"
                }
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border": "2px solid @borderColor",
              "background": "@menuBgColor !important",
              "color": "@primaryColor !important",
              "&:hover, &:focus": {
                "background": "@menuBgColor !important",
                "color": "@primaryColor !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "0 auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              },
              "max-width": "1600px"
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "transition": "all 0.3s ease-in-out",
              "&:hover": {
                "color": "@activeColor !important"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "1.6rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "110px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 3.2rem 0.5rem 1.8rem",
                "border-radius": "0"
              },
              ".navbar-logo img": {
                "width": "auto",
                "border-radius": "6px !important"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(98.5vh - @{logoSize}rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "41%"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem",
                  "text-align": "center"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-right": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "40%"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem !important",
                  "text-align": "center"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word",
                  "padding-right": "0.5rem",
                  "max-width": "80%"
                },
                ".navbar-toggler": {
                  "flex-basis": "auto"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "96px",
                ".navbar-brand": {
                  "min-height": "96px"
                }
              },
              "padding": "0 !important",
              "border-radius": "0 !important",
              "border": "none !important",
              "box-shadow": "none !important"
            },
            ".navbar-brand": {
              "min-height": "96px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word !important",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important",
                "font-weight": "400",
                "&:hover, &:focus": {
                  "color": "@activeColor !important"
                }
              },
              ".navbar-logo a": {
                "outline": "none"
              },
              "word-wrap": "break-word !important",
              "white-space": "normal"
            },
            ".navbar.opened": {
              ".navbar-brand": {
                ".navbar-caption": {
                  "&:hover, &:focus": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                "top": "3rem",
                "border-radius": "0",
                "@media (max-width: 992px)": {
                  "top": "0"
                },
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%",
                  "top": "0",
                  "border-left": "1px solid transparent"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap",
              "@media (min-width: 991px)": {
                "padding": "0",
                "background-color": "transparent",
                "border": "2px solid @borderColor",
                "& when (@collapsed)": {
                  "border-radius": "0 !important"
                }
              }
            },
            ".navbar-buttons": {
              "text-align": "center",
              ".btn": {
                "white-space": "nowrap",
                "margin-right": "0",
                "padding": "22px 32px",
                "min-height": "auto",
                ".mbr-iconfont": {
                  "width": "32px",
                  "height": "32px",
                  "min-width": "32px",
                  "font-size": "16px",
                  "margin-left": "32px",
                  "margin-right": "-20px"
                },
                "@media (max-width: 575px)": {
                  "width": "auto !important"
                }
              }
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "50px",
              "height": "50px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "border-radius": "100%",
              "background-color": "@menuBgColor !important",
              "border": "none !important",
              "box-shadow": "none !important",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "20px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "18px",
                  "left": "15px",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "left": "15px",
                  "top": "30px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            ".navbar-nav": {
              "margin": "0 auto",
              "& when not (@showButtons)": {
                "justify-content": "flex-end",
                "margin": "0"
              }
            },
            ".nav-item": {
              "padding": "0",
              "margin": "0",
              ".nav-link": {
                "padding": "24px 32px !important",
                "margin": "0 !important",
                "transition": "all 0.3s ease-in-out",
                "font-weight": "400",
                "&::after": {
                  "color": "@activeColor !important",
                  "transform": "rotate(0)",
                  "transition": ".3s"
                },
                "&:hover": {
                  "background-color": "transparent",
                  "color": "@activeColor !important"
                }
              },
              ".nav-link.show": {
                "&::after": {
                  "transform": "rotate(180deg)"
                }
              },
              ".dropdown-menu": {
                "background-color": "transparent !important",
                "&:hover": {
                  "background-color": "transparent !important"
                },
                ".dropdown-item": {
                  "color": "@primaryColor !important",
                  "&:hover": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            "& when (@collapsed)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 5rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "40px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid hsla(0, 0%, 100%, 0.2)"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center"
                  }
                }
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "flex-direction": "column !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 3rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "24px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid hsla(0, 0%, 100%, 0.2)"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center"
                  }
                }
              }
            },
            ".content-wrap": {
              "min-height": "130px"
            }
          },
          "_name": "menu01",
          "_sourceTheme": "glancem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 glancem5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#c75423\" condition=\"showItems\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffffff\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#101012\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://neutral3rd.space\">\n                        <img src=\"@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.png\" alt=\"Neutral3rd Emerging Tech Development Studio\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-info\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">GlanceM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">OfferBeacon Suite</a></li><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://neutral3rd.space/custom-task-prompt\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">From My Wildest Dreams</a></li>\n                    \n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#dev-about\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"index.html\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-bluesky socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-secondary\" href=\"https://studioguide.neutral3rd.space/chat?token=cf7573456c87d54489c7ba5f0a2e93bf&name=Samir%20%7C%20Neutral3rd%20Emerging%20Tech%20Development%20Studio&accent=%23c75423&greet=Hey!%20Welcome%20to%20Neutral3rd.%20I%27m%20Samir%2C%20Neutral3rd%27s%20AI%20studio%20guide.%20I%20can%20help%20you%20explore%20the%20OfferBeacon%20Suite%2C%20learn%20about%20this%20development%20studio%20in%20general%2C%20or%20find%20the%20right%20next%20step.%20What%20brings%20you%20here%20today%3F&face=https%3A%2F%2Fcuevueapp.com%2Fassets%2Ffaces%2Fstandard%2F62227bb3-2f6e-4220-b3c9-2c02b2fdb349.jpg&page=https%3A%2F%2Fstudioguide.neutral3rd.space%2Fneutral3rd-emerging-technologies%2Fsamir-from-neutral3rd-emerging&mode=desktop&lang=en\" data-app-placeholder=\"Type Text\" target=\"_blank\">Start a Conversation</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vyMJUqlvSn",
          "_anchor": "menu01-5k",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n    <h1 class=\"display-1\">Custom HTML Block</h1>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"#777\" width=\"200\" height=\"200\"><path d=\"M6.1 8.7L2.8 12l3.3 3.3-1.4 1.4L0 12l4.7-4.7 1.4 1.4zm13.2-1.4l-1.4 1.4 3.3 3.3-3.3 3.3 1.4 1.4L24 12l-4.7-4.7zM8.1 18.6l1.8.8 6-14-1.8-.8-6 14z\"></path></svg>\n    <p class=\"display-3\">Click to Open Code Editor</p>\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "fabm5",
          "_anchor": "custom-html-5m"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <a href=\"https://neutral3rd.space\"><img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-1-512x512.png\" alt=\"Neutral3rd Emerging Tech Development Studio\"></a>\n                            </div>\n\n                           <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <!-- <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">xx</p>\n                    </div> -->\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                       <!-- <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3> -->\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\"><b>Neutral3rd</b> helps small businesses and independent professionals put AI to work within real human work. Led by Renée Leach and supported by an army of customized AI assistants, co-pilots, and agents, this studio brings strategy, development, workflows, and AI-powered media together with a \"human STILL in-the-loop\" to make work more capable without making it more complicated.<br></p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/privacy\" class=\"text-info\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/terms\" class=\"text-info\">TERMS OF SERVICE</a></b></li><a href=\"https://neutral3rd.space/terms\" class=\"text-primary\">\n                                </a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/accessibility\" class=\"text-info\">ACCESSIBILITY</a></b></li><li class=\"item-wrap\"><b><a href=\"https://connections.neutral3rd.space/wall\" class=\"text-info\" target=\"_blank\">LEAVE YOUR FEEDBACK</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://offerbeacon.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">HELP THE RIGHT BUYERS FIND YOU</a></b></li>\n<li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/custom-task-prompt\" class=\"text-info text-primary\">FROM MY WILDEST DREAMS</a></b></li><li class=\"item-wrap\"><b><a href=\"https://perspectives.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">NEUTRAL3RD PERSPECTIVES</a></b></li><a href=\"https://neutral3rd.space\" class=\"text-primary\">\n</a><li class=\"item-wrap\"><b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-info\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Tech Development Studio. Operated by U.S.-based business entity, Rowdy Independents LLC. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
