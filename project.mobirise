        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".items-wrapper": {
              "margin": "0 -8px",
              ".item": {
                "padding": "0 8px"
              }
            },
            ".item": {
              "margin-bottom": "40px",
              "@media (max-width: 992px)": {
                "margin-bottom": "24px",
                "&:last-child": {
                  "margin-bottom": "0"
                }
              }
            },
            ".item-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "height": "100%",
              "position": "relative",
              "overflow": "hidden !important",
              "min-height": "800px",
              "padding": "60px 32px",
              "@media (max-width: 1440px)": {
                "min-height": "650px"
              },
              "@media (max-width: 992px)": {
                "padding": "24px",
                "min-height": "400px"
              },
              "&:hover, &:focus": {
                ".item-img img": {
                  "filter": "blur(6px)"
                },
                "&::before": {
                  "opacity": "0.5 !important"
                },
                ".card-box": {
                  "padding": "0"
                },
                ".item-content": {
                  ".item-text": {
                    "opacity": "1"
                  },
                  ".item-btn": {
                    "opacity": "1"
                  }
                }
              },
              ".item-img": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "transition": "all .5s ease",
                  "@media (max-width: 992px)": {
                    "filter": "blur(6px) !important"
                  }
                }
              },
              "&::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-color": "@overColor",
                "opacity": "@overOpacity",
                "pointer-events": "none",
                "z-index": "1",
                "transition": "all .5s ease"
              },
              ".item-content": {
                "position": "relative",
                "z-index": "1",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                ".item-text": {
                  "margin-bottom": "0",
                  "opacity": "0",
                  "transition": "all .5s ease",
                  "@media (max-width: 992px)": {
                    "opacity": "1 !important"
                  }
                },
                ".item-btn": {
                  "opacity": "0",
                  "margin-top": "14px",
                  "margin-bottom": "-9.6px",
                  "transition": "all .5s ease",
                  "@media (max-width: 992px)": {
                    "opacity": "1 !important"
                  }
                }
              },
              ".card-box": {
                "position": "relative",
                "z-index": "1",
                "padding": "0 24px",
                "transition": "all .5s ease",
                "@media (max-width: 992px)": {
                  "padding": "0 !important"
                },
                ".date-wrapper": {
                  "display": "flex",
                  "justify-content": "space-between",
                  "gap": "16px",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".item-label": {
                    "margin-bottom": "12px"
                  },
                  ".item-date": {
                    "margin-bottom": "12px"
                  }
                },
                ".border-wrap": {
                  "width": "100%",
                  "height": "1px",
                  "background-color": "@border",
                  "margin-bottom": "16px"
                },
                ".item-title": {
                  "margin-bottom": "0"
                },
                ".item-desc": {
                  "margin-bottom": "0"
                }
              }
            },
            ".item-label": {
              "color": "#f6f6f6"
            },
            ".item-date": {
              "color": "#f6f6f6"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-desc": {
              "color": "#f6f6f6"
            },
            ".item-text": {
              "color": "#ffffff"
            }
          },
          "_name": "features03",
          "_sourceTheme": "elementm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 elementm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"4\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Date\" name=\"showDate\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#e6e6e6\" name=\"border\" condition=\"showBorder\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Card Overlay\" name=\"overColor\" value=\"#000000\">\n        <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row items-wrapper justify-content-center\">\n            <div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"item-wrapper card-wrap\">\n                    <div class=\"item-img\">\n                        <a href=\"sei.html\"><img src=\"@PROJECT_PATH@/assets/images/mbr-1825x1213.jpg\" alt=\"The Index @ Select Access Index\"></a>\n                    </div>\n                    <div class=\"item-content\">\n                        <div class=\"text-wrapper\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardText\" data-app-selector=\".item-text, .text-wrapper\">\n                                Just added to the Index. See why it earned a place.\n                            </p>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                read more\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"card-box\">\n                        <div class=\"date-wrapper\">\n                            <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLabel\" data-app-selector=\".item-label\">\n                                THE INDEX\n                            </p>\n                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDate\" data-app-selector=\".item-date\">FALL 2026</p>\n                        </div>\n                        <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">Newly Added</h4>\n                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                            Recently reviewed offers that met our standards and joined the Index.</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 item features-image\">\n                <div class=\"item-wrapper card-wrap\">\n                    <div class=\"item-img\">\n                        <a href=\"sei.html#slider02-20\"><img src=\"@PROJECT_PATH@/assets/images/mbr-1825x1217.jpg\" alt=\"Worth a Closer Look @ Select Access Index\"></a>\n                    </div>\n                    <div class=\"item-content\">\n                        <div class=\"text-wrapper\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardText\" data-app-selector=\".item-text, .text-wrapper\">\n                                Easy to miss. Worth understanding. See why it stood out.\n                            </p>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                read more\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"card-box\">\n                        <div class=\"date-wrapper\">\n                            <p class=\"item-label mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLabel\" data-app-selector=\".item-label\">\n                                ON THE RADAR\n                            </p>\n                            <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDate\" data-app-selector=\".item-date\">\n                                09.04.2026</p>\n                        </div>\n                        <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">Worth A Closer Look</h4>\n                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                            A lesser-known digital tool, service or online offer that met our standards and deserves more attention.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
