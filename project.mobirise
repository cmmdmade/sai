                  "@media (max-width: 992px)": {
                    "width": "100%",
                    "padding-left": "0"
                  },
                  "img": {
                    "height": "830px",
                    "object-fit": "cover",
                    "width": "100%",
                    "@media (max-width: 992px)": {
                      "height": "400px"
                    }
                  }
                }
              }
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-desc": {
              "color": "#d7d7d7"
            }
