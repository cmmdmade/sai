          },
          "_name": "list01",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 fabm5 neutral3rd-faq\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n 'mbr-fullscreen': fullScreen,\n 'mbr-parallax-background': bg.parallax\n }\">\n\n<mbr-parameters>\n\n  <header>Size</header>\n  <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n  <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n  <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n  <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n\n  <header>Content</header>\n  <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n  <input type=\"checkbox\" title=\"Intro\" name=\"showText\" checked>\n  <input type=\"checkbox\" title=\"Studio Guide\" name=\"showStudioGuide\" checked>\n\n  <select title=\"FAQ Amount\" name=\"cardAmount\">\n   <option value=\"1\">1</option>\n   <option value=\"2\">2</option>\n   <option value=\"3\">3</option>\n   <option value=\"4\">4</option>\n   <option value=\"5\">5</option>\n   <option value=\"6\">6</option>\n   <option value=\"7\">7</option>\n   <option value=\"8\" selected>8</option>\n  </select>\n\n  <header>Colors</header>\n  <input type=\"color\" title=\"Border\" name=\"border\" value=\"#72716b\">\n  <input type=\"color\" title=\"Accent\" name=\"active\" value=\"#c75423\">\n\n  <header>Studio Guide</header>\n  <input type=\"image\" title=\"Guide Portrait\" name=\"studioGuideImage\" value=\"@PROJECT_PATH@/assets/images/image1-1.webp\">\n\n  <header>Background</header>\n  <fieldset type=\"background\" name=\"bg\" parallax>\n   <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" selected parallax>\n   <input type=\"color\" title=\"Color\" value=\"#474A48\">\n  </fieldset>\n\n  <input type=\"image\" title=\"Fallback Image\" name=\"fallBackImage\" value=\"../_images/background1.jpg\" condition=\"bg.type == 'video'\">\n\n  <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n  <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n  <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n</mbr-parameters>\n\n<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n<div mbr-class=\"{\n 'container': !fullWidth,\n 'container-fluid': fullWidth\n }\">\n\n <div class=\"n3-faq-inner\">\n\n  <header class=\"n3-faq-heading\">\n\n   <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrap\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Explore Converza</b></h2>\n\n   <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n    SDiscover how Converza works, what it can do for your business, and what to expect when getting started.\n   </p>\n\n  </header>\n\n  <div class=\"n3-faq-layout\">\n\n   <!-- LEFT COLUMN: FAQ -->\n\n   <div class=\"n3-faq-main\">\n\n    <div class=\"n3-faq-side-label\" aria-hidden=\"true\">FAQ</div>\n\n    <div class=\"n3-faq-list\">\n\n     <div class=\"panel-group accordionStyles accordion\" id=\"neutral3rd-faq-accordion\">\n\n      <!-- QUESTION 1 -->\n\n      <div class=\"card\">\n       <div class=\"card-header\" id=\"n3-faq-heading-1\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-1\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-1\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          What is Converza by Neutral3rd?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-1\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-1\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Converza is a business-specific AI-based conversational experience that helps customers and potential customers explore offerings, ask questions, compare documented options, and find relevant next steps using information approved by your business.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 2 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 1\">\n       <div class=\"card-header\" id=\"n3-faq-heading-2\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-2\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-2\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          Where can customers use Converza?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-2\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-2\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Depending on the selected package and supported integrations, Converza can be configured for your website, AI assistants such as ChatGPT and Claude, and supported messaging channels. Channel availability and requirements are confirmed before deployment.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 3 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 2\">\n       <div class=\"card-header\" id=\"n3-faq-heading-3\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-3\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-3\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          How is Converza different from a basic chatbot?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-3\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-3\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Converza is configured around your business information and customer journeys rather than only a fixed script. Supported capabilities can include product or service discovery, comparisons, verified links, and connected data. Available features depend on your configuration.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 4 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 3\">\n       <div class=\"card-header\" id=\"n3-faq-heading-4\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-4\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-4\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          Can Converza connect to my products or business systems?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-4\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-4\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Supported options may include product feeds, Google Sheets, Shopify, CSV files, or a custom API. Your business' existing systems, data quality, and connector compatibility are assessed before recommending an integration. Live inventory or automatic synchronization is not assumed.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 5 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 4\">\n       <div class=\"card-header\" id=\"n3-faq-heading-5\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-5\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-5\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          What do you need from my business to get started?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-5\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-5\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Configuration begins with your business website, product or services listings, frequently asked questions, policies, approved contact details, and the actions you want customers to take. Any catalog access, branding assets, or additional data requirements are confirmed during onboarding.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 6 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 5\">\n       <div class=\"card-header\" id=\"n3-faq-heading-6\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-6\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-6\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          How much does Converza cost?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-6\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-6\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Converza is offered as a managed setup with ongoing support. Pricing depends on the selected package, channels, information sources, integrations, and maintenance scope. The setup fee, recurring charges, and any optional work are confirmed before you commit.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 7 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 6\">\n       <div class=\"card-header\" id=\"n3-faq-heading-7\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-7\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-7\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          How do you help keep Converza's answers reliable?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-7\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-7\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">This application works from approved business information, test representative customer questions, review results, and makes documented updates. AI responses can still be incorrect, so source accuracy, periodic checks, and clear paths to human support remain important.\n         </p>\n        </div>\n       </div>\n      </div>\n\n      <!-- QUESTION 8 -->\n\n      <div class=\"card\" mbr-if=\"cardAmount > 7\">\n       <div class=\"card-header\" id=\"n3-faq-heading-8\">\n        <a class=\"panel-title collapsed\" role=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#n3-faq-collapse-8\" aria-expanded=\"false\" aria-controls=\"n3-faq-collapse-8\">\n         <h3 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-5\">\n          What happens after launch, and who manages the experience?\n         </h3>\n         <span class=\"n3-faq-icon\" aria-hidden=\"true\"></span>\n        </a>\n       </div>\n       <div id=\"n3-faq-collapse-8\" class=\"panel-collapse noScroll collapse\" role=\"region\" aria-labelledby=\"n3-faq-heading-8\" data-parent=\"#neutral3rd-faq-accordion\" data-bs-parent=\"#neutral3rd-faq-accordion\">\n        <div class=\"panel-body\">\n         <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\">\n          Neutral3rd has the capability to manage configuration updates, scheduled checks, testing, and agreed maintenance. Publishing identity, platform access, client responsibilities, and support terms are established during setup. Additional channels or features are scoped separately.\n         </p>\n        </div>\n       </div>\n      </div>\n\n     </div>\n    </div>\n\n   </div>\n\n   <!-- RIGHT COLUMN: STUDIO GUIDE -->\n\n   <aside class=\"n3-studio-guide\" mbr-if=\"showStudioGuide\" aria-label=\"Neutral3rd Studio Guide\">\n\n    <div class=\"n3-guide-top\">\n\n     <div class=\"n3-guide-avatar\">\n      <img src=\"@PROJECT_PATH@/assets/images/image1-1.webp\" alt=\"Neutral3rd Studio Guide portrait\" width=\"600\" height=\"600\">\n     </div>\n\n     <div class=\"n3-guide-content\">\n\n      <h3 class=\"n3-guide-title mbr-fonts-style\" mbr-theme-style=\"display-5\">\n       <b>NEUTRAL3RD STUDIO GUIDE</b>\n      </h3>\n\n      <p class=\"n3-guide-description mbr-fonts-style\" mbr-theme-style=\"display-7\">\n       Curious? Explore Neutral3rd's products, services, current builds, and possibilities with this AI Studio Guide.\n      </p>\n\n     </div>\n\n    </div>\n\n    <div class=\"n3-guide-actions mbr-section-btn\">\n     <a class=\"btn btn-primary display-4\" href=\"#\">\n      START A CONVERSATION\n      <span aria-hidden=\"true\">→</span>\n     </a>\n    </div>\n\n   </aside>\n\n  </div>\n\n </div>\n\n</div>\n\n</section>",
          "_cid": "tPfiWrOGHA",
          "_anchor": "faq-guide",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "info1",
          "_sourceTheme": "parkm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"info1\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"8\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#F0F0F5\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-2-1920x1080.webp\" selected parallax>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-12\">\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\">\n                    <b>NEW PARK</b></h3>\n                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                    <b>New Modern Amusement Park</b></h2>\n                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                    <a class=\"btn btn-primary\" href=\"https://mobiri.se/\">Open</a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "max-width": "800px",
              "margin": "0 auto 21px auto",
              "letter-spacing": ".13em",
              "color": "#FF4712",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "max-width": "800px",
              "margin": "0 auto 26.5px auto",
              "color": "#FAFAFA"
            },
            ".mbr-section-btn": {
              "max-width": "800px",
              "margin": "0 auto"
            },
            ".btn": {
              "height": "55px",
              "min-width": "170px",
              "box-shadow": "none",
              "margin-top": "0",
              "&:hover": {
                "box-shadow": "none"
              }
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            }
          },
          "_cid": "vyXIGhjOWm",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "info1-3e"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#fff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/neutral3rd20emerging20technologies20logo-720x240.webp\" alt=\"Neutral3rd\">\n                            </div>\n\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">\n                            Emerging Technologies Development Studio\n                        </p>\n                    </div>\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                        <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3>\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\">\n                                Combining human insight and creativity with AI to build smarter workflows, intelligent systems, and AI-powered media. From strategy and enablement to implementation, assurance, image, audio and video production, Neutral3rd helps businesses and professionals turn AI possibilities into practical results. Working smarter, serving better, and growing with confidence.\n                            </p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"privacy.html\" class=\"text-primary\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b>TERMS OF SERVICE</b></li>\n                                <li class=\"item-wrap\"><b>ACCESSIBILITY</b></li>\n                                <li class=\"item-wrap\"><b>SUPPORT</b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">\n                                    <b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-primary\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Technologies Development Studio. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "vyuTH9KVkF",
          "_anchor": "footer01-1m",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        },
        {
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "img": {
              "transition": "all 0.3s",
              "height": "100%",
              "width": "100%",
              "object-fit": "cover"
            },
            ".slide-content": {
              "width": "100%",
              "&:hover": {
                "img": {
                  "transform": "scale(1.15) rotate(-5deg)"
                }
              },
              "position": "relative",
              "height": "100%",
              "display": "flex",
              "overflow": "hidden",
              "flex-flow": "column nowrap"
            },
            ".img-link": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "transition": "all 0.3s",
              "padding": "1rem 0rem",
              "color": "#000000",
              "width": "100%",
              "span": {
                "font-size": "2rem",
                "color": "currentColor"
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item-wrapper": {
              "position": "relative"
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left"
            },
            ".item-title": {
              "text-align": "left"
            },
            ".item-subtitle": {
              "text-align": "left"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "490px",
              "max-width": "490px",
              "@media (max-width: 768px)": {
                "min-width": "70%",
                "max-width": "initial",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button--prev": {
              "span": {
                "padding-right": "7px"
              }
            },
            ".embla__button--next": {
              "span": {
                "padding-left": "3px"
              }
            },
            ".embla__button": {
              "top": "50%",
              "width": "60px",
              "height": "60px",
              "margin-top": "-1.5rem",
              "font-size": "40px",
              "color": "black",
              "border": "2px solid #fff",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&.embla__button--prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              },
              "@media (max-width: 1400px)": {
                "background-color": "rgba(255, 255, 255, 0.5)",
                "border-color": "black"
              },
              "@media (max-width: 767px)": {
                "top": "auto",
                "margin-top": "-0.5rem"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".img-link, .link-icon": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#d7d7d7",
              "text-align": "justify"
            }
          },
          "_name": "slider01",
          "_sourceTheme": "complexm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider1 mbr-embla\" group=\"Sliders &amp; Galleries\" plugins=\"embla\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked=\"\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked=\"\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked=\"\">\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\">\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background2-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay &amp;&amp; bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\"></div>\n    <div class=\"position-relative text-center\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-left mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>WORKS</b>\n            </h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-left mb-0 mt-2\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\"><b>CHECK OUT THESE BRANDING, REPUTATION AND OFFER AD DESIGN EXAMPLES - Developed for view on desktop, mobile and tablet.</b></h5>\n        </div>\n        <div class=\"embla mt-4\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n            <div class=\"embla__viewport\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n                <div class=\"embla__container\">\n                    \n                    <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/bold20cartoon20bee20logo20on20copper20background-192x160.webp\" alt=\"Honeygain\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                </div>\n                            </div>\n                            <!--<div class=\"item-content\">\n                                <div class=\"img-link\">\n                                   <h2 class=\"mbr-fonts-style m-0\" data-app-selector=\".img-link, .link-icon\" mbr-theme-style=\"display-7\">[service]</h2>\n                                    <span mbr-icon class=\"mbr-iconfont link-icon mobi-mbri-right mobi-mbri\"></span>\n                                </div>\n                            </div>-->\n\n                        </div>\n                    </div>\n                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    \n                                <a href=\"https://help.openai.com/en/articles/20001491-buying-and-redeeming-openai-gift-cards?utm_source=chatgpt.com\" target=\"true\"></a><a href=\"https://help.openai.com/en/articles/20001491-buying-and-redeeming-openai-gift-cards?utm_source=chatgpt.com\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/chatgpt20gift20card20promo-300x250.webp\" alt=\"OpenAI ChatGPT Gift Cards\" data-slide-to=\"3\" data-bs-slide-to=\"3\"></a></div>\n                            </div>\n                            <!--<div class=\"item-content\">\n                                <div class=\"img-link\">\n                                   <h2 class=\"mbr-fonts-style m-0\" data-app-selector=\".img-link, .link-icon\" mbr-theme-style=\"display-7\">[service]</h2>\n                                    <span mbr-icon class=\"mbr-iconfont link-icon mobi-mbri-right mobi-mbri\"></span>\n                                </div>\n                            </div>-->\n\n                        </div>\n                    </div>\n                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    \n                                <a href=\"index.html\" target=\"false\"><img src=\"@PROJECT_PATH@/assets/images/minimalist20n320advertisement20placeholder-300x250.webp\" alt=\"N3 Advertisement Placeholder\" data-slide-to=\"4\" data-bs-slide-to=\"4\"></a></div>\n                            </div>\n                            <!--<div class=\"item-content\">\n                                <div class=\"img-link\">\n                                   <h2 class=\"mbr-fonts-style m-0\" data-app-selector=\".img-link, .link-icon\" mbr-theme-style=\"display-7\">[service]</h2>\n                                    <span mbr-icon class=\"mbr-iconfont link-icon mobi-mbri-right mobi-mbri\"></span>\n                                </div>\n                            </div>-->\n\n                        </div>\n                    </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    \n                                <a href=\"index.html\" target=\"false\"><img src=\"@PROJECT_PATH@/assets/images/minimalist20n320advertisement20placeholder-300x250.webp\" alt=\"N3 Advertisement Placeholder\" data-slide-to=\"5\" data-bs-slide-to=\"6\"></a></div>\n                            </div>\n                            <!--<div class=\"item-content\">\n                                <div class=\"img-link\">\n                                 