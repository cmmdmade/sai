                }
              }
            },
            ".content-wrap": {
              "min-height": "130px"
            }
          },
          "_name": "menu01",
          "_sourceTheme": "glancem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 glancem5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"7.3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#c75423\" condition=\"showItems\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffffff\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#101012\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://mobiri.se\">\n                        <img src=\"@PROJECT_PATH@/assets/images/n320data20intelligence20automation20logo-660x220.webp\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-info\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">GlanceM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Home</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#current-build\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Current Build</a></li><li class=\"nav-item\"><a class=\"nav-link link text-info\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Marketplace</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#dev-about\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a>\n                    </li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#faq-guide\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">FAQ</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Start a Conversation</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vyYeEjo760",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {},
          "_anchor": "menu01-3o"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              "padding": "0 32px 32px",
              "@media (max-width: 992px)": {
                "padding": "0 24px 24px"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px"
              },
              ".mbr-desc": {
                "margin-bottom": "0"
              }
            },
            ".text-wrapper": {
              "border-top": "1px solid @border",
              "display": "flex",
              "justify-content": "space-between",
              "padding": "32px",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "24px"
              },
              ".mbr-text": {
                "width": "45%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "24px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".mbr-section-btn": {
              "text-align": "right"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "article04",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 fabm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText_1\" checked>\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText_2\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#72716b\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showTitle || showDesc\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Privacy</b></h2>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\n                        Neutral3rd — Emerging Technologies Development Studio\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_1\">Effective Date: July 24, 2026<br>Last Updated: October 1, 2026<br><br><b>1. Introduction</b><br><br>Neutral3rd (“Neutral3rd,” “we,” “our,” or “us”) is an independent emerging technologies development studio providing artificial intelligence (AI) enablement, software development, automation, digital communications, content systems, accessibility, and related professional services.<br><br>We recognize that privacy, transparency, and responsible data handling are essential to building trustworthy digital experiences.<br><br>This Privacy Policy explains how we collect, use, disclose, retain, and protect personal information when individuals visit our website, contact us, purchase products or services, participate in consultations, or interact with digital solutions that we operate.<br><br>This policy applies to https://neutral3rd.space and other Neutral3rd-operated services that expressly link to it. A separately operated product, client implementation, or third-party platform may have its own privacy notice.<br><br>By using our website, you acknowledge the practices described in this policy. Where applicable law requires consent, we will seek it separately.<br><br><b>2. Information We May Collect</b><br><br>2.1 Information You Provide Directly<br>Depending on your interaction with Neutral3rd, we may collect:<br><br>- Name, business name, and professional title.<br>-&nbsp;Email address, telephone number, and preferred contact method.<br>-&nbsp;Business website and publicly available business information.<br>-&nbsp;Information submitted through contact forms, intake questionnaires, consultations, and support requests.<br>-&nbsp;Project requirements, goals, preferences, and technical specifications.<br>-&nbsp;Billing, transaction, and purchase-related information.<br>-&nbsp;Communications, feedback, and correspondence.<br>-&nbsp;Information voluntarily provided when requesting access to or participating in a demonstration.<br><br>You should avoid submitting passwords, financial account credentials, government identification numbers, protected health information, or other sensitive personal information unless we have expressly requested it through an appropriate secure process.<br><br>2.2 Information Collected Automatically<br>When you visit our website, our hosting provider and any enabled website technologies may collect technical information, including:<br><br>- IP address and approximate geographic region.<br>-&nbsp;Browser type, device type, and operating system.<br>-&nbsp;Pages visited and referral sources.<br>-&nbsp;Date, time, and duration of website interactions.<br>-&nbsp;Error reports, diagnostic information, and performance data.<br>-&nbsp;Cookie identifiers and similar technical identifiers, where applicable.<br><br>The specific information collected depends on the technologies active on the website.<br><br>2.3 Information From Other Sources<br>We may receive business-related information from publicly accessible websites, business directories, professional networks, referrals, and authorized third-party integrations.<br><br>We use such information for legitimate business purposes, subject to applicable laws and platform restrictions.<br><br>3. How We Use Information<br><br>We may process information to:<br><br>- Respond to inquiries and provide customer support.<br>-&nbsp;Evaluate project requirements and prepare proposals.<br>-&nbsp;Provide consulting, implementation, training, and development services.<br>-&nbsp;Configure, test, maintain, and support authorized digital solutions.<br>-&nbsp;Process purchases, subscriptions, and related transactions.<br>-&nbsp;Deliver purchased digital products and service communications.<br>-&nbsp;Maintain business records and fulfill contractual obligations.<br>-&nbsp;Monitor website reliability, diagnose technical problems, and improve user experiences.<br>-&nbsp;Protect against fraud, abuse, unauthorized access, and security incidents.<br>-&nbsp;Comply with applicable legal obligations.<br>-&nbsp;Send optional promotional communications where permitted by law and consistent with your communication preferences.<br><br>We do not require you to subscribe to promotional emails as a condition of requesting ordinary support.<br><br>4. Artificial Intelligence and Automated Systems<br><br>Neutral3rd develops and implements AI-enabled solutions, including conversational business guides, workflow automations, and information-retrieval systems.<br><br>When an AI-enabled service is used, submitted content may be processed by the underlying AI model provider, hosting service, integration platform, or other authorized technology provider.<br><br>Depending on the solution, processed information may include user questions, business information, conversation content, and technical interaction data.<br><br>4.1 Client Business Information<br>Clients may authorize us to use approved business content, such as product descriptions, policies, service information, frequently asked questions, and website content, to configure an AI solution.<br><br>We intend to use this information within the scope of the agreed services and client authorization.<br><br>4.2 Personal Information in AI Conversations<br>Users should not enter sensitive or confidential personal information into an AI interface unless the interface explicitly supports that use and provides appropriate privacy safeguards.<br><br>AI-generated responses may contain inaccuracies and should be independently verified when used for consequential decisions.<br><br>4.3 AI Provider Practices<br>Third-party AI providers may have independent data-processing, retention, monitoring, and model-improvement practices. Those practices depend on the provider, product, configuration, and contractual terms.<br><br>Neutral3rd does not represent that all third-party AI interactions are private, zero-retention, or excluded from model training unless such protections have been specifically verified for the relevant service.<br><br>4.4 Client-Controlled Implementations<br>Where a client operates its own AI application, website, account, or data environment, that client may independently determine the purposes and means of processing personal information.<br><br>In such cases, the client's privacy policy and our applicable service agreement may govern the respective responsibilities.<br><br>5. Cookies and Similar Technologies<br><br>This website may use cookies, local storage, and similar technologies for essential functionality, performance, analytics, and user preferences.<br><br>These technologies may be used to maintain website functionality, measure traffic, identify technical errors, or support integrations.<br><br>Where required by applicable law, we will provide appropriate notice and choices for nonessential technologies.<br><br>You may also manage cookies through your browser settings. Disabling certain technologies may affect website functionality.<br><br>Website configuration notice: The categories of cookies actually deployed, their providers, and available consent controls should be confirmed against the live website and documented before publication.<br><br>6. Payments and Transactions<br><br>Neutral3rd may use third-party payment processors, including Stripe, to facilitate purchases, subscriptions, invoices, and refunds.<br><br>Payment processors may collect payment card information, billing addresses, transaction identifiers, and fraud-prevention information under their own terms and privacy policies.<br><br>We may receive transaction confirmations, payment status, billing details, and limited payment-method information necessary for customer service and accounting.<br><br>We do not intend to collect or store complete payment card numbers directly through ordinary website contact forms.<br><br></p>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_2\">7. When We Share Information\n<br>\n<br>We may disclose information to:\n<br>\n<br>- Hosting and infrastructure providers.\n<br>- Payment and billing processors.\n<br>- Email, scheduling, and communication providers.\n<br>- Customer management and workflow automation services.\n<br>- AI model and application providers involved in authorized services.\n<br>- Contractors or professional advisers who require access for legitimate business purposes.\n<br>- Government authorities or other parties when disclosure is required by applicable law.\n<br>- Parties involved in a lawful business reorganization, subject to applicable protections.\n<br>\n<br>We may also disclose information at your direction or with your authorization.\n<br>\n<br>We do not disclose personal information to unrelated parties merely because they request it.\n<br>\n<br>We do not describe Neutral3rd as selling personal information for advertising purposes. Any future advertising, tracking, or data-sharing arrangements must be evaluated and accurately disclosed before implementation.<br><br>8. Third-Party Websites and Integrations\n<br>\n<br>This website may link to external services, including AI platforms, payment processors, professional networks, software providers, and educational resources.\n<br>\n<br>These websites operate independently and may have different privacy practices.\n<br>\n<br>A link does not necessarily indicate endorsement, affiliation, or responsibility for a third party's data handling.\n<br>\n<br>We encourage you to review the applicable privacy policies before submitting information to external services.\n<br><br>9. Data Security\n<br>\n<br>Neutral3rd recognizes the importance of protecting personal and business information.\n<br>\n<br>We seek to apply reasonable administrative, technical, and organizational safeguards appropriate to the nature of the information, the services provided, and the risks involved.\n<br>\n<br>These may include access restrictions, account security measures, appropriate use of secure service providers, and procedures for identifying and addressing security concerns.\n<br>\n<br>No internet transmission, cloud service, or electronic storage system can be guaranteed completely secure.\n<br>\n<br>If you believe information associated with Neutral3rd has been exposed or accessed without authorization, contact privacy@neutral3rd.space.\n<br>\n<br>Where applicable law requires notification of a qualifying data breach, we will address those requirements.\n<br>\n<br>10. Data Retention\n<br>\n<br>We retain information for periods reasonably necessary to provide requested services, administer business relationships, meet contractual commitments, maintain appropriate records, resolve disputes, and comply with applicable law.\n<br>\n<br>Retention periods may vary according to the category of information, contractual requirements, service-provider settings, and legal obligations.\n<br>\n<br>When information is no longer required, we will seek to delete, de-identify, or securely dispose of it as appropriate, subject to lawful exceptions and technical limitations.\n<br>\n<br>Information held independently by third-party providers may remain subject to their retention policies.\n<br>\n<br>11. Your Privacy Choices and Rights\n<br>\n<br>Depending on your location and applicable law, you may have rights to:\n<br>\n<br>- Request information about personal data we maintain.\n<br>- Request access to or correction of certain information.\n<br>\n-&nbsp;Request deletion of eligible information.\n<br>\n-&nbsp;Withdraw consent where processing depends on consent.\n<br>\n-&nbsp;Object to or restrict certain processing activities.\n<br>\n-&nbsp;Opt out of marketing communications.\n<br>\n-&nbsp;Exercise other privacy rights established by applicable law.\n<br>\n<br>These rights are not absolute and may be subject to legal, security, contractual, and recordkeeping exceptions.\n<br>\n<br>To submit a privacy request, email privacy@neutral3rd.space with sufficient information for us to understand and evaluate your request.\n<br>\n<br>We may need to verify your identity before disclosing or modifying personal information. We will respond in accordance with applicable legal requirements.\n<br>\n<br>Marketing Preferences\n<br>\n<br>If you receive promotional email communications from us, you may use the unsubscribe mechanism provided or contact us directly.\n<br>\n<br>Administrative communications about purchases, security, or active services may still be necessary.\n<br>\n<br>12. Children's Privacy\n<br>\n<br>Neutral3rd's website and professional services are directed primarily toward adults and business users.\n<br>\n<br>We do not knowingly solicit personal information directly from children under 13 through our general website.\n<br>\n<br>If you believe a child has submitted personal information without appropriate authorization, contact privacy@neutral3rd.space so that we can review the matter.\n<br>\n<br>13. International Visitors\n<br>\n<br>Neutral3rd operates from the United States.\n<br>\n<br>Information submitted through our website or services may be processed in the United States or other locations where our authorized service providers operate.\n<br>\n<br>Privacy laws and data-protection requirements may differ across jurisdictions.\n<br>\n<br>Where additional requirements apply to a particular client, project, or geographic market, they may be addressed through supplemental notices, contractual terms, or other appropriate measures.\n<br>\n<br>14. Business Clients and Data Processing Responsibilities\n<br>\n<br>Some Neutral3rd services involve processing information on behalf of business clients.\n<br>\n<br>The applicable statement of work, service agreement, data-processing agreement, or other written instructions may establish additional obligations.\n<br>\n<br>Business clients remain responsible for providing lawful instructions, identifying authorized data sources, securing necessary permissions, and issuing appropriate privacy notices for their own customer-facing services.\n<br>\n<br>Neutral3rd's responsibilities depend on the agreed scope and actual allocation of control over the relevant information.\n<br>\n<br>15. Changes to This Privacy Policy\n<br>\n<br>We may update this Privacy Policy to reflect changes in our operations, technologies, service providers, or legal obligations.\n<br>\n<br>The revised policy will display an updated date.\n<br>\n<br>When a change materially affects how personal information is handled, we will provide additional notice or obtain consent when legally required.\n<br>\n<br>16. Contact the Privacy Officer\n<br>\n<br>For privacy inquiries, access requests, corrections, deletion requests, or concerns about personal information:\n<br>\n<br>Neutral3rd — Privacy Officer\n<br>Email: privacy@neutral3rd.space\n<br>Website: https://neutral3rd.space\n<br>\n<br>For general technical assistance and customer support:\n<br>\n<br>support@neutral3rd.space\n<br>\n<br>We welcome questions about how personal information is handled and aim to address privacy concerns transparently and responsibly.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vyYeONPpQk",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "article04-40"
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#fff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/neutral3rd20emerging20technologies20logo-720x240.webp\" alt=\"Neutral3rd\">\n                            </div>\n\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">\n                            Emerging Technologies Development Studio\n                        </p>\n                    </div>\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                        <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3>\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\">\n                                Combining human insight and creativity with AI to build smarter workflows, intelligent systems, and AI-powered media. From strategy and enablement to implementation, assurance, image, audio and video production, Neutral3rd helps businesses and professionals turn AI possibilities into practical results. Working smarter, serving better, and growing with confidence.\n                            </p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"privacy.html\" class=\"text-primary\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b>TERMS OF SERVICE</b></li>\n                                <li class=\"item-wrap\"><b>ACCESSIBILITY</b></li>\n                                <li class=\"item-wrap\"><b>SUPPORT</b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\">\n                                    <b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-primary\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Technologies Development Studio. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vyYeEnXAc4",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {},
          "_anchor": "footer01-3y"
        }
      ]
    }
  }
}