              "min-height": "130px"
            }
          },
          "_name": "menu01",
          "_sourceTheme": "glancem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 glancem5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#c75423\" condition=\"showItems\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffffff\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#101012\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://neutral3rd.space\">\n                        <img src=\"@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.png\" alt=\"Neutral3rd Emerging Tech Development Studio\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-info\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">GlanceM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">OfferBeacon Suite</a></li><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://neutral3rd.space/custom-task-prompt\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">From My Wildest Dreams</a></li>\n                    \n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#dev-about\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"index.html\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-bluesky socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-secondary\" href=\"https://studioguide.neutral3rd.space/chat?token=cf7573456c87d54489c7ba5f0a2e93bf&name=Samir%20%7C%20Neutral3rd%20Emerging%20Tech%20Development%20Studio&accent=%23c75423&greet=Hey!%20Welcome%20to%20Neutral3rd.%20I%27m%20Samir%2C%20Neutral3rd%27s%20AI%20studio%20guide.%20I%20can%20help%20you%20explore%20the%20OfferBeacon%20Suite%2C%20learn%20about%20this%20development%20studio%20in%20general%2C%20or%20find%20the%20right%20next%20step.%20What%20brings%20you%20here%20today%3F&face=https%3A%2F%2Fcuevueapp.com%2Fassets%2Ffaces%2Fstandard%2F62227bb3-2f6e-4220-b3c9-2c02b2fdb349.jpg&page=https%3A%2F%2Fstudioguide.neutral3rd.space%2Fneutral3rd-emerging-technologies%2Fsamir-from-neutral3rd-emerging&mode=desktop&lang=en\" data-app-placeholder=\"Type Text\" target=\"_blank\">Start a Conversation</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vAag2ZcXq6",
          "_anchor": "menu01-51",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<!-- Type valid HTML here -->\n<section class=\"mbr-section\" group=\"Custom\" mbr-theme-style=\"display-4\">\n  <mbr-parameters>\n    <header>Layout</header>\n    <input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#F8F6F2\">\n  </mbr-parameters>\n\n  <div class=\"container n3-wrap\">\n  <!-- HERO -->\n  <div class=\"row align-items-start n3-hero\">\n    <div class=\"col-12 col-lg-7\">\n      <p class=\"n3-mono-tag\">BUILT FOR REAL WORK // 3-VIDEO STUDIO EDITION</p>\n      <h1 class=\"n3-title\">The Visual Field Guide <span class=\"n3-orange\">(3-Video Edition)</span></h1>\n      <p class=\"n3-lead\">Have you ever noticed how standard AI transcription tools completely miss the most valuable part of your keynotes, coaching calls, workshops, and video podcasts - what is actually happening on the screen?</p>\n      <p class=\"n3-body\">When you teach from a slide deck, sketch a framework live, walk through a client workbook, or host a visual interview, regular AI only reads the audio transcript and ignores every visual proof point. We process <strong>3 of your recorded sessions</strong> locally on our studio hardware - watching both your spoken words and every frame on screen - to build a complete, illustrated field guide and multi-channel asset library.</p>\n      <div class=\"n3-btn-row\">\n        <a href=\"mailto:renee.leach@neutral3rd.space?subject=Visual%20Field%20Guide%203-Video%20Bundle\" class=\"btn n3-btn-primary\">Reserve a 3-Video Bundle - $697</a>\n        <a href=\"mailto:renee.leach@neutral3rd.space?subject=Visual%20Field%20Guide%20Question\" class=\"btn n3-btn-secondary\">Ask a Question First</a>\n      </div>\n    </div>\n\n    <div class=\"col-12 col-lg-5\">\n      <div class=\"n3-card\">\n        <div class=\"n3-card-top\">\n          <span>STUDIO SPECIFICATION</span>\n          <span class=\"n3-badge\">LOCAL / ZERO-UPLOAD</span>\n        </div>\n        <div class=\"n3-spec-row\"><span>Source Input</span><strong>3 Videos (up to 90m ea)</strong></div>\n        <div class=\"n3-spec-row\"><span>Analysis Engine</span><strong>Audio + On-Screen Frames</strong></div>\n        <div class=\"n3-spec-row\"><span>Illustrated Guides</span><strong>3 Frame-Verified SOPs</strong></div>\n        <div class=\"n3-spec-row\"><span>Vertical Video Clips</span><strong>9-12 Captioned Shorts</strong></div>\n        <div class=\"n3-spec-row\"><span>Social and Visuals</span><strong>3 Infographics + 14 Posts</strong></div>\n        <div class=\"n3-spec-row\"><span>AI Brain Export</span><strong>1 Unified Knowledge File</strong></div>\n        <div class=\"n3-spec-row n3-no-border\"><span>Cloud Exposure</span><strong>0% (100% Local)</strong></div>\n      </div>\n    </div>\n  </div>\n\n  <!-- NEPQ DIAGNOSTIC -->\n  <div class=\"row n3-block\">\n    <div class=\"col-12 col-lg-9\">\n      <p class=\"n3-mono-tag\">00 // WHY RAW RECORDINGS GATHER DUST</p>\n      <h2 class=\"n3-h2\">Your best frameworks are trapped inside one-hour video files.</h2>\n      <p class=\"n3-body\">If you speak on stages, lead cohort workshops, coach clients, or host a video podcast, your hardest work happens live - and then disappears into a cloud folder.</p>\n    </div>\n    <div class=\"col-12\">\n      <div class=\"n3-callout\">\n        <p class=\"n3-quote\">\"Right now, when you finish delivering a keynote, workshop, or podcast episode, how many hours does it take to turn that recording into visual participant guides, social clips, and searchable intellectual property - and what happens over the next six months if those recordings stay locked in raw MP4 files while you keep rebuilding materials from scratch?\"</p>\n        <p class=\"n3-body\">Generic repurposing tools guess from text transcripts, stripping out the exact slide, diagram, or live walkthrough that made your point land. <strong>The Visual Field Guide</strong> captures the visual evidence alongside your voice - without ever uploading your proprietary curriculum or unreleased client footage to third-party cloud servers.</p>\n        <div class=\"n3-pills\">\n          <span class=\"n3-pill\">Keynote and Stage Speakers</span>\n          <span class=\"n3-pill\">Executive and Business Coaches</span>\n          <span class=\"n3-pill\">Workshop Facilitators</span>\n          <span class=\"n3-pill\">Video Podcasters</span>\n          <span class=\"n3-pill\">Course Creators and Consultants</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- 01-06 PROCESS -->\n  <div class=\"row n3-block\">\n    <div class=\"col-12 col-lg-9\">\n      <p class=\"n3-mono-tag\">SEE WHAT MATTERS // PROCESS ARCHITECTURE</p>\n      <h2 class=\"n3-h2\">Six engineered steps from raw footage to a working field guide.</h2>\n      <p class=\"n3-body\">Every 3-video bundle runs through a structured, human-verified extraction workflow designed for clarity, visual proof, and strict IP confidentiality.</p>\n    </div>\n\n    <div class=\"col-12 col-md-6 col-lg-4 n3-grid-box\">\n      <p class=\"n3-step-num\">01 // INGEST</p>\n      <h3 class=\"n3-h3\">Private Local Intake</h3>\n      <p class=\"n3-body\">You send 3 recordings (keynotes, Zoom workshops, coaching sessions, or podcast episodes). Nothing is uploaded to public AI training clouds - everything stays on our local studio workstation.</p>\n    </div>\n    <div class=\"col-12 col-md-6 col-lg-4 n3-grid-box\">\n      <p class=\"n3-step-num\">02 // WATCH</p>\n      <h3 class=\"n3-h3\">Dual-Stream Frame Analysis</h3>\n      <p class=\"n3-body\">Our screen-aware vision system watches your video frame-by-frame alongside your spoken words, indexing slide transitions, whiteboard sketches, dashboards, and key teaching moments.</p>\n    </div>\n    <div class=\"col-12 col-md-6 col-lg-4 n3-grid-box\">\n      <p class=\"n3-step-num\">03 // VERIFY</p>\n      <h3 class=\"n3-h3\">Visual-Proof Frame Capture</h3>\n      <p class=\"n3-body\">Whenever you reference a framework, chart, or step-by-step action, we extract the exact crisp video frame as visual proof - eliminating manual pausing and sloppy screenshots.</p>\n    </div>\n    <div class=\"col-12 col-md-6 col-lg-4 n3-grid-box\">\n      <p class=\"n3-step-num\">04 // STRUCTURE</p>\n      <h3 class=\"n3-h3\">Illustrated Guide Assembly</h3>\n      <p class=\"n3-body\">We transform each video into a clean, step-by-step illustrated field guide or SOP formatted for immediate publishing in WordPress, Notion, Google Docs, or participant workbooks.</p>\n    </div>\n    <div class=\"col-12 col-md-6 col-lg-4 n3-grid-box\">\n      <p class=\"n3-step-num\">05 // AMPLIFY</p>\n      <h3 class=\"n3-h3\">Clips, Infographics and Social</h3>\n      <p class=\"n3-body\">High-impact teaching moments are cut into captioned vertical clips, paired with save-worthy infographics and two weeks of LinkedIn/social posts grounded in your actual frameworks.</p>\n    </div>\n    <div class=\"col-12 col-md-6 col-lg-4 n3-grid-box\">\n      <p class=\"n3-step-num\">06 // INDEX</p>\n      <h3 class=\"n3-h3\">Unified AI Knowledge Export</h3>\n      <p class=\"n3-body\">All 3 sessions are consolidated into one structured knowledge file ready to drop directly into your private Claude, ChatGPT, or Gemini workspace so you can query your own IP anytime.</p>\n    </div>\n  </div>\n\n  <!-- WORKFLOW DIAGRAM -->\n  <div class=\"row n3-block\">\n    <div class=\"col-12\">\n      <div class=\"n3-card\">\n        <div class=\"n3-card-top\">\n          <span>WORKFLOW DIAGRAM // ZERO-UPLOAD PIPELINE</span>\n          <span>TURNAROUND: 5 BUSINESS DAYS</span>\n        </div>\n        <div class=\"row\">\n          <div class=\"col-12 col-md-4\">\n            <div class=\"n3-pipe\">\n              <p class=\"n3-step-num\">INPUT // 3 RECORDINGS</p>\n              <h4 class=\"n3-h3\">Raw MP4 / MOV Sessions</h4>\n              <p class=\"n3-body\">Up to 90 minutes per video. Keynotes, workshops, client trainings, or video podcasts.</p>\n            </div>\n          </div>\n          <div class=\"col-12 col-md-4\">\n            <div class=\"n3-pipe n3-pipe-active\">\n              <p class=\"n3-step-num\">ENGINE // LOCAL VISION AI</p>\n              <h4 class=\"n3-h3\">Screen + Audio Correlation</h4>\n              <p class=\"n3-body\">100% air-gapped local processing. Captures exact UI states, slides, and spoken timestamps.</p>\n            </div>\n          </div>\n          <div class=\"col-12 col-md-4\">\n            <div class=\"n3-pipe\">\n              <p class=\"n3-step-num\">OUTPUT // COMPLETE SUITE</p>\n              <h4 class=\"n3-h3\">25+ Ready-to-Use Assets</h4>\n              <p class=\"n3-body\">3 Illustrated Guides, 3 Briefs, 9-12 Clips, 3 Infographics, 14 Social Posts and 1 AI Brain File.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- DELIVERABLES -->\n  <div class=\"row n3-block\">\n    <div class=\"col-12 col-lg-9\">\n      <p class=\"n3-mono-tag\">COMPLETE DELIVERABLE MANIFEST</p>\n      <h2 class=\"n3-h2\">Everything included in one 3-Video Edition.</h2>\n      <p class=\"n3-body\">No tiers, no hidden per-minute processing fees, and no bloated agency retainers. One fixed-scope build that extracts maximum value from three recordings.</p>\n    </div>\n\n    <div class=\"col-12 col-md-6 col-lg-4 mb-4\">\n      <div class=\"n3-card h-100\">\n        <span class=\"n3-badge\">01 // 3 ILLUSTRATED GUIDES</span>\n        <h3 class=\"n3-h3 mt-3\">Frame-Verified Field Guides and SOPs</h3>\n        <p class=\"n3-body\">Step-by-step instructional guides with exact video frames embedded at every critical slide, diagram, or walkthrough step - ready for WordPress, Notion, or client handouts.</p>\n        <p class=\"n3-meta\">DELIVERED: DOCX + MARKDOWN + HTML</p>\n      </div>\n    </div>\n\n    <div class=\"col-12 col-md-6 col-lg-4 mb-4\">\n      <div class=\"n3-card h-100\">\n        <span class=\"n3-badge\">02 // 3 EXECUTIVE BRIEFS</span>\n        <h3 class=\"n3-h3 mt-3\">Timestamped Findings and Key Takeaways</h3>\n        <p class=\"n3-body\">Structured executive summaries mapping every core thesis, framework, and audience Q and A moment directly to exact timestamps and visual frame citations.</p>\n        <p class=\"n3-meta\">DELIVERED: TIMESTAMPED REFERENCE DOCS</p>\n      </div>\n    </div>\n\n    <div class=\"col-12 col-md-6 col-lg-4 mb-4\">\n      <div class=\"n3-card h-100\">\n        <span class=\"n3-badge\">03 // 9-12 VERTICAL CLIPS</span>\n        <h3 class=\"n3-h3 mt-3\">Captioned Short-Form Video Cuts</h3>\n        <p class=\"n3-body\">3 to 4 high-retention vertical clips extracted per video, cleanly cut around your sharpest teaching hooks and formatted with burned-in captions for LinkedIn, Reels, and Shorts.</p>\n        <p class=\"n3-meta\">DELIVERED: 1080x1920 MP4 FILES</p>\n      </div>\n    </div>\n\n    <div class=\"col-12 col-md-6 col-lg-4 mb-4\">\n      <div class=\"n3-card h-100\">\n        <span class=\"n3-badge\">04 // 3 INFOGRAPHICS</span>\n        <h3 class=\"n3-h3 mt-3\">Save-Worthy Visual Frameworks</h3>\n        <p class=\"n3-body\">Custom visual summary graphics distilled directly from your spoken models and on-screen slides - built for high saves on LinkedIn or inclusion in speaker media kits.</p>\n        <p class=\"n3-meta\">DELIVERED: HIGH-RES PNG + PDF</p>\n      </div>\n    </div>\n\n    <div class=\"col-12 col-md-6 col-lg-4 mb-4\">\n      <div class=\"n3-card h-100\">\n        <span class=\"n3-badge\">05 // 14 SOCIAL POSTS</span>\n        <h3 class=\"n3-h3 mt-3\">Two Weeks of Authority Content</h3>\n        <p class=\"n3-body\">14 ready-to-publish LinkedIn and Facebook posts written in your grounded voice, pairing your visual frames and clips with clear takeaways that attract speaking and coaching inquiries.</p>\n        <p class=\"n3-meta\">DELIVERED: SCHEDULE-READY COPY DECK</p>\n      </div>\n    </div>\n\n    <div class=\"col-12 col-md-6 col-lg-4 mb-4\">\n      <div class=\"n3-card h-100\">\n        <span class=\"n3-badge\">06 // 1 AI KNOWLEDGE FILE</span>\n        <h3 class=\"n3-h3 mt-3\">Query-Ready Intellectual Property Vault</h3>\n        <p class=\"n3-body\">All three videos compiled into a clean, structured knowledge export you can upload into Claude Projects, Custom GPTs, or Gemini so you can draft future talks and books from your own words.</p>\n        <p class=\"n3-meta\">DELIVERED: UNIFIED .MD / .JSON BUNDLE</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- PRICING -->\n  <div class=\"row n3-block\">\n    <div class=\"col-12 col-lg-9\">\n      <p class=\"n3-mono-tag\">SIMPLIFY THE WORK // ONE CLEAR PACKAGE</p>\n      <h2 class=\"n3-h2\">Would it make sense to turn 3 of your existing recordings into a complete field guide library?</h2>\n    </div>\n\n    <div class=\"col-12\">\n      <div class=\"n3-pricing\">\n        <div class=\"row no-gutters\">\n          <div class=\"col-12 col-lg-8 n3-pricing-left\">\n            <p class=\"n3-mono-tag\">THE VISUAL FIELD GUIDE // 3-VIDEO EDITION</p>\n            <h3 class=\"n3-h2\">Complete Screen-Verified Extraction and Asset Suite</h3>\n            <p class=\"n3-body\">Send us three recordings - whether they are keynote talks, paid workshops, coaching intensives, or video podcast episodes. Within 5 business days, you receive the entire visual documentation and content ecosystem without exposing a single frame to third-party cloud platforms.</p>\n            <div class=\"row mt-4\">\n              <div class=\"col-12 col-sm-6\">\n                <p class=\"n3-check\">+ 3 Illustrated Frame-Proof Guides</p>\n                <p class=\"n3-check\">+ 3 Timestamped Executive Briefs</p>\n                <p class=\"n3-check\">+ 9-12 Captioned Vertical Clips</p>\n                <p class=\"n3-check\">+ 3 Framework Infographics</p>\n              </div>\n              <div class=\"col-12 col-sm-6\">\n                <p class=\"n3-check\">+ 14 LinkedIn / Social Posts</p>\n                <p class=\"n3-check\">+ 1 Unified AI Knowledge File</p>\n                <p class=\"n3-check\">+ Up to 90 Mins Per Source Video</p>\n                <p class=\"n3-check\">+ 100% Local Zero-Upload Privacy</p>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"col-12 col-lg-4 n3-pricing-right\">\n            <p class=\"n3-mono-tag\">FLAT STUDIO FEE</p>\n            <div class=\"n3-price\">$697</div>\n            <p class=\"n3-meta mb-4\">Per 3-Video Bundle (~$232 / video)</p>\n            <a href=\"mailto:renee.leach@neutral3rd.space?subject=Start%20Visual%20Field%20Guide%203-Video%20Bundle\" class=\"btn n3-btn-primary w-100 mb-2\">Start Your 3-Video Bundle</a>\n            <a href=\"mailto:renee.leach@neutral3rd.space?subject=Question%20About%20Visual%20Field%20Guide\" class=\"btn n3-btn-secondary w-100 mb-3\">Ask a Question First</a>\n            <p class=\"n3-small-note\">People Before Platforms. Built For Real Work.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n</section>",
          "_customCSS": "background-color: #F8F6F2;\n\n.n3-wrap {\n  color: #141414;\n  font-family: 'Inter', sans-serif;\n  text-align: left;\n  padding-top: 40px;\n  padding-bottom: 40px;\n}\n\n.n3-mono-tag {\n  font-family: 'Roboto Mono', monospace;\n  font-size: 13px;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  color: #C75423;\n  margin-bottom: 12px;\n}\n\n.n3-title {\n  font-size: 42px;\n  font-weight: 600;\n  line-height: 1.15;\n  color: #141414;\n  margin-bottom: 20px;\n}\n\n.n3-orange {\n  color: #C75423;\n  font-weight: 400;\n}\n\n.n3-h2 {\n  font-size: 32px;\n  font-weight: 600;\n  line-height: 1.2;\n  color: #141414;\n  margin-bottom: 16px;\n}\n\n.n3-h3 {\n  font-size: 19px;\n  font-weight: 600;\n  color: #141414;\n  margin-bottom: 10px;\n}\n\n.n3-lead {\n  font-size: 18px;\n  line-height: 1.6;\n  color: #141414;\n  margin-bottom: 18px;\n}\n\n.n3-body {\n  font-size: 15px;\n  line-height: 1.65;\n  color: #57534E;\n}\n\n.n3-hero {\n  padding-bottom: 56px;\n  border-bottom: 1px solid #E4E0D8;\n}\n\n.n3-block {\n  padding-top: 56px;\n  padding-bottom: 56px;\n  border-bottom: 1px solid #E4E0D8;\n}\n\n.n3-btn-row {\n  margin-top: 24px;\n}\n\n.n3-btn-primary {\n  background-color: #C75423 !important;\n  border-color: #C75423 !important;\n  color: #FFFFFF !important;\n  border-radius: 6px;\n  padding: 12px 22px;\n  font-size: 15px;\n}\n\n.n3-btn-secondary {\n  background-color: transparent !important;\n  border-color: #141414 !important;\n  color: #141414 !important;\n  border-radius: 6px;\n  padding: 12px 22px;\n  font-size: 15px;\n}\n\n.n3-card {\n  background-color: #FFFFFF;\n  border: 1px solid #E4E0D8;\n  border-radius: 8px;\n  padding: 28px;\n}\n\n.n3-card-top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding-bottom: 14px;\n  margin-bottom: 14px;\n  border-bottom: 1px solid #E4E0D8;\n  font-family: 'Roboto Mono', monospace;\n  font-size: 12px;\n  color: #57534E;\n}\n\n.n3-badge {\n  background-color: #F1EDE5;\n  color: #C75423;\n  font-family: 'Roboto Mono', monospace;\n  font-size: 11px;\n  font-weight: 600;\n  padding: 4px 10px;\n  border-radius: 4px;\n}\n\n.n3-spec-row {\n  display: flex;\n  justify-content: space-between;\n  padding-top: 10px;\n  padding-bottom: 10px;\n  border-bottom: 1px dashed #E4E0D8;\n  font-size: 14px;\n}\n\n.n3-no-border {\n  border-bottom: none;\n}\n\n.n3-callout {\n  background-color: #FFFFFF;\n  border: 1px solid #E4E0D8;\n  border-left: 4px solid #C75423;\n  border-radius: 6px;\n  padding: 32px;\n  margin-top: 20px;\n}\n\n.n3-quote {\n  font-size: 18px;\n  font-weight: 500;\n  color: #141414;\n  line-height: 1.55;\n  margin-bottom: 14px;\n}\n\n.n3-pills {\n  margin-top: 20px;\n}\n\n.n3-pill {\n  display: inline-block;\n  font-family: 'Roboto Mono', monospace;\n  font-size: 12px;\n  background-color: #F8F6F2;\n  border: 1px solid #E4E0D8;\n  border-radius: 4px;\n  padding: 6px 12px;\n  margin-right: 8px;\n  margin-bottom: 8px;\n}\n\n.n3-grid-box {\n  background-color: #FFFFFF;\n  border: 1px solid #E4E0D8;\n  padding: 28px;\n}\n\n.n3-step-num {\n  font-family: 'Roboto Mono', monospace;\n  font-size: 12px;\n  font-weight: 600;\n  color: #C75423;\n  margin-bottom: 8px;\n}\n\n.n3-pipe {\n  background-color: #F8F6F2;\n  border: 1px solid #E4E0D8;\n  border-radius: 6px;\n  padding: 20px;\n  margin-bottom: 12px;\n}\n\n.n3-pipe-active {\n  border-color: #C75423;\n  background-color: #FFFBF9;\n}\n\n.n3-meta {\n  font-family: 'Roboto Mono', monospace;\n  font-size: 12px;\n  color: #C75423;\n  margin-top: 14px;\n  margin-bottom: 0;\n}\n\n.n3-pricing {\n  background-color: #FFFFFF;\n  border: 1px solid #141414;\n  border-radius: 8px;\n  overflow: hidden;\n  margin-top: 20px;\n}\n\n.n3-pricing-left {\n  padding: 36px;\n}\n\n.n3-pricing-right {\n  background-color: #F1EDE5;\n  border-left: 1px solid #E4E0D8;\n  padding: 36px;\n}\n\n.n3-price {\n  font-size: 48px;\n  font-weight: 700;\n  color: #141414;\n  line-height: 1.1;\n  margin-bottom: 6px;\n}\n\n.n3-check {\n  font-size: 15px;\n  color: #141414;\n  margin-bottom: 10px;\n}\n\n.n3-small-note {\n  font-size: 12px;\n  color: #57534E;\n  text-align: center;\n  margin-bottom: 0;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "fabm5",
          "_anchor": "custom-html-5g",
          "_PHPplaceholders": [],
          "_JSplaceholders": []
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <a href=\"https://neutral3rd.space\"><img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-1-512x512.png\" alt=\"Neutral3rd Emerging Tech Development Studio\"></a>\n                            </div>\n\n                           <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <!-- <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">xx</p>\n                    </div> -->\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                       <!-- <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3> -->\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\"><b>Neutral3rd</b> helps small businesses and independent professionals put AI to work within real human work. Led by Renée Leach and supported by an army of customized AI assistants, co-pilots, and agents, this studio brings strategy, development, workflows, and AI-powered media together with a \"human STILL in-the-loop\" to make work more capable without making it more complicated.<br></p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/privacy\" class=\"text-info\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/terms\" class=\"text-info\">TERMS OF SERVICE</a></b></li><a href=\"https://neutral3rd.space/terms\" class=\"text-primary\">\n                                </a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/accessibility\" class=\"text-info\">ACCESSIBILITY</a></b></li><li class=\"item-wrap\"><b><a href=\"https://connections.neutral3rd.space/wall\" class=\"text-info\" target=\"_blank\">LEAVE YOUR FEEDBACK</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://offerbeacon.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">HELP THE RIGHT BUYERS FIND YOU</a></b></li>\n<li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/custom-task-prompt\" class=\"text-info text-primary\">FROM MY WILDEST DREAMS</a></b></li><li class=\"item-wrap\"><b><a href=\"https://perspectives.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">NEUTRAL3RD PERSPECTIVES</a></b></li><a href=\"https://neutral3rd.space\" class=\"text-primary\">\n</a><li class=\"item-wrap\"><b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-info\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Tech Development Studio. Operated by U.S.-based business entity, Rowdy Independents LLC. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vAag2ZwfyZ",
          "_anchor": "footer01-52",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "custom-task-prompt.html": {
      "settings": {
        "title": "From My Wildest Dreams | Neutral3rd Emerging Tech Development Studio",
        "meta_descr": "",
        "header_custom": "<style>\n.n3-fmwd {\n  --fmwd-paper: #141414;\n  --fmwd-ink: #f8f7f5;\n  --fmwd-muted: #e0dedb;\n  --fmwd-orange: #f47739;\n  --fmwd-button: #ed6229;\n  --fmwd-rule: #585653;\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  width: 100%;\n  padding: 0;\n  margin: 0;\n  color: var(--fmwd-ink);\n  background-color: var(--fmwd-paper);\n  background-image:\n    linear-gradient(90deg, rgba(214, 209, 201, 0.066667) 1px, transparent 1px),\n    linear-gradient(rgba(214, 209, 201, 0.066667) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(214, 209, 201, 0.031373) 1px, transparent 1px),\n    linear-gradient(rgba(214, 209, 201, 0.031373) 1px, transparent 1px),\n    radial-gradient(ellipse at 28% 16%, #202020, transparent 58%);\n  background-size: 88px 88px, 88px 88px, 22px 22px, 22px 22px, 100% 100%;\n  font: 400 1rem/1.42 \"Arial\", \"Helvetica Neue\", sans-serif;\n  text-align: left;\n}\n.n3-fmwd *, .n3-fmwd *::before, .n3-fmwd *::after { box-sizing: border-box; }\n.n3-fmwd :is(h1, h2, h3, p, ol, figure) { margin: 0; }\n.n3-fmwd :is(h1, h2, h3) { color: var(--fmwd-ink); }\n.n3-fmwd :is(p, ol) { color: var(--fmwd-muted); }\n.n3-fmwd ol { padding: 0; list-style: none; }\n.n3-fmwd svg { display: block; }\n.n3-fmwd .fmwd-wrap { width: 88%; max-width: 1250px; margin-inline: auto; }\n.n3-fmwd .fmwd-defs { position: absolute; width: 0; height: 0; overflow: hidden; }\n.n3-fmwd .fmwd-drafting,\n.n3-fmwd .fmwd-fold { position: absolute; inset: 0; z-index: -1; pointer-events: none; }\n.n3-fmwd .fmwd-drafting { color: #b7b5ae; }\n.n3-fmwd .fmwd-traces { width: 100%; height: 100%; opacity: .32; }\n.n3-fmwd .fmwd-spiral { position: absolute; width: clamp(130px, 23vw, 320px); opacity: .44; }\n.n3-fmwd .fmwd-spiral--top-left { top: -3%; left: -7%; transform: rotate(178deg) scale(.78); }\n.n3-fmwd .fmwd-spiral--top-right { top: -2%; right: -5%; transform: rotate(3deg) scale(1.13); }\n.n3-fmwd .fmwd-spiral--center { top: 29%; left: 41%; transform: rotate(91deg); }\n.n3-fmwd .fmwd-spiral--middle-left { top: 54%; left: -9%; transform: rotate(180deg) scale(.87); }\n.n3-fmwd .fmwd-spiral--middle-right { top: 57%; right: -9%; transform: rotate(0deg); }\n.n3-fmwd .fmwd-spiral--bottom-left { bottom: 5%; left: -3%; transform: rotate(93deg) scale(.86); }\n.n3-fmwd .fmwd-spiral--bottom-right { bottom: -2%; right: -2%; transform: rotate(269deg) scale(1.16); }\n.n3-fmwd .fmwd-top,\n.n3-fmwd .fmwd-price-section { position: relative; isolation: isolate; }\n.n3-fmwd .fmwd-fold { overflow: hidden; }\n.n3-fmwd .fmwd-fold::before,\n.n3-fmwd .fmwd-fold::after {\n  content: \"\";\n  position: absolute;\n  inset: auto 0 0 auto;\n  width: clamp(155px, 28vw, 440px);\n  height: clamp(80px, 13vw, 196px);\n  clip-path: polygon(100% 0, 100% 100%, 0 100%);\n  background: linear-gradient(140deg, #3c190c, #9d390f 80%);\n}\n.n3-fmwd .fmwd-fold::after {\n  width: clamp(117px, 22vw, 350px);\n  background: linear-gradient(138deg, #9e350e, #d84e19 88%);\n}\n.n3-fmwd .fmwd-fold--bottom::before { width: clamp(175px, 36vw, 530px); }\n.n3-fmwd .fmwd-fold--bottom::after { width: clamp(133px, 29vw, 425px); }\n.n3-fmwd .fmwd-hero {\n  display: grid;\n  grid-template-columns: minmax(0, 1.36fr) minmax(0, 1fr);\n  align-items: start;\n  gap: clamp(24px, 3.5vw, 56px);\n  padding-block: clamp(54px, 6vw, 88px) clamp(36px, 3.6vw, 64px);\n}\n.n3-fmwd .fmwd-kicker {\n  color: var(--fmwd-orange);\n  font-size: clamp(.81rem, 1.8vw, 1.52rem);\n  font-weight: 750;\n  letter-spacing: .12em;\n  line-height: 1.2;\n  text-transform: uppercase;\n}\n.n3-fmwd .fmwd-title {\n  width: fit-content;\n  margin-top: clamp(.75rem, 1.35vw, 1.4rem);\n  padding-bottom: .15em;\n  border-bottom: .12em solid var(--fmwd-button);\n  font-size: clamp(2.35rem, 6.3vw, 6rem);\n  font-weight: 900;\n  line-height: .98;\n  letter-spacing: -.055em;\n}\n.n3-fmwd .fmwd-title span { display: block; }\n.n3-fmwd .fmwd-lede {\n  max-width: 34ch;\n  margin-top: .65em;\n  font-size: clamp(1.07rem, 2.5vw, 2.15rem);\n  line-height: 1.21;\n}\n.n3-fmwd .fmwd-cta,\n.n3-fmwd .fmwd-cta:visited {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 46px;\n  max-width: 100%;\n  margin-top: clamp(17px, 2.4vw, 31px);\n  padding: .44em 1.15em .5em;\n  border: 1px solid transparent;\n  border-radius: .4em;\n  color: #120a07;\n  background: var(--fmwd-button);\n  font-size: clamp(1.05rem, 2.75vw, 2.45rem);\n  font-weight: 850;\n  line-height: 1.18;\n  text-align: center;\n  text-decoration: none;\n}\n.n3-fmwd .fmwd-cta:hover { color: #120a07; background: #ff8754; text-decoration: none; }\n.n3-fmwd .fmwd-cta:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }\n.n3-fmwd .fmwd-cta-note { margin-top: .42em; font-size: clamp(.9rem, 1.76vw, 1.45rem); }\n.n3-fmwd .fmwd-example {\n  min-width: 0;\n  margin-top: clamp(0px, 1.2vw, 18px);\n  padding: clamp(16px, 2.2vw, 33px) clamp(16px, 3vw, 42px) clamp(22px, 3.1vw, 45px);\n  border: 1px solid #b4b1ad;\n  background: rgba(21, 21, 21, 0.788235);\n}\n.n3-fmwd .fmwd-example figcaption {\n  margin-bottom: clamp(15px, 2.3vw, 33px);\n  color: var(--fmwd-ink);\n  font-size: clamp(.73rem, 1.3vw, 1.15rem);\n  font-weight: 700;\n  letter-spacing: .22em;\n  line-height: 1.4;\n  text-transform: uppercase;\n}\n.n3-fmwd .fmwd-example li {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: clamp(11px, 2.05vw, 31px);\n  min-height: 64px;\n  padding: clamp(9px, 1.2vw, 17px) clamp(12px, 2vw, 26px);\n  border: 1px solid #b4b1ad;\n  border-radius: .22rem;\n  background: #191919;\n  color: var(--fmwd-ink);\n  font-size: clamp(.95rem, 2vw, 1.75rem);\n  font-weight: 750;\n  line-height: 1.16;\n}\n.n3-fmwd .fmwd-example li + li { margin-top: clamp(25px, 4vw, 56px); }\n.n3-fmwd .fmwd-example li + li::before,\n.n3-fmwd .fmwd-example li + li::after {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  bottom: 100%;\n  color: var(--fmwd-orange);\n  transform: translateX(-50%);\n}\n.n3-fmwd .fmwd-example li + li::before { width: 2px; height: clamp(25px, 4vw, 56px); background: currentColor; }\n.n3-fmwd .fmwd-example li + li::after {\n  border: .38rem solid transparent;\n  border-top: .46rem solid currentColor;\n  border-bottom: 0;\n}\n.n3-fmwd .fmwd-icon {\n  flex: none;\n  width: clamp(29px, 4.3vw, 63px);\n  height: auto;\n  aspect-ratio: 1;\n  color: var(--fmwd-orange);\n}\n.n3-fmwd .fmwd-content-section { border-top: 1px solid var(--fmwd-rule); padding-block: clamp(23px, 3vw, 46px) clamp(29px, 3.6vw, 54px); }\n.n3-fmwd .fmwd-section-title {\n  margin-bottom: clamp(16px, 2.15vw, 32px);\n  font-size: clamp(1.9rem, 4.85vw, 4.3rem);\n  font-weight: 850;\n  letter-spacing: -.04em;\n  line-height: 1.04;\n}\n.n3-fmwd .fmwd-columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(13px, 2.2vw, 33px); }\n.n3-fmwd .fmwd-steps > li + li { border-inline-start: 1px solid #b4b1ad; padding-inline-start: clamp(13px, 2.2vw, 33px); }\n.n3-fmwd .fmwd-step-title { display: flex; align-items: baseline; gap: .66em; }\n.n3-fmwd .fmwd-step-number { color: var(--fmwd-orange); font-size: 1.25em; font-weight: 850; }\n.n3-fmwd .fmwd-item-title { font-size: clamp(1rem, 2.08vw, 1.95rem); font-weight: 800; line-height: 1.12; }\n.n3-fmwd .fmwd-item-text { margin-top: .52em; font-size: clamp(.95rem, 1.95vw, 1.6rem); line-height: 1.24; }\n.n3-fmwd .fmwd-card {\n  padding: clamp(14px, 2vw, 29px);\n  border: 1px solid #b4b1ad;\n  border-radius: .45rem;\n  background: rgba(23, 23, 23, 0.921569);\n}\n.n3-fmwd .fmwd-card .fmwd-icon { margin-bottom: clamp(9px, 1.25vw, 18px); }\n.n3-fmwd .fmwd-price-section { padding-bottom: clamp(52px, 8vw, 115px); }\n.n3-fmwd .fmwd-price {\n  display: grid;\n  grid-template-columns: minmax(0, .79fr) minmax(0, 1.21fr);\n  width: 92%;\n  max-width: 1300px;\n  padding: clamp(19px, 2.7vw, 42px);\n  border: 1px solid #efede9;\n  border-radius: .5rem;\n  background: rgba(24, 24, 24, 0.839216);\n}\n.n3-fmwd .fmwd-price-left { padding-inline-end: clamp(15px, 3.2vw, 48px); }\n.n3-fmwd .fmwd-price-right { border-inline-start: 1px solid #b4b1ad; padding-inline-start: clamp(20px, 3.6vw, 53px); }\n.n3-fmwd .fmwd-price-amount {\n  display: block;\n  margin-block: .08em .02em;\n  color: var(--fmwd-ink);\n  font-size: clamp(4rem, 10.5vw, 9.1rem);\n  font-weight: 900;\n  letter-spacing: -.075em;\n  line-height: .98;\n}\n.n3-fmwd .fmwd-price-title { font-size: clamp(1.33rem, 3vw, 2.7rem); font-weight: 850; letter-spacing: -.035em; line-height: 1.1; }\n.n3-fmwd .fmwd-price-right .fmwd-cta { margin-top: clamp(15px, 2.1vw, 28px); }\n.n3-fmwd .fmwd-intake { display: none; margin-top: 1rem; padding: .85rem 1rem; border: 1px solid #b4b1ad; border-radius: .35rem; background: var(--fmwd-paper); }\n.n3-fmwd .fmwd-intake:target { display: block; }\n@media (max-width: 767px) {\n  .n3-fmwd .fmwd-wrap { width: 88%; }\n  .n3-fmwd .fmwd-hero { grid-template-columns: minmax(0, 1fr); padding-block: 42px 36px; }\n  .n3-fmwd .fmwd-title { font-size: clamp(2.45rem, 8.8vw, 4.25rem); }\n  .n3-fmwd .fmwd-lede { font-size: clamp(1.06rem, 3vw, 1.44rem); }\n  .n3-fmwd .fmwd-example { width: 100%; max-width: 460px; }\n  .n3-fmwd .fmwd-columns { grid-template-columns: minmax(0, 1fr); }\n  .n3-fmwd .fmwd-steps > li + li { padding: .85rem 0 0; border-inline-start: 0; border-top: 1px solid var(--fmwd-rule); }\n  .n3-fmwd .fmwd-content-section { padding-block: 27px 33px; }\n  .n3-fmwd .fmwd-price { grid-template-columns: minmax(0, 1fr); }\n  .n3-fmwd .fmwd-price-left { padding: 0 0 17px; }\n  .n3-fmwd .fmwd-price-right { padding: 17px 0 0; border-inline-start: 0; border-top: 1px solid #b4b1ad; }\n  .n3-fmwd .fmwd-spiral--top-left { left: -14%; }\n  .n3-fmwd .fmwd-spiral--top-right { right: -13%; }\n  .n3-fmwd .fmwd-spiral--center { top: 31%; left: 63%; }\n  .n3-fmwd .fmwd-spiral--middle-left { top: 49%; left: -14%; }\n  .n3-fmwd .fmwd-spiral--middle-right { top: 62%; right: -14%; }\n  .n3-fmwd .fmwd-spiral--bottom-right { right: -7%; }\n}\n</style>",
        "footer_custom": "<style>\n/* Neutral3rd: Basic Image Protection */\nimg {\n  -webkit-user-drag: none;\n  user-drag: none;\n  -webkit-touch-callout: none;\n}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  // Prevent the image-specific right-click menu.\n  document.addEventListener(\"contextmenu\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n\n  // Prevent dragging images onto the desktop.\n  document.addEventListener(\"dragstart\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n})();\n</script>",
        "html_before": "",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.png",
        "order": "2"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
