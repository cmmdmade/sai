          "_name": "menu01",
          "_sourceTheme": "elementm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 elementm5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"2\" max=\"4\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#ff4400\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ff4400\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" checked>\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#000000\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ff4400\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"@THEME_PATH@/components/index.html\">\n                        <img src=\"@PROJECT_PATH@/assets/images/logo.png\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-primary\" data-app-selector=\".navbar-caption\" href=\"@THEME_PATH@/components/index.html\" data-app-placeholder=\"Type Text\">Select Access Index</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-7\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Home</a></li>\n                    <li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"sei.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">The Index</a></li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"standards.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Standards</a>\n                    </li><li class=\"nav-item\"><a class=\"nav-link link text-primary\" href=\"index.html#aheader2-4\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a></li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-facebook socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-primary-outline\" href=\"index.html#footer01-k\" data-app-placeholder=\"Type Text\">UPDATES</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vtTU2LTW37",
          "_anchor": "menu01-5",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".label-wrapper": {
              "margin-bottom": "60px",
              "padding-bottom": "24px",
              "& when (@showBorder)": {
                "border-bottom": "1px solid @border"
              },
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              ".label-content": {
                "display": "inline-flex",
                "align-items": "center",
                "gap": "16px",
                "@media (max-width: 992px)": {
                  "display": "block"
                },
                ".label-wrap": {
                  "display": "inline-flex",
                  "gap": "4px",
                  "padding-right": "24px",
                  "& when (@showBorder)": {
                    "border-right": "1px solid @border",
                    "@media (max-width: 992px)": {
                      "border-right": "none",
                      "padding-right": "0"
                    }
                  },
                  ".marker-wrapper": {
                    "display": "inline-flex",
                    "width": "16px",
                    "height": "16px",
                    "min-width": "16px",
                    "border": "4px solid @labelMarker",
                    "border-radius": "100%",
                    "margin-top": "6px"
                  },
                  ".mbr-label": {
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "12px"
                    }
                  }
                },
                ".mbr-tag": {
                  "margin-bottom": "0"
                }
              }
            },
            ".content-wrapper": {
              ".title-wrapper": {
                ".mbr-section-title": {
                  "margin-bottom": "24px"
                }
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-block",
                  "width": "50%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              },
              ".mbr-section-btn": {
                "margin-top": "14px",
                "margin-bottom": "-9.6px"
              }
            },
            ".mbr-label": {
              "color": "#c0c0c0"
            },
            ".mbr-tag": {
              "color": "#6f6f75"
            },
            ".mbr-section-title": {
              "color": "#f6f6f6"
            },
            ".mbr-text": {
              "color": "#c0c0c0"
            }
          },
          "_name": "article01",
          "_sourceTheme": "elementm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article01 elementm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Marker\" name=\"showMarker\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Marker Color\" value=\"#ff4400\" name=\"labelMarker\" condition=\"showLabel && showMarker\" selected>\n        <input type=\"checkbox\" title=\"Tag\" name=\"showTag\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#333336\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"label-wrapper\" mbr-if=\"showLabel || showTag || showBorder\">\n                    <div class=\"label-content\">\n                        <div class=\"label-wrap\" mbr-if=\"showLabel\">\n                            <div class=\"marker-wrapper\" mbr-if=\"showMarker\"></div>\n                            <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                Select Access Index</p>\n                        </div>\n                        <p class=\"mbr-tag mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-tag, .label-wrapper\" mbr-if=\"showTag\">\n                            check out the latest additions below</p>\n                    </div>\n                </div>\n                <div class=\"content-wrapper\">\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                            Find What's Worth Knowing</h2>\n                    </div>\n                    <div class=\"text-wrapper\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                            A curated directory of digital tools, specialized services and high-value online offers.\n                        </p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            read more\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vtTUvGQJae",
          "_anchor": "article01-j",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".items-wrapper": {
              "margin": "0 -20px",
              ".item": {
                "padding": "0 20px"
              }
            },
            ".item": {
              "margin-bottom": "40px",
              "@media (max-width: 992px)": {
                "margin-bottom": "24px",
                "&:last-child": {
                  "margin-bottom": "0"
                }
              }
            },
            ".item-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "height": "100%",
              "position": "relative",
              "overflow": "hidden !important",
              "min-height": "800px",
              "padding": "32px 32px 100px",
              "@media (max-width: 1920px)": {
                "min-height": "500px"
              },
              "@media (max-width: 992px)": {
                "padding": "24px",
                "min-height": "400px"
              },
              "&:hover, &:focus": {
                ".item-img img": {
                  "filter": "blur(6px)"
                },
                "&::before": {
                  "opacity": "0.5 !important"
                },
                ".card-box": {
                  ".item-date": {
                    "padding": "0 8px 16px 8px",
                    "opacity": "1"
                  },
                  ".border-wrap": {
                    "opacity": "1"
                  },
                  ".item-title": {
                    "padding": "0 4px 0 4px"
                  },
                  ".item-desc": {
                    "padding": "0 4px 0 4px"
                  }
                },
                ".item-content": {
                  ".item-text": {
                    "opacity": "1"
                  },
                  ".item-btn": {
                    "opacity": "1"
                  }
                }
              },
              ".item-img": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "transition": "all .5s ease",
                  "@media (max-width: 992px)": {
                    "filter": "blur(6px) !important"
                  }
                }
              },
              "&::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-color": "@overColor",
                "opacity": "@overOpacity",
                "pointer-events": "none",
                "z-index": "1",
                "transition": "all .5s ease"
              },
              ".card-box": {
                "position": "relative",
                "z-index": "1",
                ".item-date": {
                  "padding": "0 16px 16px 16px",
                  "margin-bottom": "0",
                  "transition": "all .5s ease",
                  "opacity": "0",
                  "@media (max-width: 992px)": {
                    "opacity": "1 !important",
                    "padding": "0 0 16px 0 !important"
                  }
                },
                ".border-wrap": {
                  "width": "100%",
                  "height": "1px",
                  "background-color": "@border",
                  "opacity": "0",
                  "transition": "all .5s ease",
                  "margin-bottom": "16px",
                  "@media (max-width: 992px)": {
                    "opacity": "1 !important"
                  }
                },
                ".item-title": {
                  "padding": "0 16px 0 16px",
                  "margin-bottom": "0",
                  "transition": "all .5s ease",
                  "@media (max-width: 992px)": {
                    "padding": "0 !important"
                  }
                },
                ".item-desc": {
                  "margin-bottom": "0",
                  "padding": "0 16px 0 16px",
                  "transition": "all .5s ease",
                  "@media (max-width: 992px)": {
                    "padding": "0 !important"
                  }
                }
              },
              ".item-content": {
                "position": "relative",
                "z-index": "1",
                ".item-text": {
                  "margin-top": "24px",
                  "margin-bottom": "0",
                  "opacity": "0",
                  "transition": "all .5s ease",
                  "@media (max-width: 992px)": {
                    "opacity": "1 !important"
                  }
                },
                ".item-btn": {
                  "opacity": "0",
                  "margin-top": "14px",
                  "margin-bottom": "-9.6px",
                  "transition": "all .5s ease",
                  "@media (max-width: 992px)": {
                    "opacity": "1 !important"
                  }
                }
              }
            },
            ".item-date": {
              "color": "#f6f6f6"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-desc": {
              "color": "#f6f6f6"
            },
            ".item-text": {
              "color": "#f6f6f6"
            }
          },
          "_name": "features02",
          "_sourceTheme": "elementm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features02 elementm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Date\" name=\"showDate\">\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#e6e6e6\" name=\"border\" condition=\"showBorder\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Card Overlay\" name=\"overColor\" value=\"#000000\">\n        <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row items-wrapper justify-content-center\">\n\n            <!-- CARD 1 -->\n            <div class=\"col-12 col-lg-4 item features-image active\">\n                <div class=\"item-wrapper card-wrap\">\n\n                    <div class=\"item-img\">\n                        <img src=\"../_images/element/image19.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                    </div>\n\n                    <div class=\"card-box\">\n\n                        <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDate\" data-app-selector=\".item-date\">\n                            April 15, 2030\n                        </p>\n\n                        <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">\n                            Spring Performance Launch\n                        </h4>\n\n                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                            Experience the next generation of sportswear designed for peak performance.\n                        </p>\n\n                    </div>\n\n                    <div class=\"item-content\">\n\n                        <div class=\"text-wrapper\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text, .text-wrapper\">\n                                Join us for the official launch of our new spring collection, featuring lightweight,\n                                breathable designs built for movement. Guests will enjoy live training sessions, product\n                                showcases, and exclusive first access to the latest gear.\n                            </p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n\n                            <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                read more\n                            </a>\n\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n\n            <!-- CARD 2 -->\n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper card-wrap\">\n\n                    <div class=\"item-img\">\n                        <img src=\"../_images/element/image7.jpg\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                    </div>\n\n                    <div class=\"card-box\">\n\n                        <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDate\" data-app-selector=\".item-date\">\n                            June 8, 2030\n                        </p>\n\n                        <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">\n                            Urban Fitness Challenge\n                        </h4>\n\n                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                            Push your limits in the heart of the city.\n                        </p>\n\n                    </div>\n\n                    <div class=\"item-content\">\n\n                        <div class=\"text-wrapper\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text, .text-wrapper\">\n                                Take part in an energetic fitness challenge combining running, strength, and endurance\n                                workouts. Test your performance alongside other athletes and discover gear that supports\n                                you through every stage of the challenge.\n                            </p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n\n                            <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                read more\n                            </a>\n\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n\n            <!-- CARD 3 -->\n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper card-wrap\">\n\n                    <div class=\"item-img\">\n                        <img src=\"../_images/element/image13.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n\n                    <div class=\"card-box\">\n\n                        <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDate\" data-app-selector=\".item-date\">\n                            August 21, 2030\n                        </p>\n\n                        <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">\n                            Pro Training Experience\n                        </h4>\n\n                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                            Train like a pro with elite-level coaching.\n                        </p>\n\n                    </div>\n\n                    <div class=\"item-content\">\n\n                        <div class=\"text-wrapper\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text, .text-wrapper\">\n                                A premium training event led by professional coaches focusing on technique, strength,\n                                and recovery. Participants will experience high-performance sportswear in action and\n                                learn how to maximize results with the right gear.\n                            </p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n\n                            <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                read more\n                            </a>\n\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n\n            <!-- CARD 4 -->\n            <div class=\"col-12 col-lg-4 item features-image\">\n                <div class=\"item-wrapper card-wrap\">\n\n                    <div class=\"item-img\">\n                        <img src=\"../_images/element/image17.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n\n                    <div class=\"card-box\">\n\n                        <p class=\"item-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDate\" data-app-selector=\".item-date\">\n                            October 3–4, 2030\n                        </p>\n\n                        <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n\n                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">\n                            Endurance Weekend Festival\n                        </h4>\n\n                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                            Two days of endurance, energy, and community.\n                        </p>\n\n                    </div>\n\n                    <div class=\"item-content\">\n\n                        <div class=\"text-wrapper\">\n                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text, .text-wrapper\">\n                                Join a full weekend of activities including long-distance runs, group workouts, and\n                                recovery sessions. Enjoy music, food, and interactive brand experiences while connecting\n                                with a community driven by performance and progress.\n                            </p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n\n                            <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                read more\n                            </a>\n\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_anchor": "features02-2x",
          "_cid": "vuiOij0EVZ",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "slider02",
          "_sourceTheme": "fluxm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider02 mbr-embla fluxm5\" group=\"Gallery & Slider\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"color\" title=\"Marker Color\" value=\"#d63614\" name=\"marker\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Label BG\" value=\"#21242b\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" title=\"Shadow\" name=\"shadow\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" name=\"arrowsColor\" title=\"Arrows Color\" value=\"#ffffff\" condition=\"arrows\">\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"32\" step=\"4\" value=\"32\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"BG\" value=\"#21242b\" name=\"cardBg\" selected>\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#21242b\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/fluxm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#080a10\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/fluxm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#080a10\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row content-wrapper\">\n            <div class=\"border-wrap border_1\"></div>\n            <div class=\"border-wrap border_2\"></div>\n            <div class=\"border-wrap border_3\"></div>\n            <div class=\"border-wrap border_4\"></div>\n            <div class=\"border-wrap border_5\"></div>\n            <div class=\"col-12 content\">\n                <div class=\"row content-wrap\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"col-12 col-lg-3 card\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap btn-radius\">\n                                <div class=\"marker-wrap\"></div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    SELECT ACCESS INDEX</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-lg-6 card\">\n                        <div class=\"title-wrapper\" mbr-if=\"showTitle || showSubtitle\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>ON</b></h2>\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\"><b>THE RADAR</b></h3>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-lg-3 card\"></div>\n                    <div class=\"col-12 card\">\n                        <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                            <div class=\"embla__viewport\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n                                <div class=\"embla__container\">\n                                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"frame-wrapper\">\n                                                    <div class=\"cross-section cross_1\"></div>\n                                                    <div class=\"frame-wrap\"></div>\n                                                    <div class=\"cross-section cross_2\"></div>\n                                                </div>\n                                                <div class=\"card-box\">\n                                                    <div class=\"item-content\">\n                                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                            Clean Visual Structure\n                                                        </h4>\n                                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\">\n                                                            Organized layouts and modern typography create a\n                                                            professional presentation.\n                                                        </p>\n                                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                            <a class=\"btn btn-white\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                                <span class=\"mobi-mbri mobi-mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>\n                                                                VIEW MORE\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"item-img\">\n                                                        <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20sep2042020262005-18-3520pm-824x824.png\" alt=\"Mobirise Website Builder\">\n                                                    </div>\n                                                </div>\n                                                <div class=\"frame-wrapper frame_2\">\n                                                    <div class=\"frame-wrap\"></div>\n                                                    <div class=\"cross-section cross_3\"></div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"frame-wrapper\">\n                                                    <div class=\"cross-section cross_1\"></div>\n                                                    <div class=\"frame-wrap\"></div>\n                                                    <div class=\"cross-section cross_2\"></div>\n                                                </div>\n                                                <div class=\"card-box\">\n                                                    <div class=\"item-content\">\n                                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                            Responsive Experience\n                                                        </h4>\n                                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\">\n                                                            Fully adaptive designs ensure seamless viewing across\n                                                            desktops, tablets.\n                                                        </p>\n                                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                            <a class=\"btn btn-white\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                                <span class=\"mobi-mbri mobi-mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>\n                                                                VIEW MORE\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"item-img\">\n                                                        <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20sep2042020262005-18-3520pm-824x824.png\" alt=\"Mobirise Website Builder\">\n                                                    </div>\n                                                </div>\n                                                <div class=\"frame-wrapper frame_2\">\n                                                    <div class=\"frame-wrap\"></div>\n                                                    <div class=\"cross-section cross_3\"></div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"frame-wrapper\">\n                                                    <div class=\"cross-section cross_1\"></div>\n                                                    <div class=\"frame-wrap\"></div>\n                                                    <div class=\"cross-section cross_2\"></div>\n                                                </div>\n                                                <div class=\"card-box\">\n                                                    <div class=\"item-content\">\n                                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                            Interactive Elements\n                                                        </h4>\n                                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\">\n                                                            Smooth animations and engaging transitions enhance user\n                                                            interaction.\n                                                        </p>\n                                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                            <a class=\"btn btn-white\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                                <span class=\"mobi-mbri mobi-mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>\n                                                                VIEW MORE\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"item-img\">\n                                                        <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20sep2042020262005-18-3520pm-824x824.png\" alt=\"Mobirise Website Builder\">\n                                                    </div>\n                                                </div>\n                                                <div class=\"frame-wrapper frame_2\">\n                                                    <div class=\"frame-wrap\"></div>\n                                                    <div class=\"cross-section cross_3\"></div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"frame-wrapper\">\n                                                    <div class=\"cross-section cross_1\"></div>\n                                                    <div class=\"frame-wrap\"></div>\n                                                    <div class=\"cross-section cross_2\"></div>\n                                                </div>\n                                                <div class=\"card-box\">\n                                                    <div class=\"item-content\">\n                                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                            Personal Brand Identity\n                                                        </h4>\n                                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\">\n                                                            Custom styling and cohesive visuals help communicate your\n                                                            unique creative direction.\n                                                        </p>\n                                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                            <a class=\"btn btn-white\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                                <span class=\"mobi-mbri mobi-mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>\n                                                                VIEW MORE\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"item-img\">\n                                                        <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20sep2042020262005-18-3520pm-824x824.png\" alt=\"Mobirise Website Builder\">\n                                                    </div>\n                                                </div>\n                                                <div class=\"frame-wrapper frame_2\">\n                                                    <div class=\"frame-wrap\"></div>\n                                                    <div class=\"cross-section cross_3\"></div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'px', 'margin-right': gap + 'px'}\">\n                                        <div class=\"slide-content\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"frame-wrapper\">\n                                                    <div class=\"cross-section cross_1\"></div>\n                                                    <div class=\"frame-wrap\"></div>\n                                                    <div class=\"cross-section cross_2\"></div>\n                                                </div>\n                                                <div class=\"card-box\">\n                                                    <div class=\"item-content\">\n                                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                                                            Fast Performance\n                                                        </h4>\n                                                        <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text, .mbr-section-btn\">\n                                                            Optimized structure and lightweight design improve loading\n                                                            speed.\n                                                        </p>\n                                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                            <a class=\"btn btn-white\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                                <span class=\"mobi-mbri mobi-mbri-plus mbr-iconfont mbr-iconfont-btn\"></span>\n                                                                VIEW MORE\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"item-img\">\n                                                        <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20sep2042020262005-18-3520pm-824x824.png\" alt=\"Mobirise Website Builder\">\n                                                    </div>\n                                                </div>\n                                                <div class=\"frame-wrapper frame_2\">\n                                                    <div class=\"frame-wrap\"></div>\n                                                    <div class=\"cross-section cross_3\"></div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <button class=\"embla__button embla__button--prev\">\n                                <span class=\"mobi-mbri mobi-mbri-left mbr-iconfont\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden visually-hidden visually-hidden visually-hidden visually-hidden visually-hidden visually-hidden\">Previous</span>\n                            </button>\n                            <button class=\"embla__button embla__button--next\">\n                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden visually-hidden visually-hidden visually-hidden visually-hidden visually-hidden visually-hidden\">Next</span>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@showBorder)": {
              "overflow": "hidden"
            },
            ".content-wrapper": {
              "position": "relative",
              "margin": "0",
              ".content": {
                "padding": "0"
              },
              "& when (@showBorder)": {
                ".border-wrap": {
                  "position": "absolute",
                  "height": "1000%",
                  "width": "1px",
                  "border-left": "1px solid @border",
                  "pointer-events": "none",
                  "padding": "0",
                  "top": "-500%"
                },
                ".border_1": {
                  "left": "0"
                },
                ".border_2": {
                  "left": "25%",
                  "@media (max-width: 992px)": {
                    "display": "none"
                  }
                },
                ".border_3": {
                  "left": "50%"
                },
                ".border_4": {
                  "left": "75%",
                  "@media (max-width: 992px)": {
                    "display": "none"
                  }
                },
                ".border_5": {
                  "left": "100%"
                }
              }
            },
            ".content-wrap": {
              "position": "relative",
              "z-index": "1",
              "margin": "0",
              ".card": {
                "padding": "0"
              }
            },
            ".label-wrapper": {
              "margin-bottom": "20px",
              ".label-wrap": {
                "display": "inline-flex",
                "gap": "12px",
                "align-items": "center",
                "background-color": "@labelBg",
                "padding": "7px 14px 6px",
                ".marker-wrap": {
                  "width": "10px",
                  "height": "10px",
                  "min-width": "10px",
                  "border-radius": "100%",
                  "background-color": "@marker"
                },
                ".mbr-label": {
                  "margin-bottom": "0"
                }
              }
            },
            ".title-wrapper": {
              "margin-bottom": "80px",
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "0"
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "460px",
              "max-width": "460px",
              "@media (max-width: 768px)": {
                "min-width": "100%",
                "max-width": "100%",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "height": "100%",
                  "display": "flex",
                  "flex-direction": "column",
                  ".frame-wrapper": {
                    "display": "flex",
                    "margin-bottom": "-1px",
                    "will-change": "transform",
                    "position": "relative",
                    "z-index": "1",
                    ".cross-section": {
                      "width": "24px",
                      "height": "24px"
                    },
                    ".cross_1": {
                      "background-image": "linear-gradient(135deg, transparent 45%, @cardBg 45%)"
                    },
                    ".cross_2": {
                      "background-image": "linear-gradient(225deg, transparent 45%, @cardBg 45%)"
                    },
                    ".cross_3": {
                      "background-image": "linear-gradient(315deg, transparent 45%, @cardBg 45%)"
                    },
                    ".frame-wrap": {
                      "width": "100%",
                      "background-color": "@cardBg",
                      "margin": "0 -1px"
                    }
                  },
                  ".frame_2": {
                    "margin-top": "-1px",
                    "margin-bottom": "0",
                    ".frame-wrap": {
                      "margin": "0 -1px 0 0"
                    }
                  },
                  ".card-box": {
                    "position": "relative",
                    "z-index": "1",
                    "padding": "1px 24px",
                    "background-color": "@cardBg",
                    "height": "100%",
                    "display": "flex",
                    "flex-direction": "column",
                    "justify-content": "space-between",
                    "will-change": "transform",
                    ".item-content": {
                      ".item-title": {
                        "margin-bottom": "8px"
                      },
                      ".item-text": {
                        "margin-bottom": "0"
                      },
                      ".mbr-section-btn": {
                        "margin-top": "10px",
                        "margin-bottom": "-9.6px",
                        "width": "100%",
                        ".btn": {
                          "width": "100%"
                        }
                      }
                    },
                    ".item-img": {
                      "margin-top": "32px",
                      "img": {
                        "height": "326px",
                        "width": "100%",
                        "object-fit": "cover",
                        "clip-path": "polygon(24px 0, 100% 0, 100% 100%, 100% 100%, 0 100%, 0 24px)",
                        "@media (max-width: 992px)": {
                          "height": "300px"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "20px",
              "height": "20px",
              "font-size": "20px",
              "background-color": "transparent !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "border-radius": "100% !important",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": ".5 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&:disabled": {
                "opacity": ".2 !important"
              },
              "&.embla__button--prev": {
                "right": "34px"
              },
              "&.embla__button--next": {
                "right": "0"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "display": "flex",
              "justify-content": "center",
              "& when (@arrows)": {
                "padding-bottom": "3rem !important"
              }
            },
            ".embla__viewport": {
              "position": "relative",
              "overflow": "hidden",
              "width": "100%",
              "padding": "0",
              "@media (max-width: 768px)": {
                "padding": "0"
              },
              "& when (@shadow)": {
                "mask-image": "linear-gradient(to right, transparent 0%, #000000 12.5%, #000000 87.5%, transparent 100%)",
                "-webkit-mask-image": "linear-gradient(to right, transparent 0%, #000000 12.5%, #000000 87.5%, transparent 100%)",
                "@media (max-width: 768px)": {
                  "mask-image": "none",
                  "-webkit-mask-image": "none"
                }
              }
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".mbr-label": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-section-subtitle": {
              "color": "#9e9e9e"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-text": {
              "color": "#9e9e9e"
            }
          },
          "_cid": "vuhQQx6o4C",
