          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "<section aria-labelledby=\"n3-fmwd-title\">\n  <div class=\"n3-fmwd\">\n    <svg class=\"fmwd-defs\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" focusable=\"false\">\n      <defs>\n        <symbol id=\"n3-fmwd-spiral\" viewBox=\"0 0 210 210\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\".62\">\n            <path d=\"M0 170A130 130 0 0 1 130 40A80 80 0 0 1 210 120A50 50 0 0 1 160 170A30 30 0 0 1 130 140A20 20 0 0 1 150 120A10 10 0 0 1 160 130A10 10 0 0 1 150 140\"></path>\n            <circle cx=\"106\" cy=\"106\" r=\"79\" stroke-dasharray=\"7 4 1 4\"></circle>\n            <circle cx=\"106\" cy=\"106\" r=\"58\" opacity=\".6\"></circle>\n            <circle cx=\"106\" cy=\"106\" r=\"24\" stroke-dasharray=\"3 3\"></circle>\n            <path d=\"M0 106h210M106 0v210M8 45h159v159M106 106h61v98M8 106v98h159\" opacity=\".58\"></path>\n            <path d=\"M102 106h8m-4-4v8M162 143h9m-4.5-4.5v9M102 45h8m-4-4v8\"></path>\n            <path d=\"M6 104h4v4H6zm98 98h4v4h-4zm61-61h4v4h-4z\"></path>\n          </g>\n        </symbol>\n        <pattern id=\"n3-fmwd-hatch\" width=\"11\" height=\"11\" patternUnits=\"userSpaceOnUse\">\n          <path d=\"m-3 3 6-6m-3 14L11 0m-3 14 6-6\" stroke=\"#a6a39e\" stroke-width=\".65\"></path>\n        </pattern>\n        <symbol id=\"n3-fmwd-notes\" viewBox=\"0 0 48 48\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"5\" y=\"7\" width=\"38\" height=\"36\" rx=\"3\"></rect><path d=\"M14 4v7m20-7v7M18 19h17m-17 8h17m-17 8h17M12 19h.5m-.5 8h.5m-.5 8h.5\"></path>\n          </g>\n        </symbol>\n        <symbol id=\"n3-fmwd-code\" viewBox=\"0 0 48 48\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M10 3h17l13 13v26a3 3 0 0 1-3 3H10a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Z\"></path><path d=\"M27 3v13h13M18 23l-5 5 5 5m11-10 5 5-5 5m-4-12-4 14\"></path>\n          </g>\n        </symbol>\n        <symbol id=\"n3-fmwd-recap\" viewBox=\"0 0 48 48\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"6\" y=\"12\" width=\"30\" height=\"29\" rx=\"3\"></rect><path d=\"M13 12V8a3 3 0 0 1 3-3h25a3 3 0 0 1 3 3v27a3 3 0 0 1-3 3h-5M16 21h13m-13 6h13m-13 6h13m-17-12h.5m-.5 6h.5m-.5 6h.5\"></path>\n          </g>\n        </symbol>\n        <symbol id=\"n3-fmwd-layers\" viewBox=\"0 0 48 48\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"m3 15 21-11 21 11-21 11L3 15Zm7 6-7 4 21 11 21-11-7-4M10 31l-7 4 21 11 21-11-7-4\"></path>\n          </g>\n        </symbol>\n        <symbol id=\"n3-fmwd-message\" viewBox=\"0 0 48 48\">\n          <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M10 5h28a6 6 0 0 1 6 6v19a6 6 0 0 1-6 6H17L5 44V11a6 6 0 0 1 5-6Z\"></path>\n            <circle cx=\"15\" cy=\"20\" r=\"1.4\"></circle><circle cx=\"24\" cy=\"20\" r=\"1.4\"></circle><circle cx=\"33\" cy=\"20\" r=\"1.4\"></circle>\n          </g>\n        </symbol>\n      </defs>\n    </svg>\n    <div class=\"fmwd-drafting\" aria-hidden=\"true\">\n      <svg class=\"fmwd-traces\" viewBox=\"0 0 1024 1536\" preserveAspectRatio=\"none\" focusable=\"false\">\n        <g fill=\"none\" stroke=\"currentColor\" stroke-width=\".68\" vector-effect=\"non-scaling-stroke\">\n          <path d=\"M0 119h1024M0 615h1024M0 872h1024M0 1204h1024M0 1452h1024M46 0v1536m918-1536v1536M0 238h488v-102h66v77h112m-170-94v137m-125-152h125m302-14h168M0 582h700v-78h191M0 904h237v-31h449m-54-57v86m242 15v166m-156-39h306m-817 326h619m-302-113v158\"></path>\n          <path d=\"M0 238h16v220m356-354h74m-43 135 93-103m60 80h42m43-158 91-38h110v139m-45-65h166m-531 487h265m-65 67h102l80-80m-46 58h106m-138 291h139v60m-207-60h112m-336 327 72-53h153m-443 181h88m369-49h138m-212 181h311\" stroke-dasharray=\"9 4 2 4\"></path>\n          <path d=\"M13 235h7v7h-7zm356-134h7v7h-7zm124 15h7v7h-7zm57 93h7v7h-7zm287-193h8v8h-8zm-141 561h8v8h-8zm-67 67h8v8h-8zm-426 223h8v8h-8zm586 47h7v7h-7zm81-1h7v7h-7zm-234 586h8v8h-8z\" fill=\"#151515\"></path>\n          <path d=\"M891 644h133v83H891zM125 989h122v62H125zM920 1120h104v59H920z\" fill=\"url(#n3-fmwd-hatch)\" opacity=\".58\" stroke=\"none\"></path>\n        </g>\n      </svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--top-left\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--top-right\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--center\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--middle-left\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--middle-right\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--bottom-left\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n      <svg class=\"fmwd-spiral fmwd-spiral--bottom-right\" viewBox=\"0 0 210 210\" focusable=\"false\"><use href=\"#n3-fmwd-spiral\"></use></svg>\n    </div>\n\n    <div class=\"fmwd-top\">\n      <div class=\"fmwd-fold\" aria-hidden=\"true\"></div>\n      <div class=\"fmwd-hero fmwd-wrap\">\n        <div>\n          <p class=\"fmwd-kicker\">Custom AI Prompt Service</p>\n            <h1 class=\"fmwd-title\" id=\"n3-fmwd-title\">From My <span>Wildest Dreams</span></h1>\n          <p class=\"fmwd-lede\">Bring one task you do often, or a specific task that needs extra focus. I write a reusable AI prompt for it, then in one recorded 90-minute video session we paste it into your own Claude Project, Google Gem, or ChatGPT plugin and get it working on your real material.</p>\n            <p><a class=\"fmwd-cta\" href=\"https://docs.google.com/forms/d/e/1FAIpQLSeHDQQb4q4fmVC_eg4_b4X6cjwPmIw_ViTqfpTr_8GJ4Gj2tw/viewform\">Start Your Project</a></p>\n          <p class=\"fmwd-cta-note\">By answering questions within a short project brief.</p>\n        </div>\n        <figure class=\"fmwd-example\">\n          <figcaption>Example Workflow</figcaption>\n          <ol role=\"list\">\n            <li><svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-notes\"></use></svg>Rough job notes</li>\n            <li><svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-code\"></use></svg>Custom AI prompt</li>\n            <li><svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-recap\"></use></svg>Client-ready recap</li>\n          </ol>\n        </figure>\n      </div>\n    </div>\n\n    <div class=\"fmwd-content-section\">\n      <div class=\"fmwd-wrap\">\n        <h2 class=\"fmwd-section-title\">How it works</h2>\n        <ol class=\"fmwd-columns fmwd-steps\" role=\"list\">\n          <li>\n            <h3 class=\"fmwd-item-title fmwd-step-title\"><span class=\"fmwd-step-number\" aria-hidden=\"true\">01</span>Send the task</h3>\n            <p class=\"fmwd-item-text\">Share the task, detailed examples, and what a good result looks like.</p>\n          </li>\n          <li>\n            <h3 class=\"fmwd-item-title fmwd-step-title\"><span class=\"fmwd-step-number\" aria-hidden=\"true\">02</span>Pay the fee</h3>\n            <p class=\"fmwd-item-text\">The fee is paid before the full questions. An unpaid project closes after three days.</p>\n          </li>\n          <li>\n            <h3 class=\"fmwd-item-title fmwd-step-title\"><span class=\"fmwd-step-number\" aria-hidden=\"true\">03</span>Answer brief</h3>\n            <p class=\"fmwd-item-text\">About ten minutes: the task, the rules it must follow, and examples of your work.</p>\n          </li>\n        </ol>\n      </div>\n    </div>\n\n <div class=\"fmwd-content-section\">\n      <div class=\"fmwd-wrap\">\n       <ol class=\"fmwd-columns fmwd-steps\" role=\"list\">\n          <li>\n<h3 class=\"fmwd-item-title fmwd-step-title\"><span class=\"fmwd-step-number\" aria-hidden=\"true\">04</span>I check the brief</h3>\n            <p class=\"fmwd-item-text\">Within one business day I confirm the task is one prompt's worth of work. If it is wider than that, the fee moves to another task as credit.</p>\n          </li>\n          <li>\n            <h3 class=\"fmwd-item-title fmwd-step-title\"><span class=\"fmwd-step-number\" aria-hidden=\"true\">05</span>Book session</h3>\n            <p class=\"fmwd-item-text\">Tuesday to Friday, 9:30 am, 12:00 pm, or 2:30 pm Eastern, at least three business days after you send the project form. 90-minutes, recorded, one to one.</p>\n          </li>\n          <li>\n            <h3 class=\"fmwd-item-title fmwd-step-title\"><span class=\"fmwd-step-number\" aria-hidden=\"true\">06</span>Build it together</h3>\n            <p class=\"fmwd-item-text\">I write and test the prompt before we meet. In the session we paste it into your own Claude Project, Google Gem, or ChatGPT plugin and fix what does not fit.</p>\n          </li>\n        </ol>\n      </div>\n    </div>\n\n    <div class=\"fmwd-content-section\">\n      <div class=\"fmwd-wrap\">\n        <h2 class=\"fmwd-section-title\">What you’ll take home</h2>\n        <div class=\"fmwd-columns\">\n          <div class=\"fmwd-card\">\n            <svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-code\"></use></svg>\n            <h3 class=\"fmwd-item-title\">Your custom prompt</h3>\n            <p class=\"fmwd-item-text\">An editable prompt for your one task.</p>\n          </div>\n          <div class=\"fmwd-card\">\n            <svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-layers\"></use></svg>\n            <h3 class=\"fmwd-item-title\">Prompt Workbench</h3>\n            <p class=\"fmwd-item-text\">A worked example, reusable templates, and a test checklist.</p>\n          </div>\n          <div class=\"fmwd-card\">\n            <svg class=\"fmwd-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#n3-fmwd-message\"></use></svg>\n            <h3 class=\"fmwd-item-title\">One Second Look</h3>\n            <p class=\"fmwd-item-text\">Send me a prompt you write within 30 days for written feedback.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"fmwd-price-section\">\n      <div class=\"fmwd-fold fmwd-fold--bottom\" aria-hidden=\"true\"></div>\n      <div class=\"fmwd-wrap fmwd-price\">\n        <div class=\"fmwd-price-left\">\n          <h2 class=\"fmwd-kicker\">Founding Client Offer</h2>\n          <strong class=\"fmwd-price-amount\">$450</strong>\n          <p class=\"fmwd-item-text\">One-time. Founding-client price $350 for the first three clients, applied automatically at checkout.</p><br>\n          <p class=\"fmwd-item-menu\">The fee is paid before your project brief submissions. If your task turns out to be wider than one prompt, the whole fee becomes credit toward a different task.</p>\n        </div>\n        <div class=\"fmwd-price-right\">\n          <p class=\"fmwd-price-title\">One task. One private session.<br>Tools you can keep.</p>\n          <p class=\"fmwd-item-text\">I check your brief within one business day of your answers. That check is what confirms the task is one prompt's worth of work, and your booking link arrives after it.</p>\n          <a class=\"fmwd-cta\" href=\"https://docs.google.com/forms/d/e/1FAIpQLSeHDQQb4q4fmVC_eg4_b4X6cjwPmIw_ViTqfpTr_8GJ4Gj2tw/viewform\">Start Your Project</a><br><br>\n<p>Start with the short form. It asks for your contact details, one sentence about the task, and your agreement to the terms. It costs nothing and takes about a minute, and the payment link follows by email.</p>\n        </div>\n      </div>\n      </div>\n  </div>\n</section>\n",
          "_customCSS": "",
          "alias": "code-editor",
          "_tags": [
            "Extension"
          ],
          "_name": "pro.custom-html",
          "_sourceTheme": "fabm5",
          "_anchor": "custom-html-5c",
          "_PHPplaceholders": [],
          "_JSplaceholders": []
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <a href=\"https://neutral3rd.space\"><img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-1-512x512.png\" alt=\"Neutral3rd Emerging Tech Development Studio\"></a>\n                            </div>\n\n                           <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <!-- <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">xx</p>\n                    </div> -->\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                       <!-- <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3> -->\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\"><b>Neutral3rd</b> helps small businesses and independent professionals put AI to work within real human work. Led by Renée Leach and supported by an army of customized AI assistants, co-pilots, and agents, this studio brings strategy, development, workflows, and AI-powered media together with a \"human STILL in-the-loop\" to make work more capable without making it more complicated.<br></p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/privacy\" class=\"text-info\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/terms\" class=\"text-info\">TERMS OF SERVICE</a></b></li><a href=\"https://neutral3rd.space/terms\" class=\"text-primary\">\n                                </a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/accessibility\" class=\"text-info\">ACCESSIBILITY</a></b></li><li class=\"item-wrap\"><b><a href=\"https://connections.neutral3rd.space/wall\" class=\"text-info\" target=\"_blank\">LEAVE YOUR FEEDBACK</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://offerbeacon.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">HELP THE RIGHT BUYERS FIND YOU</a></b></li>\n<li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/custom-task-prompt\" class=\"text-info text-primary\">FROM MY WILDEST DREAMS</a></b></li><li class=\"item-wrap\"><b><a href=\"https://perspectives.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">NEUTRAL3RD PERSPECTIVES</a></b></li><a href=\"https://neutral3rd.space\" class=\"text-primary\">\n</a><li class=\"item-wrap\"><b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-info\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Tech Development Studio. Operated by U.S.-based business entity, Rowdy Independents LLC. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vAkxbStNJy",
          "_anchor": "footer01-5b",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "fast-good-cheap.html": {
      "settings": {
        "title": "Fast, Good & Cheap - One-Off Specialist Services | Neutral3rd Emerging Tech Development Studio",
        "meta_descr": "Choose one-off curriculum, presentation, product copy and video script services from Neutral3rd. Compare priority, standard and streamlined packages.",
        "header_custom": "<meta name=\"robots\" content=\"noindex, nofollow\">\n\n\n<!-- Neutral3rd Fast. Good. Cheap. page styles.\n     Paste into Page Settings > Code Editor > Inside <head>.\n     Leave the block CSS tab empty: Mobirise saves only part of it.\n-->\n<style>\n/* ============================================================\n   Neutral3rd - Fast. Good. Cheap.\n   Scoped styles for the #n3-fgc block, written in Mobirise's own\n   conventions: mbr-section, container, the Bootstrap row and column\n   grid, mbr-section-title, mbr-section-subtitle, mbr-fonts-style,\n   btn and form-control.\n   Paste into the site CSS, replacing the old #n3-fgc block, including the\n   rules the old block scoped as #custom-html-5e #n3-fgc.\n   Every rule starts with #n3-fgc, so nothing here can reach the rest\n   of the Mobirise site. The panel compiles through Less, so this file\n   avoids calc() arithmetic on CSS variables; values are written out.\n   ============================================================ */\n\n#n3-fgc {\n  --n3-bg: #202426;\n  --n3-panel: #292e31;\n  --n3-line: #485055;\n  --n3-orange: #c75423;\n  --n3-white: #f8f8f6;\n  --n3-muted: #c3c8ca;\n  background:\n    radial-gradient(ellipse at 85% 4%, rgba(199, 84, 35, 0.17), transparent 38%),\n    repeating-linear-gradient(120deg, transparent 0 80px, rgba(255, 255, 255, 0.018) 81px 82px),\n    var(--n3-bg);\n  color: var(--n3-white);\n  padding: 80px 0;\n  font-family: Arial, Helvetica, sans-serif;\n  line-height: 1.55;\n  isolation: isolate;\n}\n\n#n3-fgc * { box-sizing: border-box; }\n\n/* One content measure at every breakpoint, on the Mobirise container. */\n#n3-fgc .container {\n  width: 100%;\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 20px;\n}\n\n/* The theme's type scale and button spacing are neutralised inside the\n   block so the approved design keeps its own type and rhythm. */\n#n3-fgc .mbr-fonts-style { font-family: inherit; }\n#n3-fgc .mbr-section-btn { margin: 0; font-size: inherit; }\n#n3-fgc .btn { margin: 0; }\n\n/* The site forces square, light buttons inside .mbr-section-btn. */\n#n3-fgc .mbr-section-btn .btn {\n  border-radius: 5px !important;\n  font-weight: 700 !important;\n}\n#n3-fgc .mbr-section-btn .btn:hover,\n#n3-fgc .mbr-section-btn .btn:focus { transform: none; }\n\n/* The site CSS forces pill inputs and a monospace face on .form-control\n   with !important, so the block restores its own input shape. */\n#n3-fgc .form-control {\n  height: auto;\n  line-height: inherit;\n  border-radius: 5px !important;\n}\n#n3-fgc textarea.form-control { line-height: inherit !important; }\n#n3-fgc .form-control:hover,\n#n3-fgc .form-control:focus {\n  border-color: #b8bfc2 !important;\n  box-shadow: none;\n}\n\n/* ------------------------------------------------ typography --- */\n\n#n3-fgc .n3-eyebrow {\n  color: #ee9b73;\n  letter-spacing: .19em;\n  font-weight: 700;\n  font-size: 12px;\n  line-height: inherit;\n  text-transform: uppercase;\n}\n\n#n3-fgc h1 {\n  font-size: clamp(44px, 7vw, 90px);\n  line-height: 1.04;\n  letter-spacing: -0.05em;\n  margin: 12px 0;\n}\n\n#n3-fgc h2 {\n  font-size: clamp(26px, 4vw, 42px);\n  line-height: 1.15;\n  margin: 0 0 12px;\n}\n\n#n3-fgc h3 {\n  font-size: 21px;\n  line-height: 1.25;\n  margin: 0 0 12px;\n}\n\n#n3-fgc p { margin: 0 0 15px; }\n\n#n3-fgc .n3-accent { color: #e37e4d; }\n\n#n3-fgc .n3-muted { color: var(--n3-muted); }\n\n#n3-fgc .n3-muted a,\n#n3-fgc .n3-legal a {\n  color: #ffb28e;\n  text-decoration: underline;\n}\n\n#n3-fgc .n3-intro {\n  font-size: 19px;\n  max-width: 740px;\n  color: var(--n3-muted);\n}\n\n/* ------------------------------------------------------ hero --- */\n\n#n3-fgc .n3-hero {\n  padding: 20px 0 55px;\n  border-bottom: 1px solid var(--n3-line);\n  position: relative;\n}\n\n#n3-fgc .n3-hero:after {\n  content: '';\n  position: absolute;\n  right: 1%;\n  top: 3%;\n  width: 240px;\n  height: 240px;\n  border: 1px solid rgba(199, 84, 35, 0.28);\n  border-radius: 50%;\n  box-shadow: 0 0 0 28px rgba(199, 84, 35, 0.035), 0 0 0 70px rgba(199, 84, 35, 0.025);\n  pointer-events: none;\n}\n\n#n3-fgc .n3-hero > * { position: relative; z-index: 1; }\n\n#n3-fgc .n3-pills {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 9px;\n  margin: 26px 0;\n}\n\n#n3-fgc .n3-pill {\n  border: 1px solid #6c7376;\n  padding: 8px 12px;\n  border-radius: 40px;\n  font-size: 13px;\n  color: #e8e9e9;\n}\n\n/* --------------------------------------------------- buttons --- */\n\n#n3-fgc .n3-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 44px;\n  background: var(--n3-orange);\n  color: #fff !important;\n  border: 1px solid var(--n3-orange);\n  border-radius: 5px;\n  padding: 11px 18px;\n  text-decoration: none;\n  cursor: pointer;\n  font: inherit;\n  font-weight: 700;\n}\n\n#n3-fgc .n3-btn:hover,\n#n3-fgc .n3-btn:focus-visible { background: #e16a35; }\n\n#n3-fgc .n3-btn[disabled] { opacity: .6; cursor: default; }\n\n#n3-fgc .n3-btn-outline {\n  background: transparent;\n  border-color: #9b9fa1;\n}\n\n/* -------------------------------------------------- sections --- */\n\n#n3-fgc .n3-section { padding: 48px 0 0; }\n\n#n3-fgc #n3-fgc-how,\n#n3-fgc #n3-fgc-catalog,\n#n3-fgc #n3-fgc-request { scroll-margin-top: 96px; }\n\n/* ------------------------------- Mobirise row and column grid --- */\n\n/* Mobirise compiles this panel with Less, which fails on calc() arithmetic\n   applied to a CSS variable. Each gutter is written out as a plain value. */\n\n#n3-fgc .row {\n  margin-left: -9px;\n  margin-right: -9px;\n  margin-bottom: -18px;\n}\n\n#n3-fgc .row > [class*=\"col-\"] {\n  min-width: 0;\n  padding-left: 9px;\n  padding-right: 9px;\n  margin-bottom: 18px;\n}\n\n#n3-fgc .row.n3-principles {\n  margin-top: 24px;\n  margin-left: -7.5px;\n  margin-right: -7.5px;\n  margin-bottom: -15px;\n}\n\n#n3-fgc .row.n3-principles > [class*=\"col-\"] {\n  padding-left: 7.5px;\n  padding-right: 7.5px;\n  margin-bottom: 15px;\n}\n\n#n3-fgc .row.n3-form-grid {\n  align-items: flex-start;\n  margin-left: -7.5px;\n  margin-right: -7.5px;\n  margin-bottom: -15px;\n}\n\n#n3-fgc .row.n3-form-grid > [class*=\"col-\"] {\n  padding-left: 7.5px;\n  padding-right: 7.5px;\n  margin-bottom: 15px;\n}\n\n#n3-fgc .row.n3-tiers {\n  margin-top: 4px;\n  margin-left: -4px;\n  margin-right: -4px;\n  margin-bottom: -8px;\n}\n\n#n3-fgc .row.n3-tiers > [class*=\"col-\"] {\n  padding-left: 4px;\n  padding-right: 4px;\n  margin-bottom: 8px;\n}\n\n/* ----------------------------------------------- principles --- */\n\n#n3-fgc .n3-principle {\n  height: 100%;\n  background: rgba(255, 255, 255, 0.035);\n  border: 1px solid var(--n3-line);\n  padding: 22px;\n  border-radius: 10px;\n}\n\n#n3-fgc .n3-principle strong {\n  display: block;\n  font-size: 18px;\n  margin-bottom: 6px;\n}\n\n#n3-fgc .n3-principle p {\n  font-size: 14px;\n  line-height: 1.7;\n  margin: 0;\n}\n\n#n3-fgc .n3-principle p b { color: #f9f9f7; }\n\n#n3-fgc .n3-tradeoff {\n  display: inline-block;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: .13em;\n  color: #ffae87;\n  margin: 0 0 12px;\n  border-bottom: 1px solid rgba(255, 174, 135, 0.5);\n  padding-bottom: 5px;\n}\n\n/* --------------------------------------------------- catalog --- */\n\n#n3-fgc .n3-toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  align-items: center;\n  margin: 24px 0;\n}\n\n#n3-fgc input,\n#n3-fgc select,\n#n3-fgc textarea {\n  background: #fff;\n  color: #202426;\n  border: 1px solid #b8bfc2;\n  border-radius: 5px;\n  padding: 12px;\n  font: inherit;\n  max-width: 100%;\n}\n\n#n3-fgc input::placeholder,\n#n3-fgc textarea::placeholder {\n  color: #596266;\n  opacity: 1;\n}\n\n#n3-fgc .n3-toolbar input { flex: 2 1 230px; }\n#n3-fgc .n3-toolbar select { flex: 1 1 220px; }\n\n#n3-fgc .n3-count { color: var(--n3-muted); font-size: 13px; }\n\n#n3-fgc .n3-card {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  background: var(--n3-panel);\n  border: 1px solid var(--n3-line);\n  border-radius: 12px;\n  padding: 23px;\n  min-width: 0;\n}\n\n#n3-fgc .n3-card[hidden] { display: none !important; }\n\n#n3-fgc .n3-tag {\n  color: #ed9a73;\n  font-size: 11px;\n  letter-spacing: .1em;\n  text-transform: uppercase;\n  font-weight: 700;\n  margin-bottom: 14px;\n}\n\n#n3-fgc .n3-card p { color: var(--n3-muted); font-size: 14px; }\n\n#n3-fgc .n3-deliverable {\n  font-size: 13px;\n  padding: 13px 0;\n  border-top: 1px solid var(--n3-line);\n  border-bottom: 1px solid var(--n3-line);\n  margin: 7px 0 17px;\n}\n\n#n3-fgc .n3-deliverable b { color: #fff; }\n\n#n3-fgc .n3-choices {\n  display: grid;\n  gap: 8px;\n  margin-top: auto;\n}\n\n#n3-fgc .n3-choice {\n  width: 100%;\n  text-align: left;\n  border: 1px solid #62696d;\n  border-radius: 7px;\n  background: #303639;\n  color: #fff;\n  padding: 10px 12px;\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  align-items: center;\n  font: inherit;\n  font-size: 13px;\n}\n\n#n3-fgc .n3-choice[aria-pressed=\"true\"] {\n  border-color: #ee8957;\n  background: #48352c;\n  box-shadow: inset 3px 0 0 #ee8957;\n}\n\n#n3-fgc .n3-choice span {\n  font-size: 12px;\n  font-weight: 700;\n}\n\n#n3-fgc .n3-choice strong {\n  font-size: 16px;\n  letter-spacing: -0.02em;\n  white-space: nowrap;\n}\n\n#n3-fgc .n3-detail {\n  min-height: 148px;\n  margin-top: 14px;\n  font-size: 13px;\n  color: #d6dadc;\n}\n\n#n3-fgc .n3-detail b { color: #fff; }\n\n#n3-fgc .n3-tradeoff-line {\n  color: #ffb28e;\n  font-weight: 700;\n  margin: 7px 0 9px;\n  line-height: 1.45;\n}\n\n#n3-fgc .n3-included { color: #d5d9da; line-height: 1.5; }\n\n#n3-fgc .n3-card .n3-btn {\n  width: 100%;\n  font-size: 14px;\n}\n\n#n3-fgc .n3-footnote {\n  font-size: 13px;\n  color: var(--n3-muted);\n  margin-top: 17px;\n}\n\n/* ---------------------------------------------- intake form --- */\n\n#n3-fgc .n3-intake {\n  border: 1px solid #6b5550;\n  background: linear-gradient(135deg, #2d3032, #302923);\n  border-radius: 12px;\n  padding: 28px;\n  margin-top: 30px;\n}\n\n#n3-fgc .n3-form-field {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  font-size: 14px;\n  font-weight: 400;\n  min-width: 0;\n}\n\n#n3-fgc .n3-form-field > label {\n  font-weight: 700;\n}\n\n#n3-fgc .n3-form-field input,\n#n3-fgc .n3-form-field select,\n#n3-fgc .n3-form-field textarea {\n  width: 100%;\n  font-weight: 400;\n}\n\n#n3-fgc .n3-hint {\n  font-weight: 400;\n  font-size: 12px;\n  color: var(--n3-muted);\n}\n\n#n3-fgc .n3-form-details textarea {\n  min-height: 175px;\n  resize: vertical;\n}\n\n#n3-fgc .n3-tier-group {\n  border: 0;\n  padding: 0;\n  margin: 0;\n  min-width: 0;\n}\n\n#n3-fgc .n3-tier-group legend {\n  font-size: 14px;\n  font-weight: 700;\n  padding: 0;\n  margin-bottom: 5px;\n}\n\n#n3-fgc .n3-tier-group .n3-hint {\n  margin: 0 0 8px;\n}\n\n#n3-fgc .n3-radio {\n  position: relative;\n  display: block;\n  cursor: pointer;\n}\n\n#n3-fgc .n3-radio input {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  opacity: 0;\n  pointer-events: none;\n}\n\n#n3-fgc .n3-radio-body {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  gap: 4px;\n  border: 1px solid #62696d;\n  border-radius: 7px;\n  background: #303639;\n  padding: 10px 12px;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n#n3-fgc .n3-radio-body strong {\n  font-size: 16px;\n  letter-spacing: -0.02em;\n}\n\n#n3-fgc .n3-radio-note {\n  font-size: 11px;\n  font-weight: 400;\n  color: #d5d9da;\n}\n\n#n3-fgc .n3-radio input:checked + .n3-radio-body {\n  border-color: #ee8957;\n  background: #48352c;\n  box-shadow: inset 3px 0 0 #ee8957;\n}\n\n#n3-fgc .n3-radio input:focus-visible + .n3-radio-body {\n  outline: 3px solid #ffb58d;\n  outline-offset: 3px;\n}\n\n#n3-fgc .n3-form-consent {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  margin: 18px 0;\n  font-size: 13px;\n  color: #e8e9e9;\n  font-weight: 400;\n}\n\n#n3-fgc .n3-form-consent input {\n  width: 18px;\n  height: 18px;\n  flex: 0 0 18px;\n  margin-top: 2px;\n  padding: 0;\n  accent-color: var(--n3-orange);\n}\n\n#n3-fgc .n3-legal {\n  font-size: 12px;\n  color: var(--n3-muted);\n}\n\n#n3-fgc .n3-status {\n  min-height: 1.4em;\n  margin: 14px 0 0;\n  font-size: 14px;\n  color: #d6dadc;\n}\n\n#n3-fgc .n3-status[data-state=\"error\"] { color: #ffb4a2; }\n\n#n3-fgc .n3-hp {\n  position: absolute;\n  left: -9999px;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n}\n\n/* -------------------------------------------------- feedback --- */\n\n#n3-fgc :focus-visible {\n  outline: 3px solid #ffb58d;\n  outline-offset: 3px;\n}\n\n#n3-fgc [hidden] { display: none !important; }\n\n/* ------------------------------------------------- responsive --- */\n\n@media (max-width: 991px) {\n  #n3-fgc .n3-grid > [class*=\"col-\"] { flex: 0 0 50%; width: 50%; max-width: 50%; }\n  #n3-fgc .n3-principles > [class*=\"col-\"],\n  #n3-fgc .n3-form-grid > [class*=\"col-\"]:not(.n3-form-wide),\n  #n3-fgc .n3-tiers > [class*=\"col-\"] { flex: 0 0 33.333333%; width: 33.333333%; max-width: 33.333333%; }\n}\n\n/* The design keeps three cards across until 960, where Bootstrap's own\n   column breakpoint would already have dropped to one. */\n@media (min-width: 961px) and (max-width: 991px) {\n  #n3-fgc .n3-grid > [class*=\"col-\"] { flex: 0 0 33.333333%; width: 33.333333%; max-width: 33.333333%; }\n}\n\n@media (max-width: 700px) {\n  #n3-fgc .n3-form-grid > [class*=\"col-\"]:not(.n3-form-wide),\n  #n3-fgc .n3-tiers > [class*=\"col-\"] { flex: 0 0 100%; width: 100%; max-width: 100%; }\n}\n\n@media (max-width: 640px) {\n  #n3-fgc { padding: 48px 0; }\n  #n3-fgc .container { padding: 0 16px; }\n  #n3-fgc .n3-grid > [class*=\"col-\"],\n  #n3-fgc .n3-principles > [class*=\"col-\"] { flex: 0 0 100%; width: 100%; max-width: 100%; }\n  #n3-fgc .n3-hero:after { opacity: .3; width: 150px; height: 150px; }\n  #n3-fgc .n3-intake { padding: 19px; }\n  #n3-fgc .n3-detail { min-height: 0; }\n}\n\n</style>",
        "footer_custom": "<style>\n/* Neutral3rd: Basic Image Protection */\nimg {\n  -webkit-user-drag: none;\n  user-drag: none;\n  -webkit-touch-callout: none;\n}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  // Prevent the image-specific right-click menu.\n  document.addEventListener(\"contextmenu\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n\n  // Prevent dragging images onto the desktop.\n  document.addEventListener(\"dragstart\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n})();\n</script>\n\n<!--\n  Part 2 of 2, the page script.\n-->\n<script>\n/* Neutral3rd Fast. Good. Cheap. page script.\n   The service dropdown, the category filter, the search and the tier prices\n   all read from the cards above. */\n(function () {\n  'use strict';\n\n  function init() {\n\n  var root = document.getElementById('n3-fgc');\n  if (!root || root.dataset.n3Ready === 'true') return;\n  root.dataset.n3Ready = 'true';\n  // Stops the old end-of-body script if it is still on the page.\n  root.dataset.n3Initialized = 'true';\n\n  var TIERS = [\n    { key: 'fg', id: 'fast_good',  name: 'FAST + GOOD',  note: 'Priority, full scope' },\n    { key: 'gc', id: 'good_cheap', name: 'GOOD + CHEAP', note: 'Full scope, flexible timing' },\n    { key: 'fc', id: 'cheap_fast', name: 'CHEAP + FAST', note: 'Quick, limited depth' }\n  ];\n\n  var DAYS = {\n    fg: { days: '2\\u20134 business days (estimated)', detail: 'NOT CHEAP \\u00b7 Full scope, priority scheduling and deeper refinement.' },\n    gc: { days: '3\\u201314 business days (estimated)', detail: 'NOT FAST \\u00b7 Full scope, thoughtful refinement and flexible scheduling.' },\n    fc: { days: '2\\u20134 business days (estimated)', detail: 'NOT FULL-SERVICE GOOD \\u00b7 Template-led basics, limited depth and minimal revisions.' }\n  };\n\n  var cards = Array.prototype.slice.call(root.querySelectorAll('.n3-card'));\n  var search = document.getElementById('n3-fgc-search');\n  var category = document.getElementById('n3-fgc-category');\n  var count = document.getElementById('n3-fgc-count');\n\n  var form = document.getElementById('n3-fgc-form');\n  var serviceSelect = document.getElementById('n3-fgc-service');\n  var tierBox = document.getElementById('n3-fgc-tier-box');\n  var tierList = document.getElementById('n3-fgc-tiers');\n  var statusEl = document.getElementById('n3-fgc-status');\n  var sendButton = document.getElementById('n3-fgc-send');\n  var requestSection = document.getElementById('n3-fgc-request');\n  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  function cardFor(id) {\n    for (var i = 0; i < cards.length; i++) {\n      if (cards[i].getAttribute('data-fgc-service') === id) return cards[i];\n    }\n    return null;\n  }\n\n  function tierKeyForId(id) {\n    for (var i = 0; i < TIERS.length; i++) {\n      if (TIERS[i].id === id) return TIERS[i].key;\n    }\n    return '';\n  }\n\n  function optionFor(id) {\n    for (var i = 0; i < serviceSelect.options.length; i++) {\n      if (serviceSelect.options[i].value === id) return serviceSelect.options[i];\n    }\n    return null;\n  }\n\n  /* The cards are the only list of services. The category filter, the search\n     and the service dropdown all build themselves from the cards, so a new\n     service is one copied card and nothing else. */\n  function buildCategories() {\n    var seen = {};\n    cards.forEach(function (card) {\n      var name = card.getAttribute('data-category');\n      if (!name || seen[name]) return;\n      seen[name] = true;\n      var opt = document.createElement('option');\n      opt.value = name;\n      opt.textContent = name;\n      category.appendChild(opt);\n    });\n  }\n\n  function buildServiceOptions() {\n    var groups = {};\n    var seen = {};\n    cards.forEach(function (card) {\n      var id = card.getAttribute('data-fgc-service');\n      var groupName = card.getAttribute('data-category');\n      var heading = card.querySelector('h3');\n      if (!id || !groupName || !heading || seen[id]) return;\n      seen[id] = true;\n      var group = groups[groupName];\n      if (!group) {\n        group = document.createElement('optgroup');\n        group.label = groupName;\n        groups[groupName] = group;\n        serviceSelect.appendChild(group);\n      }\n      var opt = document.createElement('option');\n      opt.value = id;\n      opt.textContent = heading.textContent;\n      group.appendChild(opt);\n    });\n    var general = document.createElement('option');\n    general.value = 'general';\n    general.textContent = 'Something else / a general question';\n    serviceSelect.appendChild(general);\n  }\n\n  function cardText(card) {\n    return (card.getAttribute('data-search') || '') + ' ' + card.textContent;\n  }\n\n  function filterCards() {\n    var q = search.value.trim().toLowerCase();\n    var cat = category.value;\n    var visible = 0;\n    cards.forEach(function (card) {\n      var matchCat = (cat === 'all' || card.getAttribute('data-category') === cat);\n      var matchText = !q || cardText(card).toLowerCase().indexOf(q) !== -1;\n      card.hidden = !(matchCat && matchText);\n      var col = card.parentNode;\n      if (col && col.classList && col.classList.contains('n3-card-col')) col.hidden = card.hidden;\n      if (!card.hidden) visible++;\n    });\n    count.textContent = visible + (visible === 1 ? ' service' : ' services');\n  }\n\n  function setTier(card, key) {\n    card.querySelectorAll('.n3-choice').forEach(function (b) {\n      b.setAttribute('aria-pressed', String(b.getAttribute('data-tier') === key));\n    });\n    var days = card.querySelector('.n3-days');\n    var line = card.querySelector('.n3-tradeoff-line');\n    var included = card.querySelector('.n3-included');\n    if (!days || !line || !included || !DAYS[key]) return;\n    days.textContent = DAYS[key].days;\n    line.textContent = DAYS[key].detail;\n    included.textContent = 'Included: ' + card.getAttribute(key === 'fc' ? 'data-lite' : 'data-full');\n    card.dataset.chosenTier = key;\n  }\n\n  /* Tier prices come from the selected card, so each price is written once. */\n  function renderTiers(card, preferred) {\n    tierList.innerHTML = '';\n    if (!card) {\n      var hint = document.createElement('p');\n      hint.className = 'n3-hint';\n      hint.textContent = 'Choose a service to see its three options.';\n      tierList.appendChild(hint);\n      return;\n    }\n    var key = preferred || card.dataset.chosenTier || 'gc';\n    TIERS.forEach(function (tier) {\n      var priceNode = card.querySelector('.n3-choice[data-tier=\"' + tier.key + '\"] strong');\n      var price = priceNode ? priceNode.textContent : '';\n\n      var label = document.createElement('label');\n      label.className = 'n3-radio col-12 col-lg-4';\n\n      var input = document.createElement('input');\n      input.type = 'radio';\n      input.name = 'tier';\n      input.value = tier.id;\n      input.checked = tier.key === key;\n\n      var body = document.createElement('span');\n      body.className = 'n3-radio-body';\n      body.innerHTML = '<span>' + tier.name + '</span><strong></strong><span class=\"n3-radio-note\">' + tier.note + '</span>';\n      body.querySelector('strong').textContent = price;\n\n      label.appendChild(input);\n      label.appendChild(body);\n      tierList.appendChild(label);\n    });\n  }\n\n  function selectService(id, tierKey, move) {\n    var card = cardFor(id);\n    if (!card) return;\n    var key = tierKey || card.dataset.chosenTier || 'gc';\n    serviceSelect.value = id;\n    setTier(card, key);\n    renderTiers(card, key);\n    tierBox.hidden = false;\n    statusEl.removeAttribute('data-state');\n    statusEl.textContent = card.querySelector('h3').textContent + ' selected.';\n    if (move === false) return;\n    if (requestSection) {\n      requestSection.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });\n    }\n    serviceSelect.focus({ preventScroll: true });\n  }\n\n  cards.forEach(function (card) {\n    var heading = card.querySelector('h3');\n    card.querySelectorAll('.n3-choice').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var key = btn.getAttribute('data-tier');\n        setTier(card, key);\n        if (serviceSelect.value === card.getAttribute('data-fgc-service')) {\n          renderTiers(card, key);\n        }\n      });\n    });\n    var request = card.querySelector('.n3-request');\n    if (request) {\n      if (heading) {\n        request.setAttribute('aria-label', 'Request ' + heading.textContent);\n        var choiceGroup = card.querySelector('.n3-choices');\n        if (choiceGroup) choiceGroup.setAttribute('aria-label', 'Choose a tradeoff for ' + heading.textContent);\n      }\n      request.addEventListener('click', function () {\n        selectService(card.getAttribute('data-fgc-service'), card.dataset.chosenTier);\n      });\n    }\n    setTier(card, 'gc');\n  });\n\n  serviceSelect.addEventListener('change', function () {\n    var id = serviceSelect.value;\n    if (id === 'general' || !id) {\n      tierBox.hidden = true;\n      tierList.innerHTML = '';\n      statusEl.removeAttribute('data-state');\n      statusEl.textContent = id === 'general' ? 'General inquiry selected. No tradeoff is needed.' : '';\n      return;\n    }\n    var card = cardFor(id);\n    if (!card) {\n      tierBox.hidden = true;\n      tierList.innerHTML = '';\n      return;\n    }\n    tierBox.hidden = false;\n    renderTiers(card, card.dataset.chosenTier || 'gc');\n  });\n\n  form.addEventListener('submit', function (e) {\n    var action = (form.getAttribute('action') || '').trim();\n    if (action.indexOf('https://') !== 0 || action.indexOf('/exec') === -1) {\n      e.preventDefault();\n      statusEl.setAttribute('data-state', 'error');\n      statusEl.textContent = 'This form is not connected yet. Please email renee.leach@neutral3rd.space instead.';\n      return;\n    }\n    statusEl.removeAttribute('data-state');\n    statusEl.textContent = 'Sending your request.';\n    if (sendButton) {\n      sendButton.disabled = true;\n      sendButton.textContent = 'Sending...';\n    }\n  });\n\n  window.addEventListener('pageshow', function () {\n    if (sendButton) {\n      sendButton.disabled = false;\n      sendButton.textContent = 'Send project request';\n    }\n  });\n\n  document.getElementById('n3-fgc-page').value = location.href.split('#')[0].slice(0, 300);\n\n  var params = new URLSearchParams(location.search);\n  var utm = [];\n  ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach(function (k) {\n    if (params.get(k)) utm.push(k + '=' + params.get(k));\n  });\n  document.getElementById('n3-fgc-utm').value = utm.join('&').slice(0, 200);\n\n  buildCategories();\n  buildServiceOptions();\n  filterCards();\n  search.addEventListener('input', filterCards);\n  category.addEventListener('change', filterCards);\n\n  /* A link such as ...fast-good-cheap.html?service=blog-to-ebook-manuscript\n     can open the form with that service and tradeoff already chosen. */\n  var deepService = params.get('service');\n  var deepTier = tierKeyForId(params.get('tier') || '');\n  if (deepService === 'general') {\n    serviceSelect.value = 'general';\n    statusEl.textContent = 'General inquiry selected. No tradeoff is needed.';\n  } else if (deepService && optionFor(deepService)) {\n    var deepCard = cardFor(deepService);\n    if (deepCard) {\n      var deepKey = deepTier || deepCard.dataset.chosenTier || 'gc';\n      serviceSelect.value = deepService;\n      setTier(deepCard, deepKey);\n      renderTiers(deepCard, deepKey);\n    }\n  }\n\n  tierBox.hidden = !serviceSelect.value || serviceSelect.value === 'general';\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n</script>",
        "html_before": "",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.png",
        "order": "1"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "110px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding-left": "108px",
                "padding-right": "108px",
                "@media (max-width: 1440px)": {
                  "padding-left": "64px",
                  "padding-right": "64px"
                },
                "@media (max-width: 992px)": {
                  "padding-left": "16px",
                  "padding-right": "16px"
                }
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border": "2px solid @borderColor",
              "background": "@menuBgColor !important",
              "color": "@primaryColor !important",
              "&:hover, &:focus": {
                "background": "@menuBgColor !important",
                "color": "@primaryColor !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "0 auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              },
              "max-width": "1600px"
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "transition": "all 0.3s ease-in-out",
              "&:hover": {
                "color": "@activeColor !important"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "1.6rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "110px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 3.2rem 0.5rem 1.8rem",
