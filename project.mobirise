                }
              }
            },
            ".faq-section-inner": {
              "max-width": "1500px",
              "margin": "0 auto",
              "padding": "0 12px"
            },
            ".faq-heading": {
              "margin-bottom": "18px"
            },
            ".mbr-section-title b": {
              "color": "#F9F6E0 !important"
            },
            ".faq-layout": {
              "display": "grid",
              "grid-template-columns": "minmax(0, 1.58fr) minmax(320px, 1fr)",
