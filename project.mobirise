        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrap": {
              "margin": "0 -20px",
              ".card": {
                "padding": "0 20px",
                "justify-content": "center"
              }
            },
            ".title-wrapper": {
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              ".mbr-label": {
                "margin-bottom": "12px"
              },
              ".mbr-section-title": {
                "margin-bottom": "12px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
              },
              ".main-btn": {
                "margin-top": "16px",
                ".btn": {
                  "margin-bottom": "0"
                }
              },
              ".image-wrapper": {
                "margin-top": "24px",
                "img": {
                  "width": "100%",
                  "height": "460px",
                  "object-fit": "cover",
                  "@media (max-width: 992px)": {
                    "height": "300px"
                  }
                }
              }
            },
            ".items-wrapper": {
              ".item": {
                "margin-bottom": "40px",
                "&:last-child": {
                  "margin-bottom": "0"
                },
                ".item-wrapper": {
                  ".item-number": {
                    "margin-bottom": "6px"
                  },
                  ".item-title": {
                    "margin-bottom": "6px"
                  },
                  ".item-text": {
                    "margin-bottom": "0"
                  },
                  ".item-btn": {
                    "margin-top": "16px",
                    ".btn": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".btn-wrapper": {
              "margin-top": "-2.5rem"
            },
            ".mbr-label": {
              "color": "#a8a8a8"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".item-number": {
              "color": "#a8a8a8"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-text": {
              "color": "#a8a8a8"
            }
          },
          "_name": "features05",
          "_sourceTheme": "rebootm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features05 rebootm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked=\"\">\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked=\"\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Number\" name=\"showNumber\" checked=\"\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/rebootm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#121212\" selected=\"\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/rebootm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#121212\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10 card\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row content-wrap justify-content-between\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-6 card\">\n                            <div class=\"title-wrapper\">\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-label\" mbr-if=\"showLabel\">\n                                    Sports Training Programme\n                                </p>\n                                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .main-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                                    Peak Performance Training Plan\n                                </h2>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                    This programme is designed to enhance overall athletic performance by improving\n                                    strength, endurance, speed, and coordination.\n                                </p>\n                                <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn main-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                        Start Training\n                                    </a>\n                                </div>\n                                <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/image13.webp\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 card\">\n                            <div class=\"items-wrapper\">\n                                <div class=\"item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showNumber\" data-app-selector=\".item-number\">\n                                            01\n                                        </p>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper, .item-btn\">\n                                            Warm-Up &amp; Mobility\n                                        </h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            Begin with dynamic stretches and light cardio to activate muscles,\n                                            improve flexibility, and reduce the risk of injury.\n                                        </p>\n                                        <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                Learn More\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showNumber\" data-app-selector=\".item-number\">\n                                            02\n                                        </p>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper, .item-btn\">\n                                            Strength Development\n                                        </h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            Focus on compound exercises such as squats, lunges, push-ups, and\n                                            deadlifts to build overall power and stability.\n                                        </p>\n                                        <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                Learn More\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showNumber\" data-app-selector=\".item-number\">\n                                            03\n                                        </p>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper, .item-btn\">\n                                            Endurance Training\n                                        </h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            Incorporate running, cycling, swimming, or circuit training to enhance\n                                            cardiovascular fitness and stamina.\n                                        </p>\n                                        <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                Learn More\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showNumber\" data-app-selector=\".item-number\">\n                                            04\n                                        </p>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper, .item-btn\">\n                                            Speed &amp; Agility Work\n                                        </h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            Use sprint intervals, ladder drills, and cone drills to improve\n                                            quickness, coordination, and reaction time.\n                                        </p>\n                                        <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                Learn More\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"item features-without-image\">\n                                    <div class=\"item-wrapper\">\n                                        <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showNumber\" data-app-selector=\".item-number\">\n                                            05\n                                        </p>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper, .item-btn\">\n                                            Cooldown &amp; Recovery\n                                        </h4>\n                                        <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                            End with light stretching, deep breathing, and hydration to promote\n                                            recovery and prepare the body for the next session.\n                                        </p>\n                                        <div mbr-buttons=\"\" mbr-theme-style=\"display-7\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                            <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                                Learn More\n                                            </a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vAagKyfOjm",
          "_anchor": "features05-58",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <a href=\"https://neutral3rd.space\"><img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-1-512x512.webp\" alt=\"Neutral3rd Emerging Tech Development Studio\"></a>\n                            </div>\n\n                           <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <!-- <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">xx</p>\n                    </div> -->\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                       <!-- <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3> -->\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\">Neutral3rd helps small businesses and professionals put AI to work in real human work. Led by Renée and supported by AI agents, the studio brings strategy, development, automation, and AI-powered media together to make work more capable without making it more complicated.<br></p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/privacy\" class=\"text-info\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/terms\" class=\"text-info\">TERMS OF SERVICE</a></b></li><a href=\"https://neutral3rd.space/terms\" class=\"text-primary\">\n                                </a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/accessibility\" class=\"text-info\">ACCESSIBILITY</a></b></li><li class=\"item-wrap\"><b><a href=\"https://connections.neutral3rd.space/wall\" class=\"text-info\" target=\"_blank\">LEAVE YOUR FEEDBACK</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://offerbeacon.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">HELP THE RIGHT BUYERS FIND YOU</a></b></li>\n<li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space\" class=\"text-info\">LEARN HUB</a>&nbsp;(coming soon)</b></li><li class=\"item-wrap\"><b><a href=\"https://perspectives.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">NEUTRAL3RD PERSPECTIVES</a></b></li><a href=\"https://neutral3rd.space\" class=\"text-primary\">\n</a><li class=\"item-wrap\"><b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-info\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Tech Development Studio. Operated by Rowdy Independents LLC., a U.S.-based business entity. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vAag2ZwfyZ",
          "_anchor": "footer01-52",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "page6.html": {
      "settings": {
        "title": "From My Wildest Dreams | Neutral3rd Emerging Tech Development Studio",
        "meta_descr": "Learn how Neutral3rd collects, uses, protects, and manages personal information across its website, AI-powered solutions, digital products, and services.",
        "header_custom": "<meta name=\"robots\" content=\"noindex, nofollow\">\n\n<style>\n.n3-fmwd {\n  --fmwd-paper: #141414;\n  --fmwd-ink: #f8f7f5;\n  --fmwd-muted: #e0dedb;\n  --fmwd-orange: #f47739;\n  --fmwd-button: #ed6229;\n  --fmwd-rule: #585653;\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  width: 100%;\n  padding: 0;\n  margin: 0;\n  color: var(--fmwd-ink);\n  background-color: var(--fmwd-paper);\n  background-image:\n    linear-gradient(90deg, rgba(214, 209, 201, 0.066667) 1px, transparent 1px),\n    linear-gradient(rgba(214, 209, 201, 0.066667) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(214, 209, 201, 0.031373) 1px, transparent 1px),\n    linear-gradient(rgba(214, 209, 201, 0.031373) 1px, transparent 1px),\n    radial-gradient(ellipse at 28% 16%, #202020, transparent 58%);\n  background-size: 88px 88px, 88px 88px, 22px 22px, 22px 22px, 100% 100%;\n  font: 400 1rem/1.42 \"Arial\", \"Helvetica Neue\", sans-serif;\n  text-align: left;\n}\n.n3-fmwd *, .n3-fmwd *::before, .n3-fmwd *::after { box-sizing: border-box; }\n.n3-fmwd :is(h1, h2, h3, p, ol, figure) { margin: 0; }\n.n3-fmwd :is(h1, h2, h3) { color: var(--fmwd-ink); }\n.n3-fmwd :is(p, ol) { color: var(--fmwd-muted); }\n.n3-fmwd ol { padding: 0; list-style: none; }\n.n3-fmwd svg { display: block; }\n.n3-fmwd .fmwd-wrap { width: 88%; max-width: 1250px; margin-inline: auto; }\n.n3-fmwd .fmwd-defs { position: absolute; width: 0; height: 0; overflow: hidden; }\n.n3-fmwd .fmwd-drafting,\n.n3-fmwd .fmwd-fold { position: absolute; inset: 0; z-index: -1; pointer-events: none; }\n.n3-fmwd .fmwd-drafting { color: #b7b5ae; }\n.n3-fmwd .fmwd-traces { width: 100%; height: 100%; opacity: .32; }\n.n3-fmwd .fmwd-spiral { position: absolute; width: clamp(130px, 23vw, 320px); opacity: .44; }\n.n3-fmwd .fmwd-spiral--top-left { top: -3%; left: -7%; transform: rotate(178deg) scale(.78); }\n.n3-fmwd .fmwd-spiral--top-right { top: -2%; right: -5%; transform: rotate(3deg) scale(1.13); }\n.n3-fmwd .fmwd-spiral--center { top: 29%; left: 41%; transform: rotate(91deg); }\n.n3-fmwd .fmwd-spiral--middle-left { top: 54%; left: -9%; transform: rotate(180deg) scale(.87); }\n.n3-fmwd .fmwd-spiral--middle-right { top: 57%; right: -9%; transform: rotate(0deg); }\n.n3-fmwd .fmwd-spiral--bottom-left { bottom: 5%; left: -3%; transform: rotate(93deg) scale(.86); }\n.n3-fmwd .fmwd-spiral--bottom-right { bottom: -2%; right: -2%; transform: rotate(269deg) scale(1.16); }\n.n3-fmwd .fmwd-top,\n.n3-fmwd .fmwd-price-section { position: relative; isolation: isolate; }\n.n3-fmwd .fmwd-fold { overflow: hidden; }\n.n3-fmwd .fmwd-fold::before,\n.n3-fmwd .fmwd-fold::after {\n  content: \"\";\n  position: absolute;\n  inset: auto 0 0 auto;\n  width: clamp(155px, 28vw, 440px);\n  height: clamp(80px, 13vw, 196px);\n  clip-path: polygon(100% 0, 100% 100%, 0 100%);\n  background: linear-gradient(140deg, #3c190c, #9d390f 80%);\n}\n.n3-fmwd .fmwd-fold::after {\n  width: clamp(117px, 22vw, 350px);\n  background: linear-gradient(138deg, #9e350e, #d84e19 88%);\n}\n.n3-fmwd .fmwd-fold--bottom::before { width: clamp(175px, 36vw, 530px); }\n.n3-fmwd .fmwd-fold--bottom::after { width: clamp(133px, 29vw, 425px); }\n.n3-fmwd .fmwd-hero {\n  display: grid;\n  grid-template-columns: minmax(0, 1.36fr) minmax(0, 1fr);\n  align-items: start;\n  gap: clamp(24px, 3.5vw, 56px);\n  padding-block: clamp(54px, 6vw, 88px) clamp(36px, 3.6vw, 64px);\n}\n.n3-fmwd .fmwd-kicker {\n  color: var(--fmwd-orange);\n  font-size: clamp(.81rem, 1.8vw, 1.52rem);\n  font-weight: 750;\n  letter-spacing: .12em;\n  line-height: 1.2;\n  text-transform: uppercase;\n}\n.n3-fmwd .fmwd-title {\n  width: fit-content;\n  margin-top: clamp(.75rem, 1.35vw, 1.4rem);\n  padding-bottom: .15em;\n  border-bottom: .12em solid var(--fmwd-button);\n  font-size: clamp(2.35rem, 6.3vw, 6rem);\n  font-weight: 900;\n  line-height: .98;\n  letter-spacing: -.055em;\n}\n.n3-fmwd .fmwd-title span { display: block; }\n.n3-fmwd .fmwd-lede {\n  max-width: 34ch;\n  margin-top: .65em;\n  font-size: clamp(1.07rem, 2.5vw, 2.15rem);\n  line-height: 1.21;\n}\n.n3-fmwd .fmwd-cta,\n.n3-fmwd .fmwd-cta:visited {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 46px;\n  max-width: 100%;\n  margin-top: clamp(17px, 2.4vw, 31px);\n  padding: .44em 1.15em .5em;\n  border: 1px solid transparent;\n  border-radius: .4em;\n  color: #120a07;\n  background: var(--fmwd-button);\n  font-size: clamp(1.05rem, 2.75vw, 2.45rem);\n  font-weight: 850;\n  line-height: 1.18;\n  text-align: center;\n  text-decoration: none;\n}\n.n3-fmwd .fmwd-cta:hover { color: #120a07; background: #ff8754; text-decoration: none; }\n.n3-fmwd .fmwd-cta:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }\n.n3-fmwd .fmwd-cta-note { margin-top: .42em; font-size: clamp(.9rem, 1.76vw, 1.45rem); }\n.n3-fmwd .fmwd-example {\n  min-width: 0;\n  margin-top: clamp(0px, 1.2vw, 18px);\n  padding: clamp(16px, 2.2vw, 33px) clamp(16px, 3vw, 42px) clamp(22px, 3.1vw, 45px);\n  border: 1px solid #b4b1ad;\n  background: rgba(21, 21, 21, 0.788235);\n}\n.n3-fmwd .fmwd-example figcaption {\n  margin-bottom: clamp(15px, 2.3vw, 33px);\n  color: var(--fmwd-ink);\n  font-size: clamp(.73rem, 1.3vw, 1.15rem);\n  font-weight: 700;\n  letter-spacing: .22em;\n  line-height: 1.4;\n  text-transform: uppercase;\n}\n.n3-fmwd .fmwd-example li {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: clamp(11px, 2.05vw, 31px);\n  min-height: 64px;\n  padding: clamp(9px, 1.2vw, 17px) clamp(12px, 2vw, 26px);\n  border: 1px solid #b4b1ad;\n  border-radius: .22rem;\n  background: #191919;\n  color: var(--fmwd-ink);\n  font-size: clamp(.95rem, 2vw, 1.75rem);\n  font-weight: 750;\n  line-height: 1.16;\n}\n.n3-fmwd .fmwd-example li + li { margin-top: clamp(25px, 4vw, 56px); }\n.n3-fmwd .fmwd-example li + li::before,\n.n3-fmwd .fmwd-example li + li::after {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  bottom: 100%;\n  color: var(--fmwd-orange);\n  transform: translateX(-50%);\n}\n.n3-fmwd .fmwd-example li + li::before { width: 2px; height: clamp(25px, 4vw, 56px); background: currentColor; }\n.n3-fmwd .fmwd-example li + li::after {\n  border: .38rem solid transparent;\n  border-top: .46rem solid currentColor;\n  border-bottom: 0;\n}\n.n3-fmwd .fmwd-icon {\n  flex: none;\n  width: clamp(29px, 4.3vw, 63px);\n  height: auto;\n  aspect-ratio: 1;\n  color: var(--fmwd-orange);\n}\n.n3-fmwd .fmwd-content-section { border-top: 1px solid var(--fmwd-rule); padding-block: clamp(23px, 3vw, 46px) clamp(29px, 3.6vw, 54px); }\n.n3-fmwd .fmwd-section-title {\n  margin-bottom: clamp(16px, 2.15vw, 32px);\n  font-size: clamp(1.9rem, 4.85vw, 4.3rem);\n  font-weight: 850;\n  letter-spacing: -.04em;\n  line-height: 1.04;\n}\n.n3-fmwd .fmwd-columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(13px, 2.2vw, 33px); }\n.n3-fmwd .fmwd-steps > li + li { border-inline-start: 1px solid #b4b1ad; padding-inline-start: clamp(13px, 2.2vw, 33px); }\n.n3-fmwd .fmwd-step-title { display: flex; align-items: baseline; gap: .66em; }\n.n3-fmwd .fmwd-step-number { color: var(--fmwd-orange); font-size: 1.25em; font-weight: 850; }\n.n3-fmwd .fmwd-item-title { font-size: clamp(1rem, 2.08vw, 1.95rem); font-weight: 800; line-height: 1.12; }\n.n3-fmwd .fmwd-item-text { margin-top: .52em; font-size: clamp(.95rem, 1.95vw, 1.6rem); line-height: 1.24; }\n.n3-fmwd .fmwd-card {\n  padding: clamp(14px, 2vw, 29px);\n  border: 1px solid #b4b1ad;\n  border-radius: .45rem;\n  background: rgba(23, 23, 23, 0.921569);\n}\n.n3-fmwd .fmwd-card .fmwd-icon { margin-bottom: clamp(9px, 1.25vw, 18px); }\n.n3-fmwd .fmwd-price-section { padding-bottom: clamp(52px, 8vw, 115px); }\n.n3-fmwd .fmwd-price {\n  display: grid;\n  grid-template-columns: minmax(0, .79fr) minmax(0, 1.21fr);\n  width: 92%;\n  max-width: 1300px;\n  padding: clamp(19px, 2.7vw, 42px);\n  border: 1px solid #efede9;\n  border-radius: .5rem;\n  background: rgba(24, 24, 24, 0.839216);\n}\n.n3-fmwd .fmwd-price-left { padding-inline-end: clamp(15px, 3.2vw, 48px); }\n.n3-fmwd .fmwd-price-right { border-inline-start: 1px solid #b4b1ad; padding-inline-start: clamp(20px, 3.6vw, 53px); }\n.n3-fmwd .fmwd-price-amount {\n  display: block;\n  margin-block: .08em .02em;\n  color: var(--fmwd-ink);\n  font-size: clamp(4rem, 10.5vw, 9.1rem);\n  font-weight: 900;\n  letter-spacing: -.075em;\n  line-height: .98;\n}\n.n3-fmwd .fmwd-price-title { font-size: clamp(1.33rem, 3vw, 2.7rem); font-weight: 850; letter-spacing: -.035em; line-height: 1.1; }\n.n3-fmwd .fmwd-price-right .fmwd-cta { margin-top: clamp(15px, 2.1vw, 28px); }\n.n3-fmwd .fmwd-intake { display: none; margin-top: 1rem; padding: .85rem 1rem; border: 1px solid #b4b1ad; border-radius: .35rem; background: var(--fmwd-paper); }\n.n3-fmwd .fmwd-intake:target { display: block; }\n@media (max-width: 767px) {\n  .n3-fmwd .fmwd-wrap { width: 88%; }\n  .n3-fmwd .fmwd-hero { grid-template-columns: minmax(0, 1fr); padding-block: 42px 36px; }\n  .n3-fmwd .fmwd-title { font-size: clamp(2.45rem, 8.8vw, 4.25rem); }\n  .n3-fmwd .fmwd-lede { font-size: clamp(1.06rem, 3vw, 1.44rem); }\n  .n3-fmwd .fmwd-example { width: 100%; max-width: 460px; }\n  .n3-fmwd .fmwd-columns { grid-template-columns: minmax(0, 1fr); }\n  .n3-fmwd .fmwd-steps > li + li { padding: .85rem 0 0; border-inline-start: 0; border-top: 1px solid var(--fmwd-rule); }\n  .n3-fmwd .fmwd-content-section { padding-block: 27px 33px; }\n  .n3-fmwd .fmwd-price { grid-template-columns: minmax(0, 1fr); }\n  .n3-fmwd .fmwd-price-left { padding: 0 0 17px; }\n  .n3-fmwd .fmwd-price-right { padding: 17px 0 0; border-inline-start: 0; border-top: 1px solid #b4b1ad; }\n  .n3-fmwd .fmwd-spiral--top-left { left: -14%; }\n  .n3-fmwd .fmwd-spiral--top-right { right: -13%; }\n  .n3-fmwd .fmwd-spiral--center { top: 31%; left: 63%; }\n  .n3-fmwd .fmwd-spiral--middle-left { top: 49%; left: -14%; }\n  .n3-fmwd .fmwd-spiral--middle-right { top: 62%; right: -14%; }\n  .n3-fmwd .fmwd-spiral--bottom-right { right: -7%; }\n}\n</style>",
        "footer_custom": "<style>\n/* Neutral3rd: Basic Image Protection */\nimg {\n  -webkit-user-drag: none;\n  user-drag: none;\n  -webkit-touch-callout: none;\n}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  // Prevent the image-specific right-click menu.\n  document.addEventListener(\"contextmenu\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n\n  // Prevent dragging images onto the desktop.\n  document.addEventListener(\"dragstart\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n})();\n</script>",
        "html_before": "",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.webp",
        "order": "4"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "110px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding-left": "108px",
                "padding-right": "108px",
                "@media (max-width: 1440px)": {
                  "padding-left": "64px",
                  "padding-right": "64px"
                },
                "@media (max-width: 992px)": {
                  "padding-left": "16px",
                  "padding-right": "16px"
                }
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border": "2px solid @borderColor",
              "background": "@menuBgColor !important",
              "color": "@primaryColor !important",
              "&:hover, &:focus": {
                "background": "@menuBgColor !important",
                "color": "@primaryColor !important"
              },
              "&:hover span": {
                "color": "white"
              },
