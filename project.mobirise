              "letter-spacing": "0.02em",
              "writing-mode": "vertical-rl",
              "transform": "rotate(180deg)",
              "align-self": "flex-start"
            },
            ".faq-accordion-area": {
              "min-width": "0"
            },
            ".faq-toggle-icon": {
              "display": "inline-flex",
              "flex": "0 0 20px",
              "align-items": "center",
              "justify-content": "center",
              "color": "#E0B548",
              "font-size": "1.55rem",
              "font-weight": "800",
              "line-height": "1"
            },
            ".faq-toggle-icon::before": {
              "content": "\"+\""
            },
            ".studio-guide": {
              "min-width": "0",
              "padding": "17px",
              "border": "1px solid @border",
              "border-radius": "3px",
              "background-color": "rgba(27, 27, 27, 0.87)",
