          "_name": "menu01",
          "_sourceTheme": "glancem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 glancem5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#c75423\" condition=\"showItems\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffffff\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#101012\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://neutral3rd.space\">\n                        <img src=\"@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.webp\" alt=\"Neutral3rd Emerging Tech Development Studio\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-info\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">GlanceM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">OfferBeacon Suite</a></li><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">LearnHub (coming soon)</a></li>\n                    \n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#dev-about\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"index.html\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-bluesky socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-secondary\" href=\"https://studioguide.neutral3rd.space/chat?token=cf7573456c87d54489c7ba5f0a2e93bf&name=Samir%20%7C%20Neutral3rd%20Emerging%20Tech%20Development%20Studio&accent=%23c75423&greet=Hey!%20Welcome%20to%20Neutral3rd.%20I%27m%20Samir%2C%20Neutral3rd%27s%20AI%20studio%20guide.%20I%20can%20help%20you%20explore%20the%20OfferBeacon%20Suite%2C%20learn%20about%20this%20development%20studio%20in%20general%2C%20or%20find%20the%20right%20next%20step.%20What%20brings%20you%20here%20today%3F&face=https%3A%2F%2Fcuevueapp.com%2Fassets%2Ffaces%2Fstandard%2F62227bb3-2f6e-4220-b3c9-2c02b2fdb349.jpg&page=https%3A%2F%2Fstudioguide.neutral3rd.space%2Fneutral3rd-emerging-technologies%2Fsamir-from-neutral3rd-emerging&mode=desktop&lang=en\" data-app-placeholder=\"Type Text\" target=\"_blank\">Start a Conversation</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vyYeEjo760",
          "_anchor": "menu01-3o",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              "padding": "0 32px 32px",
              "@media (max-width: 992px)": {
                "padding": "0 24px 24px"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px"
              },
              ".mbr-desc": {
                "margin-bottom": "0"
              }
            },
            ".text-wrapper": {
              "border-top": "1px solid @border",
              "display": "flex",
              "justify-content": "space-between",
              "padding": "32px",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "24px"
              },
              ".mbr-text": {
                "width": "45%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "24px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".mbr-section-btn": {
              "text-align": "right"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "article04",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 fabm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText_1\" checked>\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText_2\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#72716b\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showTitle || showDesc\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Privacy</b></h2>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\n                        <a href=\"https://neutral3rd.space\" class=\"text-warning\">Neutral3rd Emerging Tech Development Studio</a>\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_1\">Effective Date: July 24, 2026<br>Last Updated: October 1, 2026<br><br><b>1. Introduction</b><br><br>Neutral3rd (“Neutral3rd,” “we,” “our,” or “us”) is an independent emerging technologies development studio providing artificial intelligence (AI) enablement, software development, automation, digital communications, content systems, accessibility, and related professional services.<br><br>We recognize that privacy, transparency, and responsible data handling are essential to building trustworthy digital experiences.<br><br>This Privacy Policy explains how personal information is collected, used, disclosed, retained, and protected when individuals visit this website, contact us, purchase products or services, participate in consultations, or interact with digital solutions that we operate.<br><br>This policy applies to this web space (https://neutral3rd.space) and other Neutral3rd-operated services that expressly link to it. A separately operated product, client implementation, or third-party platform may have its own privacy notice.<br><br>By using this website, you acknowledge the practices described in this policy. Where applicable law requires consent, we will seek it separately.<br><br><b>2. Information We May Collect</b><br><br>2.1 Information You Provide Directly<br>Depending on your interaction with Neutral3rd, we may collect:<br><br>- Name, business name, and professional title.<br>-&nbsp;Email address, telephone number, and preferred contact method.<br>-&nbsp;Business website and publicly available business information.<br>-&nbsp;Information submitted through contact forms, intake questionnaires, consultations, and support requests.<br>-&nbsp;Project requirements, goals, preferences, and technical specifications.<br>-&nbsp;Billing, transaction, and purchase-related information.<br>-&nbsp;Communications, feedback, and correspondence.<br>-&nbsp;Information voluntarily provided when requesting access to or participating in a demonstration.<br><br>You should avoid submitting passwords, financial account credentials, government identification numbers, protected health information, or other sensitive personal information unless we have expressly requested it through an appropriate secure process.<br><br><b>2.2 Information Collected Automatically</b><br>When you visit our website, our hosting provider and any enabled website technologies may collect technical information, including:<br><br>- IP address and approximate geographic region.<br>-&nbsp;Browser type, device type, and operating system.<br>-&nbsp;Pages visited and referral sources.<br>-&nbsp;Date, time, and duration of website interactions.<br>-&nbsp;Error reports, diagnostic information, and performance data.<br>-&nbsp;Cookie identifiers and similar technical identifiers, where applicable.<br><br>The specific information collected depends on the technologies active on the website.<br><br><b>2.3 Information From Other Sources</b><br>We may receive business-related information from publicly accessible websites, business directories, professional networks, referrals, and authorized third-party integrations.<br><br>We use such information for legitimate business purposes, subject to applicable laws and platform restrictions.<br><br><b>3. How Information Is Used</b><br><br>We may process information to:<br><br>1. Respond to inquiries and provide customer support.<br>2. Evaluate project requirements and prepare proposals.<br>3. Provide consulting, implementation, training, and development services.<br>4. Configure, test, maintain, and support authorized digital solutions.<br>5. Process purchases, subscriptions, and related transactions.<br>-&nbsp;Deliver purchased digital products and service communications.<br>-&nbsp;Maintain business records and fulfill contractual obligations.<br>-&nbsp;Monitor website reliability, diagnose technical problems, and improve user experiences.<br>-&nbsp;Protect against fraud, abuse, unauthorized access, and security incidents.<br>-&nbsp;Comply with applicable legal obligations.<br>-&nbsp;Send optional promotional communications where permitted by law and consistent with your communication preferences.<br><br>We do not require you to subscribe to promotional emails as a condition of requesting ordinary support.<br><br><b>4. Artificial Intelligence &amp; Automated Systems</b><br><br>Neutral3rd develops and implements AI-enabled solutions, including conversational business guides, workflow automations, and information-retrieval systems.<br><br>When an AI-enabled service is used, submitted content may be processed by the underlying AI model provider, hosting service, integration platform, or other authorized technology provider.<br><br>Depending on the solution, processed information may include user questions, business information, conversation content, and technical interaction data.<br><br><b>4.1 Client Business Information</b><br>Clients may authorize us to use approved business content, such as product descriptions, policies, service information, frequently asked questions, and website content, to configure an AI solution.<br><br>We intend to use this information within the scope of the agreed services and client authorization.<br><br><b>4.2 Personal Information in AI Conversations</b><br>Users should not enter sensitive or confidential personal information into an AI interface unless the interface explicitly supports that use and provides appropriate privacy safeguards.<br><br>AI-generated responses may contain inaccuracies and should be independently verified when used for consequential decisions.<br><br><b>4.3 AI Provider Practices</b><br>Third-party AI providers may have independent data-processing, retention, monitoring, and model-improvement practices. Those practices depend on the provider, product, configuration, and contractual terms.<br><br>Neutral3rd does not represent that all third-party AI interactions are private, zero-retention, or excluded from model training unless such protections have been specifically verified for the relevant service.<br><br><b>4.4 Client-Controlled Implementations</b><br>Where a client operates its own AI application, website, account, or data environment, that client may independently determine the purposes and means of processing personal information.<br><br>In such cases, the client's privacy policy and our applicable service agreement may govern the respective responsibilities.<br><br><b>5. Cookies &amp; Similar Technologies</b><br><br>This website may use cookies, local storage, and similar technologies for essential functionality, performance, analytics, and user preferences.<br><br>These technologies may be used to maintain website functionality, measure traffic, identify technical errors, or support integrations.<br><br>Where required by applicable law, we will provide appropriate notice and choices for nonessential technologies.<br><br>You may also manage cookies through your browser settings. Disabling certain technologies may affect website functionality.<br><br>Website configuration notice: The categories of cookies actually deployed, their providers, and available consent controls should be confirmed against the live website and documented before publication.<br><br><b>6. Payments &amp; Transactions</b><br><br>Neutral3rd may use third-party payment processors, including Stripe, to facilitate purchases, subscriptions, invoices, and refunds.<br><br>Payment processors may collect payment card information, billing addresses, transaction identifiers, and fraud-prevention information under their own terms and privacy policies.<br><br>We may receive transaction confirmations, payment status, billing details, and limited payment-method information necessary for customer service and accounting.<br><br>We do not intend to collect or store complete payment card numbers directly through ordinary website contact forms.<br><br></p>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_2\"><b>7. When We Share Information\n</b><br>\n<br>We may disclose information to:\n<br>\n<br>- Hosting and infrastructure providers.\n<br>- Payment and billing processors.\n<br>- Email, scheduling, and communication providers.\n<br>- Customer management and workflow automation services.\n<br>- AI model and application providers involved in authorized services.\n<br>- Contractors or professional advisers who require access for legitimate business purposes.\n<br>- Government authorities or other parties when disclosure is required by applicable law.\n<br>- Parties involved in a lawful business reorganization, subject to applicable protections.\n<br>\n<br>We may also disclose information at your direction or with your authorization.\n<br>\n<br>We do not disclose personal information to unrelated parties merely because they request it.\n<br>\n<br>We do not describe Neutral3rd as selling personal information for advertising purposes. Any future advertising, tracking, or data-sharing arrangements must be evaluated and accurately disclosed before implementation.<br><br><b>8. Third-Party Websites &amp; Integrations\n</b><br>\n<br>This website may link to external services, including AI platforms, payment processors, professional networks, software providers, and educational resources.\n<br>\n<br>These websites operate independently and may have different privacy practices.\n<br>\n<br>A link does not necessarily indicate endorsement, affiliation, or responsibility for a third party's data handling.\n<br>\n<br>We encourage you to review the applicable privacy policies before submitting information to external services.\n<br><br><b>9. Data Security\n</b><br>\n<br>Neutral3rd recognizes the importance of protecting personal and business information.\n<br>\n<br>We seek to apply reasonable administrative, technical, and organizational safeguards appropriate to the nature of the information, the services provided, and the risks involved.\n<br>\n<br>These may include access restrictions, account security measures, appropriate use of secure service providers, and procedures for identifying and addressing security concerns.\n<br>\n<br>No internet transmission, cloud service, or electronic storage system can be guaranteed completely secure.\n<br>\n<br>If you believe information associated with Neutral3rd has been exposed or accessed without authorization, contact privacy@neutral3rd.space.\n<br>\n<br>Where applicable law requires notification of a qualifying data breach, we will address those requirements.\n<br>\n<br><b>10. Data Retention\n</b><br>\n<br>We retain information for periods reasonably necessary to provide requested services, administer business relationships, meet contractual commitments, maintain appropriate records, resolve disputes, and comply with applicable law.\n<br>\n<br>Retention periods may vary according to the category of information, contractual requirements, service-provider settings, and legal obligations.\n<br>\n<br>When information is no longer required, we will seek to delete, de-identify, or securely dispose of it as appropriate, subject to lawful exceptions and technical limitations.\n<br>\n<br>Information held independently by third-party providers may remain subject to their retention policies.\n<br>\n<br><b>11. Your Privacy Choices &amp; Rights\n</b><br>\n<br>Depending on your location and applicable law, you may have rights to:\n<br>\n<br>- Request information about personal data we maintain.\n<br>- Request access to or correction of certain information.\n<br>\n-&nbsp;Request deletion of eligible information.\n<br>\n-&nbsp;Withdraw consent where processing depends on consent.\n<br>\n-&nbsp;Object to or restrict certain processing activities.\n<br>\n-&nbsp;Opt out of marketing communications.\n<br>\n-&nbsp;Exercise other privacy rights established by applicable law.\n<br>\n<br>These rights are not absolute and may be subject to legal, security, contractual, and recordkeeping exceptions.\n<br>\n<br>To submit a privacy request, email privacy@neutral3rd.space with sufficient information for us to understand and evaluate your request.\n<br>\n<br>We may need to verify your identity before disclosing or modifying personal information. We will respond in accordance with applicable legal requirements.\n<br>\n<br>Marketing Preferences\n<br>\n<br>If you receive promotional email communications from us, you may use the unsubscribe mechanism provided or contact us directly.\n<br>\n<br>Administrative communications about purchases, security, or active services may still be necessary.\n<br>\n<br><b>12. Children's Privacy\n</b><br>\n<br>Neutral3rd's website and professional services are directed primarily toward adults and business users.\n<br>\n<br>We do not knowingly solicit personal information directly from children under 13 through our general website.\n<br>\n<br>If you believe a child has submitted personal information without appropriate authorization, contact privacy@neutral3rd.space so that we can review the matter.\n<br>\n<br><b>13. International Visitors\n</b><br>\n<br>Neutral3rd operates from the United States.\n<br>\n<br>Information submitted through our website or services may be processed in the United States or other locations where our authorized service providers operate.\n<br>\n<br>Privacy laws and data-protection requirements may differ across jurisdictions.\n<br>\n<br>Where additional requirements apply to a particular client, project, or geographic market, they may be addressed through supplemental notices, contractual terms, or other appropriate measures.\n<br>\n<br><b>14. Business Clients &amp; Data Processing Responsibilities\n</b><br>\n<br>Some Neutral3rd services involve processing information on behalf of business clients.\n<br>\n<br>The applicable statement of work, service agreement, data-processing agreement, or other written instructions may establish additional obligations.\n<br>\n<br>Business clients remain responsible for providing lawful instructions, identifying authorized data sources, securing necessary permissions, and issuing appropriate privacy notices for their own customer-facing services.\n<br>\n<br>Neutral3rd's responsibilities depend on the agreed scope and actual allocation of control over the relevant information.\n<br>\n<br><b>15. Changes to This Privacy Policy\n</b><br>\n<br>We may update this Privacy Policy to reflect changes in our operations, technologies, service providers, or legal obligations.\n<br>\n<br>The revised policy will display an updated date.\n<br>\n<br>When a change materially affects how personal information is handled, we will provide additional notice or obtain consent when legally required.\n<br>\n<br><b>16. Contact the Privacy Officer\n</b><br>\n<br>For privacy inquiries, access requests, corrections, deletion requests, or concerns about personal information:\n<br>\n<br>Email: privacy@neutral3rd.space\n<br>Website: https://neutral3rd.space\n<br>\n<br>For general technical assistance and customer support:\n<br>\n<br>support@neutral3rd.space\n<br>\n<br>Questions are welcomed about how personal information is handled, and Neutral3rd aims to address privacy concerns transparently and responsibly.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vyYeONPpQk",
          "_anchor": "article04-40",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <a href=\"https://neutral3rd.space\"><img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-1-512x512.webp\" alt=\"Neutral3rd Emerging Tech Development Studio\"></a>\n                            </div>\n\n                           <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <!-- <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">xx</p>\n                    </div> -->\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                       <!-- <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3> -->\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\">Neutral3rd helps small businesses and professionals put AI to work in real human work. Led by Renée and supported by AI agents, the studio brings strategy, development, automation, and AI-powered media together to make work more capable without making it more complicated.<br></p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/privacy\" class=\"text-info\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/terms\" class=\"text-info\">TERMS OF SERVICE</a></b></li><a href=\"https://neutral3rd.space/terms\" class=\"text-primary\">\n                                </a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/accessibility\" class=\"text-info\">ACCESSIBILITY</a></b></li><li class=\"item-wrap\"><b><a href=\"https://connections.neutral3rd.space/wall\" class=\"text-info\" target=\"_blank\">LEAVE YOUR FEEDBACK</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://offerbeacon.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">HELP THE RIGHT BUYERS FIND YOU</a></b></li>\n<li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space\" class=\"text-info\">LEARN HUB</a>&nbsp;(coming soon)</b></li><li class=\"item-wrap\"><b><a href=\"https://perspectives.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">NEUTRAL3RD PERSPECTIVES</a></b></li><a href=\"https://neutral3rd.space\" class=\"text-primary\">\n</a><li class=\"item-wrap\"><b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-info\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Tech Development Studio. Operated by Rowdy Independents LLC., a U.S.-based business entity. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vyYeEnXAc4",
          "_anchor": "footer",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "terms.html": {
      "settings": {
        "title": "Terms of Service | Neutral3rd Emerging Tech Development Studio",
        "meta_descr": "Review Neutral3rd's Terms of Service covering website use, AI solutions, consulting, digital products, payments, intellectual property, and client responsibilities.",
        "header_custom": "",
        "footer_custom": "<style>\n/* Neutral3rd: Basic Image Protection */\nimg {\n  -webkit-user-drag: none;\n  user-drag: none;\n  -webkit-touch-callout: none;\n}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  // Prevent the image-specific right-click menu.\n  document.addEventListener(\"contextmenu\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n\n  // Prevent dragging images onto the desktop.\n  document.addEventListener(\"dragstart\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n})();\n</script>",
        "html_before": "",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.webp",
        "order": "2"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "110px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding-left": "108px",
                "padding-right": "108px",
                "@media (max-width: 1440px)": {
                  "padding-left": "64px",
                  "padding-right": "64px"
                },
                "@media (max-width: 992px)": {
                  "padding-left": "16px",
                  "padding-right": "16px"
                }
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border": "2px solid @borderColor",
              "background": "@menuBgColor !important",
              "color": "@primaryColor !important",
              "&:hover, &:focus": {
                "background": "@menuBgColor !important",
                "color": "@primaryColor !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "0 auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              },
              "max-width": "1600px"
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "transition": "all 0.3s ease-in-out",
              "&:hover": {
                "color": "@activeColor !important"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "1.6rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "110px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 3.2rem 0.5rem 1.8rem",
                "border-radius": "0"
              },
              ".navbar-logo img": {
                "width": "auto",
                "border-radius": "6px !important"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(98.5vh - @{logoSize}rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "41%"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem",
                  "text-align": "center"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-right": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "40%"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem !important",
                  "text-align": "center"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word",
                  "padding-right": "0.5rem",
                  "max-width": "80%"
                },
                ".navbar-toggler": {
                  "flex-basis": "auto"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "96px",
                ".navbar-brand": {
                  "min-height": "96px"
                }
              },
              "padding": "0 !important",
              "border-radius": "0 !important",
              "border": "none !important",
              "box-shadow": "none !important"
            },
            ".navbar-brand": {
              "min-height": "96px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word !important",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important",
                "font-weight": "400",
                "&:hover, &:focus": {
                  "color": "@activeColor !important"
                }
              },
              ".navbar-logo a": {
                "outline": "none"
              },
              "word-wrap": "break-word !important",
              "white-space": "normal"
            },
            ".navbar.opened": {
              ".navbar-brand": {
                ".navbar-caption": {
                  "&:hover, &:focus": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                "top": "3rem",
                "border-radius": "0",
                "@media (max-width: 992px)": {
                  "top": "0"
                },
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%",
                  "top": "0",
                  "border-left": "1px solid transparent"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap",
              "@media (min-width: 991px)": {
                "padding": "0",
                "background-color": "transparent",
                "border": "2px solid @borderColor",
                "& when (@collapsed)": {
                  "border-radius": "0 !important"
                }
              }
            },
            ".navbar-buttons": {
              "text-align": "center",
              ".btn": {
                "white-space": "nowrap",
                "margin-right": "0",
                "padding": "22px 32px",
                "min-height": "auto",
                ".mbr-iconfont": {
                  "width": "32px",
                  "height": "32px",
                  "min-width": "32px",
                  "font-size": "16px",
                  "margin-left": "32px",
                  "margin-right": "-20px"
                },
                "@media (max-width: 575px)": {
                  "width": "auto !important"
                }
              }
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "50px",
              "height": "50px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "border-radius": "100%",
              "background-color": "@menuBgColor !important",
              "border": "none !important",
              "box-shadow": "none !important",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "20px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "18px",
                  "left": "15px",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "left": "15px",
                  "top": "30px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            ".navbar-nav": {
              "margin": "0 auto",
              "& when not (@showButtons)": {
                "justify-content": "flex-end",
                "margin": "0"
              }
            },
            ".nav-item": {
              "padding": "0",
              "margin": "0",
              ".nav-link": {
                "padding": "24px 32px !important",
                "margin": "0 !important",
                "transition": "all 0.3s ease-in-out",
                "font-weight": "400",
                "&::after": {
                  "color": "@activeColor !important",
                  "transform": "rotate(0)",
                  "transition": ".3s"
                },
                "&:hover": {
                  "background-color": "transparent",
                  "color": "@activeColor !important"
                }
              },
              ".nav-link.show": {
                "&::after": {
                  "transform": "rotate(180deg)"
                }
              },
              ".dropdown-menu": {
                "background-color": "transparent !important",
                "&:hover": {
                  "background-color": "transparent !important"
                },
                ".dropdown-item": {
                  "color": "@primaryColor !important",
                  "&:hover": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            "& when (@collapsed)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 5rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "40px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid hsla(0, 0%, 100%, 0.2)"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center"
                  }
                }
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "flex-direction": "column !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 3rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "24px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid hsla(0, 0%, 100%, 0.2)"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center"
                  }
                }
              }
            },
            ".content-wrap": {
              "min-height": "130px"
            }
          },
          "_name": "menu01",
          "_sourceTheme": "glancem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 glancem5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#c75423\" condition=\"showItems\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffffff\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#101012\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://neutral3rd.space\">\n                        <img src=\"@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.webp\" alt=\"Neutral3rd Emerging Tech Development Studio\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-info\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">GlanceM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">OfferBeacon Suite</a></li><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">LearnHub (coming soon)</a></li>\n                    \n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#dev-about\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"index.html\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-bluesky socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-secondary\" href=\"https://studioguide.neutral3rd.space/chat?token=cf7573456c87d54489c7ba5f0a2e93bf&name=Samir%20%7C%20Neutral3rd%20Emerging%20Tech%20Development%20Studio&accent=%23c75423&greet=Hey!%20Welcome%20to%20Neutral3rd.%20I%27m%20Samir%2C%20Neutral3rd%27s%20AI%20studio%20guide.%20I%20can%20help%20you%20explore%20the%20OfferBeacon%20Suite%2C%20learn%20about%20this%20development%20studio%20in%20general%2C%20or%20find%20the%20right%20next%20step.%20What%20brings%20you%20here%20today%3F&face=https%3A%2F%2Fcuevueapp.com%2Fassets%2Ffaces%2Fstandard%2F62227bb3-2f6e-4220-b3c9-2c02b2fdb349.jpg&page=https%3A%2F%2Fstudioguide.neutral3rd.space%2Fneutral3rd-emerging-technologies%2Fsamir-from-neutral3rd-emerging&mode=desktop&lang=en\" data-app-placeholder=\"Type Text\" target=\"_blank\">Start a Conversation</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vyZtqaroJI",
          "_anchor": "menu01-41",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              "padding": "0 32px 32px",
              "@media (max-width: 992px)": {
                "padding": "0 24px 24px"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px"
              },
              ".mbr-desc": {
                "margin-bottom": "0"
              }
            },
            ".text-wrapper": {
              "border-top": "1px solid @border",
              "display": "flex",
              "justify-content": "space-between",
              "padding": "32px",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "24px"
              },
              ".mbr-text": {
                "width": "45%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "24px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".mbr-section-btn": {
              "text-align": "right"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "article04",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 fabm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText_1\" checked>\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText_2\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#72716b\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showTitle || showDesc\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Terms of Service</b></h2>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\n                        <a href=\"https://neutral3rd.space\" class=\"text-warning\">Neutral3rd Emerging Tech Development Studio</a>\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_1\">Effective Date: July 24, 2026<br>Last Updated: October 1, 2026<br><br><b>1. Acceptance of Terms</b><br><br>Welcome to Neutral3rd.<br><br>These Terms of Service (“Terms”) govern your access to and use of the Neutral3rd website, information, digital products, demonstrations, and services made available directly by Neutral3rd.<br><br>By accessing or using our website or purchasing our products or services, you agree to these Terms, to the extent permitted by applicable law.<br><br>If you do not agree, please discontinue use of all applicable Neutral3rd websites and services.<br><br>If you are acting on behalf of a business or organization, you represent that you have the authority to enter into applicable agreements on its behalf.<br><br><b>2. About Neutral3rd</b><br><br>Neutral3rd is an independent emerging technologies development studio focused on practical technology solutions for real-world business needs.<br><br>Offerings may include:<br><br>- AI enablement and implementation.<br>-&nbsp;Conversational AI solutions and business information guides.<br>-&nbsp;Workflow and process automation.<br>-&nbsp;Software and web technology development.<br>-&nbsp;Digital communications and content systems.<br>-&nbsp;Accessibility and usability consulting.<br>-&nbsp;Technical training, education, and documentation.<br>-&nbsp;Prompt packs, templates, and other digital resources.<br>-&nbsp;Custom technology configuration, testing, and ongoing support.<br><br>Descriptions on this website are informational and do not guarantee the availability of any particular service, integration, capability, or commercial arrangement.<br><br><b>3. Website Use</b><br><br>You may access and use publicly available website content for lawful informational and business purposes.<br><br>You agree not to:<br><br>- Attempt unauthorized access to systems, accounts, or data.<br>-&nbsp;Interfere with website functionality or security.<br>-&nbsp;Introduce malicious code or harmful automated traffic.<br>-&nbsp;Misrepresent your identity or authority.<br>-&nbsp;Use the website to violate applicable law.<br>-&nbsp;Copy, distribute, or commercially exploit protected content without authorization.<br>-&nbsp;Attempt to circumvent service restrictions or technical safeguards.<br>-&nbsp;Use our services to infringe intellectual property, privacy, or other legal rights.<br><br>We may restrict access or take other appropriate action in response to suspected misuse.<br><br><b>4. Service Proposals &amp; Client Agreements</b><br><br>Descriptions, demonstrations, estimates, and website materials do not constitute a binding commitment to deliver a specific project.<br><br>Professional services may require a separate proposal, statement of work, order form, subscription agreement, or other written contract.<br><br>Such documents may specify:<br><br>- Project scope and deliverables.<br>-&nbsp;Implementation milestones and schedules.<br>-&nbsp;Client responsibilities.<br>-&nbsp;Fees and payment terms.<br>-&nbsp;Revision allowances.<br>-&nbsp;Acceptance procedures.<br>-&nbsp;Support and maintenance coverage.<br>-&nbsp;Third-party dependencies.<br>-&nbsp;Intellectual property rights.<br>-&nbsp;Confidentiality and data handling.<br>-&nbsp;Cancellation and termination conditions.<br><br>If a separately executed agreement conflicts with these Terms concerning the contracted services, the separately executed agreement will govern that subject matter unless it states otherwise.<br><br><b>5. Fees, Purchases, &amp; Payment</b><br><br>Prices are displayed or quoted in the applicable offer, invoice, checkout, or agreement.<br><br>Unless otherwise specified, prices are in U.S. dollars.<br><br>Payment may be collected through an authorized third-party processor.<br><br>Applicable taxes, recurring charges, and additional fees will be disclosed as required before purchase.<br><br>A payment obligation is not satisfied merely by submitting an order if payment is declined or otherwise unsuccessful.<br><br>We may suspend work or withhold undelivered services when required payments are overdue, subject to applicable agreements and law.<br><br><b>5.1 Setup &amp; Implementation Fees</b><br>Setup fees may cover discovery, configuration, content preparation, implementation, testing, and other agreed work.<br><br>The scope and refund treatment of setup fees should be specified in the applicable offer or agreement.<br><br><b>5.2 Recurring Services</b><br>Some services may involve recurring charges for maintenance, monitoring, support, hosting, or other ongoing activities.<br><br>The applicable checkout or agreement will specify the billing interval, amount, renewal arrangement, and cancellation procedure.<br><br>Cancellation generally affects future billing and does not automatically reverse charges already incurred, except where required by law or the applicable agreement.<br><br><b>5.3 Third-Party Costs</b><br>Clients may be responsible for third-party subscriptions, usage fees, hosting, API charges, transaction fees, or software licenses.<br><br>Unless expressly included in a written offer, such costs are separate from Neutral3rd service fees.<br><br><b>6. Digital Products &amp; Prompt Packs</b><br><br>Neutral3rd may sell downloadable resources, prompt collections, templates, educational materials, and other digital products.<br><br>Unless the applicable product listing grants different rights, a completed purchase provides a limited, nonexclusive, nontransferable license to use the purchased materials for the purchaser's own personal or internal business purposes.<br><br>Purchasing a digital product does not transfer ownership of its underlying intellectual property.<br><br>You may adapt purchased prompts and templates for your own authorized work.<br><br>Unless expressly permitted in writing, you may not:<br><br>- Resell or sublicense the original materials.<br>-&nbsp;Redistribute entire packs or substantially equivalent copies.<br>-&nbsp;Publish purchased materials as your own competing commercial product.<br>-&nbsp;Upload the complete product to a public repository or file-sharing service.<br>- Remove proprietary notices or misrepresent authorship.<br><br>Outputs produced through third-party AI services remain subject to those services' terms and applicable law.<br><br>A Neutral3rd prompt pack does not include a LLM subscription, API credits, or third-party software access unless expressly stated.<br><br><b>7. Digital Product Delivery &amp; Refunds</b><br><br>Digital product delivery methods, access requirements, and any refund eligibility will be described at the point of purchase or in an applicable written policy.<br><br>Because digital materials may be accessible immediately after delivery, certain purchases may have restricted refund eligibility where legally permitted and clearly disclosed before checkout.<br><br>Nothing in these Terms eliminates nonwaivable consumer rights or remedies for defective, misdescribed, or undelivered products.<br><br>If you experience a delivery problem, contact support@neutral3rd.space with your order information.<br><br><b>8. AI-Enabled Services &amp; Outputs</b><br><br>Some Neutral3rd products and services incorporate artificial intelligence, machine learning, retrieval systems, and automated workflows.<br><br>These technologies may produce inaccurate, incomplete, outdated, inconsistent, or otherwise unsuitable results.<br><br>AI-generated outputs should not be treated as guaranteed factual statements or professional determinations.<br><br><b>8.1 Human Review</b><br>Users and clients are responsible for reviewing AI-generated content before relying on it, publishing it, distributing it, or using it to make consequential decisions.<br><br><b>8.2 High-Impact Decisions</b><br>Unless expressly authorized through a suitable professional and technical arrangement, Neutral3rd AI solutions are not intended to independently make decisions involving medical treatment, legal rights, employment eligibility, credit, insurance, housing, or other similarly consequential matters.<br><br><b>8.3 Third-Party AI Platforms</b><br>AI services may depend on third-party providers whose models, APIs, pricing, policies, features, or availability can change.<br><br>Neutral3rd cannot guarantee uninterrupted availability or permanent compatibility with third-party systems.<br><br><b>8.4 No Guaranteed Business Outcomes</b><br>We do not guarantee that an AI solution, automation, prompt pack, or digital service will produce a particular revenue increase, customer conversion rate, search ranking, productivity gain, or other commercial result.<br><br>Results depend on implementation, information quality, user behavior, market conditions, and factors outside our control.<br><br><b>9. Client Responsibilities</b><br><br>Clients agree to provide reasonably accurate and authorized information needed for their projects.<br><br>Clients are responsible for:<br><br>- Confirming the accuracy of submitted business information.<br>-&nbsp;Obtaining necessary rights to supplied content, images, documents, and data.<br>-&nbsp;Maintaining appropriate access to their own accounts and platforms.<br>-&nbsp;Reviewing and approving deliverables where required.<br>-&nbsp;Complying with laws applicable to their businesses and industries.<br>-&nbsp;Providing required notices and permissions to their own customers.<br>-&nbsp;Informing Neutral3rd about material changes affecting a deployed solution.<br>- Avoiding submission of restricted or sensitive information through unapproved channels.<br>- Delays in supplying required materials or approvals may affect delivery schedules.<br><br></p>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_2\"><b>10. Client Content &amp; Intellectual Property\n</b><br>\n<br>Clients retain their ownership rights in materials they lawfully provide to Neutral3rd.\n<br>\n<br>Clients grant Neutral3rd a limited right to use, reproduce, process, and adapt such materials as reasonably necessary to perform authorized services.\n<br>\n<br>Unless a written agreement provides otherwise, Neutral3rd retains ownership of its preexisting intellectual property, reusable methods, frameworks, templates, software components, internal tools, and general technical know-how.\n<br>\n<br>Ownership and licensing of custom deliverables will be governed by the applicable project agreement.\n<br>\n<br>Neither party receives ownership of the other's trademarks or other protected intellectual property merely through a business relationship.\n<br><br><b>11. Confidentiality\n</b><br>\n<br>Where Neutral3rd and a client enter into a confidentiality agreement, that agreement governs the information and obligations it covers.\n<br>\n<br>Absent a separate confidentiality agreement, the parties should still avoid unnecessary disclosure of nonpublic business information and use appropriate secure channels for sensitive materials.\n<br>\n<br>Website contact forms and ordinary email should not be assumed to provide the same confidentiality protections as a specifically contracted secure environment.\n<br>\n<br><b>12. Accessibility &amp; Inclusive Design\n</b><br>\n<br>Neutral3rd values accessibility and inclusive digital experiences.\n<br>\n<br>Accessibility requirements for client projects should be established in the applicable project scope, including any required WCAG version, conformance level, assistive technology testing, remediation responsibilities, and acceptance criteria.\n<br>\n<br>Accessibility consulting or development does not automatically constitute an independent certification or legal compliance guarantee.\n<br>\n<br>For accessibility concerns involving our own website, contact support@neutral3rd.space.\n<br>\n<br><b>13. Third-Party Services &amp; External Links\n</b><br>\n<br>Our website and services may reference or integrate third-party products, websites, payment systems, AI platforms, and other technology providers.\n<br>\n<br>Third-party services are governed by their respective terms, policies, licensing requirements, and availability conditions.\n<br>\n<br>Neutral3rd is not responsible for independent third-party conduct or changes beyond its reasonable control, except to the extent responsibility cannot lawfully be excluded or is expressly assumed under a written agreement.\n<br>\n<br>References to third-party brands do not necessarily indicate endorsement, sponsorship, or affiliation.\n<br>\n<br><b>14. Demonstrations &amp; Early-Access Offerings\n</b><br>\n<br>Neutral3rd may display prototypes, conceptual demonstrations, preview features, or products identified as being in development.\n<br>\n<br>These materials may not reflect a final commercial release.\n<br>\n<br>Early-access features may be modified, delayed, limited, or discontinued.\n<br>\n<br>Participation in an early-access program does not guarantee a specific release date, feature set, or permanent access unless separately agreed in writing.\n<br>\n<br><b>15. Support &amp; Maintenance\n</b><br>\n<br>Support availability and response commitments depend on the purchased service and any applicable maintenance agreement.\n<br>\n<br>Unless a separate agreement establishes specific service levels, website statements about support do not create a guaranteed response time, uptime percentage, or continuous monitoring obligation.\n<br>\n<br>Support requests may be submitted to support@neutral3rd.space.\n<br>\n<br><b>16. Privacy &amp; Data Handling\n</b><br>\n<br>Our Privacy Policy describes how Neutral3rd handles personal information in connection with its website and applicable services.\n<br>\n<br>Separate client agreements or data-processing arrangements may establish additional responsibilities.\n<br>\n<br>Clients are responsible for ensuring that information submitted for processing has been obtained and disclosed lawfully.\n<br>\n<br><b>17. Disclaimers\n</b><br>\n<br>The website and general informational materials are provided on an “as available” basis.\n<br>\n<br>To the maximum extent permitted by applicable law, Neutral3rd disclaims implied warranties not expressly provided in a written agreement, including implied warranties of merchantability, fitness for a particular purpose, and noninfringement.\n<br>\n<br>Nothing in these Terms excludes an express warranty contained in an applicable signed agreement or any warranty that cannot lawfully be disclaimed.\n<br>\n<br>Professional advice in regulated fields should be obtained from appropriately qualified professionals.\n<br>\n<br><b>18. Limitation of Liability\n</b><br>\n<br>To the extent permitted by applicable law, Neutral3rd will not be liable for indirect, incidental, special, consequential, or punitive damages arising from use of the general website or services, including lost profits, lost opportunities, or business interruption, except where such exclusions are prohibited.\n<br>\n<br>For claims arising solely from general website use and not governed by a separate written agreement, Neutral3rd's aggregate liability will not exceed the amount paid directly to Neutral3rd for the specific website-related service giving rise to the claim during the preceding twelve months, or $100 if no such payment was made, to the extent enforceable.\n<br>\n<br>Separate service agreements may establish different liability terms.\n<br>\n<br>Nothing in these Terms limits liability for fraud, willful misconduct, or other matters for which liability cannot legally be excluded or restricted.\n<br>\n<br><b>19. Indemnification\n</b><br>\n<br>To the extent permitted by law, business users agree to defend and indemnify Neutral3rd against third-party claims arising from their unlawful use of our services, infringement caused by materials they supplied, or material violations of these Terms.\n<br>\n<br>This obligation does not apply to the extent a claim results from Neutral3rd's own unlawful conduct or other responsibility that cannot lawfully be transferred.\n<br>\n<br>Any additional indemnification arrangements for professional services should be established in a separate agreement.\n<br>\n<br><b>20. Suspension &amp; Termination\n</b><br>\n<br>We may suspend or restrict access where reasonably necessary to address security risks, unlawful activity, material misuse, or a material violation of applicable terms.\n<br>\n<br>Either party may terminate an ongoing service according to the applicable agreement.\n<br>\n<br>Termination does not automatically eliminate outstanding payment obligations, accrued rights, or provisions intended to survive termination.\n<br>\n<br><b>21. Governing Law &amp; Disputes\n</b><br>\n<br>Unless a separate written agreement states otherwise, these Terms are governed by the laws of the State of North Carolina, United States, without regard to conflict-of-law principles.\n<br>\n<br>Disputes arising from these Terms will be subject to the courts of competent jurisdiction in the state of Georgia, except where mandatory consumer-protection or other applicable law requires a different forum.\n<br>\n<br>Before commencing formal proceedings, parties are encouraged to contact Neutral3rd and attempt to resolve the matter informally.\n<br>\n<br>These Terms do not require arbitration or waive the right to participate in a class action.\n<br>\n<br><b>22. Changes to Terms\n</b><br>\n<br>We may revise these Terms to reflect operational, technological, legal, or commercial changes.\n<br>\n<br>Updated Terms will be posted with a revised date.\n<br>\n<br>Material changes affecting existing paid agreements will be handled according to applicable contractual and legal requirements.\n<br>\n<br>Changes will not retroactively eliminate rights already accrued under an existing agreement.\n<br>\n<br><b>23. Severability &amp; Entire Agreement\n</b><br>\n<br>If a provision of these Terms is determined to be unenforceable, the remaining provisions will remain effective to the extent legally permissible.\n<br>\n<br>These Terms, together with any applicable policies and separately executed agreements, constitute the relevant agreement governing the covered subject matter.\n<br>\n<br>Failure to enforce a provision on one occasion does not necessarily waive the right to enforce it later.\n<br>\n<br><b>24. Contact Information\n</b><br>\n<br>Neutral3rd Emerging Tech Development Studio\n<br>\n<br>Website: https://neutral3rd.space\n<br>General Support: support@neutral3rd.space\n<br>Privacy Inquiries: privacy@neutral3rd.space\n<br>\n<br>For questions concerning a specific purchase, subscription, or project, please include the relevant order or project reference when contacting support.<br></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vyZtqaPZ3j",
          "_anchor": "article04-42",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <a href=\"https://neutral3rd.space\"><img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-1-512x512.webp\" alt=\"Neutral3rd Emerging Tech Development Studio\"></a>\n                            </div>\n\n                           <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <!-- <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">xx</p>\n                    </div> -->\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                       <!-- <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3> -->\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\">Neutral3rd helps small businesses and professionals put AI to work in real human work. Led by Renée and supported by AI agents, the studio brings strategy, development, automation, and AI-powered media together to make work more capable without making it more complicated.<br></p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/privacy\" class=\"text-info\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/terms\" class=\"text-info\">TERMS OF SERVICE</a></b></li><a href=\"https://neutral3rd.space/terms\" class=\"text-primary\">\n                                </a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/accessibility\" class=\"text-info\">ACCESSIBILITY</a></b></li><li class=\"item-wrap\"><b><a href=\"https://connections.neutral3rd.space/wall\" class=\"text-info\" target=\"_blank\">LEAVE YOUR FEEDBACK</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://offerbeacon.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">HELP THE RIGHT BUYERS FIND YOU</a></b></li>\n<li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space\" class=\"text-info\">LEARN HUB</a>&nbsp;(coming soon)</b></li><li class=\"item-wrap\"><b><a href=\"https://perspectives.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">NEUTRAL3RD PERSPECTIVES</a></b></li><a href=\"https://neutral3rd.space\" class=\"text-primary\">\n</a><li class=\"item-wrap\"><b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-info\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Tech Development Studio. Operated by Rowdy Independents LLC., a U.S.-based business entity. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vyZtqbleyt",
          "_anchor": "footer01-43",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "accessibility.html": {
      "settings": {
        "title": "Accessibility | Neutral3rd Emerging Tech Development Studio",
        "meta_descr": "Explore Neutral3rd's commitment to digital accessibility, inclusive design, WCAG 2.2 Level AA goals, assistive technology support, and continuous improvement.",
        "header_custom": "",
        "footer_custom": "<style>\n/* Neutral3rd: Basic Image Protection */\nimg {\n  -webkit-user-drag: none;\n  user-drag: none;\n  -webkit-touch-callout: none;\n}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  // Prevent the image-specific right-click menu.\n  document.addEventListener(\"contextmenu\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n\n  // Prevent dragging images onto the desktop.\n  document.addEventListener(\"dragstart\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n})();\n</script>",
        "html_before": "",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.webp",
        "order": "3"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "110px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding-left": "108px",
                "padding-right": "108px",
                "@media (max-width: 1440px)": {
                  "padding-left": "64px",
                  "padding-right": "64px"
                },
                "@media (max-width: 992px)": {
                  "padding-left": "16px",
                  "padding-right": "16px"
                }
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border": "2px solid @borderColor",
              "background": "@menuBgColor !important",
              "color": "@primaryColor !important",
              "&:hover, &:focus": {
                "background": "@menuBgColor !important",
                "color": "@primaryColor !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "0 auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              },
              "max-width": "1600px"
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "transition": "all 0.3s ease-in-out",
              "&:hover": {
                "color": "@activeColor !important"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "1.6rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "110px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 3.2rem 0.5rem 1.8rem",
                "border-radius": "0"
              },
              ".navbar-logo img": {
                "width": "auto",
                "border-radius": "6px !important"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(98.5vh - @{logoSize}rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "41%"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem",
                  "text-align": "center"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-right": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "40%"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem !important",
                  "text-align": "center"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word",
                  "padding-right": "0.5rem",
                  "max-width": "80%"
                },
                ".navbar-toggler": {
                  "flex-basis": "auto"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "96px",
                ".navbar-brand": {
                  "min-height": "96px"
                }
              },
              "padding": "0 !important",
              "border-radius": "0 !important",
              "border": "none !important",
              "box-shadow": "none !important"
            },
            ".navbar-brand": {
              "min-height": "96px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word !important",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important",
                "font-weight": "400",
                "&:hover, &:focus": {
                  "color": "@activeColor !important"
                }
              },
              ".navbar-logo a": {
                "outline": "none"
              },
              "word-wrap": "break-word !important",
              "white-space": "normal"
            },
            ".navbar.opened": {
              ".navbar-brand": {
                ".navbar-caption": {
                  "&:hover, &:focus": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                "top": "3rem",
                "border-radius": "0",
                "@media (max-width: 992px)": {
                  "top": "0"
                },
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%",
                  "top": "0",
                  "border-left": "1px solid transparent"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap",
              "@media (min-width: 991px)": {
                "padding": "0",
                "background-color": "transparent",
                "border": "2px solid @borderColor",
                "& when (@collapsed)": {
                  "border-radius": "0 !important"
                }
              }
            },
            ".navbar-buttons": {
              "text-align": "center",
              ".btn": {
                "white-space": "nowrap",
                "margin-right": "0",
                "padding": "22px 32px",
                "min-height": "auto",
                ".mbr-iconfont": {
                  "width": "32px",
                  "height": "32px",
                  "min-width": "32px",
                  "font-size": "16px",
                  "margin-left": "32px",
                  "margin-right": "-20px"
                },
                "@media (max-width: 575px)": {
                  "width": "auto !important"
                }
              }
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "50px",
              "height": "50px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "border-radius": "100%",
              "background-color": "@menuBgColor !important",
              "border": "none !important",
              "box-shadow": "none !important",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "20px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "18px",
                  "left": "15px",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "left": "15px",
                  "top": "30px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            ".navbar-nav": {
              "margin": "0 auto",
              "& when not (@showButtons)": {
                "justify-content": "flex-end",
                "margin": "0"
              }
            },
            ".nav-item": {
              "padding": "0",
              "margin": "0",
              ".nav-link": {
                "padding": "24px 32px !important",
                "margin": "0 !important",
                "transition": "all 0.3s ease-in-out",
                "font-weight": "400",
                "&::after": {
                  "color": "@activeColor !important",
                  "transform": "rotate(0)",
                  "transition": ".3s"
                },
                "&:hover": {
                  "background-color": "transparent",
                  "color": "@activeColor !important"
                }
              },
              ".nav-link.show": {
                "&::after": {
                  "transform": "rotate(180deg)"
                }
              },
              ".dropdown-menu": {
                "background-color": "transparent !important",
                "&:hover": {
                  "background-color": "transparent !important"
                },
                ".dropdown-item": {
                  "color": "@primaryColor !important",
                  "&:hover": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            "& when (@collapsed)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 5rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "40px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid hsla(0, 0%, 100%, 0.2)"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center"
                  }
                }
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "flex-direction": "column !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 3rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "24px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid hsla(0, 0%, 100%, 0.2)"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center"
                  }
                }
              }
            },
            ".content-wrap": {
              "min-height": "130px"
            }
          },
          "_name": "menu01",
          "_sourceTheme": "glancem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 glancem5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#c75423\" condition=\"showItems\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffffff\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#101012\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://neutral3rd.space\">\n                        <img src=\"@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.webp\" alt=\"Neutral3rd Emerging Tech Development Studio\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-info\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">GlanceM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">OfferBeacon Suite</a></li><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">LearnHub (coming soon)</a></li>\n                    \n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#dev-about\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"index.html\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-bluesky socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-secondary\" href=\"https://studioguide.neutral3rd.space/chat?token=cf7573456c87d54489c7ba5f0a2e93bf&name=Samir%20%7C%20Neutral3rd%20Emerging%20Tech%20Development%20Studio&accent=%23c75423&greet=Hey!%20Welcome%20to%20Neutral3rd.%20I%27m%20Samir%2C%20Neutral3rd%27s%20AI%20studio%20guide.%20I%20can%20help%20you%20explore%20the%20OfferBeacon%20Suite%2C%20learn%20about%20this%20development%20studio%20in%20general%2C%20or%20find%20the%20right%20next%20step.%20What%20brings%20you%20here%20today%3F&face=https%3A%2F%2Fcuevueapp.com%2Fassets%2Ffaces%2Fstandard%2F62227bb3-2f6e-4220-b3c9-2c02b2fdb349.jpg&page=https%3A%2F%2Fstudioguide.neutral3rd.space%2Fneutral3rd-emerging-technologies%2Fsamir-from-neutral3rd-emerging&mode=desktop&lang=en\" data-app-placeholder=\"Type Text\" target=\"_blank\">Start a Conversation</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vz05MEQnSh",
          "_anchor": "menu01-44",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              "padding": "0 32px 32px",
              "@media (max-width: 992px)": {
                "padding": "0 24px 24px"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px"
              },
              ".mbr-desc": {
                "margin-bottom": "0"
              }
            },
            ".text-wrapper": {
              "border-top": "1px solid @border",
              "display": "flex",
              "justify-content": "space-between",
              "padding": "32px",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "24px"
              },
              ".mbr-text": {
                "width": "45%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "24px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".mbr-section-btn": {
              "text-align": "right"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "article04",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 fabm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText_1\" checked>\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText_2\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#72716b\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showTitle || showDesc\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Accessibility</b></h2>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\n                        <a href=\"https://neutral3rd.space\" class=\"text-warning\">Neutral3rd Emerging Technologies Development Studio</a>\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_1\">Effective Date: July 24, 2026<br>Last Updated: October 1, 2026<br><br><br>1. Our Commitment to Accessibility<br><br>At Neutral3rd, we believe technology should make work and everyday experiences more accessible, understandable, and effective.<br><br>Accessibility is an important part of our approach to developing digital communications, software, artificial intelligence solutions, and business technology systems.<br><br>We are committed to improving the accessibility and usability of our website for people with diverse abilities, needs, technologies, and ways of interacting with digital content.<br><br>Our objective is to provide an inclusive experience for visitors, prospective clients, customers, and individuals who use assistive technologies.<br><br>We recognize that accessibility is an ongoing process involving design, development, testing, feedback, and continuous improvement.<br><br>2. Accessibility Standards<br><br>Neutral3rd uses the Web Content Accessibility Guidelines (WCAG) as a reference for accessible digital design and development.<br><br>Our accessibility target for this website is WCAG 2.2 Level AA.<br><br>These internationally recognized guidelines address accessibility needs involving vision, hearing, mobility, cognition, and other disabilities.<br><br>The guidelines are organized around four foundational principles:<br><br>- Perceivable: Information and interface components should be presented in ways users can perceive.<br>-&nbsp;Operable: Navigation and interface components should be usable through different interaction methods.<br>-&nbsp;Understandable: Information and interface behavior should be clear and predictable.<br>-&nbsp;Robust: Content should be compatible with appropriate browsers, devices, and assistive technologies.<br><br>These principles inform our accessibility improvement efforts.<br><br>3. Current Accessibility Status<br><br>Neutral3rd is working toward its stated accessibility target.<br><br>A complete, documented evaluation establishing WCAG 2.2 Level AA conformance across the entire website has not been confirmed for purposes of this statement.<br><br>Accordingly, this statement should not be interpreted as a certification or declaration that every page, component, or third-party integration fully conforms to WCAG 2.2 Level AA.<br><br>We intend to review accessibility concerns, evaluate barriers, and prioritize improvements based on their effect on users.<br><br><b>4. Accessibility Considerations</b><br><br>Our accessibility approach considers the following areas.<br><br><b>4.1 Keyboard Accessibility</b><br>Interactive controls, links, navigation, and forms should be usable without requiring a mouse.<br><br>We seek to identify and address keyboard-access barriers, including inaccessible controls, missing focus indicators, and focus-management problems.<br><br><b>4.2 Screen Reader Compatibility</b><br>We aim to use meaningful content structure, headings, accessible names, labels, and semantic markup to support assistive technologies.<br><br>Screen reader behavior may vary depending on the device, browser, software, and individual configuration.<br><br><b>4.3 Readability &amp; Visual Presentation</b><br>We consider text contrast, typography, spacing, responsive layouts, and information hierarchy when developing website content.<br><br>Our goal is to make information easier to read and navigate across desktop and mobile devices.<br><br><b>4.4 Images &amp; Non-Text Content</b><br>Meaningful images should have appropriate text alternatives where necessary to communicate their purpose.<br><br>Decorative images should be implemented so that they do not create unnecessary barriers for assistive technology users.<br><br><b>4.5 Forms &amp; Interactive Elements</b><br>Forms should provide understandable labels, instructions, error identification, and feedback.<br><br>We aim to improve the usability of contact forms, inquiry processes, buttons, and other interactive elements.<br><br><b>4.6 Motion &amp; Multimedia</b><br>Where animations, video, audio, or other multimedia features are used, we consider accessibility requirements such as captions, alternatives, motion sensitivity, and user control.<br><br><b>4.7 Responsive &amp; Mobile Accessibility</b><br>Our website is intended to support a range of screen sizes and input methods.<br><br>We consider text resizing, content reflow, touch-target usability, and navigation behavior as part of accessibility improvement work.<br><br><b>5. Artificial Intelligence &amp; Accessibility</b><br><br>Neutral3rd develops and implements AI-enabled tools and conversational interfaces.<br><br>We recognize that AI technologies can both improve access to information and introduce new accessibility challenges.<br><br>Relevant considerations include:<br><br>- Accessible chat and messaging interfaces.<br>-&nbsp;Keyboard navigation through conversational controls.<br>-&nbsp;Meaningful labels for input fields and action buttons.<br>-&nbsp;Clear communication of system responses and errors.<br>-&nbsp;Readable and understandable generated content.<br>-&nbsp;Appropriate focus management and status announcements.<br>-&nbsp;Alternatives when automated interactions are inaccessible.<br>-&nbsp;Human review of important or consequential AI-generated information.<br><br>The accessibility of third-party AI platforms and embedded interfaces may depend on their own design, implementation, and ongoing updates.<br><br>Neutral3rd does not represent that every third-party AI component is fully accessible.<br><br><br><br></p>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_2\"><b>6. Known &amp; Potential Limitations\n</b><br>\n<br>Although we aim to improve accessibility, some visitors may encounter barriers.\n<br>\n<br>Areas that may require additional evaluation include:\n<br>\n<br>- Third-party embedded widgets or conversational interfaces.\n<br>\n-&nbsp;Navigation and menu behavior on certain devices.\n<br>\n-&nbsp;Keyboard focus behavior in interactive components.\n<br>\n-&nbsp;Images or visual content that require improved alternatives.\n<br>\n-&nbsp;Video or audio materials requiring accessible equivalents.\n<br>\n-&nbsp;Forms and automated status messages.\n<br>\n-&nbsp;Components affected by changes to browsers, themes, or external services.\n<br>\n<br>These are areas identified for evaluation, not a declaration that each listed issue has been confirmed on the live website.\n<br>\n<br>We encourage users to report specific barriers so they can be investigated.\n<br>\n<br><b>7. Third-Party Content &amp; Services\n</b><br>\n<br>Our website may include content or functionality supplied by external providers.\n<br>\n<br>Examples may include scheduling tools, payment services, AI interfaces, videos, social platforms, and other embedded technologies.\n<br>\n<br>We may not control every aspect of third-party accessibility.\n<br>\n<br>Where a third-party component creates an accessibility barrier, we will consider available alternatives, configuration changes, workarounds, or communication with the provider.\n<br>\n<br><b>8. Requesting Accessibility Assistance\n</b><br>\n<br>If you have difficulty accessing any information, feature, document, or service on the Neutral3rd website, please contact us.\n<br>\n<br>Email: support@neutral3rd.space\n<br>\n<br>To help us investigate, please provide any information you are comfortable sharing, such as:\n<br>\n<br>- The page or feature involved.\n<br>\n-&nbsp;A description of the difficulty.\n<br>\n-&nbsp;The task you were attempting to complete.\n<br>\n-&nbsp;Your browser, device, or assistive technology, if relevant.\n<br>\n-&nbsp;An alternative format or method of assistance that would be useful.\n<br>\n<br>You are not required to disclose a disability diagnosis or sensitive medical information to report an accessibility problem.\n<br>\n<br>We will review reported issues and seek to provide reasonable assistance or an accessible alternative when feasible.\n<br>\n<br><b>9. Alternative Access to Information\n</b><br>\n<br>If website content or an interactive feature is inaccessible, you may request assistance by email.\n<br>\n<br>Depending on the content and circumstances, we may be able to provide information in an alternative electronic format, explain the relevant material, or offer another practical method of communication.\n<br>\n<br>Availability of a particular alternative may depend on the content, technology, and resources involved.\n<br>\n<br><b>10. Accessibility Evaluation &amp; Improvement\n</b><br>\n<br>Our accessibility improvement process may include:\n<br>\n<br>- Reviewing website structure and semantic markup.\n<br>\n-&nbsp;Checking keyboard navigation and visible focus.\n<br>\n-&nbsp;Evaluating text and non-text contrast.\n<br>\n-&nbsp;Reviewing images and text alternatives.\n<br>\n-&nbsp;Testing forms and interactive elements.\n<br>\n-&nbsp;Considering screen reader compatibility.\n<br>\n-&nbsp;Evaluating responsive behavior and content reflow.\n<br>\n-&nbsp;Reviewing multimedia accessibility.\n<br>\n-&nbsp;Assessing relevant third-party integrations.\n<br>- Prioritizing reported barriers and remediation opportunities.\n<br>\n<br>Automated accessibility testing can assist in identifying certain issues but cannot establish complete accessibility on its own.\n<br>\n<br>Manual evaluation and testing with assistive technologies are also important.\n<br>\n<br><b>11. Accessibility in Client Projects\n</b><br>\n<br>Accessibility is a service consideration within Neutral3rd's development and consulting work.\n<br>\n<br>For client projects, the applicable agreement should define the accessibility requirements, technical standards, testing methods, responsibilities, and acceptance criteria.\n<br>\n<br>Where requested, accessibility-related services may include design review, technical assessment, remediation guidance, usability considerations, and accessibility documentation.\n<br>\n<br>Any formal conformance claim or certification must be supported by appropriate evaluation evidence.\n<br>\n<br><b>12. Continuous Improvement\n</b><br>\n<br>Accessibility requirements, assistive technologies, and digital platforms continue to evolve.\n<br>\n<br>We intend to review this statement and our accessibility practices as the website changes.\n<br>\n<br>Feedback from people who experience accessibility barriers is an important source of information for identifying improvements.\n<br>\n<br>We welcome constructive reports and suggestions.\n<br>\n<br><b>13. Contact Information\n</b><br>\n<br>Neutral3rd — Accessibility Support\n<br>\n<br>Email: support@neutral3rd.space\n<br>Website: https://neutral3rd.space\n<br>\n<br>For concerns specifically involving the privacy of information submitted through an accessibility request:\n<br>\n<br>Privacy Officer: privacy@neutral3rd.space\n<br>\n<br>We appreciate the opportunity to improve access to our website and digital services.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vz05MFtiF3",
          "_anchor": "article04-45",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <a href=\"https://neutral3rd.space\"><img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-1-512x512.webp\" alt=\"Neutral3rd Emerging Tech Development Studio\"></a>\n                            </div>\n\n                           <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <!-- <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">xx</p>\n                    </div> -->\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                       <!-- <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3> -->\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\">Neutral3rd helps small businesses and professionals put AI to work in real human work. Led by Renée and supported by AI agents, the studio brings strategy, development, automation, and AI-powered media together to make work more capable without making it more complicated.<br></p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/privacy\" class=\"text-info\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/terms\" class=\"text-info\">TERMS OF SERVICE</a></b></li><a href=\"https://neutral3rd.space/terms\" class=\"text-primary\">\n                                </a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/accessibility\" class=\"text-info\">ACCESSIBILITY</a></b></li><li class=\"item-wrap\"><b><a href=\"https://connections.neutral3rd.space/wall\" class=\"text-info\" target=\"_blank\">LEAVE YOUR FEEDBACK</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://offerbeacon.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">HELP THE RIGHT BUYERS FIND YOU</a></b></li>\n<li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space\" class=\"text-info\">LEARN HUB</a>&nbsp;(coming soon)</b></li><li class=\"item-wrap\"><b><a href=\"https://perspectives.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">NEUTRAL3RD PERSPECTIVES</a></b></li><a href=\"https://neutral3rd.space\" class=\"text-primary\">\n</a><li class=\"item-wrap\"><b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-info\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Tech Development Studio. Operated by Rowdy Independents LLC., a U.S.-based business entity. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vz05MG30Ta",
          "_anchor": "footer01-46",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "page4.html": {
      "settings": {
        "title": "Page 4",
        "meta_descr": "Learn how Neutral3rd collects, uses, protects, and manages personal information across its website, AI-powered solutions, digital products, and services.",
        "header_custom": "<meta name=\"robots\" content=\"noindex, nofollow\">",
        "footer_custom": "<style>\n/* Neutral3rd: Basic Image Protection */\nimg {\n  -webkit-user-drag: none;\n  user-drag: none;\n  -webkit-touch-callout: none;\n}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  // Prevent the image-specific right-click menu.\n  document.addEventListener(\"contextmenu\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n\n  // Prevent dragging images onto the desktop.\n  document.addEventListener(\"dragstart\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n})();\n</script>",
        "html_before": "",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.webp",
        "order": "5"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "110px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding-left": "108px",
                "padding-right": "108px",
                "@media (max-width: 1440px)": {
                  "padding-left": "64px",
                  "padding-right": "64px"
                },
                "@media (max-width: 992px)": {
                  "padding-left": "16px",
                  "padding-right": "16px"
                }
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border": "2px solid @borderColor",
              "background": "@menuBgColor !important",
              "color": "@primaryColor !important",
              "&:hover, &:focus": {
                "background": "@menuBgColor !important",
                "color": "@primaryColor !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "0 auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              },
              "max-width": "1600px"
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "transition": "all 0.3s ease-in-out",
              "&:hover": {
                "color": "@activeColor !important"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "1.6rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "110px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 3.2rem 0.5rem 1.8rem",
                "border-radius": "0"
              },
              ".navbar-logo img": {
                "width": "auto",
                "border-radius": "6px !important"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(98.5vh - @{logoSize}rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
