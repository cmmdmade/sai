        {
          "alias": false,
          "_styles": {
            "position": "relative",
            "isolation": "isolate",
            "overflow": "hidden",
            "min-height": "680px",
            "background-color": "#101112",
            "background-position": "center center",
            "background-size": "cover",
            "color": "#F9F6E0",
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".n3-hero-media": {
              "position": "absolute",
              "z-index": "0",
              "inset": "0",
              "overflow": "hidden",
              "pointer-events": "none"
            },
            ".n3-hero-image-frame": {
              "position": "absolute",
              "inset": "0 0 0 auto",
              "width": "100%",
              "height": "100%",
              "background-size": "cover",
              "background-repeat": "no-repeat",
              "background-position": "center center"
            },
            ".n3-hero-image-shade": {
              "position": "absolute",
              "inset": "0",
              "z-index": "1",
              "pointer-events": "none",
              "background": "linear-gradient(90deg, rgba(10, 11, 12, 1) 0%, rgba(10, 11, 12, 0.99) 19%, rgba(10, 11, 12, 0.91) 36%, rgba(10, 11, 12, 0.68) 53%, rgba(10, 11, 12, 0.22) 75%, rgba(10, 11, 12, 0.08) 100%), linear-gradient(0deg, rgba(10, 11, 12, 0.65) 0%, transparent 27%, transparent 78%, rgba(10, 11, 12, 0.2) 100%)"
            },
            ".n3-hero-container": {
              "position": "relative",
              "z-index": "2",
              "width": "100%",
              "min-height": "620px",
              "display": "flex",
              "align-items": "center"
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding-left": "6%",
                "padding-right": "6%"
              }
            },
            ".n3-hero-content": {
              "position": "relative",
              "z-index": "3",
              "width": "100%",
              "max-width": "700px",
              "padding": "30px 0"
            },
            ".n3-hero-eyebrow": {
              "color": "@goldAccent !important",
              "font-size": "0.78rem",
              "font-weight": "800",
              "letter-spacing": "0.2em",
              "line-height": "1.5",
              "margin": "0 0 17px",
              "text-transform": "uppercase"
            },
            ".n3-hero-brand": {
              "color": "#ffffff",
              "font-size": "clamp(3.6rem, 7vw, 7rem)",
              "font-weight": "800",
              "line-height": "0.98",
              "letter-spacing": "-0.065em",
              "margin": "0 0 23px"
            },
            ".n3-hero-brand .n3-gold": {
              "color": "@goldAccent !important"
            },
            ".n3-hero-headline": {
              "color": "#d7d7d7",
              "font-size": "clamp(1.7rem, 3.15vw, 3.15rem)",
              "font-weight": "700",
              "line-height": "1.12",
              "letter-spacing": "-0.025em",
              "margin": "0 0 22px"
            },
            ".n3-hero-description": {
              "color": "#d7d7d7",
              "max-width": "610px",
              "font-size": "clamp(1rem, 1.22vw, 1.2rem)",
              "line-height": "1.65",
              "margin": "0 0 30px"
            },
            ".n3-hero-buttons": {
              "display": "flex",
              "flex-wrap": "wrap",
              "align-items": "center",
              "gap": "12px",
              "margin": "0 0 32px",
              "padding": "0",
              "text-align": "left"
            },
            ".n3-hero-buttons .btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "gap": "14px",
              "min-height": "49px",
              "margin": "0",
              "padding": "13px 23px",
              "border-radius": "3px",
              "font-size": "0.83rem",
              "font-weight": "800",
              "line-height": "1.3",
              "letter-spacing": "0.025em",
              "text-decoration": "none",
              "text-transform": "uppercase",
              "box-shadow": "none"
            },
            ".n3-hero-buttons .btn-primary": {
              "background-color": "@goldAccent !important",
              "border": "1px solid @goldAccent !important",
              "color": "#15120A !important"
            },
            ".n3-hero-buttons .btn-primary:hover": {
              "background-color": "#F4CD62 !important",
              "border-color": "#F4CD62 !important",
              "color": "#15120A !important"
            },
            ".n3-hero-buttons .btn-secondary": {
              "background-color": "rgba(10, 10, 10, 0.35) !important",
              "border": "1px solid @goldAccent !important",
              "color": "#F9F6E0 !important"
            },
            ".n3-hero-buttons .btn-secondary:hover": {
              "background-color": "@goldAccent !important",
              "color": "#15120A !important"
            },
            ".n3-hero-buttons .btn:focus-visible": {
              "outline": "3px solid #FFFFFF",
              "outline-offset": "3px"
            },
            ".n3-hero-keywords": {
              "color": "#E6E3D9 !important",
              "font-size": "0.75rem",
              "font-weight": "700",
              "letter-spacing": "0.14em",
              "line-height": "1.8",
              "margin": "0"
            },
            ".n3-hero-keywords span": {
              "color": "@goldAccent",
              "padding": "0 7px"
            },
            "@media (min-width: 993px) and (max-width: 1199px)": {
              ".n3-hero-content": {
                "max-width": "600px"
              },
              ".n3-hero-image-shade": {
                "background": "linear-gradient(90deg, rgba(10, 11, 12, 1) 0%, rgba(10, 11, 12, 0.98) 23%, rgba(10, 11, 12, 0.85) 46%, rgba(10, 11, 12, 0.26) 100%)"
              }
            },
            "@media (max-width: 992px)": {
              "min-height": "650px",
              ".n3-hero-container": {
                "min-height": "650px"
              },
              ".n3-hero-content": {
                "max-width": "630px",
                "padding": "45px 0"
              },
              ".n3-hero-image-frame": {
                "width": "100% !important"
              },
              ".n3-hero-image-shade": {
                "background": "linear-gradient(90deg, rgba(10, 11, 12, 0.96) 0%, rgba(10, 11, 12, 0.89) 35%, rgba(10, 11, 12, 0.54) 100%), linear-gradient(0deg, rgba(10, 11, 12, 0.72) 0%, transparent 65%)"
              },
              ".n3-hero-brand": {
                "font-size": "clamp(3.6rem, 9vw, 5.8rem)"
              }
            },
            "@media (max-width: 575px)": {
              "min-height": "690px",
              ".n3-hero-container": {
                "min-height": "690px",
                "padding-left": "24px",
                "padding-right": "24px"
              },
              ".n3-hero-content": {
                "padding": "45px 0"
              },
              ".n3-hero-image-shade": {
                "background": "linear-gradient(180deg, rgba(10, 11, 12, 0.7) 0%, rgba(10, 11, 12, 0.9) 40%, rgba(10, 11, 12, 0.98) 100%)"
              },
              ".n3-hero-eyebrow": {
                "font-size": "0.69rem",
                "letter-spacing": "0.14em"
              },
              ".n3-hero-brand": {
                "font-size": "clamp(3.3rem, 12vw, 4.8rem)",
                "margin-bottom": "20px"
              },
              ".n3-hero-headline": {
                "font-size": "clamp(1.65rem, 6vw, 2.3rem)"
              },
              ".n3-hero-description": {
                "font-size": "0.98rem",
                "line-height": "1.6"
              },
              ".n3-hero-buttons": {
                "flex-direction": "column",
                "align-items": "stretch"
              },
              ".n3-hero-buttons .btn": {
                "width": "100%"
              },
              ".n3-hero-keywords": {
                "font-size": "0.68rem",
                "letter-spacing": "0.07em"
              },
              ".n3-hero-keywords span": {
                "padding": "0 3px"
              }
            },
            "P": {
              "color": "#ffffff"
            }
          },
          "_name": "header01",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features08 fabm5 neutral3rd-hero\" id=\"neutral3rd-hero\" group=\"Features\" mbr-class=\"{\n  'mbr-fullscreen': fullScreen,\n  'mbr-parallax-background': bg.parallax\n }\">\n\n<mbr-parameters>\n\n  <header>Size</header>\n\n  <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\n  <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n\n  <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n\n  <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n\n\n  <header>Hero Content</header>\n\n  <input type=\"checkbox\" title=\"Eyebrow\" name=\"showEyebrow\" checked>\n\n  <input type=\"checkbox\" title=\"Description\" name=\"showDescription\" checked>\n\n  <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n\n  <input type=\"checkbox\" title=\"Keywords\" name=\"showKeywords\" checked>\n\n\n  <!-- HERO IMAGE CONTROL -->\n\n  <header>Hero Image</header>\n\n  <input type=\"checkbox\" title=\"Show Hero Image\" name=\"showHeroImage\" checked>\n\n  <input type=\"image\" title=\"Select Hero Image\" name=\"heroImage\" value=\"@PROJECT_PATH@/assets/images/ai20business20guide20workspace-1932x1087.webp\">\n\n  <input type=\"range\" inline title=\"Image Width\" name=\"imageWidth\" min=\"35\" max=\"100\" step=\"5\" value=\"70\">\n\n  <input type=\"range\" inline title=\"Image Position X\" name=\"imagePositionX\" min=\"0\" max=\"100\" step=\"5\" value=\"75\">\n\n  <input type=\"range\" inline title=\"Image Position Y\" name=\"imagePositionY\" min=\"0\" max=\"100\" step=\"5\" value=\"100\">\n\n\n  <header>Colors</header>\n\n  <input type=\"color\" title=\"Gold Accent\" name=\"goldAccent\" value=\"#c75423\">\n\n  <input type=\"color\" title=\"Heading Color\" name=\"headingColor\" value=\"#F9F6E0\">\n\n\n  <!-- BACKGROUND + PARALLAX -->\n\n  <header>Background</header>\n\n  <fieldset type=\"background\" name=\"bg\" parallax>\n\n    <input type=\"color\" title=\"Color\" value=\"#101112\" selected>\n\n    <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n\n  </fieldset>\n\n  <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\n  <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101112\" condition=\"overlay && bg.type !== 'color'\">\n\n  <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\n</mbr-parameters>\n\n\n<!-- BACKGROUND OVERLAY -->\n\n<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\">\n</div>\n\n\n<!-- CINEMATIC IMAGE LAYER -->\n\n<div class=\"n3-hero-media\" mbr-if=\"showHeroImage\">\n\n  <div class=\"n3-hero-image-frame\" mbr-style=\"{\n    'background-image': url(heroImage),\n    'background-position': imagePositionX + '% ' + imagePositionY + '%',\n    'width': imageWidth + '%'\n   }\">\n  </div>\n\n  <div class=\"n3-hero-image-shade\" aria-hidden=\"true\"></div>\n\n</div>\n\n\n<!-- MAIN CONTENT -->\n\n<div class=\"n3-hero-container\" mbr-class=\"{\n  'container': !fullWidth,\n  'container-fluid': fullWidth\n }\">\n\n  <div class=\"n3-hero-content\">\n\n    <!-- EYEBROW -->\n\n    <p class=\"n3-hero-eyebrow mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showEyebrow\">Emerging Technologies DEVELOPMENT STUDIO\n    </p>\n\n\n    <!-- BRAND -->\n\n    <h1 class=\"n3-hero-brand mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".n3-hero-brand\"><b>\n      Neutral<span class=\"n3-gold\"><b>3rd</b></span></b>\n    </h1>\n\n\n    <!-- HEADLINE -->\n\n    <h2 class=\"n3-hero-headline mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".n3-hero-headline\">\n      Practical AI Solutions<br>\n      for Real Human Work.\n    </h2>\n\n\n    <!-- DESCRIPTION -->\n\n    <p class=\"n3-hero-description mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDescription\" data-app-selector=\".n3-hero-description\">\n      Combining human insight and creativity with AI to build smarter workflows, intelligent systems, and AI-powered media. From strategy and enablement to implementation, assurance, image, audio and video production, Neutral3rd&nbsp; helps businesses and professionals turn AI possibilities into practical results. Working&nbsp;smarter,\n      serving better, and growing with confidence.\n    </p>\n\n\n    <!-- BUTTONS -->\n\n    <div class=\"n3-hero-buttons mbr-section-btn\" mbr-if=\"showButtons\">\n\n     <!-- <a class=\"btn btn-primary display-4\" href=\"#\">\n        EXPLORE THE BUILDS\n        <span aria-hidden=\"true\">→</span>\n      </a> -->\n\n      <a class=\"btn btn-secondary display-4\" href=\"#\">\n        START A CONVERSATION\n        <span aria-hidden=\"true\">→</span>\n      </a>\n\n    </div>\n\n\n    <!-- KEYWORDS -->\n\n    <p class=\"n3-hero-keywords mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showKeywords\">\n      IDEAS <span>|</span>\n      SYSTEMS <span>|</span>\n      AUTOMATION <span>|</span>\n      REAL IMPACT\n    </p>\n\n  </div>\n\n</div>\n\n</section>",
          "_cid": "tPfidOb3iJ",
          "_anchor": "header01-1",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".row": {
              "justify-content": "center",
              "border-top": "1px solid @border",
              "@media (min-width: 992px)": {
                "margin": "0"
              },
              "@media (max-width: 992px)": {
                "border": "none"
              },
              ".item": {
                "padding": "0 32px 0 0",
                "border-radius": "0 !important",
                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".item-wrapper": {
              "height": "100%",
              ".card-box": {
                "display": "flex",
                "height": "100%",
                "@media (max-width: 992px)": {
                  "display": "block"
                }
              }
            },
            ".subtitle-wrap": {
              "display": "flex",
              "justify-content": "flex-end",
              "@media (max-width: 992px)": {
                "display": "block"
              },
              ".mbr-section-subtitle": {
                "padding": "32px",
                "writing-mode": "tb",
                "transform": "rotate(180deg)",
                "margin": "0",
                "@media (max-width: 992px)": {
                  "transform": "rotate(0)",
                  "writing-mode": "horizontal-tb",
                  "padding": "24px",
                  "border-left": "1px solid @border",
                  "text-align": "left"
                }
              }
            },
            ".content-wrapper": {
              "padding": "32px",
              "border-left": "1px solid @border",
              "@media (max-width: 992px)": {
                "padding": "24px",
                "border-top": "1px solid @border",
                "border-left": "1px solid @border"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px"
              },
              ".mbr-text": {
                "margin-bottom": "0",
                "@media (max-width: 992px)": {
                  "text-align": "left"
                }
              },
              ".mbr-section-btn": {
                "margin-top": "32px",
                "@media (max-width: 992px)": {
                  "text-align": "left",
                  "margin-top": "24px"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0"
            },
            ".mbr-section-subtitle": {
              "color": "#c75423",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#d7d7d7"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "features05",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features05 fabm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Border Color\" value=\"#72716b\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#474A48\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            \n            <div class=\"col-12 col-lg-6 item features-without-image item-mb active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"subtitle-wrap\">\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\"><b>First Key Principle</b></h3>\n                        </div>\n                        <div class=\"content-wrapper\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                                <b>People Before Platforms</b></h2>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">AI should make work simplier, more accessible, and more effective. I design solutions around real people, real workflows, and real goals - with clarity, transparency, and practical results.</p>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                    <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                    READ MORE\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div><div class=\"col-12 col-lg-6 item features-without-image item-mb\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"subtitle-wrap\">\n                            <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                                <b>Second Key Principle</b>\n                            </h3>\n                        </div>\n                        <div class=\"content-wrapper\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                                <b>Built for Real Work</b></h2>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                                Custom AI tools, automations, and systems that are reliable, secured, have continued support, and easy to use. No unnecessary complexity - just practical solutions that fit how you and your business work.</p>\n                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                                <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                    <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                    READ MORE\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
