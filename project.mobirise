          "_name": "features03",
          "_sourceTheme": "neuralm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 neuralm5\" group=\"Features\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Animated Text Settings</header>\n        <select title=\"Font style\" name=\"linesTitle\">\n            <option value=\"title1\" selected>Title 1</option>\n            <option value=\"title2\">Title 2</option>\n        </select>\n        <input type=\"text\" title=\"Line content 1 <br> (For the best experience, please write at least 100 characters)\" inline=\"\" name=\"animatedLine1\" value=\"// Human-centered AI Development // AI Tools // AI Agents // Automations // AI-based Software               // AI-based Software // Audio/Video // Content Developer\">\n        <select title=\"Direction 1\" name=\"direction1\">\n            <option value=\"-1\">Left</option>\n            <option value=\"1\" selected>Right</option>\n        </select>\n        <input type=\"color\" title=\"Content Color 1\" value=\"#121212\" name=\"contentColor_1\" selected>\n        <input type=\"color\" title=\"Content BG 1\" value=\"#c75423\" name=\"contentBG_1\" selected>\n        <input type=\"checkbox\" title=\"Line 2\" name=\"showLine2\" checked>\n        <input type=\"text\" title=\"Line content 2 <br> (For the best experience, please write at least 100 characters)\" inline=\"\" name=\"animatedLine2\" value=\"// Renée Leach // AI Enablement Consultant/Software Developer // Renée Leach               // AI Enablement Consultant/Software Developer // Renée Leach\" condition=\"showLine2\">\n        <select title=\"Direction 2\" name=\"direction2\" condition=\"showLine2\">\n            <option value=\"-1\" selected>Left</option>\n            <option value=\"1\">Right</option>\n        </select>\n        <input type=\"color\" title=\"Content Color 2\" value=\"#ffffff\" name=\"contentColor_2\" selected condition=\"showLine2\">\n        <input type=\"color\" title=\"Content BG 2\" value=\"#121212\" name=\"contentBG_2\" selected condition=\"showLine2\">\n        <input type=\"range\" inline title=\"Line speed\" name=\"speed\" min=\"0.01\" max=\"0.09\" step=\"0.01\" value=\"0.01\">\n        <header>Background</header>\n        <fieldset type=\"background\" parallax name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#121212\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fff7ee\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container-fluid\">\n\n        <div class=\"content-wrap_1\">\n            <div class=\"loop-container container_1\">\n                <div class=\"item item_1\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2'}\" data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction1}}\" data-speed=\"{{speed}}\"></div>\n                <div class=\"item item_1\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2'}\" data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction1}}\" data-speed=\"{{speed}}\"></div>\n            </div>\n        </div>\n\n        <div class=\"content-wrap_2\" mbr-if=\"showLine2\">\n            <div class=\"loop-container container_2\">\n                <div class=\"item item_2\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2'}\" data-linewords=\"{{animatedLine2}}\" data-direction=\"{{direction2}}\" data-speed=\"{{speed}}\"></div>\n                <div class=\"item item_2\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2'}\" data-linewords=\"{{animatedLine2}}\" data-direction=\"{{direction2}}\" data-speed=\"{{speed}}\"></div>\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_cid": "vyHuuCVRIb",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "features03-1y"
