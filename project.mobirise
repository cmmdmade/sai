                }
              }
            },
            ".content-wrapper": {
              "display": "grid",
              "grid-template-columns": "2fr 1fr",
              "gap": "40px",
              "@media (max-width: 1640px)": {
                "grid-template-columns": "1fr"
              },
              "& when not (@fullWidth)": {
                "grid-template-columns": "1fr"
              },
              ".content-wrap": {
                ".label-wrapper": {
                  "margin-bottom": "16px",
                  ".label-wrap": {
                    "display": "inline-flex",
                    "gap": "4px",
                    ".marker-wrapper": {
                      "display": "inline-flex",
                      "width": "12px",
                      "height": "12px",
                      "min-width": "12px",
                      "border": "3px solid @labelMarker",
                      "border-radius": "100%",
                      "margin-top": "6px"
                    },
                    ".mbr-label": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".mbr-section-title": {
                  "margin-bottom": "12px"
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-block",
                    "width": "80%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "margin-top": "14px",
                  "margin-bottom": "-9.6px"
                }
              },
              ".items-wrapper": {
                "display": "grid",
                "grid-template-columns": "1fr",
                "gap": "32px",
                "@media (max-width: 1640px)": {
                  "grid-template-columns": "1fr 1fr"
                },
                "@media (max-width: 768px)": {
                  "grid-template-columns": "1fr"
                },
                "& when (@showBorder)": {
                  "border-left": "1px solid @border",
                  "padding-left": "40px",
                  "@media (max-width: 992px)": {
                    "padding-left": "24px"
                  }
                },
                "& when not (@fullWidth)": {
                  "grid-template-columns": "1fr 1fr",
                  "@media (max-width: 768px)": {
                    "grid-template-columns": "1fr"
                  }
                },
                ".item": {
                  ".item-wrapper": {
                    ".item-title": {
                      "margin-bottom": "0"
                    },
                    ".item-number": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".btn-wrapper": {
              "margin-top": "-2.5rem"
            },
            ".mbr-label": {
              "color": "#c0c0c0"
