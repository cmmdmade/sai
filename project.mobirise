          "_name": "article01",
          "_sourceTheme": "walletm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article01 walletm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/walletm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#02050a\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/walletm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".mbr-label\">\n                        Personal Finance &amp; Wealth Management\n                    </p>\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn, .title-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">We look for substance before popularity, fit before hype, and reasons before recommendations.\n<br>\n<br>That is the Select Access Index standard.<br></h2>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Start now\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vu3WmyoJM0",
          "_anchor": "article01-15",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding": "0"
            },
            ".items-wrapper": {
              "margin": "0",
              ".card": {
                "padding": "0"
              }
            },
            ".border-wrap": {
              "width": "100%",
              "height": "1px",
              "background-color": "@border"
            },
            ".nav-wrapper": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "100px",
              "padding": "60px 40px 60px 48px",
              "height": "100%",
              "@media (max-width: 992px)": {
                "padding": "24px",
                "gap": "48px"
              },
              ".nav-wrap": {
                ".list": {
                  "padding": "0",
                  "margin": "0",
                  "list-style": "none",
                  "width": "fit-content",
                  ".item-wrap": {
                    "width": "fit-content",
                    "position": "relative",
                    "transition": "all .3s ease",
                    "margin-bottom": "16px",
                    "&::before": {
                      "content": "''",
                      "position": "absolute",
                      "bottom": "-2px",
                      "left": "0",
                      "width": "12px",
                      "height": "2px",
                      "background-color": "@activeNav",
                      "transition": "all .3s ease"
                    },
                    "&:last-child": {
                      "margin-bottom": "0"
                    },
                    "&:hover, &:focus": {
                      "color": "@activeNav",
                      "&::before": {
                        "width": "100%"
                      }
                    }
                  }
                }
              }
            },
            ".content-wrapper": {
              "padding": "60px 40px 60px 40px",
              "background-color": "@cardBg",
              "height": "100%",
              "@media (max-width: 992px)": {
                "padding": "24px"
              },
              "& when (@showBorder)": {
                "border-left": "1px solid @border",
                "border-right": "1px solid @border",
                "@media (max-width: 992px)": {
                  "border-left": "none",
                  "border-right": "none",
                  "border-top": "1px solid @border",
                  "border-bottom": "1px solid @border"
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "12px"
              },
              ".mbr-text": {
                "margin-bottom": "0"
              },
              ".mbr-section-btn": {
                "margin-top": "14px",
                "margin-bottom": "-9.6px"
              }
            },
            ".social-wrapper": {
              "height": "100%",
              ".soc-item": {
                "padding": "20px 24px",
                "display": "flex",
                "justify-content": "space-between",
                "gap": "16px",
                "transition": "all .3s ease",
                "& when (@showBorder)": {
                  "border-top": "1px solid @border",
                  "&:first-child": {
                    "border-top": "none"
                  }
                },
                "&:hover, &:hover": {
                  "background-color": "@activeSocBg",
                  ".soc-item": {
                    "color": "@activeSoc"
                  },
                  ".mbr-iconfont": {
                    "color": "@activeSoc !important"
                  },
                  "a.mbr-iconfont": {
                    "color": "@activeSoc !important"
                  }
                },
                ".mbr-soc": {
                  "margin-bottom": "0",
                  "transition": "all .3s ease"
                },
                "a": {
                  "display": "block",
                  ".mbr-iconfont": {
                    "display": "inline-flex",
                    "font-size": "24px",
                    "transition": "all 0.3s ease-in-out"
                  }
                }
              }
            },
            ".mbr-copy": {
              "padding": "40px",
              "margin-bottom": "0",
              "@media (max-width: 992px)": {
                "padding": "24px"
              },
              "color": "#6f6f75",
              "text-align": "center"
            },
            ".list": {
              "color": "#333336"
            },
            ".mbr-section-title": {
              "color": "#333336"
            },
            ".mbr-text": {
              "color": "#333336"
            },
            ".mbr-soc": {
              "color": "#333336"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "elementm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 elementm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Card Bg\" value=\"#f6f6f6\" name=\"cardBg\" condition=\"showTitle || showText || showButtons\" selected>\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"2\" step=\"1\" value=\"1\" condition=\"showNav\">\n        <input type=\"color\" title=\"Active Color\" value=\"#ff4400\" name=\"activeNav\" condition=\"showNav\" selected>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Amount\" name=\"soc\" min=\"1\" max=\"5\" step=\"1\" value=\"5\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Active Color\" value=\"#ffffff\" name=\"activeSoc\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Active BG\" value=\"#ff4400\" name=\"activeSocBg\" condition=\"showSocial\" selected>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#e6e6e6\" name=\"border\" condition=\"showBorder\" selected>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row items-wrapper justify-content-center\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 card\">\n                <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\" mbr-if=\"showNav\">\n                <div class=\"nav-wrapper\">\n                    <div class=\"nav-wrap\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\"><a href=\"index.html\" class=\"text-primary\">Home</a></li>\n                            <li class=\"item-wrap\"><a href=\"sei.html\" class=\"text-primary\">The Index</a></li>\n                            <li class=\"item-wrap\"><a href=\"standards.html\" class=\"text-primary\">Our Standards</a></li><a href=\"page2.html\" class=\"text-primary\">\n                            </a><li class=\"item-wrap\">Contact</li>\n                        </ul>\n                    </div>\n                    <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\">Digital Products</li>\n                            <li class=\"item-wrap\">AI &amp; Software</li>\n                            <li class=\"item-wrap\">Online Services</li>\n                            <li class=\"item-wrap\">Business Tools</li><li class=\"item-wrap\">Premium Offers</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showTitle || showText || showButtons\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">Stay Ahead of the Mainstream</h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Occasional updates when something genuinely earns a closer look.\n                    </p>\n<div id=\"raim-form-embed-1\"></div>\n[JS_CODE_0]\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 card\" mbr-if=\"showSocial\">\n                <div class=\"social-wrapper\">\n                    <div class=\"social-wrap\">\n                        <div class=\"soc-item\">\n                            <p class=\"mbr-soc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-soc\">\n                                Privacy</p>\n                            <a href=\"https://mobiri.se/\">\n                                <span mbr-icon class=\"mbr-iconfont card-icon mdi-hardware-security\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 68, 0); fill: rgb(255, 68, 0);\"></span>\n                            </a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                            <p class=\"mbr-soc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-soc\">\n                                Terms</p>\n                            <a href=\"https://mobiri.se/\">\n                                <span mbr-icon class=\"mbr-iconfont icon54-v4-webpage\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 68, 0); fill: rgb(255, 68, 0);\"></span>\n                            </a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"soc > 2\">\n                            <p class=\"mbr-soc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-soc\">\n                                Affiliate Disclosure</p>\n                            <a href=\"https://mobiri.se/\">\n                                <span mbr-icon class=\"mbr-iconfont icon54-v1-search-money\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 68, 0); fill: rgb(255, 68, 0);\"></span>\n                            </a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"soc > 3\">\n                            <p class=\"mbr-soc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-soc\">\n                                Editorial Policy</p>\n                            <a href=\"https://mobiri.se/\">\n                                <span mbr-icon class=\"mbr-iconfont icon54-v4-webpage\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 68, 0); fill: rgb(255, 68, 0);\"></span>\n                            </a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"soc > 4\">\n                            <p class=\"mbr-soc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-soc\"><b>Back To The Top</b></p>\n                            <a href=\"https://mobiri.se/\">\n                                <span mbr-icon class=\"mbr-iconfont fa-arrow-up fa\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 68, 0); fill: rgb(255, 68, 0);\"></span>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 card\">\n                <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n            </div>\n            <div class=\"col-12 card\">\n                <p class=\"mbr-copy mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\"><b>\n                    © 2026 <a href=\"index.html\" class=\"text-primary\">Select Access Index</a> - All Rights Reserved.</b><br>This is an independent editorial directory. Some links may be affiliate links, meaning compensation may be received from qualifying purchases or actions. Inclusion does not guarantee results or constitute financial, investment or business advice. Always evaluate an offer based on your own circumstances.<br></p>\n            </div>\n        </div>\n    </div>\n</section>",
