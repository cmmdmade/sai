        "meta_descr": "Neutral3rd is Renée Leach’s AI-powered development studio, combining human direction and AI agents to build practical technology, automation, and media for real work.",
        "header_custom": "",
        "footer_custom": "<!-- SocialJuice -->\n<script src=\"https://collect.socialjuice.io/widget.js\" data-space=\"10643\" async></script>\n<!-- End SocialJuice -->\n\n<style>\n/* Neutral3rd: Basic Image Protection */\nimg {\n  -webkit-user-drag: none;\n  user-drag: none;\n  -webkit-touch-callout: none;\n}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  // Prevent the image-specific right-click menu.\n  document.addEventListener(\"contextmenu\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n\n  // Prevent dragging images onto the desktop.\n  document.addEventListener(\"dragstart\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n})();\n</script>\n\n\n<!-- Strategic Analytics Tag Manager -->\n<script type=\"text/javascript\">\nvar _mtm = window._mtm = window._mtm || [];\n_mtm.push({\"mtm.startTime\": (new Date().getTime()), \"event\": \"mtm.Start\"});\nvar d=document, g=d.createElement(\"script\"), s=d.getElementsByTagName(\"script\")[0];\ng.type=\"text/javascript\"; g.async=true; g.src=\"https://track.stratanalytics.com/js/container_J1LY7Kmm.js\"; s.parentNode.insertBefore(g,s);\n</script>\n<!-- End Strategic Analytics Tag Manager -->",
        "html_before": "",
