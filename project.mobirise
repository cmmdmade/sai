              "&:hover, &:focus": {
                ".item-img img": {
                  "transform": "scale(1.1)"
                }
              },
              ".item-img": {
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "transition": "all .3s ease"
                }
              },
              ".card-box": {
                "position": "relative",
                "z-index": "1",
                "padding": "32px",
                "@media (max-width: 992px)": {
                  "padding": "24px"
                },
                ".item-title_1": {
                  "margin-bottom": "12px"
                },
                ".item-text": {
                  "margin-bottom": "0"
                },
                ".item-btn": {
                  "margin-top": "4px",
                  "margin-bottom": "-9.6px"
                },
                ".title-wrap": {
                  ".card-title": {
                    "display": "inline-flex",
                    "gap": "4px",
                    ".marker-wrapper": {
                      "display": "inline-flex",
                      "width": "16px",
                      "height": "16px",
                      "min-width": "16px",
                      "border": "4px solid @cardMarker",
                      "border-radius": "100%",
                      "margin-top": "6px"
                    },
                    ".item-title": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".card_1, .card_2": {
              ".card-box": {
                ".item-text": {
                  "& when (@showCardMarker)": {
                    "padding-left": "20px",
                    "@media (max-width: 992px)": {
                      "padding-left": "0"
                    }
                  }
                },
                ".item-btn": {
                  "& when (@showCardMarker)": {
                    "padding-left": "20px",
                    "@media (max-width: 992px)": {
                      "padding-left": "0"
                    }
                  }
                }
              }
            },
            ".card_1": {
              "&::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-image": "linear-gradient(135deg, @overColor 0, transparent 150%)",
                "pointer-events": "none",
                "z-index": "1"
              }
            },
            ".card_2": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "flex-end",
              "@media (max-width: 992px)": {
                "justify-content": "flex-start"
              },
              "&::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-image": "linear-gradient(45deg, @overColor 0, transparent 150%)",
                "pointer-events": "none",
                "z-index": "1",
                "@media (max-width: 992px)": {
                  "background-image": "linear-gradient(135deg, @overColor 0, transparent 150%)"
                }
              }
            },
            ".card_3": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center",
              "@media (max-width: 992px)": {
                "justify-content": "flex-start"
              },
              "&::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-color": "@overColor",
                "opacity": "@overOpacity",
                "pointer-events": "none",
                "z-index": "1"
              }
            },
            ".mbr-label": {
              "color": "#333336"
            },
            ".mbr-desc": {
              "color": "#333336"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#333336"
            },
            ".item-title_1": {
              "color": "#ff4400"
            },
            ".item-text, .text-wrap": {
              "color": "#333336"
            },
            ".mbr-label, .label-wrapper": {
              "text-align": "center"
            },
            ".mbr-desc, .desc-wrapper, .iconfont-wrapper": {
              "text-align": "center"
            },
            ".mbr-section-title, .main-btn": {
              "text-align": "center"
            }
          },
          "_name": "features01",
          "_sourceTheme": "elementm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features01 elementm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label BG\" value=\"#ffffff\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#e6e6e6\" name=\"labelBorder\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"BG 1\" value=\"#f6f6f6\" name=\"cardBg_1\" selected>\n        <input type=\"color\" title=\"BG 2\" value=\"#ff4400\" name=\"cardBg_2\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Marker\" name=\"showCardMarker\" condition=\"showCardTitle\" checked>\n        <input type=\"color\" title=\"Marker Color\" value=\"#ff4400\" name=\"cardMarker\" condition=\"showCardTitle && showCardMarker\" selected>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons 1\" name=\"showButtons_1\">\n        <input type=\"checkbox\" title=\"Buttons 2\" name=\"showButtons_2\" checked>\n        <input type=\"color\" title=\"Card Overlay\" name=\"overColor\" value=\"#f6f6f6\">\n        <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"row items-wrapper justify-content-center\">\n                    <div class=\"col-12 col-lg-4 item features-image\">\n                        <div class=\"item-wrapper card_1 card-wrap\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20aug20312020262003-19-1720pm-1101x826.png\" alt=\"Mobirise Website Builder\">\n                            </div>\n                            <div class=\"card-box\">\n                                <div class=\"title-wrap\" mbr-if=\"showCardTitle\">\n                                    <div class=\"card-title\">\n                                        <div class=\"marker-wrapper\" mbr-if=\"showCardMarker\"></div>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .title-wrap\">Clear Use Case</h4>\n                                    </div>\n                                </div>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                    It should solve a real problem, improve a process or create a meaningful advantage.\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons_1\" data-toolbar=\"-mbrBtnMove\">\n                                    <a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                        read more\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-lg-4 item\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"content-wrap card-wrap\">\n                                <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                                    <p class=\"mbr-label card-wrap large-radius mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-label, .label-wrapper\">OUR FILTER</p>\n                                </div>\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"cards-icon mbr-iconfont mobi-mbri-user-2 mobi-mbri\" data-app-selector=\".cards-icon\" style=\"color: rgb(255, 68, 0); fill: rgb(255, 68, 0);\"></span>\n                                </div>\n                                <div class=\"desc-wrapper\">\n                                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc, .iconfont-wrapper, .desc-wrapper\">\n                                        NOT EVERYTHING BELONGS HERE.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"content-wrapper card-wrap\">\n                                <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Distinct Enough to Matter</h2>\n                                <div class=\"text-wrapper\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                        There should be a reason to choose it over the obvious alternatives.\n                                    </p>\n                                </div>\n                                <div class=\"image-wrap\" mbr-if=\"showImage\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/mbr-681x444.jpg\" alt=\"Mobirise\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-lg-4 item features-image\">\n                        <div class=\"item-wrapper card_2 card-wrap\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20aug20312020262003-19-1720pm-1101x826.png\" alt=\"Mobirise Website Builder\">\n                            </div>\n                            <div class=\"card-box\">\n                                <div class=\"title-wrap\" mbr-if=\"showCardTitle\">\n                                    <div class=\"card-title\">\n                                        <div class=\"marker-wrapper\" mbr-if=\"showCardMarker\"></div>\n                                        <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .title-wrap\">Credible Delivery</h4>\n                                    </div>\n                                </div>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                    A strong promise means little without a believable product, service or business behind it.\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons_1\" data-toolbar=\"-mbrBtnMove\">\n                                    <a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                        read more\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-lg-4 item features-image\">\n                        <div class=\"item-wrapper card_3 card-wrap\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20aug20312020262003-20-0120pm-1101x826.png\" alt=\"Mobirise Website Builder\">\n                            </div>\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title_1 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title_1, .item-btn\">Clear Buyer Fit</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">We look for offers made for a recognizable type of customer, so you can quickly tell whether it fits your needs, goals or situation.</p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons_2\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"></a></div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-lg-4 item features-image\">\n                        <div class=\"item-wrapper card_3 card-wrap\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20aug20312020262003-20-0120pm-1101x826.png\" alt=\"Mobirise Website Builder\">\n                            </div>\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title_1 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title_1, .item-btn\">Worth the Price</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                    We consider what you actually receive for the cost, including usefulness, capability, access, convenience and support.\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons_2\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"></a></div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-lg-4 item features-image\">\n                        <div class=\"item-wrapper card_3 card-wrap\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/chatgpt20image20aug20312020262003-20-0120pm-1101x826.png\" alt=\"Mobirise Website Builder\">\n                            </div>\n                            <div class=\"card-box\">\n                                <h4 class=\"item-title_1 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title_1, .item-btn\">More Than Marketing</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                    We favor offers with real usefulness behind the sales pitch, not products that depend mainly on trends, urgency or exaggerated promises.\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showButtons_2\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-black-outline\" href=\"standards.html\" data-app-placeholder=\"Type Text\">our standards</a></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vi5703NwEm",
          "_anchor": "features01-2",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
