          "_name": "features03",
          "_sourceTheme": "rebootm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 rebootm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Avatar\" name=\"showAvatar\" checked>\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\">\n        <input type=\"color\" title=\"BG\" value=\"#2b2b2b\" name=\"cardBg\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/rebootm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#121212\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/rebootm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#121212\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10 card\">\n                <div class=\"content-wrapper\">\n                    <div class=\"row content-wrap justify-content-between\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-5 card\">\n                            <div class=\"title-wrapper\">\n               <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label\" mbr-if=\"showLabel\"><b>FOUNDER / STUDIO LEAD&nbsp;</b></p>                 \n                                 <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Renée Leach</b></h2>\n                                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                    AI &amp; Emerging Tech Developer\n                                </p>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary\" href=\"https://rleach-dev.neutral3rd.space/\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                        Discover More</a></div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6 card\">\n                            <div class=\"items-wrapper\">\n                                <div class=\"card-wrapper\">\n                                    <div class=\"image-wrapper\" mbr-if=\"showAvatar\">\n                                        <img src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-512x512.webp\" alt=\"Mobirise\">\n                                    </div>\n                                    <div class=\"card-box\">\n                                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".item-name, .image-wrapper\">AI &amp; Workflow Development</h4>\n                                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">\n                                            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\n                                        </p>\n                                    </div>\n                                </div>\n                                <div class=\"items-wrap\">\n                                    <div class=\"item features-without-image\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-growing-chart mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                            </div>\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper\"><div>Web &amp; Software Development<br><br><div>* <a href=\"https://offerbeacon.neutral3rd.space\" class=\"text-warning\" target=\"_blank\">OfferBeacon Suite</a></div></div></h4>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do.\n                                            </p>\n                                        </div>\n                                    </div>\n                                    <div class=\"item features-without-image\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-success mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                            </div>\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper\">Audio | Video | Streaming Media</h4>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do.\n                                            </p>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
