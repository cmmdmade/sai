              "margin": "0",
              ".nav-link": {
                "padding": "24px 32px !important",
                "margin": "0 !important",
                "transition": "all 0.3s ease-in-out",
                "font-weight": "400",
                "&::after": {
                  "color": "@activeColor !important",
                  "transform": "rotate(0)",
                  "transition": ".3s"
                },
                "&:hover": {
                  "background-color": "transparent",
                  "color": "@activeColor !important"
                }
              },
              ".nav-link.show": {
                "&::after": {
                  "transform": "rotate(180deg)"
                }
              },
              ".dropdown-menu": {
                "background-color": "transparent !important",
