                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "&.navbar-short": {
                "min-height": "96px",
                ".navbar-brand": {
                  "min-height": "96px"
                }
              },
              "padding": "0 !important",
              "border-radius": "0 !important",
              "border": "none !important",
              "box-shadow": "none !important"
            },
            ".navbar-brand": {
              "min-height": "96px",
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "10px 0",
              "transition": "all 0.3s",
              "word-break": "break-word !important",
              "z-index": "1",
              ".navbar-caption": {
                "line-height": "inherit !important",
                "font-weight": "400",
                "&:hover, &:focus": {
                  "color": "@activeColor !important"
                }
              },
              ".navbar-logo a": {
                "outline": "none"
              },
              "word-wrap": "break-word !important",
              "white-space": "normal"
            },
            ".navbar.opened": {
              ".navbar-brand": {
                ".navbar-caption": {
                  "&:hover, &:focus": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            ".dropdown-item.active, .dropdown-item:active": {
              "background-color": "transparent"
            },
            ".navbar-expand-lg .navbar-nav .nav-link": {
              "padding": "0"
            },
            ".nav-dropdown .link.dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin-right": "0",
                "padding": "0.667em 1.667em"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                "top": "3rem",
                "border-radius": "0",
                "@media (max-width: 992px)": {
                  "top": "0"
                },
                ".dropdown-submenu": {
                  "margin": "0",
                  "left": "100%",
                  "top": "0",
                  "border-left": "1px solid transparent"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "block"
            },
            "ul.navbar-nav": {
              "flex-wrap": "wrap",
              "@media (min-width: 991px)": {
                "padding": "0",
                "background-color": "transparent",
                "border": "2px solid @borderColor",
                "& when (@collapsed)": {
                  "border-radius": "0 !important"
                }
              }
            },
            ".navbar-buttons": {
              "text-align": "center",
              ".btn": {
                "white-space": "nowrap",
                "margin-right": "0",
                "padding": "22px 32px",
                "min-height": "auto",
                ".mbr-iconfont": {
                  "width": "32px",
                  "height": "32px",
                  "min-width": "32px",
                  "font-size": "16px",
                  "margin-left": "32px",
                  "margin-right": "-20px"
                },
                "@media (max-width: 575px)": {
                  "width": "auto !important"
                }
              }
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "50px",
              "height": "50px",
              "cursor": "pointer",
              "transition": "all 0.2s",
              "position": "relative",
              "align-self": "center",
              "border-radius": "100%",
              "background-color": "@menuBgColor !important",
              "border": "none !important",
              "box-shadow": "none !important",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "20px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "18px",
                  "left": "15px",
                  "transition": "all 0.2s"
                },
                "&:nth-child(2)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(3)": {
                  "left": "15px",
                  "top": "24px",
                  "transition": "all 0.15s"
                },
                "&:nth-child(4)": {
                  "left": "15px",
                  "top": "30px",
                  "transition": "all 0.2s"
                }
              }
            },
            "nav.opened .hamburger span": {
              "&:nth-child(1)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              },
              "&:nth-child(2)": {
                "transform": "rotate(45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(3)": {
                "transform": "rotate(-45deg)",
                "transition": "all 0.25s"
              },
              "&:nth-child(4)": {
                "top": "8px",
                "width": "0",
                "opacity": "0",
                "right": "50%",
                "transition": "all 0.2s"
              }
            },
            ".navbar-dropdown": {
              "padding": "0 1rem",
              "& when (@sticky)": {
                "position": "fixed"
              }
            },
            "a.nav-link": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".icons-menu": {
              "flex-wrap": "nowrap",
              "display": "flex",
              "justify-content": "center",
              "padding-left": "1rem",
              "padding-right": "1rem",
              "padding-top": "0.3rem",
              "text-align": "center"
            },
            "@media screen and (~'-ms-high-contrast: active'), (~'-ms-high-contrast: none')": {
              ".navbar": {
                "height": "70px",
                "&.opened": {
                  "height": "auto"
                }
              },
              ".nav-item .nav-link:hover::before": {
                "width": "175%",
                "max-width": "calc(100% ~\"+\" 2rem)",
                "left": "-1rem"
              }
            },
            ".navbar-nav": {
              "margin": "0 auto",
              "& when not (@showButtons)": {
                "justify-content": "flex-end",
                "margin": "0"
              }
            },
            ".nav-item": {
              "padding": "0",
              "margin": "0",
              ".nav-link": {
                "padding": "24px 32px !important",
                "margin": "0 !important",
                "transition": "all 0.3s ease-in-out",
                "font-weight": "400",
                "&::after": {
                  "color": "@activeColor !important",
                  "transform": "rotate(0)",
                  "transition": ".3s"
                },
                "&:hover": {
                  "background-color": "transparent",
                  "color": "@activeColor !important"
                }
              },
              ".nav-link.show": {
                "&::after": {
                  "transform": "rotate(180deg)"
                }
              },
              ".dropdown-menu": {
                "background-color": "transparent !important",
                "&:hover": {
                  "background-color": "transparent !important"
                },
                ".dropdown-item": {
                  "color": "@primaryColor !important",
                  "&:hover": {
                    "color": "@activeColor !important"
                  }
                }
              }
            },
            "& when (@collapsed)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 5rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "40px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid hsla(0, 0%, 100%, 0.2)"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center"
                  }
                }
              }
            },
            "@media (max-width: 991px)": {
              ".navbar": {
                "justify-content": "flex-start !important"
              },
              ".navbar.opened": {
                "min-height": "100vh !important",
                "flex-direction": "column !important",
                "justify-content": "flex-start !important"
              },
              ".navbar-collapse": {
                "padding": "20px 0 3rem",
                ".navbar-nav": {
                  "width": "100%",
                  "margin-bottom": "24px"
                },
                ".nav-item": {
                  "width": "100%",
                  "margin": "0",
                  "&:not(:first-child)": {
                    "border-top": "1px solid hsla(0, 0%, 100%, 0.2)"
                  },
                  ".nav-link": {
                    "padding": "14px !important",
                    "justify-content": "center"
                  }
                }
              }
            },
            ".content-wrap": {
              "min-height": "130px"
            }
          },
          "_name": "menu01",
          "_sourceTheme": "glancem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu01 glancem5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"color\" title=\"Active Color\" name=\"activeColor\" value=\"#c75423\" condition=\"showItems\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffffff\" condition=\"showItems\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcons\">\n        <select title=\"Amount\" name=\"iconsAmount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Icons Color\" name=\"iconsColor\" value=\"#ffffff\" condition=\"showIcons\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#101012\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#ffffff\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\" class=\"content-wrap\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://neutral3rd.space\">\n                        <img src=\"@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.png\" alt=\"Neutral3rd Emerging Tech Development Studio\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-info\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">GlanceM5</a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://offerbeacon.neutral3rd.space\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">OfferBeacon Suite</a></li><li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"https://neutral3rd.space/custom-task-prompt\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">From My Wildest Dreams</a></li>\n                    \n                    <li class=\"nav-item\"><a class=\"nav-link link text-info text-primary\" href=\"index.html#dev-about\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">About</a>\n                    </li></ul>\n                <div class=\"icons-menu\" mbr-if=\"showIcons\">\n                    <a class=\"iconfont-wrapper\" href=\"index.html\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-bluesky socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 1\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-twitter socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 2\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-instagram socicon\"></span>\n                    </a>\n                    <a class=\"iconfont-wrapper\" href=\"https://mobiri.se\" target=\"_blank\" mbr-if=\"iconsAmount > 3\">\n                        <span mbr-icon class=\"p-2 mbr-iconfont socicon-linkedin socicon\"></span>\n                    </a>\n                </div>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-secondary\" href=\"https://studioguide.neutral3rd.space/chat?token=cf7573456c87d54489c7ba5f0a2e93bf&name=Samir%20%7C%20Neutral3rd%20Emerging%20Tech%20Development%20Studio&accent=%23c75423&greet=Hey!%20Welcome%20to%20Neutral3rd.%20I%27m%20Samir%2C%20Neutral3rd%27s%20AI%20studio%20guide.%20I%20can%20help%20you%20explore%20the%20OfferBeacon%20Suite%2C%20learn%20about%20this%20development%20studio%20in%20general%2C%20or%20find%20the%20right%20next%20step.%20What%20brings%20you%20here%20today%3F&face=https%3A%2F%2Fcuevueapp.com%2Fassets%2Ffaces%2Fstandard%2F62227bb3-2f6e-4220-b3c9-2c02b2fdb349.jpg&page=https%3A%2F%2Fstudioguide.neutral3rd.space%2Fneutral3rd-emerging-technologies%2Fsamir-from-neutral3rd-emerging&mode=desktop&lang=en\" data-app-placeholder=\"Type Text\" target=\"_blank\">Start a Conversation</a></div>\n            </div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vz05MEQnSh",
          "_anchor": "menu01-44",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 32px",
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "@media (max-width: 992px)": {
                  "padding": "0 24px"
                }
              }
            },
            ".card": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              "padding": "0 32px 32px",
              "@media (max-width: 992px)": {
                "padding": "0 24px 24px"
              },
              ".mbr-section-title": {
                "margin-bottom": "16px"
              },
              ".mbr-desc": {
                "margin-bottom": "0"
              }
            },
            ".text-wrapper": {
              "border-top": "1px solid @border",
              "display": "flex",
              "justify-content": "space-between",
              "padding": "32px",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "24px"
              },
              ".mbr-text": {
                "width": "45%",
                "@media (max-width: 992px)": {
                  "width": "100%",
                  "margin-bottom": "24px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#F9F6E0"
            },
            ".mbr-desc": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".mbr-section-btn": {
              "text-align": "right"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "article04",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 fabm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText_1\" checked>\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText_2\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#72716b\" name=\"border\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showTitle || showDesc\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Accessibility</b></h2>\n                    <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">\n                        <a href=\"https://neutral3rd.space\" class=\"text-warning\">Neutral3rd Emerging Technologies Development Studio</a>\n                    </p>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_1\">Effective Date: July 24, 2026<br>Last Updated: October 1, 2026<br><br><br>1. Our Commitment to Accessibility<br><br>At Neutral3rd, we believe technology should make work and everyday experiences more accessible, understandable, and effective.<br><br>Accessibility is an important part of our approach to developing digital communications, software, artificial intelligence solutions, and business technology systems.<br><br>We are committed to improving the accessibility and usability of our website for people with diverse abilities, needs, technologies, and ways of interacting with digital content.<br><br>Our objective is to provide an inclusive experience for visitors, prospective clients, customers, and individuals who use assistive technologies.<br><br>We recognize that accessibility is an ongoing process involving design, development, testing, feedback, and continuous improvement.<br><br>2. Accessibility Standards<br><br>Neutral3rd uses the Web Content Accessibility Guidelines (WCAG) as a reference for accessible digital design and development.<br><br>Our accessibility target for this website is WCAG 2.2 Level AA.<br><br>These internationally recognized guidelines address accessibility needs involving vision, hearing, mobility, cognition, and other disabilities.<br><br>The guidelines are organized around four foundational principles:<br><br>- Perceivable: Information and interface components should be presented in ways users can perceive.<br>-&nbsp;Operable: Navigation and interface components should be usable through different interaction methods.<br>-&nbsp;Understandable: Information and interface behavior should be clear and predictable.<br>-&nbsp;Robust: Content should be compatible with appropriate browsers, devices, and assistive technologies.<br><br>These principles inform our accessibility improvement efforts.<br><br>3. Current Accessibility Status<br><br>Neutral3rd is working toward its stated accessibility target.<br><br>A complete, documented evaluation establishing WCAG 2.2 Level AA conformance across the entire website has not been confirmed for purposes of this statement.<br><br>Accordingly, this statement should not be interpreted as a certification or declaration that every page, component, or third-party integration fully conforms to WCAG 2.2 Level AA.<br><br>We intend to review accessibility concerns, evaluate barriers, and prioritize improvements based on their effect on users.<br><br><b>4. Accessibility Considerations</b><br><br>Our accessibility approach considers the following areas.<br><br><b>4.1 Keyboard Accessibility</b><br>Interactive controls, links, navigation, and forms should be usable without requiring a mouse.<br><br>We seek to identify and address keyboard-access barriers, including inaccessible controls, missing focus indicators, and focus-management problems.<br><br><b>4.2 Screen Reader Compatibility</b><br>We aim to use meaningful content structure, headings, accessible names, labels, and semantic markup to support assistive technologies.<br><br>Screen reader behavior may vary depending on the device, browser, software, and individual configuration.<br><br><b>4.3 Readability &amp; Visual Presentation</b><br>We consider text contrast, typography, spacing, responsive layouts, and information hierarchy when developing website content.<br><br>Our goal is to make information easier to read and navigate across desktop and mobile devices.<br><br><b>4.4 Images &amp; Non-Text Content</b><br>Meaningful images should have appropriate text alternatives where necessary to communicate their purpose.<br><br>Decorative images should be implemented so that they do not create unnecessary barriers for assistive technology users.<br><br><b>4.5 Forms &amp; Interactive Elements</b><br>Forms should provide understandable labels, instructions, error identification, and feedback.<br><br>We aim to improve the usability of contact forms, inquiry processes, buttons, and other interactive elements.<br><br><b>4.6 Motion &amp; Multimedia</b><br>Where animations, video, audio, or other multimedia features are used, we consider accessibility requirements such as captions, alternatives, motion sensitivity, and user control.<br><br><b>4.7 Responsive &amp; Mobile Accessibility</b><br>Our website is intended to support a range of screen sizes and input methods.<br><br>We consider text resizing, content reflow, touch-target usability, and navigation behavior as part of accessibility improvement work.<br><br><b>5. Artificial Intelligence &amp; Accessibility</b><br><br>Neutral3rd develops and implements AI-enabled tools and conversational interfaces.<br><br>We recognize that AI technologies can both improve access to information and introduce new accessibility challenges.<br><br>Relevant considerations include:<br><br>- Accessible chat and messaging interfaces.<br>-&nbsp;Keyboard navigation through conversational controls.<br>-&nbsp;Meaningful labels for input fields and action buttons.<br>-&nbsp;Clear communication of system responses and errors.<br>-&nbsp;Readable and understandable generated content.<br>-&nbsp;Appropriate focus management and status announcements.<br>-&nbsp;Alternatives when automated interactions are inaccessible.<br>-&nbsp;Human review of important or consequential AI-generated information.<br><br>The accessibility of third-party AI platforms and embedded interfaces may depend on their own design, implementation, and ongoing updates.<br><br>Neutral3rd does not represent that every third-party AI component is fully accessible.<br><br><br><br></p>\n                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText_2\"><b>6. Known &amp; Potential Limitations\n</b><br>\n<br>Although we aim to improve accessibility, some visitors may encounter barriers.\n<br>\n<br>Areas that may require additional evaluation include:\n<br>\n<br>- Third-party embedded widgets or conversational interfaces.\n<br>\n-&nbsp;Navigation and menu behavior on certain devices.\n<br>\n-&nbsp;Keyboard focus behavior in interactive components.\n<br>\n-&nbsp;Images or visual content that require improved alternatives.\n<br>\n-&nbsp;Video or audio materials requiring accessible equivalents.\n<br>\n-&nbsp;Forms and automated status messages.\n<br>\n-&nbsp;Components affected by changes to browsers, themes, or external services.\n<br>\n<br>These are areas identified for evaluation, not a declaration that each listed issue has been confirmed on the live website.\n<br>\n<br>We encourage users to report specific barriers so they can be investigated.\n<br>\n<br><b>7. Third-Party Content &amp; Services\n</b><br>\n<br>Our website may include content or functionality supplied by external providers.\n<br>\n<br>Examples may include scheduling tools, payment services, AI interfaces, videos, social platforms, and other embedded technologies.\n<br>\n<br>We may not control every aspect of third-party accessibility.\n<br>\n<br>Where a third-party component creates an accessibility barrier, we will consider available alternatives, configuration changes, workarounds, or communication with the provider.\n<br>\n<br><b>8. Requesting Accessibility Assistance\n</b><br>\n<br>If you have difficulty accessing any information, feature, document, or service on the Neutral3rd website, please contact us.\n<br>\n<br>Email: support@neutral3rd.space\n<br>\n<br>To help us investigate, please provide any information you are comfortable sharing, such as:\n<br>\n<br>- The page or feature involved.\n<br>\n-&nbsp;A description of the difficulty.\n<br>\n-&nbsp;The task you were attempting to complete.\n<br>\n-&nbsp;Your browser, device, or assistive technology, if relevant.\n<br>\n-&nbsp;An alternative format or method of assistance that would be useful.\n<br>\n<br>You are not required to disclose a disability diagnosis or sensitive medical information to report an accessibility problem.\n<br>\n<br>We will review reported issues and seek to provide reasonable assistance or an accessible alternative when feasible.\n<br>\n<br><b>9. Alternative Access to Information\n</b><br>\n<br>If website content or an interactive feature is inaccessible, you may request assistance by email.\n<br>\n<br>Depending on the content and circumstances, we may be able to provide information in an alternative electronic format, explain the relevant material, or offer another practical method of communication.\n<br>\n<br>Availability of a particular alternative may depend on the content, technology, and resources involved.\n<br>\n<br><b>10. Accessibility Evaluation &amp; Improvement\n</b><br>\n<br>Our accessibility improvement process may include:\n<br>\n<br>- Reviewing website structure and semantic markup.\n<br>\n-&nbsp;Checking keyboard navigation and visible focus.\n<br>\n-&nbsp;Evaluating text and non-text contrast.\n<br>\n-&nbsp;Reviewing images and text alternatives.\n<br>\n-&nbsp;Testing forms and interactive elements.\n<br>\n-&nbsp;Considering screen reader compatibility.\n<br>\n-&nbsp;Evaluating responsive behavior and content reflow.\n<br>\n-&nbsp;Reviewing multimedia accessibility.\n<br>\n-&nbsp;Assessing relevant third-party integrations.\n<br>- Prioritizing reported barriers and remediation opportunities.\n<br>\n<br>Automated accessibility testing can assist in identifying certain issues but cannot establish complete accessibility on its own.\n<br>\n<br>Manual evaluation and testing with assistive technologies are also important.\n<br>\n<br><b>11. Accessibility in Client Projects\n</b><br>\n<br>Accessibility is a service consideration within Neutral3rd's development and consulting work.\n<br>\n<br>For client projects, the applicable agreement should define the accessibility requirements, technical standards, testing methods, responsibilities, and acceptance criteria.\n<br>\n<br>Where requested, accessibility-related services may include design review, technical assessment, remediation guidance, usability considerations, and accessibility documentation.\n<br>\n<br>Any formal conformance claim or certification must be supported by appropriate evaluation evidence.\n<br>\n<br><b>12. Continuous Improvement\n</b><br>\n<br>Accessibility requirements, assistive technologies, and digital platforms continue to evolve.\n<br>\n<br>We intend to review this statement and our accessibility practices as the website changes.\n<br>\n<br>Feedback from people who experience accessibility barriers is an important source of information for identifying improvements.\n<br>\n<br>We welcome constructive reports and suggestions.\n<br>\n<br><b>13. Contact Information\n</b><br>\n<br>Neutral3rd — Accessibility Support\n<br>\n<br>Email: support@neutral3rd.space\n<br>Website: https://neutral3rd.space\n<br>\n<br>For concerns specifically involving the privacy of information submitted through an accessibility request:\n<br>\n<br>Privacy Officer: privacy@neutral3rd.space\n<br>\n<br>We appreciate the opportunity to improve access to our website and digital services.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vz05MFtiF3",
          "_anchor": "article04-45",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "position": "relative",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container-fluid": {
              "padding-left": "clamp(24px, 5vw, 100px)",
              "padding-right": "clamp(24px, 5vw, 100px)"
            },
            ".n3-footer-main": {
              "align-items": "flex-start",
              "row-gap": "30px"
            },
            ".content-wrapper": {
              "max-width": "900px",
              "margin-bottom": "64px",
              "@media (max-width: 991px)": {
                "margin-bottom": "20px"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "0"
            },
            ".title-wrap": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "gap": "20px"
            },
            ".logo-wrapper": {
              "display": "block",
              "width": "100%",
              "max-width": "(@logoWidth * 1px)",
              "margin-bottom": "8px"
            },
            ".logo-wrapper img, .n3-footer-logo": {
              "display": "block",
              "width": "100%",
              "height": "auto",
              "max-width": "100%",
              "min-width": "0",
              "object-fit": "contain",
              "object-position": "left center",
              "border-radius": "0"
            },
            ".mbr-section-title": {
              "color": "#f9f6ea",
              "margin": "0"
            },
            ".text-wrapper": {
              "margin-top": "12px"
            },
            ".mbr-text": {
              "display": "block",
              "width": "100%",
              "max-width": "650px",
              "margin": "0",
              "color": "#ffffff",
              "font-size": "0.95rem",
              "line-height": "1.6",
              "letter-spacing": "0.02em"
            },
            ".desc-wrapper": {
              "position": "relative",
              "margin-top": "32px",
              "padding-top": "28px"
            },
            ".desc-wrapper::before": {
              "content": "''",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "64px",
              "height": "3px",
              "background-color": "#c75423"
            },
            ".mbr-section-subtitle": {
              "color": "#f9f6ea",
              "margin-bottom": "16px"
            },
            ".desc-wrap": {
              "width": "100%"
            },
            ".mbr-desc": {
              "display": "block",
              "width": "(@descWidth * 1%)",
              "max-width": "760px",
              "margin": "0",
              "color": "#c6c3bd",
              "line-height": "1.85",
              "font-size": "clamp(0.95rem, 1.1vw, 1.08rem)",
              "letter-spacing": "0.005em"
            },
            ".mbr-section-btn": {
              "margin-top": "28px",
              "margin-bottom": "0"
            },
            ".mbr-section-btn .btn": {
              "border-color": "#c75423",
              "color": "#ffffff",
              "background-color": "#c75423",
              "border-radius": "3px",
              "padding": "14px 24px",
              "transition": "background-color 0.2s ease"
            },
            ".mbr-section-btn .btn:hover": {
              "background-color": "#a8421c",
              "border-color": "#a8421c",
              "color": "#ffffff"
            },
            ".navigation-wrap": {
              "width": "100%",
              "padding-top": "18px"
            },
            ".nav-wrapper": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "flex-start",
              "flex-wrap": "wrap",
              "gap": "32px 44px",
              "margin-bottom": "64px",
              "& when (@reverseContent)": {
                "justify-content": "flex-start"
              }
            },
            ".nav-wrap": {
              "min-width": "150px"
            },
            ".nav-wrap .list": {
              "list-style-type": "none",
              "padding": "0",
              "margin": "0",
              "color": "#e4e3dc"
            },
            ".nav-wrap .item-wrap": {
              "position": "relative",
              "display": "flex",
              "align-items": "center",
              "padding": "0 22px 0 20px",
              "margin-bottom": "20px",
              "font-size": "0.85rem",
              "line-height": "1.5",
              "transition": "color 0.2s ease",
              "& when (@showArrow)": {
                "&::after": {
                  "content": "'→'",
                  "position": "absolute",
                  "right": "0",
                  "top": "0",
                  "font-size": "18px",
                  "transform": "rotate(-45deg)"
                }
              }
            },
            ".nav-wrap .item-wrap:last-child": {
              "margin-bottom": "0"
            },
            ".nav-wrap .item-wrap::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0.35em",
              "width": "9px",
              "height": "9px",
              "border": "1px solid @markerColor",
              "background-color": "transparent",
              "transition": "background-color 0.2s ease"
            },
            ".nav-wrap .item-wrap:hover": {
              "color": "@markerColor"
            },
            ".nav-wrap .item-wrap:hover::before": {
              "background-color": "@markerColor"
            },
            ".nav-wrap a": {
              "color": "inherit",
              "text-decoration": "none"
            },
            ".nav-wrap a:hover": {
              "color": "#c75423"
            },
            ".mbr-copy": {
              "padding": "26px 24px",
              "margin-bottom": "0",
              "background-color": "@cardBg",
              "border-top": "1px solid @cardBorder",
              "border-bottom": "1px solid @cardBorder",
              "color": "#ffffff",
              "text-align": "center",
              "font-size": "0.85rem",
              "line-height": "1.6"
            },
            "@media (max-width: 1199px)": {
              ".nav-wrapper": {
                "gap": "26px"
              },
              ".nav-wrap": {
                "min-width": "125px"
              },
              ".mbr-desc": {
                "font-size": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "max-width": "100%"
              },
              ".logo-wrapper": {
                "max-width": "360px"
              },
              ".mbr-desc": {
                "width": "100%",
                "max-width": "720px"
              },
              ".navigation-wrap": {
                "padding-top": "8px"
              },
              ".nav-wrapper": {
                "justify-content": "flex-start",
                "gap": "30px 48px",
                "margin-bottom": "36px"
              },
              ".desc-wrapper": {
                "margin-top": "28px"
              }
            },
            "@media (max-width: 575px)": {
              ".container-fluid": {
                "padding-left": "20px",
                "padding-right": "20px"
              },
              ".logo-wrapper": {
                "max-width": "290px",
                "margin-bottom": "6px"
              },
              ".text-wrapper": {
                "margin-top": "8px"
              },
              ".mbr-text": {
                "font-size": "0.85rem",
                "line-height": "1.6"
              },
              ".desc-wrapper": {
                "margin-top": "24px",
                "padding-top": "24px"
              },
              ".desc-wrapper::before": {
                "width": "48px"
              },
              ".mbr-desc": {
                "width": "100%",
                "font-size": "0.95rem",
                "line-height": "1.75"
              },
              ".nav-wrapper": {
                "gap": "24px 18px",
                "margin-bottom": "30px"
              },
              ".nav-wrap": {
                "min-width": "0",
                "flex": "1 1 135px"
              },
              ".nav-wrap .item-wrap": {
                "padding-right": "14px",
                "margin-bottom": "14px",
                "font-size": "0.78rem",
                "overflow-wrap": "anywhere"
              },
              ".mbr-copy": {
                "padding": "20px 14px",
                "font-size": "0.75rem"
              }
            },
            ".mbr-desc, .desc-wrap": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#fff"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "impactm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 impactm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"2\" condition=\"showNav\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#c75423\" name=\"markerColor\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Arrow\" name=\"showArrow\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Copyright BG\" value=\"#161617\" name=\"cardBg\" condition=\"showCopy\">\n        <input type=\"color\" title=\"Border Color\" value=\"#353535\" name=\"cardBorder\" condition=\"showCopy\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#101012\" selected>\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101012\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\n        <header>Neutral3rd Layout</header>\n        <input type=\"range\" inline title=\"Logo Width\" name=\"logoWidth\" min=\"180\" max=\"520\" step=\"10\" value=\"360\">\n        <input type=\"range\" inline title=\"Description Width %\" name=\"descWidth\" min=\"60\" max=\"100\" step=\"5\" value=\"60\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row justify-content-center n3-footer-main\" mbr-class=\"{'flex-row-reverse': reverseContent}\">\n\n            <div class=\"col-12 col-lg-7\" mbr-if=\"showLogo || showTitle || showSubtitle || showButtons || showText || showDesc\">\n\n                <div class=\"content-wrapper\">\n\n                    <div class=\"title-wrapper\" mbr-if=\"showLogo || showTitle\">\n                        <div class=\"title-wrap\">\n\n                            <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                <a href=\"https://neutral3rd.space\"><img class=\"n3-footer-logo\" src=\"@PROJECT_PATH@/assets/images/bold20n320geometric20logo-1-512x512.png\" alt=\"Neutral3rd Emerging Tech Development Studio\"></a>\n                            </div>\n\n                           <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrapper, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                <b>Neutral3rd</b>\n                            </h2>\n\n                        </div>\n                    </div>\n\n                    <!-- <div class=\"text-wrapper\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">xx</p>\n                    </div> -->\n\n                    <div class=\"desc-wrapper\" mbr-if=\"showSubtitle || showDesc || showButtons\">\n\n                       <!-- <h3 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                            <b>ABOUT THE STUDIO</b>\n                        </h3> -->\n\n                        <div class=\"desc-wrap\" mbr-if=\"showDesc\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc, .desc-wrap\"><b>Neutral3rd</b> helps small businesses and independent professionals put AI to work within real human work. Led by Renée Leach and supported by an army of customized AI assistants, co-pilots, and agents, this studio brings strategy, development, workflows, and AI-powered media together with a \"human STILL in-the-loop\" to make work more capable without making it more complicated.<br></p>\n                        </div>\n\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a class=\"btn btn-primary-outline\" href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\">\n                                CONTACT NOW\n                            </a>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-5\" mbr-if=\"showNav\">\n                <div class=\"navigation-wrap\">\n                    <div class=\"nav-wrapper\">\n\n                        <div class=\"nav-wrap\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/privacy\" class=\"text-info\">PRIVACY</a></b></li><a href=\"privacy.html\" class=\"text-primary\"><b>\n                                </b></a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/terms\" class=\"text-info\">TERMS OF SERVICE</a></b></li><a href=\"https://neutral3rd.space/terms\" class=\"text-primary\">\n                                </a><li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/accessibility\" class=\"text-info\">ACCESSIBILITY</a></b></li><li class=\"item-wrap\"><b><a href=\"https://connections.neutral3rd.space/wall\" class=\"text-info\" target=\"_blank\">LEAVE YOUR FEEDBACK</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b><a href=\"https://offerbeacon.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">HELP THE RIGHT BUYERS FIND YOU</a></b></li>\n<li class=\"item-wrap\"><b><a href=\"https://neutral3rd.space/custom-task-prompt\" class=\"text-info text-primary\">FROM MY WILDEST DREAMS</a></b></li><li class=\"item-wrap\"><b><a href=\"https://perspectives.neutral3rd.space/\" class=\"text-info\" target=\"_blank\">NEUTRAL3RD PERSPECTIVES</a></b></li><a href=\"https://neutral3rd.space\" class=\"text-primary\">\n</a><li class=\"item-wrap\"><b><a href=\"mailto:renee.leach@neutral3rd.space?subject=Business%20Inquiry\" class=\"text-info\">EMAIL RENEE</a></b></li>\n                            </ul>\n                        </div>\n\n                        <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                            <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                <li class=\"item-wrap\"><b>YOUTUBE</b></li>\n                            </ul>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12\">\n                <p class=\"mbr-copy mbr-fonts-style card-wrap\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\" mbr-if=\"showCopy\">\n                    © 2026 Neutral3rd Emerging Tech Development Studio. Operated by U.S.-based business entity, Rowdy Independents LLC. All Rights Reserved.\n                </p>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "vz05MG30Ta",
          "_anchor": "footer01-46",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "page5.html": {
      "settings": {
        "title": "Page 5",
        "meta_descr": "Learn how Neutral3rd collects, uses, protects, and manages personal information across its website, AI-powered solutions, digital products, and services.",
        "header_custom": "<meta name=\"robots\" content=\"noindex, nofollow\">",
        "footer_custom": "<style>\n/* Neutral3rd: Basic Image Protection */\nimg {\n  -webkit-user-drag: none;\n  user-drag: none;\n  -webkit-touch-callout: none;\n}\n</style>\n\n<script>\n(function () {\n  \"use strict\";\n\n  // Prevent the image-specific right-click menu.\n  document.addEventListener(\"contextmenu\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n\n  // Prevent dragging images onto the desktop.\n  document.addEventListener(\"dragstart\", function (event) {\n    if (event.target.closest(\"img, picture\")) {\n      event.preventDefault();\n    }\n  });\n})();\n</script>",
        "html_before": "",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/white20and20orange20n320logo-1206x1206.png",
        "order": "6"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
              "z-index": "1000",
              "width": "100%",
              "& when not (@transparent)": {
                "position": "relative",
                "min-height": "110px"
              },
              "nav.navbar": {
                "position": "fixed"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding-left": "108px",
                "padding-right": "108px",
                "@media (max-width: 1440px)": {
                  "padding-left": "64px",
                  "padding-right": "64px"
                },
                "@media (max-width: 992px)": {
                  "padding-left": "16px",
                  "padding-right": "16px"
                }
              }
            },
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            ".dropdown-menu": {
              "padding": "0",
              "border-radius": "4px",
              "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
            },
            ".dropdown-item": {
              "border": "2px solid @borderColor",
              "background": "@menuBgColor !important",
              "color": "@primaryColor !important",
              "&:hover, &:focus": {
                "background": "@menuBgColor !important",
                "color": "@primaryColor !important"
              },
              "&:hover span": {
                "color": "white"
              },
              "&:first-child": {
                "border-top-left-radius": "4px",
                "border-top-right-radius": "4px"
              },
              "&:last-child": {
                "border-bottom-left-radius": "4px",
                "border-bottom-right-radius": "4px"
              }
            },
            ".nav-dropdown .link": {
              "padding": "0 0.3em !important",
              "margin": "0.667em 1em !important"
            },
            ".nav-dropdown .link.dropdown-toggle::after": {
              "margin-left": "0.5rem",
              "margin-top": "0.2rem"
            },
            ".nav-link": {
              "position": "relative"
            },
            ".container": {
              "display": "flex",
              "margin": "0 auto",
              "& when not (@collapsed)": {
                "@media (min-width: 992px)": {
                  "flex-wrap": "nowrap"
                }
              },
              "max-width": "1600px"
            },
            ".iconfont-wrapper": {
              "color": "@iconsColor !important",
              "font-size": "1.5rem",
              "transition": "all 0.3s ease-in-out",
              "&:hover": {
                "color": "@activeColor !important"
              }
            },
            ".dropdown-menu, .navbar.opened": {
              "background": "@menuBgColor !important"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "width": "auto",
              "transition": "all 0.25s ease-in-out",
              "&::after": {
                "right": "1.6rem"
              },
              ".mbr-iconfont": {
                "margin-right": "0.5rem",
                "vertical-align": "sub",
                "&:before": {
                  "display": "inline-block",
                  "transform": "scale(1, 1)",
                  "transition": "all 0.25s ease-in-out"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "padding": "0.235em 1.5em 0.235em 1.5em !important",
                "transition": "none",
                "margin": "0 !important"
              }
            },
            ".navbar": {
              "min-height": "110px",
              "transition": "all 0.3s",
              "border-bottom": "1px solid transparent",
              "&:not(.navbar-short)": {},
              "& when not (@transparent)": {
                "box-shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)",
                "background": "@menuBgColor"
              },
              "& when (@transparent)": {
                "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity)"
              },
              "&.opened": {
                "transition": "all 0.3s"
              },
              ".dropdown-item": {
                "padding": "0.5rem 3.2rem 0.5rem 1.8rem",
                "border-radius": "0"
              },
              ".navbar-logo img": {
                "width": "auto",
                "border-radius": "6px !important"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1"
              },
              "&.collapsed": {
                "justify-content": "center",
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(98.5vh - @{logoSize}rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "41%"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem",
                  "text-align": "center"
                },
                ".icons-menu": {
                  "padding-left": "0",
                  "padding-right": "0",
                  "padding-top": "0.5rem",
                  "padding-bottom": "0.5rem"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".dropdown-menu": {
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  },
                  ".dropdown-item:after": {
                    "right": "auto"
                  },
                  ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]:after": {
                    "margin-left": "0.5rem",
                    "margin-top": "0.2rem",
                    "border-top": "0.35em solid",
                    "border-right": "0.35em solid transparent",
                    "border-left": "0.35em solid transparent",
                    "border-bottom": "0",
                    "top": "40%"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                "ul.navbar-nav": {
                  "li": {
                    "margin": "auto"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": "0.25rem 1.5rem !important",
                  "text-align": "center"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word",
                  "padding-right": "0.5rem",
                  "max-width": "80%"
                },
