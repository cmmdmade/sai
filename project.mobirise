              "display": "flex",
              "align-items": "center",
              "gap": "16px"
            },
            ".benefits-heading-line": {
              "display": "block",
              "flex": "1",
              "height": "1px",
              "background-color": "#c75423",
              "opacity": "0.75"
            },
            ".benefits-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(3, minmax(0, 1fr))",
              "gap": "0"
            },
            ".benefits-column": {
              "padding": "0 32px",
              "border-right": "1px solid rgba(224, 181, 72, 0.55)",
              "&:first-child": {
                "padding-left": "8px"
              },
              "&:last-child": {
                "border-right": "none",
                "padding-right": "8px"
              }
            },
            ".benefit-item": {
              "display": "grid",
              "grid-template-columns": "54px minmax(0, 1fr)",
              "align-items": "start",
              "gap": "16px",
              "margin-bottom": "34px",
              "&:last-child": {
                "margin-bottom": "0"
              }
            },
            ".benefit-icon": {
              "color": "#c75423",
              "text-align": "center",
              ".mbr-iconfont": {
                "display": "inline-block",
                "font-size": "44px",
                "line-height": "1",
                "color": "#c75423"
              }
            },
            ".benefit-content": {
              "min-width": "0"
            },
            ".benefit-title": {
              "color": "#F9F6E0",
              "margin-bottom": "6px",
              "line-height": "1.25"
            },
            ".benefit-description": {
              "color": "#D2D0C9",
              "margin-bottom": "0",
              "line-height": "1.5"
            },
            "@media (max-width: 991px)": {
              ".benefits-grid": {
                "grid-template-columns": "repeat(2, minmax(0, 1fr))",
                "row-gap": "32px"
              },
              ".benefits-column": {
                "padding": "0 24px"
              },
              ".benefits-column:first-child": {
                "padding-left": "0"
              },
              ".benefits-column:nth-child(2)": {
                "border-right": "none"
              },
              ".benefits-column:last-child": {
                "padding-left": "0",
                "border-right": "none"
              },
              ".benefit-item": {
                "margin-bottom": "28px"
              },
              ".benefits-heading": {
                "padding": "0"
              }
            },
            "@media (max-width: 575px)": {
              ".benefits-heading": {
                "margin-bottom": "28px"
              },
              ".benefits-subtitle-row": {
                "display": "block"
              },
              ".benefits-heading-line": {
                "width": "100%",
                "margin-top": "14px"
              },
              ".benefits-grid": {
                "grid-template-columns": "1fr",
                "gap": "28px"
              },
              ".benefits-column, .benefits-column:first-child, .benefits-column:last-child": {
                "padding": "0",
                "border-right": "none",
                "border-bottom": "1px solid rgba(224, 181, 72, 0.35)",
                "padding-bottom": "24px"
              },
              ".benefits-column:last-child": {
                "border-bottom": "none",
                "padding-bottom": "0"
              },
              ".benefit-item": {
                "grid-template-columns": "48px minmax(0, 1fr)",
                "gap": "14px",
                "margin-bottom": "24px"
              },
              ".benefit-icon .mbr-iconfont": {
                "font-size": "38px"
              },
              ".benefit-title": {
                "margin-bottom": "4px"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#d7d7d7"
            },
            "H3": {
              "color": "#ffffff"
            }
          },
          "_name": "features08",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features08 fabm5 neutral3rd-benefits\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Name\" name=\"showName\">\n        <input type=\"color\" title=\"Name Active Color\" value=\"#8AA29E\" name=\"active\" condition=\"showName\">\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\">\n        <input type=\"color\" title=\"Card BG\" value=\"#474A48\" name=\"card\">\n        <input type=\"color\" title=\"Border Color\" value=\"#c75423\" name=\"border\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#474A48\">\n        </fieldset>\n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"row\">\n            <div class=\"col-12\">\n\n                <div class=\"benefits-heading\" mbr-if=\"showTitle || showText\">\n\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\"><b>Practical Technology. Real Business Possibilities.</b></h2>\n\n                    <div class=\"benefits-subtitle-row\" mbr-if=\"showText\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-text\">\n                            Smarter systems, clearer experiences, and solutions built around the way people work.\n                        </p>\n\n                        <span class=\"benefits-heading-line\"></span>\n                        \n                    </div>\n<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-text\">Neutral3rd combines human insight with emerging technologies to help businesses simplify operations, improve experiences, connect information, and explore new opportunities.\n                        </p>\n\n                </div>\n\n            </div>\n        </div>\n\n        <div class=\"row\">\n            <div class=\"col-12\">\n\n                <div class=\"benefits-grid\">\n\n                    <!-- COLUMN 1 -->\n                    <div class=\"benefits-column\">\n\n                        <div class=\"benefit-item\">\n                            <div class=\"benefit-icon\">\n                                <span class=\"mbr-iconfont mobi-mbri-speed mobi-mbri\"></span>\n                            </div>\n                            <div class=\"benefit-content\">\n                                <h3 class=\"benefit-title mbr-fonts-style\" mbr-theme-style=\"display-5\"><b>Simplify the Work</b></h3>\n                                <p class=\"benefit-description mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Reduce repetitive tasks and create more efficient ways to get things done.\n                                </p>\n                            </div>\n                        </div>\n\n                        <div class=\"benefit-item\">\n                            <div class=\"benefit-icon\">\n                                <span class=\"mbr-iconfont mobi-mbri-growing-chart mobi-mbri\"></span>\n                            </div>\n                            <div class=\"benefit-content\">\n                                <h3 class=\"benefit-title mbr-fonts-style\" mbr-theme-style=\"display-5\"><b>Enable Better Decisions</b></h3>\n                                <p class=\"benefit-description mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Turn relevant information into practical insights and next steps.\n                                </p>\n                            </div>\n                        </div>\n\n                    </div>\n\n                    <!-- COLUMN 2 -->\n                    <div class=\"benefits-column\">\n\n                        <div class=\"benefit-item\">\n                            <div class=\"benefit-icon\">\n                                <span class=\"mbr-iconfont mobi-mbri-users mobi-mbri\"></span>\n                            </div>\n                            <div class=\"benefit-content\">\n                                <h3 class=\"benefit-title mbr-fonts-style\" mbr-theme-style=\"display-5\"><b>Improve Experiences</b></h3>\n                                <p class=\"benefit-description mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Make digital interactions clearer, more accessible, and easier to navigate.\n                                </p>\n                            </div>\n                        </div>\n\n                        <div class=\"benefit-item\">\n                            <div class=\"benefit-icon\">\n                                <span class=\"mbr-iconfont mobi-mbri-target mobi-mbri\"></span>\n                            </div>\n                            <div class=\"benefit-content\">\n                                <h3 class=\"benefit-title mbr-fonts-style\" mbr-theme-style=\"display-5\"><b>Build Useful Solutions</b></h3>\n                                <p class=\"benefit-description mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Develop AI-powered tools, automations, and digital experiences around real needs.\n                                </p>\n                            </div>\n                        </div>\n\n                    </div>\n\n                    <!-- COLUMN 3 -->\n                    <div class=\"benefits-column\">\n\n                        <div class=\"benefit-item\">\n                            <div class=\"benefit-icon\">\n                                <span class=\"mbr-iconfont mobi-mbri-setting mobi-mbri\"></span>\n                            </div>\n                            <div class=\"benefit-content\">\n                                <h3 class=\"benefit-title mbr-fonts-style\" mbr-theme-style=\"display-5\"><b>Connect Information</b></h3>\n                                <p class=\"benefit-description mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Bring business knowledge, tools, and processes together in more useful ways.\n                                </p>\n                            </div>\n                        </div>\n\n                        <div class=\"benefit-item\">\n                            <div class=\"benefit-icon\">\n                                <span class=\"mbr-iconfont mobi-mbri-lock mobi-mbri\"></span>\n                            </div>\n                            <div class=\"benefit-content\">\n                                <h3 class=\"benefit-title mbr-fonts-style\" mbr-theme-style=\"display-5\"><b>Adapt and Evolve</b></h3>\n                                <p class=\"benefit-description mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    Create solutions that can be evaluated, improved, and expanded as needs change.\n                                </p>\n                            </div>\n                        </div>\n\n                    </div>\n\n                </div>\n\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_anchor": "features08-o",
          "_cid": "vyqf49IxUR",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "position": "relative",
            "overflow": "hidden",
            "color": "#F7F5F0",
            "background-position": "center center",
            "background-size": "cover",
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding-left": "32px",
                "padding-right": "32px"
              }
            },
            ".container, .container-fluid": {
              "position": "relative",
              "z-index": "2"
            },
            ".featured-shell": {
              "width": "100%",
              "max-width": "none",
              "margin": "0",
              "padding": "0"
            },
            ".featured-heading": {
              "margin-bottom": "22px"
            },
            ".mbr-section-title": {
              "color": "#FFFFFF !important",
              "font-size": "clamp(1.9rem, 2.4vw, 2.9rem)",
              "line-height": "1.12",
              "margin": "0 0 4px",
              "font-weight": "700"
            },
            ".mbr-section-title b": {
              "color": "#FFFFFF !important"
            },
            ".featured-section-subtitle": {
              "color": "#d7d7d7",
              "font-size": "clamp(1rem, 1.25vw, 1.4rem)",
              "line-height": "1.4",
              "margin": "0"
            },
            ".featured-grid": {
              "display": "grid",
              "grid-template-columns": "minmax(0, 1.08fr) minmax(0, 0.92fr)",
              "gap": "42px",
              "align-items": "start",
              "width": "100%"
            },
            ".featured-media": {
              "min-width": "0"
            },
            ".featured-image-frame": {
              "width": "100%",
              "aspect-ratio": "(1.13 / 1)",
              "overflow": "hidden",
              "border": "1px solid @border",
              "border-radius": "3px",
              "background": "#0D0D0D"
            },
            ".featured-product-image": {
              "display": "block",
              "width": "100%",
              "height": "100%",
              "max-width": "none",
              "object-fit": "cover",
              "object-position": "(@imagePosition * 1%) center",
              "border": "0",
              "border-radius": "0"
            },
            ".featured-details": {
              "min-width": "0",
              "padding-top": "0"
            },
            ".featured-gold-rule": {
              "height": "2px",
              "width": "100%",
              "background-color": "@accent",
              "margin": "0 0 22px"
            },
            ".featured-status": {
              "display": "inline-block",
              "background-color": "@accent",
              "color": "#FFFFFF !important",
              "border": "1px solid @accent",
              "border-radius": "2px",
              "padding": "9px 17px",
              "font-size": "0.85rem",
              "line-height": "1.2",
              "font-weight": "800",
              "letter-spacing": "0.015em",
              "text-transform": "uppercase",
              "margin-bottom": "14px"
            },
            ".featured-product-title": {
              "color": "#FFFFFF !important",
              "font-size": "clamp(1.85rem, 2.3vw, 2.8rem)",
              "line-height": "1.15",
              "margin": "0 0 6px",
              "font-weight": "700"
            },
            ".featured-product-title b": {
              "color": "#FFFFFF !important"
            },
            ".featured-product-credit": {
              "color": "#ffffff",
              "font-size": "clamp(0.95rem, 1.18vw, 1.3rem)",
              "line-height": "1.4",
              "margin": "0 0 25px"
            },
            ".featured-product-description": {
              "color": "#d7d7d7",
              "font-size": "clamp(1.05rem, 1.25vw, 1.4rem)",
              "line-height": "1.55",
              "margin": "0 0 32px"
            },
            ".featured-checklist": {
              "list-style": "none",
              "padding": "0",
              "margin": "0 0 28px"
            },
            ".featured-checklist li": {
              "display": "flex",
              "align-items": "flex-start",
              "gap": "15px",
              "color": "#D9D9D9",
              "font-size": "clamp(0.98rem, 1.12vw, 1.25rem)",
              "line-height": "1.55",
              "margin": "0 0 13px"
            },
            ".featured-checklist li:last-child": {
              "margin-bottom": "0"
            },
            ".featured-check": {
              "flex": "0 0 22px",
              "color": "@accent",
              "font-size": "1.5rem",
              "font-weight": "800",
              "line-height": "1.15"
            },
            ".featured-notice": {
              "border": "1px solid @border",
              "background-color": "rgba(15, 15, 15, 0.42)",
              "padding": "18px 22px",
              "margin-bottom": "18px"
            },
            ".featured-notice p": {
              "color": "#ffffff",
              "font-size": "clamp(0.9rem, 1.02vw, 1.1rem)",
              "line-height": "1.48",
              "margin": "0"
            },
            ".featured-actions": {
              "margin": "0",
              "padding": "0"
            },
            ".featured-actions .btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "gap": "18px",
              "min-height": "52px",
              "margin": "0",
              "padding": "13px 24px",
              "border-radius": "3px",
              "font-size": "0.9rem",
              "font-weight": "800",
              "line-height": "1.3",
              "text-decoration": "none",
              "text-transform": "uppercase",
              "box-shadow": "none"
            },
            ".featured-actions .btn-primary": {
              "color": "#FFFFFF !important",
              "background-color": "@accent !important",
              "border": "1px solid @accent !important"
            },
            ".featured-actions .btn-primary:hover": {
              "color": "#FFFFFF !important",
              "background-color": "#A8431D !important",
              "border-color": "#A8431D !important"
            },
            ".featured-actions .btn:focus-visible": {
              "outline": "3px solid #FFFFFF",
              "outline-offset": "3px"
            },
            "@media (min-width: 1600px)": {
              ".featured-grid": {
                "gap": "48px"
              }
            },
            "@media (min-width: 992px) and (max-width: 1199px)": {
              ".featured-grid": {
                "gap": "28px"
              },
              ".featured-product-description": {
                "font-size": "1.05rem"
              },
              ".featured-checklist li": {
                "font-size": "0.96rem"
              }
            },
            "@media (max-width: 991px)": {
              ".featured-grid": {
                "grid-template-columns": "1fr",
                "gap": "30px"
              },
              ".featured-shell": {
                "max-width": "none",
                "padding": "0"
              },
              ".featured-gold-rule": {
                "margin": "0 0 22px"
              },
              ".featured-image-frame": {
                "aspect-ratio": "(1.2 / 1)"
              },
              ".featured-details": {
                "padding-top": "0"
              }
            },
            "@media (max-width: 575px)": {
              "& when (@fullWidth)": {
                ".container-fluid": {
                  "padding-left": "16px",
                  "padding-right": "16px"
                }
              },
              ".featured-shell": {
                "padding": "0"
              },
              ".featured-heading": {
                "margin-bottom": "20px"
              },
              ".mbr-section-title": {
                "font-size": "1.9rem"
              },
              ".featured-section-subtitle": {
                "font-size": "1rem"
              },
              ".featured-grid": {
                "gap": "25px"
              },
              ".featured-image-frame": {
                "aspect-ratio": "(1 / 1)"
              },
              ".featured-status": {
                "font-size": "0.75rem",
                "padding": "8px 12px"
              },
              ".featured-product-title": {
                "font-size": "1.85rem"
              },
              ".featured-product-credit": {
                "font-size": "0.95rem"
              },
              ".featured-product-description": {
                "font-size": "1rem",
                "margin-bottom": "26px"
              },
              ".featured-checklist li": {
                "font-size": "0.95rem",
                "gap": "12px",
                "margin-bottom": "12px"
              },
              ".featured-notice": {
                "padding": "15px"
              },
              ".featured-actions .btn": {
                "width": "100%",
                "padding": "13px 15px"
              }
            }
          },
          "_name": "features08",
          "_sourceTheme": "fabm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features08 fabm5 neutral3rd-featured\" group=\"Features\" mbr-class=\"{\n 'mbr-fullscreen': fullScreen,\n 'mbr-parallax-background': bg.parallax}\">\n\n<mbr-parameters>\n\n  <header>Size</header>\n\n  <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\n  <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n\n  <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\n  <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\n  <header>Show/Hide</header>\n\n  <input type=\"checkbox\" title=\"Section Heading\" name=\"showTitle\" checked>\n\n  <input type=\"checkbox\" title=\"Section Subtitle\" name=\"showText\" checked>\n\n  <input type=\"checkbox\" title=\"Development Notice\" name=\"showNotice\" checked>\n\n  <header>Featured Build Image</header>\n\n  <!--\n    REPLACE IMAGE IN MOBIRISE:\n    Block Settings > Featured Build Image\n\n    RECOMMENDED DIMENSIONS:\n    1600 x 1400 pixels\n\n    FORMAT:\n    WebP or JPG\n\n    Keep the product/device centered.\n    Avoid embedding section text or buttons.\n  -->\n\n  <input type=\"image\" title=\"Featured Build Image\" name=\"featuredImage\" value=\"@PROJECT_PATH@/assets/images/cozy%2520ai%2520business%2520workspace%2520at%2520dusk-1672x941.png\">\n\n  <input type=\"range\" inline title=\"Image Position\" name=\"imagePosition\" min=\"0\" max=\"90\" step=\"5\" value=\"100\">\n\n  <header>Colors</header>\n\n  <input type=\"color\" title=\"Accent Gold\" name=\"accent\" value=\"#c75423\">\n\n  <input type=\"color\" title=\"Border Color\" name=\"border\" value=\"#565650\">\n\n  <header>Background</header>\n\n  <fieldset type=\"background\" name=\"bg\" parallax>\n\n    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" selected parallax>\n\n    <input type=\"color\" title=\"Color\" value=\"#171716\">\n\n  </fieldset>\n\n  <header condition=\"bg.type === 'video'\">\n    Fallback Image\n  </header>\n\n  <input type=\"image\" title=\"Fallback Image\" name=\"fallBackImage\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" condition=\"bg.type === 'video'\">\n\n  <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\n  <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n\n  <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n\n</mbr-parameters>\n\n\n<!-- BACKGROUND -->\n\n<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\n<!-- FEATURED BUILD CONTENT -->\n\n<div mbr-class=\"{\n 'container': !fullWidth,\n 'container-fluid': fullWidth}\">\n\n  <div class=\"featured-shell\">\n\n    <!-- SECTION HEADING -->\n\n    <div class=\"featured-heading\">\n\n      <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrap\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>The Featured Build</b></h2>\n\n      <p class=\"featured-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".featured-section-subtitle\" mbr-if=\"showText\">\n        A closer look at what I'm creating.&nbsp;Explore a featured Neutral3rd solution—designed to address a real challenge, simplify a process, or create a better experience through practical technology.<br></p>\n\n    </div>\n\n\n    <!-- TWO-COLUMN FEATURED BUILD -->\n\n    <div class=\"featured-grid\">\n\n      <!-- LEFT: PRODUCT IMAGE -->\n\n      <div class=\"featured-media\">\n\n        <!--\n          FEATURED IMAGE\n\n          REPLACE USING:\n          Block Settings > Featured Build Image\n\n          RECOMMENDED:\n          1600 x 1400 pixels\n\n          CURRENT PRODUCT:\n          AI Business Guide / BizinGPT\n\n          Update alt text when the\n          featured product changes.\n        -->\n\n        <div class=\"featured-image-frame\">\n\n          <img class=\"featured-product-image\" src=\"@PROJECT_PATH@/assets/images/ai20business20guide20workspace-1932x1087.webp\" alt=\"Concept illustration of the AI Business Guide interface on a laptop\" width=\"1600\" height=\"1400\">\n\n        </div>\n\n      </div>\n\n\n      <!-- RIGHT: PRODUCT DETAILS -->\n\n      <div class=\"featured-details\">\n\n        <!-- GOLD TOP RULE -->\n\n        <div class=\"featured-gold-rule\" aria-hidden=\"true\"></div>\n\n\n        <!-- DEVELOPMENT STATUS -->\n\n        <div class=\"featured-status\">\n          IN DEVELOPMENT\n        </div>\n\n\n        <!-- PRODUCT NAME -->\n        <h3 class=\"featured-product-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".featured-product-title\"><b>Neutral3rd Converza</b></h3>\n          \n          <!-- PRODUCT Sub-Title -->\n        <p class=\"featured-product-credit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".featured-product-credit\">Your business, connected through conversation.</p>\n\n        <!-- PRODUCT ATTRIBUTION -->\n        <p class=\"featured-product-credit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".featured-product-credit\">Give customers a more natural way to explore your business, discover offerings, and take meaningful next steps across supported AI assistants, messaging channels, and your website.<br></p>\n          \n          <!-- Neutral3rd ATTRIBUTION -->\n        <p class=\"featured-product-credit mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".featured-product-credit\"><i>Configured, tested, and managed by Neutral3rd.</i></p>\n\n        <!-- PRODUCT DESCRIPTION -->\n        <p class=\"featured-product-description mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".featured-product-description\">Converza transforms your approved business information into an interactive customer experience. From product discovery and service questions to comparisons and verified shopping or contact links, it helps customers find relevant answers and move forward with confidence.<br><br>Built for more than a single platform, Converza can extend across supported AI assistants, websites, and messaging channels. Neutral3rd manages the configuration, business-specific knowledge, supported data connections, testing, and ongoing maintenance—so your business can focus on serving customers.</p>\n\n        <!-- FEATURE CHECKLIST \n\n        <ul class=\"featured-checklist\">\n\n          <li>\n            <span class=\"featured-check\" aria-hidden=\"true\">✓</span>\n            <span>Includes setup, testing, and ongoing support (details vary)</span>\n          </li>\n\n        </ul> -->\n\n\n        <!-- DEVELOPMENT NOTICE -->\n\n        <div class=\"featured-notice\" mbr-if=\"showNotice\">\n\n          <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".featured-notice p\">\n            Currently in development and available for early-access inquiries. Features and availability depend on testing, platform support, and the selected service package.\n          </p>\n\n        </div>\n\n\n        <!-- EARLY ACCESS CTA -->\n\n        <div class=\"featured-actions mbr-section-btn\">\n\n          <a class=\"btn btn-primary display-4\" href=\"#\">\n            REQUEST EARLY ACCESS\n            <span aria-hidden=\"true\">→</span>\n          </a>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </div>\n\n</div>\n\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_anchor": "current-build",
          "_cid": "vyqyfuGxr0",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "54px",
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              ".title-wrap": {
                ".mbr-section-title": {
                  "display": "inline-block",
                  "width": "60%",
                  "margin-bottom": "0",
                  "@media (max-width: 1200px)": {
                    "width": "100%"
                  },
                  "span": {
                    "color": "@titleColor"
                  }
                }
              }
            },
            ".items-wrapper": {
              "justify-content": "center",
              "margin": "0 -10px"
            },
            ".item": {
              "padding": "0 10px",
              "margin-bottom": "20px",
              ".item-wrapper": {
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "height": "100%",
                "background-color": "@cardBg",
                "padding": "30px",
                "@media (max-width: 992px)": {
                  "height": "auto",
                  "padding": "20px"
                },
                ".card-box": {
                  ".icon-wrapper": {
                    "margin-bottom": "30px",
                    ".mbr-iconfont": {
                      "width": "80px",
                      "height": "80px",
                      "display": "inline-flex",
                      "align-items": "center",
                      "justify-content": "center",
                      "font-size": "36px",
                      "color": "@icon",
                      "background-color": "@iconBg",
                      "border-radius": "100%"
                    }
                  },
                  ".desc-wrapper": {
                    ".item-desc": {
                      "display": "inline-block",
                      "background-color": "@desc",
                      "padding": "5px 12px",
                      "margin-bottom": "16px"
                    }
                  },
                  ".item-name": {
                    "margin-bottom": "8px"
                  },
                  ".item-role": {
                    "margin-bottom": "0"
                  }
                },
                ".mbr-section-btn": {
                  "margin-top": "20px",
                  ".btn": {
                    "justify-content": "center",
                    "padding": "10px 15px",
                    "margin-bottom": "0",
                    "width": "auto !important"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#404349"
            },
            ".item-desc": {
              "color": "#b19a7c"
            },
            ".item-name": {
              "color": "#404349"
            },
            ".item-role": {
              "color": "#ffffff"
            },
            ".mbr-section-title, .title-wrap": {
              "color": "#ffffff"
            },
            ".item-name, .icon-wrapper, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "features08",
          "_sourceTheme": "stockm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features08 stockm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Secondary Color\" value=\"#ed463f\" name=\"titleColor\" condition=\"showTitle\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\">\n        <input type=\"color\" title=\"Icon Color\" value=\"#b19a7c\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Icon BG\" value=\"#fff1e2\" name=\"iconBg\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\">\n        <input type=\"color\" title=\"Description BG\" value=\"#fff1e2\" name=\"desc\" condition=\"showDesc\" selected>\n        <input type=\"checkbox\" title=\"Card Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Card Role\" name=\"showRole\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Card BG\" value=\"#c75423\" name=\"cardBg\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#fff1e2\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/stockm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle\">\n                    <div class=\"title-wrap\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .title-wrap\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Inside This Build</b></h2>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row items-wrapper\">\n            <div class=\"item features-without-image col-12 col-lg-3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-user mobi-mbri\"></span>\n                        </div>\n                        <div class=\"desc-wrapper\">\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc, .desc-wrapper\">\n                                &gt; 5 years\n                            </p>\n                        </div>\n                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-name, .icon-wrapper, .mbr-section-btn\" mbr-if=\"showName\">\n                            <b>Business Knowledge</b></h4>\n                        <p class=\"item-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\" mbr-if=\"showRole\">Approved business information organized for reliable answers.<br></p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                        <a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Contact now\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-user mobi-mbri\"></span>\n                        </div>\n                        <div class=\"desc-wrapper\">\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc, .desc-wrapper\">\n                                &gt; 3 years\n                            </p>\n                        </div>\n                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-name, .icon-wrapper, .mbr-section-btn\" mbr-if=\"showName\"><b>Guided Conversations</b></h4>\n                        <p class=\"item-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\" mbr-if=\"showRole\">Natural-language assistance for discovery and next steps.<br></p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                        <a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Contact now\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-user mobi-mbri\"></span>\n                        </div>\n                        <div class=\"desc-wrapper\">\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc, .desc-wrapper\">\n                                &gt; 8 years\n                            </p>\n                        </div>\n                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-name, .icon-wrapper, .mbr-section-btn\" mbr-if=\"showName\"><b>Connected Data</b></h4>\n                        <p class=\"item-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\" mbr-if=\"showRole\">\n                            Supported integrations with relevant business data sources.\n                        </p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                        <a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Contact now\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-without-image col-12 col-lg-3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-box\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-user mobi-mbri\"></span>\n                        </div>\n                        <div class=\"desc-wrapper\">\n                            <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".item-desc, .desc-wrapper\">\n                                &gt; 10 years\n                            </p>\n                        </div>\n                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-name, .icon-wrapper, .mbr-section-btn\" mbr-if=\"showName\"><b>Managed Quality</b></h4>\n                        <p class=\"item-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\" mbr-if=\"showRole\">Structured testing, updates, and ongoing review.</p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                        <a class=\"btn btn-secondary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Contact now\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vyrDXLUIOh",
          "_anchor": "features08-1c",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "position": "relative",
            "color": "#c75423",
            "background-position": "center center",
            "background-size": "cover",
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            "width": "100%",
            "max-width": "100%",
            "overflow-x": "clip",
            ".n3-faq-inner, .n3-faq-inner *, .n3-faq-inner *::before, .n3-faq-inner *::after": {
              "box-sizing": "border-box"
            },
            ".mbr-fallback-image": {
              "position": "absolute",
              "inset": "0",
              "width": "100%",
              "height": "100%",
              "background-position": "center center",
              "background-size": "cover",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              },
              "display": "block",
              "top": "0"
            },
            ".container, .container-fluid": {
              "position": "relative",
              "z-index": "2",
              "min-width": "0"
            },
            ".n3-faq-inner": {
              "width": "100%",
              "max-width": "1420px",
              "min-width": "0",
              "margin": "0 auto"
            },
            ".n3-faq-heading": {
              "margin": "0 0 25px",
              "min-width": "0"
            },
            ".mbr-section-title": {
              "color": "#ffffff !important",
              "text-align": "left",
              "font-size": "clamp(1.9rem, 2.4vw, 2.8rem)",
              "line-height": "1.15",
              "margin": "0 0 6px",
              "overflow-wrap": "anywhere"
            },
            ".mbr-text": {
              "color": "#D9D9D9 !important",
              "text-align": "left",
              "font-size": "clamp(0.98rem, 1.15vw, 1.3rem)",
              "line-height": "1.45",
              "margin": "0",
              "overflow-wrap": "anywhere"
            },
            ".n3-faq-layout": {
              "display": "grid",
              "grid-template-columns": "minmax(0, 1.55fr) minmax(0, 1fr)",
              "gap": "26px",
              "align-items": "start",
              "width": "100%",
              "min-width": "0"
            },
            ".n3-faq-layout > *": {
              "min-width": "0",
              "max-width": "100%"
            },
            ".n3-faq-main": {
              "display": "grid",
              "grid-template-columns": "42px minmax(0, 1fr)",
              "gap": "15px",
              "align-items": "start",
              "min-width": "0",
              "width": "100%"
            },
            ".n3-faq-side-label": {
              "min-width": "0",
              "color": "#c75423",
              "border-right": "2px solid #c75423",
              "padding": "7px 10px 0 0",
              "min-height": "150px",
              "font-size": "1.15rem",
              "font-weight": "800",
              "line-height": "1",
              "writing-mode": "vertical-rl",
              "transform": "rotate(180deg)",
              "text-align": "right"
            },
            ".n3-faq-list": {
              "min-width": "0",
              "width": "100%",
              "max-width": "100%"
            },
            ".panel-group": {
              "display": "block",
              "width": "100%",
              "min-width": "0",
              "margin": "0",
              "border": "1px solid @border",
              "border-radius": "0",
              ".card": {
                "padding": "0",
                "border": "none",
                "border-top": "1px solid @border",
                "border-radius": "0 !important",
                "background-color": "rgba(20, 20, 20, 0.38)",
                "&:first-child": {
                  "border-top": "none"
                },
                ".card-header": {
                  "padding": "0",
                  "border": "none",
                  "background-color": "transparent",
                  ".panel-title": {
                    "position": "relative",
                    "display": "flex",
                    "align-items": "center",
                    "justify-content": "space-between",
                    "gap": "15px",
                    "min-height": "43px",
                    "padding": "9px 15px",
                    "color": "#F9F6E0 !important",
                    "text-decoration": "none",
                    "&:hover": {
                      "background-color": "rgba(255, 255, 255, 0.045)"
                    },
                    "&:focus-visible": {
                      "outline": "2px solid #c75423",
                      "outline-offset": "-2px"
                    },
                    ".panel-title-edit": {
                      "margin": "0",
                      "padding": "0",
                      "border": "none",
                      "color": "#ffffff !important",
                      "font-size": "clamp(0.95rem, 1.15vw, 1.18rem)",
                      "font-weight": "600",
                      "line-height": "1.35",
                      "b, span": {
                        "color": "inherit !important"
                      }
                    },
                    "&:not(.collapsed)": {
                      ".panel-title-edit": {
                        "color": "#F9F6E0 !important",
                        "border-left": "2px solid @active",
                        "padding-left": "12px"
                      },
                      ".faq-toggle-icon::before": {
                        "content": "\"−\""
                      }
                    }
                  }
                },
                ".panel-collapse": {
                  ".panel-body": {
                    "padding": "0 18px 17px",
                    ".panel-text": {
                      "color": "#D9D9D9 !important",
                      "font-size": "0.97rem",
                      "line-height": "1.55",
                      "margin": "0"
                    }
                  }
                }
              }
            },
            ".panel-group .card": {
              "display": "block",
              "width": "100%",
              "min-width": "0",
              "margin": "0",
              "padding": "0",
              "border": "none",
              "border-top": "1px solid @border",
              "border-radius": "0 !important",
              "background-color": "rgba(20, 20, 20, 0.45)",
              "box-shadow": "none"
            },
            ".panel-group .card:first-child": {
              "border-top": "none"
            },
            ".panel-group .card-header": {
              "width": "100%",
              "min-width": "0",
              "margin": "0",
              "padding": "0",
              "border": "none",
              "background": "transparent"
            },
            ".panel-group .panel-title": {
              "display": "flex",
              "flex-direction": "row",
              "align-items": "center",
              "justify-content": "space-between",
              "gap": "14px",
              "width": "100%",
              "min-width": "0",
              "min-height": "54px",
              "padding": "13px 16px",
              "margin": "0",
              "color": "#F9F6E0 !important",
              "text-decoration": "none !important",
              "background": "transparent"
            },
            ".panel-group .panel-title:hover": {
              "background-color": "rgba(255, 255, 255, 0.045)"
            },
            ".panel-group .panel-title:focus-visible": {
              "outline": "2px solid #E0B548",
              "outline-offset": "-2px"
            },
            ".panel-group .panel-title-edit": {
              "display": "block",
              "flex": "1 1 auto",
              "width": "auto",
              "min-width": "0",
              "max-width": "100%",
              "margin": "0",
              "padding": "0",
              "color": "#F9F6E0 !important",
              "font-size": "clamp(0.95rem, 1.1vw, 1.15rem)",
              "font-weight": "600",
              "line-height": "1.4",
              "text-align": "left",
              "overflow-wrap": "anywhere",
              "word-break": "normal"
            },
            ".panel-group .panel-title:not(.collapsed) .panel-title-edit": {
              "border-left": "2px solid @active",
              "padding-left": "11px"
            },
            ".n3-faq-icon": {
              "display": "inline-flex",
              "flex": "0 0 22px",
              "width": "22px",
              "height": "22px",
              "align-items": "center",
              "justify-content": "center",
              "color": "#c75423",
              "font-size": "1.45rem",
              "font-weight": "700",
              "line-height": "1"
            },
            ".n3-faq-icon::before": {
              "content": "\"+\""
            },
            ".panel-title:not(.collapsed) .n3-faq-icon::before": {
              "content": "\"−\""
            },
            ".panel-group .panel-collapse": {
              "width": "100%",
              "min-width": "0"
            },
            ".panel-group .panel-body": {
              "width": "100%",
              "min-width": "0",
              "padding": "0 17px 18px"
            },
            ".panel-group .panel-text": {
              "color": "#D9D9D9 !important",
              "font-size": "0.97rem",
              "line-height": "1.6",
              "margin": "0",
              "padding": "0",
              "overflow-wrap": "anywhere"
            },
            ".n3-studio-guide": {
              "width": "100%",
              "max-width": "100%",
              "min-width": "0",
              "padding": "19px",
              "border": "1px solid @border",
              "border-radius": "3px",
              "background-color": "rgba(27, 27, 27, 0.9)",
              "box-shadow": "0 5px 18px rgba(0, 0, 0, 0.18)"
            },
            ".n3-guide-top": {
              "display": "flex",
              "flex-direction": "row",
              "align-items": "flex-start",
              "gap": "16px",
              "width": "100%",
              "min-width": "0",
              "margin-bottom": "20px"
            },
            ".n3-guide-avatar": {
              "flex": "0 0 94px",
              "width": "94px",
              "height": "94px",
              "overflow": "hidden",
              "border": "2px solid #72716b",
              "border-radius": "50%",
              "background": "#242424"
            },
            ".n3-guide-avatar img": {
              "display": "block",
              "width": "100%",
              "height": "100%",
              "max-width": "100%",
              "object-fit": "cover",
              "object-position": "center",
              "border-radius": "50%"
            },
            ".n3-guide-content": {
              "flex": "1 1 auto",
              "width": "auto",
              "min-width": "0",
              "padding-top": "5px"
            },
            ".n3-guide-title": {
              "color": "#FFFFFF !important",
              "font-size": "clamp(0.95rem, 1.2vw, 1.2rem)",
              "line-height": "1.35",
              "margin": "0 0 10px",
              "overflow-wrap": "anywhere"
            },
            ".n3-guide-description": {
              "color": "#DADADA !important",
              "font-size": "clamp(0.94rem, 1.1vw, 1.1rem)",
              "line-height": "1.55",
              "margin": "0",
              "overflow-wrap": "anywhere"
            },
            ".n3-guide-actions": {
              "width": "100%",
